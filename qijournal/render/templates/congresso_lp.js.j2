{#- Aba Congresso: a visão por parlamentar (incluído por congresso.js.j2, dentro da mesma função,
    só quando há c.lp). O interruptor "Ver por" (as abas de cada visão; a visão não entra no
    endereço: sai da aba), o que as vistas novas têm em comum (os rótulos do manifesto, o leitor
    de arquivos sob demanda, a Janela, a pessoa em foco e a alavanca, que atravessam as vistas) e
    as duas primeiras: "Os projetos" (#v=projetos) e "Quem propõe" (#v=autores).
    Os pontos vêm de projetos-<casa>.json e autores-<casa>.json quando a vista abre; o HTML já
    traz os números, as cabeças das faixas, as listas e as tabelas. Seleção realça: o que não
    passa fica esmaecido, não some, e nenhum ponto muda de lugar (só a troca de medida
    redesenha). Nenhum nome de faixa, alavanca, marca ou código é escrito aqui: vêm de M.lp.
    Sempre com textContent: nada do arquivo vira HTML. -#}
  /* ════ A visão por parlamentar ════ */
  var LPM = M.lp || {}, LPR = LPM.rot || {}, LPC = LPM.cortes || {};
  var LP = { quem: '', eixo: '' };  // o que vale entre as vistas: a pessoa em foco e a alavanca
  var lpVistas = {};  // vista → Casa → { abrir(), doEndereco(parâmetros), casaMudou() }

  /* O interruptor "Ver por": as abas de hoje são a visão "partido"; as novas, a visão "pessoa". */
  var lenteEl = d.getElementById('cgLente'), fraseDaBarra = d.getElementById('cgCasasN');
  var LENTE = {}, lenteAtual = 'partido', carregando = true;
  if (nav) lista(nav.querySelectorAll('ul')).forEach(function (ul) {
    var l = ul.getAttribute('data-lente') || 'partido';
    lista(ul.querySelectorAll('a[data-vista]')).forEach(function (a) {
      var v = a.getAttribute('data-vista');
      LENTE[v] = LENTE[v] && LENTE[v] !== l ? 'ambas' : l;
    });
  });
  function guardar(chave, valor) { try { w.sessionStorage.setItem(chave, valor); } catch (erro) { /* sem armazenamento: vale só nesta página */ } }
  function guardado(chave) { try { return w.sessionStorage.getItem(chave); } catch (erro) { return null; } }
  function verLente(l) {
    lenteAtual = l;
    root.setAttribute('data-lente', l);
    if (lenteEl) lista(lenteEl.querySelectorAll('button')).forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-lente') === l ? 'true' : 'false'); });
    guardar('qij-lente', l);
  }
  aoTrocarVista = function (nome) {
    if (LENTE[nome] && LENTE[nome] !== 'ambas' && LENTE[nome] !== lenteAtual) verLente(LENTE[nome]);
    if (!(carregando && nome === vistaPadrao)) guardar('qij-vista-' + lenteAtual, nome);
  };
  w.setTimeout(function () { carregando = false; }, 0);
  if (lenteEl && abas.length) {
    lenteEl.hidden = false;
    if (fraseDaBarra) fraseDaBarra.hidden = !casas || casas.hidden;
    verLente('partido');
    lenteEl.addEventListener('click', function (event) {
      var b = event.target && event.target.closest ? event.target.closest('button[data-lente]') : null, l = b ? b.getAttribute('data-lente') : '';
      if (!l || l === lenteAtual) return;
      var destino = guardado('qij-vista-' + l);
      if (!destino || (LENTE[destino] !== l && LENTE[destino] !== 'ambas')) destino = l === 'pessoa' ? (LPM.abas || [])[0] : vistaPadrao;
      if (!destino) return;
      if (w.history && w.history.pushState) w.history.pushState(null, '', '#v=' + destino);
      verLente(l);
      verVista(destino);
    });
  }

  /* "Como ler", na visão por parlamentar, leva ao bloco da leitura dos projetos (no fim da seção que já existia). */
  if (nav) nav.addEventListener('click', function (event) {
    var a = event.target && event.target.closest ? event.target.closest('a[href="#cg-lp-metodo"]') : null, alvo = d.getElementById('cg-lp-metodo');
    if (a && alvo) alvo.scrollIntoView();
  });

  /* ── O que as vistas novas têm em comum ── */
  var lpCache = {}, lpFila = {};
  /* Um arquivo da visão, lido uma vez: lpArquivo('projetos', 'cd', fn) ou lpArquivo('autoria', 'cd-204536', fn). */
  function lpArquivo(tipo, qual, pronto) {
    var chave = tipo + ':' + qual;
    if (lpCache[chave]) { pronto(null, lpCache[chave]); return; }
    if (lpFila[chave]) { lpFila[chave].push(pronto); return; }
    lpFila[chave] = [pronto];
    buscar((LPM.arq || {})[tipo] + qual + '.json', function (erro, x) {
      var ok = !erro && x && x.cols && (x.linhas || x.votacoes);  // decide-<casa>.json traz "votacoes" no lugar de "linhas"
      if (ok) lpCache[chave] = x;
      var fila = lpFila[chave];
      lpFila[chave] = null;
      fila.forEach(function (fn) { fn(ok ? null : (erro || new Error('formato')), lpCache[chave]); });
    });
  }
  /* As linhas de um arquivo (vetores) como objetos, pelas colunas dele. */
  function lpLinhas(arq) {
    return arq.linhas.map(function (l) {
      var o = {};
      arq.cols.forEach(function (c, i) { o[c] = l[i]; });
      return o;
    });
  }
  function lpParams(q) {
    var p = {}, algum = false;
    (q || '').split('&').forEach(function (par) {
      var i = par.indexOf('=');
      if (i > 0) { try { p[par.slice(0, i)] = decodeURIComponent(par.slice(i + 1)); algum = true; } catch (erro) { /* parâmetro malformado: ignorado */ } }
    });
    return algum ? p : null;
  }
  function lpCasaDaVez() { return casas && !casas.hidden ? root.getAttribute('data-ver') : ''; }
  function lpDec(v) { return v == null ? '—' : String(Math.round(v * 10) / 10).replace('.', ','); }
  function lpRotulo(listaDePares, id) {
    for (var i = 0; i < (listaDePares || []).length; i++) if (listaDePares[i][0] === id) return listaDePares[i];
    return null;
  }
  function lpEixo(id) { var e = lpRotulo(LPM.eixos, id); return e ? e[1] : id; }
  function lpDir(id) { return lpRotulo(LPM.direcoes, id) || [id, id, 'vazado', null]; }
  function lpFaixa(id) { var f = lpRotulo(LPM.faixas, id); return f ? f[1] : id; }
  function lpNoTopo(faixa) { return ((LPM.grupos || {}).topo || []).indexOf(faixa) >= 0; }
  function lpForma(forma, extra) { return h('i', { cls: 'cg-lp-g cg-lp-' + (forma || 'vazado') + (extra ? ' ' + extra : ''), 'aria-hidden': 'true' }); }
  function lpSelo() { return h('button', { cls: 'az-selo cg-lp-selo', type: 'button', 'data-dica': LPM.selo_dica || null, text: LPM.selo || '' }); }
  lista(root.querySelectorAll('.cg-lp-selo')).forEach(function (b) { b.setAttribute('data-dica', LPM.selo_dica || ''); });
  function lpTag(confirmado) { return h('span', { cls: 'cg-lp-tag' + (confirmado ? '' : ' cg-lp-tag-ac'), text: confirmado ? LPR.topo : 'a confirmar' }); }
  function lpMateria(k, t, u, f) {
    if (f) return h('a', { cls: 'cg-mt', href: '#m=' + k, 'data-m': k, text: t });
    return u ? h('a', { cls: 'cg-mt', href: u, target: '_blank', rel: 'noopener noreferrer', text: t }) : h('span', { cls: 'cg-pa-c-t', text: t });
  }
  function lpPessoa(k, nome) { return k ? h('a', { cls: 'cg-p', href: '#p=' + k, 'data-k': k, text: nome }) : d.createTextNode(nome || ''); }
  function lpIr(vista, quem, texto) { return h('a', { cls: 'cg-lp-ir', href: '#v=' + vista + '&c=' + quem.slice(0, 2) + '&quem=' + quem, text: texto }); }
  /* A Janela de uma vista: sem filtro, o texto do HTML; com filtro, "Realçados: n de total" (ou outro rótulo) e uma ficha por filtro, cada uma com o seu ×, e "Limpar". */
  function lpJanela(bloco) {
    var el = bloco.querySelector('.cg-lp-jan'), padrao = el ? lista(el.childNodes) : [];
    return function (texto, fichas, limpar, rotulo) {
      if (!el) return;
      esvaziar(el);
      if (!fichas || !fichas.length) {  // sem filtro: o texto do HTML (ou outro, se a vista trocou de medida)
        if (texto) el.appendChild(h('span', { cls: 'cg-lp-jan-t' }, texto)); else padrao.forEach(function (no) { el.appendChild(no); });
        return;
      }
      el.appendChild(h('b', { text: rotulo || 'Realçados: ' }));
      el.appendChild(d.createTextNode(texto.join('') + ' · '));
      fichas.forEach(function (f) {
        var b = h('button', { type: 'button', cls: 'cg-lp-jan-x', 'aria-label': 'Tirar o filtro: ' + f[0], text: f[0] });
        b.addEventListener('click', f[1]);
        el.appendChild(b);
      });
      var tudo = h('button', { type: 'button', cls: 'cg-pa-limpa', text: 'Limpar' });
      tudo.addEventListener('click', limpar);
      el.appendChild(tudo);
    };
  }
  /* No celular, a Janela ocupa uma linha, com reticências; o toque abre o texto inteiro. */
  lista(root.querySelectorAll('.cg-lp-jan')).forEach(function (el) {
    el.addEventListener('click', function (event) { if (!(event.target.closest && event.target.closest('button'))) el.classList.toggle('cg-lp-jan-ab'); });
  });
  /* As listas longas: no celular, 5 itens e "mostrar todos". */
  lista(root.querySelectorAll('.cg-lp-mm')).forEach(function (b) {
    b.hidden = false;
    b.addEventListener('click', function () { var ls = b.parentNode.querySelector('.cg-lp-ls'); if (ls) ls.classList.add('cg-lp-ab'); b.hidden = true; });
  });
  /* Os links "→" entre as vistas (com a pessoa em foco) e a linha "A seguir". */
  root.addEventListener('click', function (event) {
    var a = event.target && event.target.closest ? event.target.closest('a[data-lp-ir]') : null;
    if (!a) return;
    event.preventDefault();
    event.stopPropagation();
    var destino = '#v=' + a.getAttribute('data-lp-ir') + '&c=' + (lpCasaDaVez() || 'cd') + (LP.quem ? '&quem=' + LP.quem : '') + (LP.eixo ? '&eixo=' + LP.eixo : '');
    if (w.history && w.history.pushState) { w.history.pushState(null, '', destino); doEndereco(); w.scrollTo(0, 0); } else w.location.hash = destino.slice(1);
  }, true);
  function lpVista(nome) {
    lpVistas[nome] = {};
    aoAbrirVista[nome] = function () {
      var ver = lpCasaDaVez();
      Object.keys(lpVistas[nome]).forEach(function (casa) { if (!ver || ver === casa) lpVistas[nome][casa].abrir(); });
    };
    aoEndereco[nome] = function (q) {
      var p = lpParams(q);
      if (!p) return;
      var casa = p.c === 'sf' || p.c === 'cd' ? p.c : /^(cd|sf)-/.test(p.quem || p.m || '') ? (p.quem || p.m).slice(0, 2) : (lpCasaDaVez() || 'cd');
      if (!lpVistas[nome][casa]) return;
      if (casas && !casas.hidden && root.getAttribute('data-ver') !== casa) verCasa(casa);
      lpVistas[nome][casa].doEndereco(p);
    };
    return lpVistas[nome];
  }

  /* ════ Os projetos: uma faixa por porta, um ponto por projeto do topo da régua ════ */
  (function () {
    var vista = lpVista('projetos');
    var NIVEIS = w.innerWidth <= 760 ? 12 : 9, PASSO = 10, VIZINHAS = [0, 1, -1, 2, -2, 3, -3];  // no celular a coluna é mais larga: a pilha pode ser mais alta
    var ESCALA = LPM.escala_tempo || [], TETO = LPM.tempo_teto || 98, PARADO = LPC.dias_parado || 365;
    /* O tempo sem andar no eixo, em saltos (não é medida fina: o registro muda a data até quando a matéria é só pautada). */
    function xDoTempo(n) {
      if (n == null || n <= 0 || !ESCALA.length) return 0;
      for (var i = 1; i < ESCALA.length; i++) {
        if (n <= ESCALA[i][0]) return ESCALA[i - 1][1] + (n - ESCALA[i - 1][0]) / (ESCALA[i][0] - ESCALA[i - 1][0]) * (ESCALA[i][1] - ESCALA[i - 1][1]);
      }
      var fim = ESCALA[ESCALA.length - 1];
      return Math.min(TETO, fim[1] + (n - fim[0]) / fim[0] * (TETO - fim[1]));
    }
    lista(root.querySelectorAll('[data-lp="projetos"]')).forEach(function (bloco) {
      var casa = bloco.getAttribute('data-casa'), focoPadrao = bloco.getAttribute('data-foco') || '';
      var portasEl = bloco.querySelector('.cg-lp-portas'), fig = bloco.querySelector('.cg-lp-fig'), cw = bloco.querySelector('.cg-lp-cw');
      var fs = bloco.querySelector('.cg-lp-fs'), st = bloco.querySelector('.cg-lp-st'), dica = bloco.querySelector('.cg-lp-dica');
      if (!portasEl || !fig || !cw || !fs) return;
      var card = cw.querySelector('.cg-lp-card'), navEl = cw.querySelector('.cg-pa-nav');
      var ant = navEl.querySelector('.cg-pa-ant'), prox = navEl.querySelector('.cg-pa-prox'), posEl = navEl.querySelector('.cg-pa-pos');
      var limpar = fs.querySelector('.cg-pa-limpa'), selEixo = fs.querySelector('select[data-f="eixo"]');
      var chips = lista(fs.querySelectorAll('.cg-pa-f')), numeros = lista(bloco.querySelectorAll('.cg-lp-n')), cabecas = lista(bloco.querySelectorAll('.cg-lp-porta'));
      var janela = lpJanela(bloco), parado = w.matchMedia && w.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var P = [], porChave = {}, pistas = {}, estado = 0, pendente = null;  // estado: 0 sem os pontos, 1 carregando, 2 pronto
      var F = { dir: '', conf: '', par: false, porta: '' };  // os filtros desta vista (a alavanca e a pessoa em foco ficam em LP)
      var emFoco = null, noCartao = focoPadrao, ordem = [], temAConfirmar = false;
      cabecas.forEach(function (b) { var c = b.querySelector('.cg-lp-pc'); b._n = c ? c.textContent : ''; });

      function temFiltro() { return !!(F.dir || F.conf || F.par || F.porta || LP.eixo || LP.quem); }
      function passa(p) {
        if (F.dir && p.dir !== F.dir) return false;
        if (F.conf && (F.conf === '1') !== p.conf) return false;
        if (F.par && !p.par) return false;
        if (F.porta && p.pp !== F.porta) return false;
        if (LP.eixo && p.ex !== LP.eixo) return false;
        if (LP.quem && p.a !== LP.quem) return false;
        return true;
      }
      function ligado(f) {
        var i = f.indexOf(':'), tipo = i < 0 ? f : f.slice(0, i), valor = i < 0 ? '' : f.slice(i + 1);
        return tipo === 'dir' ? F.dir === valor : tipo === 'conf' ? F.conf === valor : tipo === 'par' ? F.par : tipo === 'porta' ? F.porta === valor : tipo === 'eixo' ? LP.eixo === valor : false;
      }
      function alternar(f, soEste) {
        var i = f.indexOf(':'), tipo = i < 0 ? f : f.slice(0, i), valor = i < 0 ? '' : f.slice(i + 1), on = ligado(f);
        if (soEste || tipo === 'todos') { F = { dir: '', conf: '', par: false, porta: '' }; LP.eixo = ''; LP.quem = ''; }
        if (tipo === 'dir') F.dir = on ? '' : valor;
        else if (tipo === 'conf') F.conf = on ? '' : valor;
        else if (tipo === 'par') F.par = !on;
        else if (tipo === 'porta') F.porta = on ? '' : valor;
        else if (tipo === 'eixo') LP.eixo = on ? '' : valor;
        if (tipo === 'todos') emFoco = null;
        aplicar();
      }
      function endereco() {
        return '#v=projetos&c=' + casa + (LP.eixo ? '&eixo=' + LP.eixo : '') + (F.porta ? '&porta=' + F.porta : '') + (F.dir ? '&dir=' + F.dir : '') + (F.conf ? '&conf=' + F.conf : '') +
          (F.par ? '&par=1' : '') + (LP.quem ? '&quem=' + LP.quem : '') + (emFoco && emFoco.k !== focoPadrao ? '&m=' + emFoco.k : '');
      }
      function gravarEndereco() {
        if (estado !== 2 || vistaAtual !== 'projetos' || aberto || !w.history || !w.history.replaceState) return;
        if (lpCasaDaVez() && lpCasaDaVez() !== casa) return;
        if ((w.location.hash || '') !== endereco()) w.history.replaceState(null, '', endereco());
      }
      function nomeDaPessoa(k) {
        for (var i = 0; i < P.length; i++) if (P[i].a === k) return P[i].an;
        return nomeDe(k);
      }
      function atualizarPasso() {
        var i = emFoco ? ordem.indexOf(emFoco) : -1, n = ordem.length;
        ant.disabled = !n || i === 0;
        prox.disabled = !n || i === n - 1;
        if (!emFoco) posEl.textContent = n ? num(n) + (temFiltro() ? ' realçados' : ' projetos') : 'nada realçado';
        else if (i < 0) posEl.textContent = emFoco.t + ' · fora do realce (' + num(n) + (n === 1 ? ' realçado)' : ' realçados)');
        else posEl.textContent = emFoco.t + ' · ' + num(i + 1) + ' de ' + num(n) + (temFiltro() ? (n === 1 ? ' realçado' : ' realçados') : '');
      }
      function aplicar(semEndereco) {
        if (estado !== 2) return;
        var filtro = temFiltro(), porPorta = {}, conf = 0;
        ordem = [];
        P.forEach(function (p) {
          var ok = passa(p);
          if (p.el) p.el.classList.toggle('cg-lp-off', !ok);
          if (!ok) return;
          ordem.push(p);
          porPorta[p.pp] = (porPorta[p.pp] || 0) + 1;
          if (p.conf) conf += 1;
        });
        chips.forEach(function (b) { b.setAttribute('aria-pressed', ligado(b.getAttribute('data-f') || '') ? 'true' : 'false'); });
        numeros.forEach(function (b) {
          var f = b.getAttribute('data-f') || '', on = ligado(f), aviso = b.querySelector('.cg-pa-m-ir');
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          if (aviso && f !== 'todos') aviso.textContent = on ? 'realçado no gráfico' : 'ver no gráfico';
        });
        cabecas.forEach(function (b) {
          var id = (b.getAttribute('data-f') || '').slice(6), c = b.querySelector('.cg-lp-pc');
          b.setAttribute('aria-pressed', F.porta === id ? 'true' : 'false');
          if (c) c.textContent = filtro ? num(porPorta[id] || 0) + ' de ' + b._n : b._n;
        });
        if (selEixo) selEixo.value = LP.eixo;
        limpar.hidden = !filtro;
        var fichas = [];
        if (LP.eixo) fichas.push([lpEixo(LP.eixo), function () { LP.eixo = ''; aplicar(); }]);
        if (F.porta) fichas.push([(LPM.portas_nome || {})[F.porta] || F.porta, function () { F.porta = ''; aplicar(); }]);
        if (F.dir) fichas.push([lpDir(F.dir)[1], function () { F.dir = ''; aplicar(); }]);
        if (F.conf) fichas.push([F.conf === '1' ? 'confirmados por dois leitores' : 'a confirmar', function () { F.conf = ''; aplicar(); }]);
        if (F.par) fichas.push(['parados há mais de um ano', function () { F.par = false; aplicar(); }]);
        if (LP.quem) fichas.push(['Seguindo: ' + nomeDaPessoa(LP.quem), function () { LP.quem = ''; aplicar(); }]);
        /* com algum projeto à espera da segunda leitura, o realce diz quantos são de cada estado */
        janela(fichas.length ? [num(ordem.length) + ' de ' + num(P.length) + ' no gráfico' + (temAConfirmar ? ' (' + num(conf) + (conf === 1 ? ' confirmado' : ' confirmados') + ' e ' + num(ordem.length - conf) + ' a confirmar)' : '')] : null, fichas, limparTudo);
        st.hidden = !!ordem.length;
        if (!ordem.length) st.textContent = LP.quem && fichas.length === 1 ? 'Nenhum projeto de ' + nomeDaPessoa(LP.quem) + ' está entre os do topo da régua que tramitam.' : 'Nenhum projeto passa neste filtro.';
        if (ordem.length && (!emFoco || ordem.indexOf(emFoco) < 0)) irAo(!filtro && porChave[focoPadrao] ? porChave[focoPadrao] : ordem[0], { semEndereco: true });
        else atualizarPasso();
        if (!semEndereco) gravarEndereco();
      }
      function limparTudo() { alternar('todos'); }

      /* ── O cartão do projeto (o mesmo do HTML, montado aqui para os demais) ── */
      function linhaDoCodigo(rotulo, filhos) { return h('div', null, [h('dt', { text: rotulo }), h('dd', null, filhos)]); }
      function cartaoDe(p) {
        var campos = LPM.campos || {}, d0 = lpDir(p.dir), nivel = lpRotulo(LPM.eixos, p.ex);
        var nomeDoNivel = nivel ? lpRotulo(LPM.niveis, nivel[2]) : null, marca = lpRotulo(LPM.marcas, (LPM.papeis || {}).caixa);
        var cod = [linhaDoCodigo(LPR.eixo || '', [lpEixo(p.ex), nomeDoNivel ? h('small', { text: ' ' + nomeDoNivel[1] }) : null])];
        (p.cod || []).forEach(function (par) {
          var c = campos[par[0]] || [par[0], {}];
          cod.push(linhaDoCodigo(c[0], [par[1] === 'nd' ? (LPM.nd || '') : (c[1][par[1]] || par[1])]));
        });
        if (marca) cod.push(linhaDoCodigo('Marca de ' + marca[1].toLowerCase(), [lpForma(d0[2]), d0[1]]));
        var porta = lpRotulo(LPM.portas, p.pp) || [p.pp, '', ''], comRelator = p.rln && p.pp === 'parecer', nd = dias(p.ult);
        var frasePorta = porta[1] ? porta[1].charAt(0).toUpperCase() + porta[1].slice(1) : '';
        var legenda = [p.ap, p.au].filter(Boolean).join('-'), deQuem = [];
        if (p.an) { deQuem.push(lpPessoa(p.a, p.an)); if (legenda) deQuem.push(' (' + legenda + ')'); } else if (legenda) deQuem.push(legenda);
        var origem = (LPM.origens || {})[p.og] || '';
        if (origem) deQuem.push((deQuem.length ? ' · ' : '') + origem);
        if (p.d) deQuem.push(' · apresentado em ' + dataBr(p.d));
        if (p.a && (LPM.abas || []).indexOf('autores') >= 0) { deQuem.push(' · '); deQuem.push(lpIr('autores', p.a, 'ver o perfil de projetos →')); }
