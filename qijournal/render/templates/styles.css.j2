{#- Estilos das páginas (incluídos inline em todas: edição, arquivo, Analítico, Pesquisa,
    Todas as notícias, Congresso e Tribunais). Tokens --qi/--qn/--qc/--qr, papel na largura
    toda da tela, cabeçalho, linha de indicadores e, na página da edição, a home em três
    andares: a manchete e "Em 1 minuto", "Como a mídia cobriu" e o bloco recolhido das
    matérias por editoria; na cópia arquivada, as gavetas de detalhe (cobertura comparada,
    termômetro e como a edição foi feita). Depois, as janelas das matérias e o rodapé.
    Os blocos da home usam um sistema só: uma régua (--fio), cinco tamanhos de letra
    (--f-man, --f-tit, --f-txt, --f-min, --f-rot), dois pesos (400 e 700) e a margem
    lateral --mg. Um bloco novo da home (a agenda da semana) segue o mesmo sistema:
    <section class="bl"> com o título em <h2 class="rot"> e o link do pé em <p class="mais">.
    As cores da marca vêm de config.brand.colors (já validadas em web.py); os neutros
    são os cinzas azulados do layout original, que casam com o marinho e o cobalto da
    marca Triangula. Com brand.masthead, o cabeçalho vira um bloco de cor com o logo em
    on_masthead. -#}
:root{
  --qi:{{ brand.colors.primary }};--qn:{{ brand.colors.navy }};--qc:{{ brand.colors.accent }};--qr:{{ brand.colors.alert }};
  --up:{{ brand.colors.ticker_up }};--down:{{ brand.colors.ticker_down }};
  --qi-rgb:{{ brand.rgb.primary }};--qn-rgb:{{ brand.rgb.navy }};--qr-rgb:{{ brand.rgb.alert }};
  --ink:#1a2332;--paper:#fff;--bg:#f0f2f5;--rule:#d0d5dd;--rl:#e4e7ec;
  --head:var(--qn);--body:#4a5568;--muted:#5a6577;--mute2:#5f6b7e;--faint:#626e81;
  --soft:#f8f9fb;--side:#fdfdfd;--hover:#fafbff;--hl:#e8ebf0;--op-a:#fafbff;--op-b:#f0f2f5;
  --link:var(--qi);--text:#333d4d;
  --gut:30px;
  --fx-dot:var(--qi);--fx-line:var(--qc);
  --sf:'Noto Serif',Georgia,'Times New Roman',serif;
  --ss:'Noto Sans',Helvetica,Arial,sans-serif;
  --mn:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color-scheme:light;
}
/* Home: uma régua, cinco tamanhos de letra e a margem lateral dos blocos */
:root{--fio:1px solid var(--rule);--mg:var(--gut);--f-man:26px;--f-tit:17px;--f-txt:14px;--f-min:12.5px;--f-rot:11px}
:root[data-theme="dark"]{
  --ink:#e2e8f4;--paper:#111827;--bg:#0b0f17;--rule:#2d3748;--rl:#1f2937;
  --head:#e8edf7;--body:#a9b4c6;--muted:#97a3b6;--mute2:#8a96a8;--faint:#7d8899;
  --soft:#131c2d;--side:#0f1522;--hover:#1a2235;--hl:#1e2d47;--op-a:#1a2235;--op-b:#111827;
  --link:#8fb0f5;--text:#c8d3e6;
  color-scheme:dark;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--sf);-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.4}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--link);outline-offset:2px}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:8px;z-index:10000;padding:8px 14px;background:var(--paper);color:var(--link);font-family:var(--ss);font-size:13px;font-weight:700;border:2px solid var(--qi)}
.skip:focus{left:16px}
.paper{width:100%;min-height:100vh;display:flex;flex-direction:column;background:var(--paper)}
.paper>main{flex:1}

/* Barra de progresso de leitura */
#rdprog{position:fixed;top:0;left:0;right:0;height:3px;background:var(--qc);transform:scaleX(0);transform-origin:0 50%;z-index:9999;pointer-events:none}

/* Cabeçalho */
.mast-wrap{position:relative;overflow:hidden;background:var(--paper);border-bottom:3px solid var(--qn)}
:root[data-theme="dark"] .mast-wrap{border-bottom-color:var(--qi)}
#mast-canvas{position:absolute;inset:0;width:100%;height:100%;opacity:.07;pointer-events:none}
:root[data-theme="dark"] #mast-canvas{opacity:.09}
.mast{position:relative;z-index:2;text-align:center;padding:28px 40px 22px}
.mast h1{font-family:var(--ss);font-size:48px;font-weight:800;letter-spacing:-1px;line-height:1.15;color:var(--qn)}
.mast h1 a{display:inline-block}
.mast h1:focus{outline:none}
.mast h1 .q{color:var(--qc)}
.mast h1 .journal{font-weight:900;margin-left:4px}
:root[data-theme="dark"] .mast h1{color:var(--head)}
.mast h1.logo{line-height:0}
.mast h1.logo svg{display:block;height:116px;width:auto;margin:0 auto}
:root[data-theme="dark"] .mast h1.logo:not(.mono):not(.duo) svg{filter:invert(1) hue-rotate(180deg) brightness(1.15)}
/* Logo com versão própria para o modo escuro: troca de SVG em vez de filtro */
.mast h1.logo .lg{display:block}
.mast h1.logo .lg-d,:root[data-theme="dark"] .mast h1.logo .lg-l{display:none}
:root[data-theme="dark"] .mast h1.logo .lg-d{display:block}
.mast h1.logo.mono svg{height:64px;color:var(--qn)}
:root[data-theme="dark"] .mast h1.logo.mono svg{color:var(--head)}
{% if brand.logo_height %}
.mast h1.logo svg,.mast h1.logo.mono svg{height:{{ brand.logo_height }}px;max-width:100%}
{% endif %}
.mast-sub{font-family:var(--ss);font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--mute2);margin-top:6px}
.mast h1.logo+.mast-sub{margin-top:14px}
.mast-date{font-family:var(--mn);font-size:10px;color:var(--faint);margin-top:8px;letter-spacing:1px}
.mast-date .nw{white-space:nowrap}
{% if brand.masthead %}
/* Cabeçalho em bloco de cor (brand.masthead): logo, slogan, data e botões em on_masthead */
.mast-wrap.solid{--mh:{{ brand.masthead }};--on-mh:{{ brand.on_masthead }};--on-mh-rgb:{{ brand.rgb.on_masthead }};--fx-dot:var(--on-mh);--fx-line:var(--on-mh);background:var(--mh);background:linear-gradient(135deg,color-mix(in srgb,var(--mh) 94%,#fff),color-mix(in srgb,var(--mh) 92%,#000))}
:root[data-theme="dark"] .mast-wrap.solid{border-bottom-color:var(--qn);background:color-mix(in srgb,var(--mh) 82%,#000)}
.mast-wrap.solid #mast-canvas{opacity:.1}
.mast-wrap.solid .mast h1,.mast-wrap.solid .mast h1.logo svg{color:var(--on-mh)}
.mast-wrap.solid .mast-sub{color:rgba(var(--on-mh-rgb),.8)}
.mast-wrap.solid .mast-date{color:rgba(var(--on-mh-rgb),.72)}
.mast-wrap.solid .tool{background:transparent;border-color:rgba(var(--on-mh-rgb),.4);color:var(--on-mh)}
.mast-wrap.solid .tool:hover{border-color:var(--on-mh);background:rgba(var(--on-mh-rgb),.1)}
.mast-wrap.solid :focus-visible{outline-color:var(--on-mh)}
{% endif %}
.mast-tools{position:absolute;top:14px;right:16px;z-index:3;display:flex;gap:6px}
.tool{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--mn);font-size:9.5px;letter-spacing:1px;text-transform:uppercase;color:var(--mute2);cursor:pointer;transition:border-color .25s,color .25s}
.tool:hover{border-color:var(--link);color:var(--link)}
.tool svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.tool .i-sun{display:none}
:root[data-theme="dark"] .tool .i-sun{display:block}
:root[data-theme="dark"] .tool .i-moon{display:none}
/* Os botões do cabeçalho vêm em dois grupos (macros.html.j2, ferramentas): as abas especiais e as
   ferramentas; o botão da aba em que se está leva aria-current (o contorno na cor do texto). */
.mt-g{display:flex;gap:6px}
.tool[aria-current="page"]{border-color:currentColor}
.mast-wrap:not(.solid) .tool[aria-current="page"]{color:var(--ink)}

/* Linha de indicadores: cotações fixas, sem rolagem automática; arrasta-se para o lado
   para ver as demais. O clima da primeira cidade fica preso no fim da linha (some no celular). */
.tk{display:flex;align-items:stretch;background:var(--qn);font-family:var(--mn);font-size:10.5px;line-height:15px;color:rgba(255,255,255,.62)}
:root[data-theme="dark"] .tk{background:#0a1430}
.tk-rail{flex:1 1 auto;min-width:0;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch;cursor:grab}
.tk-rail::-webkit-scrollbar{display:none}
.tk-rail.arr{cursor:grabbing;-webkit-user-select:none;user-select:none}
.tk-rail:focus-visible{outline-color:#fff;outline-offset:-2px}
.tk.tem-mais .tk-rail{-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 44px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 44px),transparent)}
.tk-track{list-style:none;display:flex;width:max-content;padding:8px var(--mg)}
.tk-i{white-space:nowrap}
.tk-i+.tk-i::before{content:"·";color:rgba(255,255,255,.3);margin:0 10px}
.tk-i b,.tk-wx b{color:#fff;font-weight:500;margin-left:2px}
.tk .u{color:var(--up)}
.tk .d{color:var(--down)}
.tk .f{color:rgba(255,255,255,.62)}
.tk-wx{flex:none;display:none;align-items:center;gap:5px;padding:0 var(--mg) 0 16px;border-left:1px solid rgba(255,255,255,.18);white-space:nowrap}
@media (min-width:641px){.tk-wx{display:flex}}

/* Rótulo de seção (Em 1 minuto, Destaques…) */
.kicker{font-family:var(--ss);font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;color:var(--link);margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid var(--qi)}

/* Área clicável: o link do título cobre a chamada inteira */
.hit::after{content:"";position:absolute;inset:0;z-index:1}
.hit:focus-visible{outline:none}
.man,.um-l li,.cl{position:relative}
.man:has(.hit:focus-visible),.um-l li:has(.hit:focus-visible),.cl:has(.hit:focus-visible){outline:2px solid var(--link);outline-offset:3px}
.cat{font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:5px;color:var(--sc,var(--qi))}
:root[data-theme="dark"] .cat,:root[data-theme="dark"] .mcat{color:#9fb3d9;color:color-mix(in srgb,var(--sc,var(--qi)) 50%,#fff)}
figure[data-img]{overflow:hidden;border-radius:3px;background:var(--soft)}
figure[data-img] img{width:100%;height:100%;object-fit:cover}
figure.img-fail{display:none}
:root[data-theme="dark"] figure[data-img] img{filter:brightness(.9)}

/* ── Home em três andares ──
   Peças comuns: .bl (bloco com régua no topo), .rot (título do bloco), .sub (título de
   coluna), .mais (link do pé) e .sv (linha de serviço de uma chamada; .sv-dv é a marca
   de divergência, o único uso do laranja nos blocos). */
.bl{margin:0 var(--mg);padding:24px 0 28px;border-top:var(--fio)}
.rot{margin-bottom:10px;font-family:var(--ss);font-size:var(--f-rot);font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:var(--head)}
.sub{font-family:var(--ss);font-size:var(--f-txt);font-weight:700;line-height:1.4;color:var(--ink)}
.mais{margin-top:14px;font-family:var(--ss);font-size:var(--f-min);font-weight:700;line-height:1.4}
.mais a{color:var(--link)}
.mais a::after{content:" \2192"}
.mais a:hover{text-decoration:underline}
.sv{font-family:var(--ss);font-size:var(--f-min);line-height:1.5;color:var(--muted)}
.sv a{position:relative;z-index:2}
.sv-dv{font-weight:700;color:var(--ink);white-space:nowrap}
.sv-dv::before{content:"";display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:var(--qc);vertical-align:1px}
a.sv-dv:hover{text-decoration:underline}

/* Andar das notícias: a manchete (sem corpo) e "Em 1 minuto" */
.capa{display:grid;grid-template-columns:minmax(0,1fr);row-gap:22px;margin:0 var(--mg);padding:18px 0 26px}
.man{min-width:0;cursor:pointer}
.man.curto{--f-man:30px}
.man.longo{--f-man:24px}
.man .cat{margin-bottom:8px;font-size:var(--f-rot)}
.man h2{font-family:var(--sf);font-size:var(--f-man);font-weight:700;line-height:1.14;letter-spacing:-.3px;color:var(--head);overflow-wrap:break-word;text-wrap:balance}
.man h2 a,.um-l h3 a,.cl h3 a,.dv h4 a{transition:color .2s}
.man:hover h2 a,.um-l li:hover h3 a,.cl:hover h3 a,.dv h4 a:hover,.rc a:hover .rc-t{color:var(--link)}
.man-c{display:grid;grid-template-columns:minmax(0,1fr) 96px;column-gap:14px;align-items:start;margin-top:12px}
.man.noimg .man-c,.man:has(.man-f.img-fail) .man-c{grid-template-columns:minmax(0,1fr)}
.man-x{display:flex;flex-direction:column;min-width:0}
.man-dek{font-family:var(--sf);font-size:var(--f-tit);line-height:1.5;color:var(--body)}
.man .sv{margin-top:10px}
.man-f{width:96px;aspect-ratio:1;margin-top:5px}
.um{min-width:0}
.um-l{list-style:none;counter-reset:um;border-bottom:var(--fio)}
.um-l li{counter-increment:um;display:grid;grid-template-columns:24px minmax(0,1fr);align-content:start;padding:12px 0 13px;border-top:var(--fio);cursor:pointer}
.um-l li::before{content:counter(um);grid-row:1/span 3;font-family:var(--sf);font-size:var(--f-tit);font-weight:700;line-height:1.3;color:var(--link)}
.um-l li>*{grid-column:2}
.um-l h3{font-family:var(--sf);font-size:var(--f-tit);font-weight:700;line-height:1.3;color:var(--ink)}
.um-dk{display:none;margin-top:3px;font-family:var(--ss);font-size:var(--f-txt);line-height:1.45;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.um .sv{margin-top:3px}
/* De 641 px para cima a foto da manchete deixa de ser miniatura e a letra cresce um passo */
@media (min-width:641px){
  .man{--f-man:34px}
  .man.curto{--f-man:38px}
  .man.longo{--f-man:30px}
  .man-c{grid-template-columns:minmax(0,1fr) minmax(200px,34%);column-gap:24px;margin-top:14px}
  .man-f{width:100%;aspect-ratio:3/2;margin-top:4px}
  .man-dek{max-width:40em}
}

/* Como a mídia cobriu: a linha do viés e as duas colunas */
.md-vies{max-width:44em;font-family:var(--sf);font-size:var(--f-tit);line-height:1.5;color:var(--ink)}
.md-vies a{font-family:var(--ss);font-size:var(--f-min);font-weight:700;color:var(--link);white-space:nowrap}
.md-vies a::after{content:" \2192"}
.md-vies a:hover,.md-fora a:hover{text-decoration:underline}
.md-fora{list-style:none;max-width:60em;margin-top:6px;font-family:var(--ss);font-size:var(--f-txt);line-height:1.5;color:var(--body)}
.md-fora b{color:var(--ink)}
.md-cols{display:grid;grid-template-columns:minmax(0,1fr);row-gap:26px}
.md-vies+.md-cols,.md-fora+.md-cols{margin-top:20px}
.md-col{min-width:0}
.dv,.rc,.dv-l{list-style:none}
.dv,.rc{margin-top:8px;border-bottom:var(--fio)}
.dv>li{padding:12px 0 13px;border-top:var(--fio);scroll-margin-top:12px}
.dv>li:target{background:var(--soft)}
.dv h4{font-family:var(--sf);font-size:var(--f-tit);font-weight:700;line-height:1.3;color:var(--ink)}
.dv-l{margin-top:5px;font-family:var(--ss);font-size:var(--f-txt);line-height:1.5;color:var(--body)}
.dv-l b{color:var(--ink)}
.dv-l .resto{color:var(--muted)}
.md-nada{margin-top:8px;padding:12px 0 13px;border-top:var(--fio);border-bottom:var(--fio);font-family:var(--sf);font-size:var(--f-tit);line-height:1.5;color:var(--body)}
.rc li{border-top:var(--fio)}
.rc a{display:grid;grid-template-columns:44px minmax(0,1fr);column-gap:8px;align-items:baseline;padding:10px 0 11px}
.rc time{font-family:var(--ss);font-size:var(--f-min);font-variant-numeric:tabular-nums;line-height:1.5;color:var(--muted)}
.rc b{display:block;font-family:var(--ss);font-size:var(--f-min);font-weight:700;line-height:1.5;color:var(--muted)}
.rc-t{display:block;font-family:var(--ss);font-size:var(--f-txt);line-height:1.45;color:var(--ink);transition:color .2s}
@media (max-width:640px){.rc .larga{display:none}}

/* Gavetas: o bloco recolhido das matérias e, na cópia arquivada, as três de detalhe.
   Fechada, cada uma é uma linha; a seta gira ao abrir. */
.gav{margin:0 var(--mg);border-top:var(--fio)}
.gav>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px 2px 17px 0;cursor:pointer;list-style:none}
.gav>summary::-webkit-details-marker{display:none}
.gav>summary::after{content:"";flex:none;width:8px;height:8px;margin:-4px 4px 0 0;border-right:2px solid var(--link);border-bottom:2px solid var(--link);transform:rotate(45deg);transition:transform .2s}
.gav[open]>summary::after{margin-top:4px;transform:rotate(-135deg)}
.gav-t{font-family:var(--sf);font-size:var(--f-tit);font-weight:700;line-height:1.3;color:var(--ink);transition:color .2s}
.gav>summary:hover .gav-t{color:var(--link)}
.gav>summary:focus-visible{outline-offset:-2px}
.gav-c{padding-bottom:26px}
/* Fechada, a gaveta não deixa nada por dentro (nem para o foco do teclado nem para as medidas) */
.gav:not([open])>:not(summary){display:none}

/* Busca nas matérias do dia (dentro do bloco recolhido) */
.srch{display:flex;align-items:center;gap:12px;padding:0 0 12px}
.srch-label{flex-shrink:0;font-family:var(--ss);font-size:var(--f-min);font-weight:700;color:var(--muted)}
.srch-input{flex:1;min-width:0;max-width:420px;height:36px;padding:0 14px;border:1px solid var(--rule);border-radius:18px;font-family:var(--ss);font-size:var(--f-txt);color:var(--ink);background:var(--paper);outline:none;transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;appearance:none}
.srch-input:focus{border-color:var(--qi);box-shadow:0 0 0 3px rgba(var(--qi-rgb),.15)}
.srch-input::placeholder{color:var(--faint)}
.srch-count{flex-shrink:0;font-family:var(--ss);font-size:var(--f-min);color:var(--muted)}
.srch-all{flex-shrink:0;margin-left:auto;height:32px;padding:0 12px;border:1px solid var(--rule);border-radius:16px;background:transparent;font-family:var(--ss);font-size:var(--f-min);font-weight:700;white-space:nowrap;color:var(--link);cursor:pointer;transition:border-color .2s}
.srch-all:hover{border-color:var(--link)}
.no-res{grid-column:1/-1;padding:28px 0;text-align:center;font-family:var(--ss);font-size:var(--f-txt);color:var(--muted)}
.no-res[hidden]{display:none}

/* Abas (matérias por editoria e cobertura comparada): só a aba aberta leva a cor da editoria */
.tabs-nav{position:relative}
.tabs-bar{display:flex;overflow-x:auto;border-bottom:var(--fio);scrollbar-width:none;-webkit-overflow-scrolling:touch}
.tabs-bar::-webkit-scrollbar{display:none}
.tab-btn{flex-shrink:0;padding:11px 11px 9px;border:none;border-bottom:2px solid transparent;background:transparent;font-family:var(--ss);font-size:var(--f-rot);font-weight:700;text-transform:uppercase;letter-spacing:.8px;white-space:nowrap;color:var(--mute2);cursor:pointer;transition:color .2s,border-color .2s}
.tab-btn:first-child{padding-left:0}
.tab-btn:hover{color:var(--ink)}
.tab-btn[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--sc,var(--qi))}
:root[data-theme="dark"] .tab-btn[aria-selected="true"]{border-bottom-color:color-mix(in srgb,var(--sc,var(--qi)) 60%,#fff)}
.tab-btn .n{margin-left:4px;font-weight:400;letter-spacing:0;color:var(--faint)}
.tab-btn:focus-visible{outline-offset:-3px}
.tabs-wrap.searching .tab-btn[aria-selected="true"]{color:var(--mute2);border-bottom-color:transparent}
.tabs-arrow{position:absolute;top:0;bottom:1px;z-index:2;width:40px;border:none;font-family:var(--ss);font-size:22px;line-height:1;color:var(--ink);cursor:pointer}
.tabs-arrow.prev{left:0;padding-right:12px;background:linear-gradient(90deg,var(--paper) 55%,transparent)}
.tabs-arrow.next{right:0;padding-left:12px;background:linear-gradient(270deg,var(--paper) 55%,transparent)}
.tabs-arrow:hover{color:var(--link)}
.tabs-arrow[hidden]{display:none}
.pane-hd{display:none;padding:18px 0 8px;font-family:var(--ss);font-size:var(--f-rot);font-weight:700;text-transform:uppercase;letter-spacing:1.6px;color:var(--sc,var(--qi))}
:root[data-theme="dark"] .pane-hd{color:color-mix(in srgb,var(--sc,var(--qi)) 50%,#fff)}
html:not(.js) .pane-hd{display:block}
.js .tab-pane{display:none}
.js .tab-pane.active{display:block}
html:not(.js) .tabs-bar{display:none}

/* Matérias por editoria: uma grade só, sem caixas; cada cartão traz editoria, título e linha fina */
.tab-main{display:grid;grid-template-columns:minmax(0,1fr);column-gap:40px;margin-top:-1px}
.tab-main .tab-pane,.cards{display:contents}
.js .tab-main .tab-pane{display:none}
.js .tab-main .tab-pane.active,.js .tabs-wrap.searching .tab-main .tab-pane{display:contents}
.cl{min-width:0;padding:13px 0 15px;border-top:var(--fio);cursor:pointer}
.tabs-wrap.searching .cl.is-hidden{display:none}
.cl .cat{margin-bottom:4px;font-size:var(--f-rot);letter-spacing:1.2px}
.cl h3{font-family:var(--sf);font-size:var(--f-tit);font-weight:700;line-height:1.3;color:var(--ink)}
.cl .dk{margin-top:4px;font-family:var(--ss);font-size:var(--f-txt);line-height:1.5;color:var(--muted)}
.cl .sv{margin-top:4px}
@media (min-width:700px){.tab-main{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1100px){.tab-main{grid-template-columns:repeat(3,minmax(0,1fr))}}

/* Modal da matéria: abre na tela inteira em qualquer tela (no computador e no
   tablet, como no celular), com o texto numa coluna de leitura no meio. */
body.modal-open{overflow:hidden}
.mo{display:none;position:fixed;inset:0;z-index:1000;overflow-y:auto;overscroll-behavior:contain;padding:0;background:rgba(var(--qn-rgb),.5);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
:root[data-theme="dark"] .mo{background:rgba(0,0,0,.6)}
.mo.on,html:not(.js) .mo:target{display:flex;justify-content:center;align-items:flex-start}
.ml{position:relative;width:100%;min-height:100%;padding:56px 40px 64px;background:var(--paper);border-top:4px solid var(--sc,var(--qi));box-shadow:0 20px 60px rgba(var(--qn-rgb),.2);animation:ml-in .35s cubic-bezier(.2,.9,.3,1.15)}
.ml>:not(.mc){max-width:720px;margin-left:auto;margin-right:auto}
:root[data-theme="dark"] .ml{background:#161f31}
.ml:focus{outline:none}
@keyframes ml-in{from{opacity:0;transform:translateY(28px) scale(.97)}to{opacity:1;transform:none}}
/* O × acompanha a rolagem do modal (.mo é o contêiner que rola): matéria longa aberta pelo e-mail não o esconde. */
.mc{position:sticky;top:8px;float:right;z-index:2;margin:-28px -30px 0 0;width:36px;height:36px;border:none;border-radius:50%;background:var(--paper);font-family:var(--ss);font-size:26px;line-height:1;color:var(--faint);cursor:pointer;transition:color .2s,background .2s}
:root[data-theme="dark"] .mc{background:#161f31}
.mback{margin-top:22px;text-align:center}
.mc2{padding:9px 18px;border:1.5px solid var(--rl);border-radius:20px;background:transparent;font-family:var(--ss);font-size:12px;font-weight:700;letter-spacing:.5px;color:var(--link);cursor:pointer}
.mc2:hover{border-color:var(--link)}
.mc:hover{color:var(--ink);background:var(--soft)}
.ml .mcat{font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;margin-bottom:8px;color:var(--sc,var(--qi))}
.ml h2{padding-right:24px;font-size:26px;font-weight:900;line-height:1.2;margin-bottom:12px;color:var(--head)}
.ml .mdek{font-family:var(--ss);font-size:15px;line-height:1.6;color:var(--body)}
.ml .mhd{padding-bottom:14px;margin-bottom:20px;border-bottom:2px solid var(--qi)}
.ml .mi{margin-bottom:20px;max-height:380px}
.ml .bt p{font-family:var(--ss);font-size:15px;line-height:1.8;color:var(--text)}
.ml .bt p+p{margin-top:14px}
.ml .bt strong{color:var(--ink)}
.ml .why{margin-top:22px;padding:14px 18px;background:var(--soft);border-left:3px solid var(--qc)}
.ml .why h3,.ml .bb h3{font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint);margin-bottom:6px}
.ml .why p{font-family:var(--sf);font-size:15px;font-style:italic;line-height:1.6;color:var(--ink)}
.ml .bb{margin-top:24px;padding-top:14px;border-top:1px solid var(--rl)}
.ml .bb ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px 18px}
.ml .bb a,.ml .bb span{font-family:var(--mn);font-size:11.5px;color:var(--link)}
.ml .bb span{color:var(--muted)}
.ml .bb a:hover{color:var(--qr);text-decoration:underline}
.ml .mtime{margin-top:16px;font-family:var(--mn);font-size:10px;color:var(--faint);letter-spacing:.5px}

/* Cobertura comparada: lado A à esquerda, neutros no meio, lado B à direita */
:root{--cov-a:var(--qi);--cov-b:#C8631A;--cov-n:#C5CCD8}
:root[data-theme="dark"]{--cov-a:#8FA0CC;--cov-a:color-mix(in srgb,var(--qi) 55%,#fff);--cov-b:#FF8A5C;--cov-n:#3A4658}
.cov-bar{display:flex;gap:2px;height:8px;border-radius:4px;overflow:hidden;background:var(--rl)}
.cov-bar span{display:block;height:100%;min-width:4px}
.cov-a{background:var(--cov-a)}
.cov-n{background:var(--cov-n)}
.cov-b{background:var(--cov-b)}
.cov-lean{margin-top:5px;font-family:var(--mn);font-size:9px;letter-spacing:.3px;line-height:1.45;color:var(--mute2)}
.cov-lean::before,.cov-sa::before,.cov-sb::after{content:"";display:inline-block;width:7px;height:7px;border-radius:2px;background:var(--cov-n)}
.cov-lean::before{margin-right:6px}
.lean-a .cov-lean::before,.cov-sa::before{background:var(--cov-a)}
.lean-b .cov-lean::before,.cov-sb::after{background:var(--cov-b)}
.lean-equilibrio .cov-lean::before{background:linear-gradient(90deg,var(--cov-a) 50%,var(--cov-b) 50%)}
.cov.full .cov-lean{font-size:10px;font-weight:600;color:var(--ink)}
.cov-scale{display:flex;justify-content:space-between;gap:16px;margin-bottom:6px;font-family:var(--ss);font-size:11.5px;font-weight:600;line-height:1.35;color:var(--ink)}
.cov-sa::before{margin-right:6px}
.cov-sb{text-align:right}
.cov-sb::after{margin-left:6px}
.cov-scale b{font-family:var(--mn);font-weight:600;color:var(--mute2)}
.cov-c{margin-top:8px;font-family:var(--sf);font-size:14.5px;font-style:italic;line-height:1.55;color:var(--ink)}
.cov-who{margin-top:10px}
.cov-who summary{cursor:pointer;font-family:var(--ss);font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--link)}
.cov-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 20px;margin-top:10px}
.cov-col.cn:only-child,.cov-col.cn:nth-child(3){grid-column:1/-1}
.cov-col h4{margin-bottom:6px;padding-bottom:4px;border-bottom:2px solid var(--cov-n);font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--mute2)}
.cov-col.ca h4{border-bottom-color:var(--cov-a)}
.cov-col.cb h4{border-bottom-color:var(--cov-b)}
.cov-col h4 span{font-family:var(--mn);font-weight:500}
.cov-col ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.cov-col li{font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body)}
.cov-col a,.cov-col b{font-weight:700;color:var(--ink)}
.cov-col a:hover{color:var(--link);text-decoration:underline}
.cov-col li p.cov-f{margin-top:2px;color:var(--muted)}
.mcomp{margin-bottom:8px;font-family:var(--ss);font-size:12px;color:var(--muted)}
.ml .mcov{margin-top:22px;padding:16px 18px;border:1px solid var(--rl);border-radius:4px;background:var(--soft)}
.ml .mcov>h3{margin-bottom:10px;font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint)}
.cmp{padding:2px 0 28px}
.cmp-note{max-width:860px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.cmp-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px;margin-top:6px}
.cmp-i{padding:16px 0;border-bottom:1px solid var(--rl)}
.cmp-i h3{margin-bottom:8px;font-size:17px;font-weight:700;line-height:1.3;color:var(--ink)}
.cmp-i h3 a:hover{color:var(--link);text-decoration:underline}
.cmp-t{font-weight:500;letter-spacing:.5px;color:var(--faint)}
/* Cobertura comparada: abas por editoria; em cada aba, onde divergiu e o que foi relatado de forma semelhante */
.cmp [hidden]{display:none!important}
.cmp-tabs{margin-top:14px}
.cmp .pane-hd{padding:18px 0 8px}
.cmp-tabs.all .pane-hd{display:block}
.cmp-tabs.all .cmp-pane+.cmp-pane{margin-top:10px}
.tab-btn .cmp-dn{margin-left:6px;font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:0;text-transform:none;color:var(--cov-b)}
.cmp-gh{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin-top:16px;padding-bottom:6px;border-bottom:2px solid var(--ink);font-family:var(--sf);font-size:17px;font-weight:700;color:var(--ink)}
.cmp-gh span{font-family:var(--ss);font-size:12px;font-weight:400;color:var(--muted)}
.cmp-dv{font-weight:600;color:var(--cov-b)}
.cmp-mt{font-weight:500;color:var(--faint)}
.cmp-vazio{margin-top:10px;font-family:var(--ss);font-size:12.5px;font-style:italic;color:var(--muted)}
.cmp-cl{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));column-gap:32px}
.cmp-cl li{border-bottom:1px solid var(--rl)}
.cmp-cl summary{display:flex;flex-direction:column;gap:1px;padding:8px 0 8px 16px;position:relative;cursor:pointer;list-style:none}
.cmp-cl summary::-webkit-details-marker{display:none}
.cmp-cl summary::before{content:"+";position:absolute;left:0;top:7px;font-family:var(--mn);font-size:13px;font-weight:600;color:var(--link)}
.cmp-cl details[open] summary::before{content:"−"}
.cmp-ct{font-family:var(--sf);font-size:14.5px;font-weight:700;line-height:1.35;color:var(--ink)}
.cmp-cl summary:hover .cmp-ct{color:var(--link)}
.cmp-cm{font-family:var(--mn);font-size:10.5px;color:var(--faint)}
.cmp-cl details>.cov,.cmp-cl .cmp-lk{margin:0 0 10px 16px}
.cmp-lk{font-family:var(--ss);font-size:12.5px}
.cmp-lk a{font-weight:700;color:var(--link)}
.cmp-lk a:hover{text-decoration:underline}

/* Como a edição foi feita (gaveta da cópia arquivada) e lista completa do dia */
.rat{padding:2px 0 26px}
.rat-sum{max-width:900px;font-family:var(--sf);font-size:16px;line-height:1.6;color:var(--ink)}
.rat-blocks{list-style:none;counter-reset:blk;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px 24px;margin-top:14px}
.rat-blocks li{counter-increment:blk;display:flex;flex-direction:column;gap:2px;padding:10px 12px;border-left:3px solid var(--qi);background:var(--soft);font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--muted)}
.rat-blocks li.off{border-left-color:var(--cov-n)}
.rat-blocks b{color:var(--ink)}
.rat-blocks b::before{content:counter(blk) ". ";font-family:var(--mn);font-weight:500;color:var(--faint)}
.rat-note{max-width:900px;margin-top:14px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.todas{padding:22px var(--gut) 30px;border-top:2px solid var(--qn);background:var(--paper)}
:root[data-theme="dark"] .todas{border-top-color:var(--qi)}
.todas .kicker span{font-family:var(--mn);font-weight:500;letter-spacing:.5px;color:var(--faint)}
.todas-note{max-width:900px;margin-bottom:10px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.todas-sec{border-top:1px solid var(--rl)}
.todas-sec:last-child{border-bottom:1px solid var(--rl)}
.todas-sec>summary{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;padding:11px 0;cursor:pointer;font-family:var(--ss);font-size:14px;color:var(--ink)}
.todas-sec>summary b{padding-left:9px;border-left:3px solid var(--sc)}
.todas-sec>summary span{font-size:12px;color:var(--muted)}
.idx{list-style:none;display:flex;flex-direction:column;gap:10px;padding:2px 0 16px 12px}
.idx-h{font-family:var(--ss);font-size:13.5px;font-weight:700;line-height:1.4;color:var(--ink)}
.idx-h a{color:var(--link)}
.idx-h a:hover{text-decoration:underline}
.idx-h em{margin-left:4px;padding:1px 6px;border-radius:3px;background:var(--soft);font-family:var(--mn);font-size:9.5px;font-style:normal;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--link)}
.idx-h em.cmpd{color:var(--mute2)}
.idx-h span{font-weight:500;color:var(--faint)}
.idx-t ul{list-style:none;display:flex;flex-direction:column;gap:3px;margin-top:3px;padding-left:10px;border-left:1px solid var(--rl)}
.idx-t li{font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body)}
.idx-t li b{font-weight:600;color:var(--mute2)}
.idx-t li a{color:var(--body)}
.idx-t li a:hover{color:var(--link);text-decoration:underline}
.idx-t time{font-family:var(--mn);font-size:10.5px;color:var(--faint)}
.rat-all{margin-top:14px;font-family:var(--ss);font-size:13px;font-weight:700}
.rat-all a{color:var(--link)}
.rat-all a:hover{text-decoration:underline}

/* Rodapé */
.ft{background:var(--qn);padding:20px 28px;text-align:center;font-family:var(--mn);font-size:9.5px;letter-spacing:1.5px;line-height:1.8;color:rgba(255,255,255,.62);text-transform:uppercase}
:root[data-theme="dark"] .ft{background:#0a1430}
.ft strong{color:var(--qc)}
.ft a{color:#fff;border-bottom:1px solid rgba(255,255,255,.3);transition:border-color .2s}
.ft a:hover{border-bottom-color:var(--qc)}
.ft-links{margin-top:6px}
.ft details{max-width:960px;margin:14px auto 0;text-align:left}
.ft summary{cursor:pointer;text-align:center;color:rgba(255,255,255,.8)}
.ft summary:hover{color:#fff}
.src-list{list-style:none;margin-top:12px;columns:3 220px;column-gap:28px;text-transform:none;letter-spacing:.2px;font-size:10.5px}
.src-list li{break-inside:avoid;padding:2px 0 2px 14px;position:relative}
.src-list .dot{position:absolute;left:0;top:.55em;width:7px;height:7px;border-radius:50%;background:var(--qc)}
.src-list .st-parcial .dot{background:#F5B83D}
.src-list .st-erro .dot{background:var(--qr)}
.src-list .nf{color:rgba(255,255,255,.45)}
.src-list em{font-style:normal;color:#ffb3cf}
.ft-ass{margin-top:10px}
.ed .ft a{white-space:nowrap}

/* Voltar ao topo */
.btt{position:fixed;right:24px;bottom:24px;z-index:998;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border:none;border-radius:50%;background:var(--qi);color:#fff;cursor:pointer;box-shadow:0 4px 18px rgba(var(--qi-rgb),.4);opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .3s,transform .3s,visibility .3s,background .3s}
.btt.show{opacity:1;visibility:visible;transform:none}
.btt:hover{background:var(--qn)}
.btt svg{width:18px;height:18px;fill:currentColor}
body.modal-open .btt{visibility:hidden}

/* Arquivo de edições */
.arch{padding:24px var(--gut) 36px;min-height:40vh}
.arch-top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap}
.arch-top .kicker{flex:1}
.arch-home{font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.arch-home:hover{text-decoration:underline}
.arch-m{margin:22px 0 4px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
.arch-list{list-style:none}
.arch-list li{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--rl)}
.arch-list a{flex:1;display:flex;gap:18px;align-items:baseline;padding:11px 8px 11px 0;min-width:0;transition:background .2s}
.arch-list a:hover{background:var(--hover)}
.arch-list time{flex:0 0 250px;font-family:var(--mn);font-size:11px;color:var(--mute2)}
.arch-t{font-size:15px;font-weight:700;line-height:1.3;color:var(--ink)}
.badge{flex-shrink:0;padding:1px 6px;border:1px solid var(--rule);border-radius:10px;font-family:var(--mn);font-size:8.5px;letter-spacing:1px;color:var(--faint)}
.arch-empty{padding:30px 0;font-family:var(--ss);color:var(--muted)}
{% if brand.termometro %}
/* Termômetro de Viés Editorial (painel do dia no fim da edição) e aba Analítico Político.
   Escala divergente validada (rampa ordinal por braço, claro e escuro): verde-azulado =
   esquerda, âmbar = direita, cinza = equilíbrio; misto hachurado. A cor vai só nas marcas
   (faixas, ponteiro, colunas, barras e pontos); números e rótulos ficam nas cores de texto,
   sempre escritos ao lado da marca. Marcas finas, réguas de 1 px e uma folga de 2 px na cor
   do fundo entre as faixas. */
:root{--t-ef:#0B5F6B;--t-em:#2E8F9C;--t-el:#7FBCC4;--t-eq:#AEB6C2;--t-dl:#E2A66E;--t-dm:#C77A2E;--t-df:#8F4A0E;--t-na:#D0D5DD;--tm-pn:#f6f7f9;--tm-hl:#eef1f5;--tm-bar:var(--qi);--tm-trk:rgba(var(--qi-rgb),.14)}
:root[data-theme="dark"]{--t-ef:#86D3DC;--t-em:#46A9B6;--t-el:#327E88;--t-eq:#4A576B;--t-dl:#9A6536;--t-dm:#CF8A45;--t-df:#F2B577;--t-na:#2D3748;--tm-pn:#141c2b;--tm-hl:#1a2436;--tm-bar:#8fb0f5;--tm-trk:rgba(143,176,245,.16)}
.t-ef{background:var(--t-ef)}.t-em{background:var(--t-em)}.t-el{background:var(--t-el)}.t-eq{background:var(--t-eq)}
.t-dl{background:var(--t-dl)}.t-dm{background:var(--t-dm)}.t-df{background:var(--t-df)}.t-na{background:var(--t-na)}
.t-mx{background:repeating-linear-gradient(135deg,var(--t-eq) 0 3px,transparent 3px 6px);box-shadow:inset 0 0 0 1px var(--t-eq)}
.sw{display:inline-block;width:8px;height:8px;margin-right:6px;border-radius:2px;vertical-align:baseline}
.term{padding:2px 0 30px}
.tm-top{display:flex;align-items:baseline;justify-content:flex-end;gap:16px;flex-wrap:wrap}
.tm-links{display:flex;gap:18px;font-family:var(--ss);font-size:12px;font-weight:700}
.tm-links a{color:var(--link)}
.tm-links a:hover{text-decoration:underline}
.tm-dek{max-width:860px;margin-top:4px;font-family:var(--sf);font-size:16px;line-height:1.55;color:var(--body)}
.tm-k{display:block;font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.3px;color:var(--muted)}
.tm-ph{font-family:var(--ss);font-size:13.5px;font-weight:800;line-height:1.3;color:var(--ink)}
.tm-pd{margin:3px 0 14px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--muted)}
.tm-foot{margin-top:10px;font-family:var(--ss);font-size:11.5px;line-height:1.5;color:var(--muted)}
.tm-foot .sw{vertical-align:0}
.tm-empty{padding:14px 16px;border:1px solid var(--rl);border-radius:6px;background:var(--tm-pn);font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--muted)}
.tm-empty-lg{max-width:860px;margin-top:8px;font-size:14px}
/* Placar: o número da média, o rótulo e o intervalo, ao lado da escala */
.tm-placar{--tg-bg:var(--tm-pn);display:grid;grid-template-columns:minmax(190px,250px) minmax(0,1fr);gap:20px 36px;align-items:center;margin-top:18px;padding:22px 28px 18px;border:1px solid var(--rl);border-radius:8px;background:var(--tm-pn)}
.tm-n{margin-top:8px;font-family:var(--ss);font-size:68px;font-weight:600;line-height:.95;letter-spacing:-2px;color:var(--ink)}
.tm-r{display:flex;align-items:center;gap:8px;margin-top:12px;font-family:var(--ss);font-size:16px;font-weight:700;color:var(--ink)}
.tm-r .sw{width:12px;height:12px;margin:0;border-radius:3px}
.tm-ic{margin-top:7px;font-family:var(--mn);font-size:11px;color:var(--muted)}
.tm-b{margin-top:3px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--muted)}
/* Escala de −100 a +100: faixas, intervalo de 95%, ponteiro da média e um traço por notícia */
.tg{--tg-bg:var(--paper);position:relative;min-width:0;margin:0;padding-top:34px;container-type:inline-size}
.tm-placar .tg{--tg-bg:var(--tm-pn)}
.tg.sm{padding-top:0}
.tg.sm .tg-flag{display:none}
.tg-flag{position:absolute;top:0;left:clamp(70px,var(--x),calc(100% - 70px));transform:translateX(-50%);padding:4px 10px;border-radius:5px;background:var(--ink);font-family:var(--ss);font-size:11.5px;font-weight:600;line-height:1.2;color:var(--tg-bg);white-space:nowrap}
.tg-flag b{font-family:var(--mn);font-weight:600}
.tg-track{position:relative;height:16px}
.tg-f{position:absolute;top:0;bottom:0;border:0 solid var(--tg-bg);border-width:0 1px;background-clip:padding-box;opacity:.3}
.tg-f:first-child{border-left-width:0;border-radius:8px 0 0 8px}
.tg-f:nth-child(7){border-right-width:0;border-radius:0 8px 8px 0}
.tg-f.on{opacity:1}
:root[data-theme="dark"] .tg-f{opacity:.45}
:root[data-theme="dark"] .tg-f.on{opacity:1}
.tg-ic{position:absolute;top:4px;bottom:4px;border-radius:4px;background:var(--ink);opacity:.3}
.tg-needle{position:absolute;top:-9px;bottom:-9px;width:3px;margin-left:-1.5px;border-radius:2px;background:var(--ink);box-shadow:0 0 0 2px var(--tg-bg)}
.tg-needle::after{content:"";position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:var(--ink);box-shadow:0 0 0 3px var(--tg-bg)}
.tg-rug{position:relative;height:12px;margin-top:12px}
.tg-rug i{position:absolute;top:0;width:2px;height:12px;margin-left:-1px;border-radius:1px;background:var(--ink);opacity:.3}
.tg-ticks{position:relative;height:14px;margin-top:6px;font-family:var(--mn);font-size:10px;color:var(--faint)}
.tg-rug+.tg-ticks{margin-top:4px}
.tg-ticks span{position:absolute;top:0;transform:translateX(-50%);white-space:nowrap}
.tg-ticks span:first-child{transform:none}
.tg-ticks span:last-child{transform:translateX(-100%)}
.tg-zones{position:relative;height:16px;margin-top:2px;font-family:var(--ss);font-size:10.5px;color:var(--muted)}
.tg-zones span{position:absolute;top:0;text-align:center;white-space:nowrap}
.tg-zones .on{font-weight:700;color:var(--ink)}
.tg-sides{display:flex;justify-content:space-between;gap:12px;margin-top:6px;font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.tg-rug-k{font-weight:500;text-transform:none;letter-spacing:0;color:var(--faint)}
.tg-rug-k i{display:inline-block;width:2px;height:10px;margin-right:6px;border-radius:1px;background:var(--ink);opacity:.45;vertical-align:-1px}
/* Régua estreita: as marcas de ±10 e ±25 e os nomes das faixas não cabem sem se encostar */
@container (max-width:640px){.tg-ticks .mn,.tg-zones{display:none}}
@media (min-width:761px) and (max-width:1000px){@supports not (container-type:inline-size){.tg-ticks .mn,.tg-zones{display:none}}}
/* Indicadores */
.tm-kpis{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:18px;border-top:1px solid var(--rl);border-bottom:1px solid var(--rl)}
.tm-kpis li{display:flex;flex-direction:column;gap:4px;min-width:0;padding:16px 20px 16px 0}
.tm-kpis li+li{padding-left:20px;border-left:1px solid var(--rl)}
.tm-kv{font-family:var(--ss);font-size:30px;font-weight:600;line-height:1.1;letter-spacing:-.5px;color:var(--ink)}
.tm-kv small{margin-left:3px;font-size:13px;font-weight:500;letter-spacing:0;color:var(--muted)}
.tm-kd{font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--muted)}
.tm-meter{display:block;height:6px;margin:3px 0 1px;border-radius:3px;background:var(--tm-trk);overflow:hidden}
.tm-meter span{display:block;height:100%;border-radius:3px;background:var(--tm-bar)}
/* Painéis */
.tm-panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:26px 40px;margin-top:26px}
.tm-panel{min-width:0;padding-top:14px;border-top:1px solid var(--rule)}
/* Distribuição: uma barra por faixa (contagem e parcela ao lado) */
.th{list-style:none}
.th li{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr) 84px;gap:12px;align-items:center;padding:6px 0;border-top:1px solid var(--rl)}
.th li:first-child{border-top:none;padding-top:0}
.th-l{font-family:var(--ss);font-size:12px;line-height:1.35;color:var(--ink)}
.th-l .sw{margin-right:7px;vertical-align:0}
.th-m{display:block;height:10px;border-left:1px solid var(--rule)}
.th-m span{display:block;height:100%;min-width:3px;border-radius:0 4px 4px 0}
.th .zero .th-m span{display:none}
.th .zero .th-l{color:var(--muted)}
.th-v{font-family:var(--mn);font-size:10.5px;text-align:right;white-space:nowrap;color:var(--muted)}
.th-v b{font-size:12px;font-weight:600;color:var(--ink)}
.th .zero .th-v b{font-weight:400;color:var(--faint)}
/* Sinais por critério: à esquerda e à direita de um eixo central */
.tsg-hd,.tsg-list li{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,1fr) 36px;align-items:center}
.tsg-hd{padding-bottom:6px;font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.tsg-hd span:nth-child(2){padding-right:8px;text-align:right}
.tsg-hd span:nth-child(3){padding-left:8px}
.tsg-list{list-style:none}
.tsg-list li{padding:5px 0;border-top:1px solid var(--rl)}
.tsg-n{padding-right:10px;font-family:var(--ss);font-size:12px;line-height:1.3;color:var(--ink)}
.tsg-l,.tsg-r{display:flex;align-items:center;gap:6px;min-height:18px}
.tsg-l{justify-content:flex-end;padding-right:1px;border-right:1px solid var(--rule)}
.tsg-r{padding-left:1px}
.tsg-b{display:block;height:10px;min-width:3px}
.tsg-l .tsg-b{border-radius:4px 0 0 4px}
.tsg-r .tsg-b{border-radius:0 4px 4px 0}
.tsg-l b,.tsg-r b{font-family:var(--mn);font-size:11px;font-weight:600;color:var(--ink)}
.tsg-eq{font-family:var(--mn);font-size:11px;text-align:right;color:var(--muted)}
.tsg-eq i{display:inline-block;width:8px;height:8px;margin-right:4px;border-radius:50%}
/* Qualidade da apuração: em quantas notícias cada prática aparece */
.tq{list-style:none}
.tq li{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr) 84px;gap:12px;align-items:center;padding:6px 0;border-top:1px solid var(--rl)}
.tq li:first-child{border-top:none;padding-top:0}
.tq-n{font-family:var(--ss);font-size:12px;line-height:1.35;color:var(--ink)}
.tq-m{display:block;height:8px;border-radius:4px;background:var(--tm-trk);overflow:hidden}
.tq-m span{display:block;height:100%;border-radius:4px;background:var(--tm-bar)}
.tq-v{font-family:var(--mn);font-size:10.5px;text-align:right;white-space:nowrap;color:var(--muted)}
.tq-v b{font-size:12px;font-weight:600;color:var(--ink)}
/* Recortes do dia (veículos e editorias): um ponto por grupo numa escala comum */
.trc{list-style:none}
.trc-i,.trc-axis{display:grid;grid-template-columns:minmax(0,150px) minmax(0,1fr) 124px;gap:12px;align-items:center}
.trc-i{padding:6px 0;border-top:1px solid var(--rl)}
.trc>.trc-i:first-child{border-top:none;padding-top:0}
.trc-n{font-family:var(--ss);font-size:12.5px;font-weight:700;line-height:1.3;color:var(--ink)}
.trc-p{position:relative;height:16px}
.trc-i .trc-p::before{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:var(--rl)}
.trc-z{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--rule)}
.trc-ic{position:absolute;top:50%;height:4px;margin-top:-2px;border-radius:2px;background:var(--ink);opacity:.25}
.trc-d{position:absolute;top:50%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;box-shadow:0 0 0 2px var(--paper),0 0 0 3px var(--ink)}
.trc-v{font-family:var(--ss);font-size:11.5px;white-space:nowrap;color:var(--muted)}
.trc-v b{display:inline-block;min-width:32px;font-family:var(--mn);font-size:13px;font-weight:600;color:var(--ink)}
.trc-x{font-family:var(--mn);font-size:10px}
.trc-axis{padding-top:4px}
.trc-axis .trc-p{height:12px}
.trc-axis i{position:absolute;top:0;transform:translateX(-50%);font-family:var(--mn);font-size:9.5px;font-style:normal;color:var(--faint);white-space:nowrap}
.trc-axis i:first-child{transform:none}
.trc-axis i:last-child{transform:translateX(-100%)}
.trc-more>summary{margin:6px 0 2px;cursor:pointer;font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.trc-more>summary:hover{text-decoration:underline}
.trc-more .trc>.trc-i:first-child{border-top:1px solid var(--rl);padding-top:6px}
/* Cada texto analisado: filtros, ordem e uma linha por texto que abre o detalhe */
.tm-list{margin-top:30px;padding-top:16px;border-top:1px solid var(--rule)}
.tm-cnt{margin-left:6px;padding:1px 8px;border-radius:10px;background:var(--tm-hl);font-family:var(--mn);font-size:11px;font-weight:600;vertical-align:1px;color:var(--muted)}
.tm-fil{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px 14px;margin:4px 0 14px}
.tm-fil[hidden]{display:none}
.tm-chips{display:flex;flex-wrap:wrap;gap:6px}
.tm-chip{height:32px;padding:0 13px;border:1px solid var(--rule);border-radius:16px;background:var(--paper);font-family:var(--ss);font-size:12px;font-weight:600;color:var(--body);cursor:pointer;transition:border-color .2s,background .2s}
.tm-chip span{margin-left:4px;font-family:var(--mn);font-size:11px;color:var(--faint)}
.tm-chip:hover:not(:disabled){border-color:var(--ink)}
.tm-chip[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.tm-chip[aria-pressed="true"] span{color:inherit;opacity:.75}
.tm-chip:disabled{opacity:.45;cursor:default}
.tm-sel{display:flex;flex-direction:column;gap:3px;font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.tm-sel select{height:32px;min-width:140px;max-width:230px;padding:0 8px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);font-family:var(--ss);font-size:12.5px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--ink)}
.tm-shown{margin-left:auto;padding-bottom:8px;font-family:var(--mn);font-size:11px;color:var(--faint)}
.tr-hd,.tr>details>summary{display:grid;grid-template-columns:62px minmax(0,1fr) 128px 148px 74px 78px;gap:16px;align-items:center}
.tr-hd{padding:0 12px 7px;border-bottom:1px solid var(--rule);font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.tr-list{list-style:none}
.tr{border-bottom:1px solid var(--rl)}
.tr[hidden]{display:none}
.tr>details>summary{padding:12px;list-style:none;cursor:pointer;transition:background .15s}
.tr>details>summary::-webkit-details-marker{display:none}
.tr>details>summary:hover{background:var(--hover)}
.tr>details[open]>summary{background:var(--tm-hl)}
.tr-t{display:flex;align-items:center;gap:9px;font-family:var(--mn);font-size:17px;font-weight:600;color:var(--ink)}
.tr-sw{flex:0 0 4px;width:4px;height:30px;border-radius:2px}
.tr-tx{display:flex;flex-direction:column;gap:3px;min-width:0}
.tr-src{font-family:var(--ss);font-size:11px;line-height:1.35;color:var(--muted)}
.tr-src b{font-weight:700;color:var(--ink)}
.tr-h{font-family:var(--sf);font-size:15px;font-weight:700;line-height:1.35;color:var(--ink)}
.tr-sc{position:relative;height:16px}
.tr-sc::before{content:"";position:absolute;left:0;right:0;top:50%;height:4px;margin-top:-2px;border-radius:2px;background:var(--rl)}
.tr-z{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--rule)}
.tr-d{position:absolute;top:50%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;box-shadow:0 0 0 2px var(--paper),0 0 0 3px var(--ink)}
.tr>details[open]>summary .tr-d{box-shadow:0 0 0 2px var(--tm-hl),0 0 0 3px var(--ink)}
.tr-r,.tr-q{display:flex;flex-direction:column;gap:2px;font-family:var(--ss);font-size:12.5px;line-height:1.3;color:var(--ink)}
.tr-r span,.tr-q span{font-size:11px;color:var(--muted)}
.tr-q b{font-family:var(--mn);font-size:14px;font-weight:600}
.tr-sig{justify-self:end;display:flex;align-items:center;gap:9px;font-family:var(--ss);font-size:11px;font-weight:600;white-space:nowrap;color:var(--link)}
.tr-sig::after{content:"";width:7px;height:7px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:translateY(-2px) rotate(45deg);transition:transform .2s}
.tr>details[open]>summary .tr-sig::after{transform:translateY(2px) rotate(-135deg)}
.tr-body{padding:8px 12px 22px 90px}
.tr-sum{max-width:820px;font-family:var(--sf);font-size:14.5px;line-height:1.55;color:var(--ink)}
.tr-note{margin-top:4px;font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--muted)}
.tr-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:20px 36px;margin-top:14px}
.tr-k{margin:18px 0 8px;font-family:var(--ss);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1.3px;color:var(--muted)}
.tr-main>.tr-k:first-child,.tr-side>.tr-k:first-child{margin-top:0}
.tev{list-style:none;display:flex;flex-direction:column;gap:14px}
.tev li{padding-left:12px;border-left:3px solid var(--t-eq)}
.tev li.tev-esq{border-left-color:var(--t-em)}
.tev li.tev-dir{border-left-color:var(--t-dm)}
.tev-h{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;font-family:var(--ss);font-size:12.5px;color:var(--ink)}
.tev-d{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.tev blockquote{margin:5px 0 0;font-family:var(--sf);font-size:14px;font-style:italic;line-height:1.5;color:var(--ink)}
.tev blockquote::before{content:"\201C"}
.tev blockquote::after{content:"\201D"}
.tev-x{margin-top:4px;font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--body)}
.tev-a{margin-top:2px;font-family:var(--ss);font-size:11.5px;line-height:1.45;color:var(--muted)}
.tev-more{margin-top:12px}
.tev-more>summary{cursor:pointer;font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.tev-more>summary:hover{text-decoration:underline}
.tev-more>.tev{margin-top:12px}
.tct{list-style:none;max-width:560px}
.tct li{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) 44px;gap:10px;align-items:center;padding:3px 0;font-family:var(--ss);font-size:12px;color:var(--ink)}
.tct-p{position:relative;height:10px}
.tct-z{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--rule)}
.tct-b{position:absolute;top:1px;bottom:1px}
.tct-b.esq{right:50%;border-radius:4px 0 0 4px;background:var(--t-em)}
.tct-b.dir{left:50%;border-radius:0 4px 4px 0;background:var(--t-dm)}
.tct-b.eq{left:calc(50% - 1px);width:3px!important;background:var(--t-eq)}
.tct-v{font-family:var(--mn);font-size:11px;text-align:right;color:var(--muted)}
.tfr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 22px}
.tfr dt{font-family:var(--ss);font-size:10.5px;font-weight:700;color:var(--muted)}
.tfr dd{margin-top:2px;font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--ink)}
.tr-inv{padding:10px 12px;border-radius:6px;background:var(--tm-hl);font-family:var(--sf);font-size:13.5px;line-height:1.55;color:var(--ink)}
.tck{list-style:none;display:flex;flex-direction:column;gap:6px}
.tck li{display:flex;align-items:flex-start;gap:8px;font-family:var(--ss);font-size:12.5px;line-height:1.4;color:var(--ink)}
.tck i{position:relative;flex:0 0 16px;height:16px;margin-top:1px;border-radius:50%}
.tck-sim i{background:var(--tm-bar)}
.tck-sim i::after{content:"";position:absolute;left:5.5px;top:2.5px;width:3.5px;height:7.5px;border:solid var(--paper);border-width:0 2px 2px 0;transform:rotate(45deg)}
.tck-nao{color:var(--muted)}
.tck-nao i{border:1.5px solid var(--muted)}
.tck-nao i::before,.tck-nao i::after{content:"";position:absolute;left:50%;top:50%;width:8px;height:1.5px;margin:-.75px 0 0 -4px;background:var(--muted);transform:rotate(45deg)}
.tck-nao i::after{transform:rotate(-45deg)}
.tck-nao_se_aplica{color:var(--faint)}
.tck-nao_se_aplica i{border:1.5px solid var(--rl)}
.tck-nao_se_aplica i::after{content:"";position:absolute;left:3.5px;right:3.5px;top:50%;height:1.5px;margin-top:-.75px;background:var(--faint)}
.tfo{list-style:none;display:flex;flex-direction:column;gap:7px}
.tfo li{display:flex;flex-direction:column;font-family:var(--ss);font-size:12.5px;line-height:1.4;color:var(--ink)}
.tfo-m{font-size:11px;color:var(--muted)}
.tfi{list-style:none;display:flex;flex-direction:column;gap:4px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--body)}
.tr-go{margin-top:18px;font-family:var(--ss);font-size:12.5px;font-weight:700}
.tr-go a{color:var(--link)}
.tr-go a:hover{text-decoration:underline}
.tm-more{display:block;height:36px;margin:16px auto 0;padding:0 22px;border:1px solid var(--rule);border-radius:18px;background:var(--paper);font-family:var(--ss);font-size:12.5px;font-weight:700;color:var(--link);cursor:pointer;transition:border-color .2s}
.tm-more:hover{border-color:var(--link)}
.tm-more[hidden]{display:none}
.tm-none{padding:18px 12px;font-family:var(--ss);font-size:13px;color:var(--muted)}
/* Como ler */
.tm-metodo{margin-top:30px;padding-top:16px;border-top:1px solid var(--rule)}
.tm-metodo dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 32px;margin-top:10px}
.tm-metodo dt{font-family:var(--ss);font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:1.1px;color:var(--ink)}
.tm-metodo dd{margin-top:4px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.term-note{max-width:900px;margin-top:12px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.term-det{margin-top:14px}
.term-det>summary{cursor:pointer;font-family:var(--ss);font-size:12px;font-weight:700;letter-spacing:.3px;color:var(--link)}
.term-det>summary:hover{text-decoration:underline}
/* Uma análise por linha (todas as análises, na aba Analítico Político) */
.ta-v{flex:0 0 auto;min-width:48px;font-family:var(--mn);font-size:15px;font-weight:600;color:var(--ink);white-space:nowrap}
.tl-list{list-style:none;margin-top:8px}
.tl{display:grid;grid-template-columns:56px 44px minmax(0,1fr) auto;gap:12px;align-items:baseline;padding:8px 8px;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:12.5px;line-height:1.4;color:var(--body)}
.tl .ta-v{min-width:0;padding:0;font-size:12.5px}
.tl-d{font-family:var(--mn);font-size:10.5px;color:var(--faint)}
.tl-tx b{color:var(--ink)}
.tl-tx a{color:var(--ink)}
.tl-tx a:hover{color:var(--link);text-decoration:underline}
.tl-r{font-size:11.5px;color:var(--muted);white-space:nowrap}
/* Todas as análises: a linha inteira abre o texto original (o link do título a cobre) */
.tl.tl-lk{position:relative;cursor:pointer;transition:background .2s}
.tl.tl-lk:hover{background:var(--hover)}
.tl.tl-lk:hover .tl-tx a{color:var(--link);text-decoration:underline}
.tl.tl-lk:has(.hit:focus-visible){outline:2px solid var(--link);outline-offset:-2px}
.tl-go{font-weight:700;color:var(--link)}
.tl-fora{margin-top:12px}
.an{padding:24px var(--gut) 36px}
.an-intro{max-width:900px;font-family:var(--sf);font-size:16px;line-height:1.6;color:var(--ink)}
.an-blk{margin-top:26px;padding-top:16px;border-top:1px solid var(--rl)}
.an .tm-panels{grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));max-width:1240px}
.an-h{margin-bottom:10px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
.an-tiles{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}
.an-tiles li,.an-reads li{display:flex;flex-direction:column;gap:3px;padding:12px 14px;border-left:3px solid var(--qi);background:var(--soft)}
.an-tl{font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.an-tiles b{font-family:var(--mn);font-size:24px;font-weight:600;color:var(--ink)}
.an-td{font-family:var(--ss);font-size:11.5px;line-height:1.4;color:var(--muted)}
.an-reads{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.an-reads b{font-family:var(--ss);font-size:15px;font-weight:800;color:var(--ink)}
.an-reads p{font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--body)}
.an-reads .rd-esq{border-left-color:var(--t-em)}
.an-reads .rd-dir{border-left-color:var(--t-dm)}
.an-reads .rd-est,.an-reads .rd-melhor{border-left-color:var(--t-eq)}
.an-reads .rd-pior{border-left-color:var(--qr)}
.an-reads .rd-ins{border-left-color:var(--rule)}
/* Nesta página (atalhos) e Em resumo (o termômetro em linguagem clara) */
.an-nav{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;margin-top:12px;font-family:var(--ss);font-size:12.5px}
.an-nav span{font-family:var(--mn);font-size:9.5px;letter-spacing:1px;text-transform:uppercase;color:var(--faint)}
.an-nav a{font-weight:600;color:var(--link)}
.an-nav a:hover{text-decoration:underline}
.an-res-t{max-width:980px;font-family:var(--sf);font-size:20px;font-weight:700;line-height:1.35;color:var(--ink)}
.an-res-l{list-style:none;max-width:980px;margin-top:10px;padding:12px 16px;border-left:3px solid var(--qc);background:var(--soft)}
.an-res-l li{position:relative;padding-left:16px;font-family:var(--sf);font-size:15px;line-height:1.55;color:var(--ink)}
.an-res-l li+li{margin-top:6px}
.an-res-l li::before{content:"";position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--qc)}
.an-res-mais{margin-top:10px;font-family:var(--ss);font-size:12.5px}
.an-res-mais a{font-weight:700;color:var(--link)}
.an-res-mais a:hover{text-decoration:underline}
.an-crit{list-style:none}
.an-crit li{display:grid;grid-template-columns:minmax(120px,190px) minmax(60px,1fr) minmax(120px,auto);align-items:center;gap:10px;padding:5px 0;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:12.5px;color:var(--ink)}
.an-cn{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.an-cb{display:flex;height:8px;border-radius:4px;background:var(--rl);overflow:hidden}
.an-cb i{display:block;height:100%}
.an-cb .neu{background:var(--qi)}
:root[data-theme="dark"] .an-cb .neu{background:var(--link)}
.an-cv{font-family:var(--mn);font-size:11px;color:var(--muted);white-space:nowrap;text-align:right}
.an-cv b{color:var(--ink);font-weight:600}
.an-pux{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}
.an-tbl-wrap{overflow-x:auto}
.an-tbl{width:100%;border-collapse:collapse;font-family:var(--ss);font-size:12.5px;color:var(--body)}
.an-tbl caption{margin-bottom:6px;text-align:left;font-size:11px;font-weight:700;color:var(--muted)}
.an-tbl th,.an-tbl td{padding:7px 10px 7px 0;border-bottom:1px solid var(--rl);text-align:right;white-space:nowrap}
.an-tbl th:first-child,.an-tbl td.an-l,.an-tbl th.an-l{text-align:left}
.an-tbl thead th{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--muted)}
.an-tbl tbody th{font-weight:700;color:var(--ink)}
.an-tbl td{font-family:var(--mn);font-size:11.5px}
.an-tbl td.an-l{font-family:var(--ss);font-size:12px}
.an-tbl a{color:var(--link)}
.an-tbl a:hover{text-decoration:underline}
.ts{max-width:900px;margin:0 0 22px}
.ts figcaption{margin-bottom:8px;font-family:var(--ss);font-size:12px;font-weight:700;color:var(--ink)}
.ts-plot{position:relative;height:200px;margin-left:38px}
.ts-g{position:absolute;left:0;right:0;height:0;border-top:1px solid var(--rl)}
.ts-g i{position:absolute;right:100%;margin-right:8px;transform:translateY(-50%);font-family:var(--mn);font-size:9.5px;font-style:normal;color:var(--faint);white-space:nowrap}
.ts-z{border-top:2px solid var(--rule)}
.ts-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ts-band{fill:var(--qi);opacity:.14}
.ts-line{fill:none;stroke:var(--qi);stroke-width:2;stroke-linejoin:round}
:root[data-theme="dark"] .ts-band{fill:var(--link)}
:root[data-theme="dark"] .ts-line{stroke:var(--link)}
.ts-pt{position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;border:2px solid var(--paper);border-radius:50%;background:var(--qi);cursor:default}
:root[data-theme="dark"] .ts-pt{background:var(--link)}
.ts-pt::before{content:"";position:absolute;inset:-8px}
.ts-x{position:relative;height:16px;margin:6px 0 0 38px;font-family:var(--mn);font-size:9.5px;color:var(--faint)}
.ts-x span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.ts-x span:first-child{transform:none}
.ts-x span:last-child:not(:first-child){transform:translateX(-100%)}
.rk,.qb,.rk-axis{list-style:none;max-width:900px}
.rk-i,.qb li,.rk-axis{display:grid;grid-template-columns:180px minmax(0,1fr) 220px;gap:14px;align-items:center;padding:7px 0;border-bottom:1px solid var(--rl)}
.rk-axis{border-bottom:none;padding-top:4px}
.rk-n{font-family:var(--ss);font-size:12.5px;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rk-p{position:relative;height:14px}
.rk-axis .rk-p{height:12px}
.rk-axis i{position:absolute;transform:translateX(-50%);font-family:var(--mn);font-size:9px;font-style:normal;color:var(--faint);white-space:nowrap}
.rk-axis i:first-child{transform:none}
.rk-axis i:last-child{transform:translateX(-100%)}
.rk-z{position:absolute;top:-4px;bottom:-4px;width:2px;margin-left:-1px;background:var(--rule)}
.rk-ic{position:absolute;top:50%;height:2px;margin-top:-1px;background:var(--mute2)}
.rk-d{position:absolute;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px}
.rk-d i{display:block;width:100%;height:100%;border:2px solid var(--paper);border-radius:50%;box-shadow:0 0 0 1px var(--ink)}
.rk-v{font-family:var(--ss);font-size:12px;line-height:1.35;color:var(--muted)}
.rk-v b{font-family:var(--mn);font-size:13px;color:var(--ink)}
.rk-x{display:block;font-family:var(--mn);font-size:9.5px;color:var(--faint)}
/* Veículos com amostra pequena (menos notícias com T que o mínimo da especificação): esmaecidos */
.rk-nota{margin:0 0 6px}
.rk-pq .rk-d,.rk-pq .rk-ic,.rk-pq .qb-bar span{opacity:.45}
.rk-pq .rk-n{font-weight:600;color:var(--mute2)}
.qb-bar{display:block;height:10px;border-radius:0 4px 4px 0;background:var(--rl)}
.qb-bar span{display:block;height:100%;border-radius:0 4px 4px 0;background:var(--qi)}
:root[data-theme="dark"] .qb-bar span{background:var(--link)}
@media (max-width:1100px){
  .tr-hd,.tr>details>summary{grid-template-columns:56px minmax(0,1fr) 104px 124px 64px 70px;gap:12px}
  .tr-body{padding-left:80px}
}
@media (max-width:860px){
  .tm-placar{grid-template-columns:1fr;gap:14px}
  .tm-hero{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:18px;align-items:center}
  .tm-hero .tm-k{grid-column:1/-1}
  .tm-n{grid-column:1;grid-row:2/span 3;margin-top:6px}
  .tm-r,.tm-ic,.tm-b{grid-column:2}
  .tm-r{margin-top:6px}
  .tm-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
  .tm-kpis li:nth-child(odd){padding-left:0;border-left:none}
  .tm-kpis li:nth-child(n+3){border-top:1px solid var(--rl)}
}
@media (max-width:760px){
  .an{padding:18px 16px 24px}
  .tm-dek{font-size:15px}
  .tm-placar{padding:16px 16px 14px}
  .tm-n{font-size:54px}
  .tm-kpis li{padding:12px 12px 12px 0}
  .tm-kpis li+li{padding-left:12px}
  .tm-kv{font-size:24px}
  .tg-ticks .mn,.tg-zones,.tg-rug-k{display:none}
  .tm-metodo dl{grid-template-columns:1fr}
  .trc-i,.trc-axis{grid-template-columns:minmax(0,104px) minmax(0,1fr) 88px;gap:10px}
  .trc-x{display:block}
  .tr-hd{display:none}
  .tr>details>summary{grid-template-columns:48px minmax(0,1fr) auto;gap:8px 10px;padding:12px 4px}
  .tr-t{grid-column:1;grid-row:1/4;align-self:start;gap:7px;font-size:15px}
  .tr-tx{grid-column:2/4;grid-row:1}
  .tr-sc{grid-column:2;grid-row:2}
  .tr-sig{grid-column:3;grid-row:2}
  .tr-r{grid-column:2;grid-row:3;flex-direction:row;flex-wrap:wrap;align-items:baseline;gap:2px 8px}
  .tr-q{grid-column:3;grid-row:3;flex-direction:row;align-items:baseline;gap:4px;justify-self:end}
  .tr-body{padding:6px 4px 18px}
  .tr-grid,.tfr{grid-template-columns:1fr}
  .tm-fil{gap:8px 10px}
  .tm-sel{flex:1 1 140px}
  .tm-sel select{width:100%;max-width:none}
  .tm-shown{width:100%;margin-left:0;padding-bottom:0}
  .an-reads,.an-pux{grid-template-columns:1fr}
  .tl{grid-template-columns:52px minmax(0,1fr);gap:2px 10px}
  .tl-tx{grid-column:2;grid-row:1}
  .tl-d{grid-column:1;grid-row:2}
  .tl-r{grid-column:2;grid-row:2;white-space:normal}
  .an-res-t{font-size:17.5px}
  .an-res-l{padding:10px 12px}
  .an-res-l li{font-size:14px}
  .an-crit li{grid-template-columns:minmax(0,1fr) auto;gap:2px 10px}
  .an-cb{grid-column:1/-1;grid-row:2}
  .rk-i,.qb li,.rk-axis{grid-template-columns:34% minmax(0,1fr);gap:4px 10px}
  .rk-v{grid-column:1/-1}
  .rk-axis .rk-v{display:none}
}
@media (max-width:400px){
  .tool.tool-an span{display:none}
}
{% endif %}

{% if brand.congresso %}
/* Fichas do Congresso dentro da matéria: os parlamentares citados e o que os registros
   dizem de cada um. Verde-azulado × âmbar = vota com a esquerda × com a direita, sempre
   com o saldo (com sinal) ao lado. */
.ml .mcg{--mcg-e:#0B5F6B;--mcg-d:#8F4A0E;margin-top:22px;padding:16px 18px;border:1px solid var(--rl);border-radius:4px;background:var(--soft)}
:root[data-theme="dark"] .ml .mcg{--mcg-e:#86D3DC;--mcg-d:#F2B577}
.ml .mcg>h3{margin-bottom:6px;font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint)}
.ml .mcg>h3 span{margin-left:8px;letter-spacing:0;text-transform:none;font-family:var(--ss);font-size:11px;font-weight:400}
.ml .mcg ul{list-style:none}
.ml .mcg li{padding:10px 0;border-top:1px solid var(--rl)}
.ml .mcg li:first-child{border-top:0}
.mcg-n{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;font-family:var(--ss);font-size:14.5px;font-weight:700}
.mcg-n a{color:var(--link)}
.mcg-n a:hover{text-decoration:underline}
.mcg-n span{font-family:var(--mn);font-size:10.5px;font-weight:400;color:var(--muted)}
.mcg-s{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;margin-top:5px;font-family:var(--ss);font-size:12.5px;color:var(--ink)}
.mcg-s b{font-family:var(--mn)}
.mcg-b{position:relative;flex:none;width:120px;height:8px;border-radius:2px;background:linear-gradient(var(--ink),var(--ink)) 50% 0/1px 100% no-repeat rgba(var(--qi-rgb),.12)}
.mcg-b i{position:absolute;top:0;bottom:0;border-radius:2px}
.mcg-e{background:var(--mcg-e)}.mcg-d{background:var(--mcg-d)}.mcg-c{background:var(--muted)}
.mcg-x{margin-top:4px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--body)}
.mcg-f{margin-top:8px;padding-top:9px;border-top:1px solid var(--rl);font-family:var(--ss);font-size:11.5px;line-height:1.5;color:var(--muted)}
.mcg-f a{font-weight:700;color:var(--link);white-space:nowrap}
.mcg-f a:hover{text-decoration:underline}
{% endif %}
/* ── Computador (a partir de 1024 px) ──
   Cabeçalho compacto (data e hora da edição à esquerda, logo ao centro, ferramentas à
   direita). Na home, "Como a mídia cobriu" passa a duas colunas (7 e 5 de 12); a manchete
   só fica ao lado de "Em 1 minuto", nas mesmas colunas, a partir de 1280 px (mais abaixo). */
.mast-l{display:none}
@media (min-width:1024px){
  :root{--gut:32px;--fr:var(--ink)}
  :root[data-theme="dark"]{--fr:#75829a}

  /* Cabeçalho */
  .mast{padding:16px 300px 14px}
  .mast h1.logo svg,.mast h1.logo.mono svg{height:clamp(64px,4.2vw,92px)}
  .mast h1.logo+.mast-sub{margin-top:8px}
  .mast-sub{font-size:9px}
  .mast-l:not(:empty){display:block;position:absolute;z-index:3;left:var(--gut);top:50%;transform:translateY(-50%);font-family:var(--ss);text-align:left}
  .mast-l:not(:empty)~.mast .mast-date{display:none}
  .mast-l .ml-d{font-size:13px;font-weight:600;line-height:1.4;color:var(--on-mh,var(--head))}
  .mast-l .ml-e{margin-top:3px;font-family:var(--mn);font-size:10px;letter-spacing:.6px;color:var(--faint)}
  .mast-wrap.solid .mast-l .ml-e{color:rgba(var(--on-mh-rgb),.72)}
  .mast-l .nw{white-space:nowrap}
  .mast-tools{top:50%;right:var(--gut);transform:translateY(-50%)}

  /* Home: "Como a mídia cobriu" em duas colunas (7 e 5 de 12); a linha fina das chamadas aparece */
  :root{--f-tit:18px}
  .capa{padding:24px 0 30px}
  .um-dk{display:block}
  .md-cols{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:56px}
  .dv>li{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:28px}
  .dv-l{margin-top:2px}
  /* Uma coluna só (edição automática, sem cobertura comparada): a lista vira uma fileira */
  .md-cols.uma{grid-template-columns:minmax(0,1fr)}
  .md-cols.uma .rc{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);column-gap:36px}
  .md-cols.uma .rc a{grid-template-columns:minmax(0,1fr);row-gap:1px}
  .md-cols.uma .dv{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);column-gap:36px}
  .md-cols.uma .dv>li{display:block}
  .md-cols.uma .dv-l{margin-top:5px}

  /* Racional: blocos numa grade de 4 colunas sem vagas vazias (a última linha
     incompleta se fecha); a partir de 1600 px, resumo à esquerda e blocos à direita */
  .rat-sum{font-size:15.5px}
  .rat>.rat-blocks{grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 20px;margin-top:14px}
  .rat-blocks li{justify-content:flex-start;padding:5px 0 6px 12px;background:transparent;font-size:12px;line-height:1.4}
  .rat-blocks li:last-child:nth-child(4n+1){grid-column:1/-1}
  .rat-blocks li:last-child:nth-child(4n+2),.rat-blocks li:nth-last-child(2):nth-child(4n+1),.rat-blocks li:last-child:nth-child(4n+3){grid-column:span 2}
  .rat-note{font-size:12px}

  /* Cobertura comparada: colunas com réguas finas; em cada linha, títulos, barras e
     conclusões alinhados (subgrade) */
  .cmp-list{grid-template-columns:repeat(3,minmax(0,1fr));column-gap:40px;row-gap:0;margin-top:4px}
  .cmp-i{position:relative;display:grid;grid-row:span 7;grid-template-rows:subgrid;align-content:start;padding:14px 0 16px;border-bottom:none;border-top:1px solid var(--rl)}
  .cmp-i:nth-child(-n+3){border-top:none}
  .cmp-i:not(:nth-child(3n+1))::before{content:"";position:absolute;left:-20px;top:14px;bottom:16px;width:1px;background:var(--rl)}
  .cmp-i>.cov.full{display:contents}
  .cmp-i>.cat{grid-row:1}
  .cmp-i>h3{grid-row:2;margin-bottom:8px;font-size:16px;line-height:1.28}
  .cmp-i .cov-scale{grid-row:3;align-self:end;font-size:11px;line-height:1.3}
  .cmp-i .cov-bar{grid-row:4}
  .cmp-i .cov-lean{grid-row:5}
  .cmp-i .cov-c{grid-row:6;font-size:13.5px;line-height:1.5}
  .cmp-i .cov-who{grid-row:7}
}
@media (min-width:1024px) and (max-width:1279.98px){
  /* Cobertura comparada em 2 colunas (3 ficariam estreitas demais) */
  .cmp-list{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cmp-i:nth-child(3){border-top:1px solid var(--rl)}
  .cmp-i:nth-child(3n+1)::before{content:"";position:absolute;left:-20px;top:14px;bottom:16px;width:1px;background:var(--rl)}
  .cmp-i:nth-child(odd)::before{display:none}
  /* Item que sobra na última linha: ocupa a linha (título e barra à esquerda,
     conclusão à direita) em vez de deixar uma vaga vazia */
  .cmp-i:last-child:nth-child(odd){grid-column:1/-1}
  .cmp-i:last-child:nth-child(odd){grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:40px}
  .cmp-i:last-child:nth-child(odd)>*,.cmp-i:last-child:nth-child(odd) .cov-scale,.cmp-i:last-child:nth-child(odd) .cov-bar,.cmp-i:last-child:nth-child(odd) .cov-lean{grid-column:1}
  .cmp-i:last-child:nth-child(odd) .cov-c{grid-column:2;grid-row:2/-1;align-self:start;margin-top:0}
  .cmp-i:last-child:nth-child(odd) .cov-who{grid-column:1;grid-row:6}
}
@media (min-width:1280px){
  /* Home em tela larga: a manchete (título em toda a coluna; abaixo, a linha fina à esquerda
     e a foto à direita, que acompanha a altura da lista) ao lado de "Em 1 minuto" */
  .capa{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:56px}
  .man{display:flex;flex-direction:column;--f-man:41px}
  .man.curto{--f-man:46px}
  .man.longo{--f-man:36px}
  .man .cat{margin-bottom:10px}
  .man-c{flex:1 1 auto;grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:28px;align-items:stretch;margin-top:16px}
  .man-x{height:100%}
  .man .sv{margin-top:auto;padding-top:12px}
  .man-f{position:relative;width:100%;height:100%;min-height:250px;aspect-ratio:auto;margin:0}
  .man-f img{position:absolute;inset:0;object-position:50% 30%}
  /* Sem foto (a matéria não tem ou ela não carregou): a manchete ocupa a largura toda e
     "Em 1 minuto" vira uma fileira de chamadas abaixo dela, sem buraco na página */
  .capa.solo,.capa:has(.man.noimg),.capa:has(.man-f.img-fail){grid-template-columns:minmax(0,1fr)}
  .man.noimg .man-c,.man:has(.man-f.img-fail) .man-c{margin-top:14px}
  .man.noimg .man-dek,.man:has(.man-f.img-fail) .man-dek{max-width:46em}
  .capa:has(.man.noimg) .um-l,.capa:has(.man-f.img-fail) .um-l{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);column-gap:36px}
  .capa:has(.man.noimg) .um-l li,.capa:has(.man-f.img-fail) .um-l li{grid-template-columns:minmax(0,1fr);padding:12px 0 14px}
  .capa:has(.man.noimg) .um-l li::before,.capa:has(.man-f.img-fail) .um-l li::before{grid-row:auto;margin-bottom:2px}
  .capa:has(.man.noimg) .um-l li>*,.capa:has(.man-f.img-fail) .um-l li>*{grid-column:1}
  .capa:has(.man.noimg) .um-dk,.capa:has(.man-f.img-fail) .um-dk{display:none}
}
@media (min-width:1280px) and (max-width:1599.98px){
  /* Cobertura comparada em 3 colunas: os itens que sobram na última linha se
     alargam para fechá-la */
  .cmp-i:last-child:nth-child(3n+1){grid-column:1/-1}
  .cmp-i:last-child:nth-child(3n+2){grid-column:span 2}
  .cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2)){grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:40px}
  .cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2))>*,.cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2)) .cov-scale,.cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2)) .cov-bar,.cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2)) .cov-lean{grid-column:1}
  .cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2)) .cov-c{grid-column:2;grid-row:2/-1;align-self:start;margin-top:0}
  .cmp-i:last-child:is(:nth-child(3n+1),:nth-child(3n+2)) .cov-who{grid-column:1;grid-row:6}
}
@media (min-width:1280px){
  .src-list{columns:4 220px}
}
@media (min-width:1600px){
  .rat-sum{font-size:16px}
  .rat{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);grid-template-rows:repeat(4,auto) 1fr;column-gap:36px}
  .rat>*{grid-column:1}
  .rat>.rat-blocks{grid-column:2;grid-row:2/-1;align-self:stretch;grid-auto-rows:1fr;gap:12px 20px;margin-top:2px}
  /* Cobertura comparada em 4 colunas */
  .cmp-list{grid-template-columns:repeat(4,minmax(0,1fr))}
  .cmp-i:nth-child(-n+4){border-top:none}
  .cmp-i:not(:nth-child(4n+1))::before{content:"";position:absolute;left:-20px;top:14px;bottom:16px;width:1px;background:var(--rl)}
  .cmp-i:nth-child(4n+1)::before{display:none}
  /* Itens que sobram na última linha: fecham a linha (1 sozinho ocupa as 4
     colunas; 2 ficam com 2 cada; de 3, o último fica com 2) */
  .cmp-i:last-child:nth-child(4n+1){grid-column:1/-1}
  .cmp-i:last-child:nth-child(4n+2),.cmp-i:nth-last-child(2):nth-child(4n+1),.cmp-i:last-child:nth-child(4n+3){grid-column:span 2}
  .cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3)){grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:40px}
  .cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3))>*,.cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3)) .cov-scale,.cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3)) .cov-bar,.cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3)) .cov-lean{grid-column:1}
  .cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3)) .cov-c{grid-column:2;grid-row:2/-1;align-self:start;margin-top:0}
  .cmp-i:is(:last-child:nth-child(4n+1),:last-child:nth-child(4n+2),:nth-last-child(2):nth-child(4n+1),:last-child:nth-child(4n+3)) .cov-who{grid-column:1;grid-row:6}
}

