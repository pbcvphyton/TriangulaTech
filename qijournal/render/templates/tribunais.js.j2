  function razao(r) { return r == null ? '—' : (r < 10 ? (Math.round(r * 10) / 10).toFixed(1) : String(Math.round(r))).replace('.', ','); }
  function dataBr(iso) { return iso && iso.length >= 10 ? iso.slice(8, 10) + '/' + iso.slice(5, 7) + '/' + iso.slice(0, 4) : ''; }
  var MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
  function mesBr(am) { var i = parseInt(String(am).slice(5, 7), 10); return MESES[i - 1] || String(am); }  /* "2026-10" → "out" */
  function diasDe(j) { var a = Date.parse((j || [])[0]), b = Date.parse((j || [])[1]); return isNaN(a) || isNaN(b) ? 0 : Math.round((b - a) / 864e5) + 1; }
