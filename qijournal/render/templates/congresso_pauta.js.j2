      if (!p) { apagarDica(); return; }
      if (p !== sobre) {
        if (sobre) sobre.el.classList.remove('on');
        sobre = p;
        p.el.classList.add('on');
        esvaziar(dicaDoPonto);
        dicaDoPonto.appendChild(h('b', { text: p.t }));
        dicaDoPonto.appendChild(h('span', { text: (p.a ? 'aprovada ' + emDias(p.d) : 'esperando; protocolada há ' + tempo(p.d)) + ' · nota ' + p.n + ' · clique para ver' }));
      }
      var caixa = fig.getBoundingClientRect(), r = svg.getBoundingClientRect();
      var x = r.left - caixa.left + p.x * r.width / 100 + 12, y = r.top - caixa.top + p.y * r.height / 100 - 8;
      dicaDoPonto.hidden = false;
      if (x + dicaDoPonto.offsetWidth > caixa.width) x = Math.max(0, x - dicaDoPonto.offsetWidth - 24);
      dicaDoPonto.style.left = x + 'px';
      dicaDoPonto.style.top = Math.max(0, y - dicaDoPonto.offsetHeight) + 'px';
    });
    plot.addEventListener('pointerleave', apagarDica);
    plot.addEventListener('click', function (ev) {
      var p = maisPerto(ev, 20);
      if (p) irAo(p);
    });

    /* ── Os filtros ── */
    function alternar(f, soEste) {
      var tipo = f.slice(0, 2), valor = f.slice(2), on = ligado(f);
      if (soEste) F = { s: [], q: '', forte: false, tema: '' };
      if (tipo === 's:') { if (soEste) F.s = on ? [] : [valor]; else if (on) F.s = F.s.filter(function (x) { return x !== valor; }); else F.s = F.s.concat([valor]); }
      else if (tipo === 'q:') F.q = on ? '' : valor;
      else if (tipo === 'f:') F.forte = !on;
      aplicar();
    }
    chips.forEach(function (b) { b.addEventListener('click', function () { alternar(b.getAttribute('data-f') || ''); }); });
    /* Um número da manchete: só ele realçado, e a tela vai ao gráfico. */
    manchetes.forEach(function (b) {
      b.addEventListener('click', function () { alternar(b.getAttribute('data-f') || '', true); rolarAte(bloco.querySelector('.cg-pa-g')); });
    });
    if (seletor) seletor.addEventListener('change', function () { F.tema = seletor.value; aplicar(); });
    linhasDoTema.forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.getAttribute('data-tema') || '', on = F.tema === t;
        F = { s: [], q: '', forte: false, tema: on ? '' : t };
        aplicar();
        if (!on) rolarAte(bloco.querySelector('.cg-pa-g'));
      });
    });
    if (limpar) limpar.addEventListener('click', function () { F = { s: [], q: '', forte: false, tema: '' }; aplicar(); });

    /* ── A lista "vale olhar" e as semanas levam ao cartão ── */
    lista(bloco.querySelectorAll('.cg-pa-ver')).forEach(function (b) {
      b.hidden = false;
      b.addEventListener('click', function () { mostrarMateria(b.getAttribute('data-ver')); });
    });
    if (semanas) {
      if (quadrados.length) quadrados[0].setAttribute('tabindex', '0');
      semanas.addEventListener('click', function (ev) {
        var b = ev.target.closest ? ev.target.closest('.cg-pa-b') : null;
        if (!b) {  // o toque na coluna da semana: a primeira matéria dela; de novo, a seguinte
          var coluna = ev.target.closest ? ev.target.closest('.cg-pa-w') : null, dela = coluna ? lista(coluna.querySelectorAll('.cg-pa-b')) : [];
          if (!dela.length) return;
          var i = -1;
          dela.forEach(function (x, k) { if (emFoco && x.getAttribute('data-ver') === emFoco.t) i = k; });
          b = dela[(i + 1) % dela.length];
        }
        mostrarMateria(b.getAttribute('data-ver'));
      });
      semanas.addEventListener('keydown', function (ev) {
        var b = ev.target.closest ? ev.target.closest('.cg-pa-b') : null, delta = ev.key === 'ArrowRight' || ev.key === 'ArrowUp' ? 1 : ev.key === 'ArrowLeft' || ev.key === 'ArrowDown' ? -1 : 0;
        if (!b || !delta) return;
        ev.preventDefault();
        var alvo = quadrados[Math.max(0, Math.min(quadrados.length - 1, quadrados.indexOf(b) + delta))];
        quadrados.forEach(function (x) { x.setAttribute('tabindex', x === alvo ? '0' : '-1'); });
        alvo.focus();
      });
    }

    /* A tabela de todos os pontos: cada nome vira um link para a ficha (quando a tabela é aberta). */
    var tabelaDosPontos = bloco.querySelector('.cg-pa-tb'), comLinks = false;
    if (tabelaDosPontos) tabelaDosPontos.addEventListener('toggle', function () {
      if (comLinks || !tabelaDosPontos.open) return;
      comLinks = true;
      lista(tabelaDosPontos.querySelectorAll('tbody th')).forEach(function (th) {
        var t = th.textContent, k = chaveDaMateria(casa, t);
        if (!k) return;
        th.textContent = '';
        th.appendChild(h('a', { cls: 'cg-mt', href: '#m=' + k, 'data-m': k, text: t }));
      });
    });

    aplicar(true);
    pautaDaCasa[casa] = {
      doEndereco: function (p) {
        var sinais = (p.s || '').split(',').filter(function (s) { return ROTULO[s]; });
        var tema = p.t && seletor && lista(seletor.options).some(function (o) { return o.value === p.t; }) ? p.t : '';
        F = { s: sinais, q: p.q === 'a' || p.q === 'e' ? p.q : '', forte: p.n === 'forte', tema: tema };
        aplicar(true);
        var alvo = materiaDaChave(p.m || ''), ponto = alvo && alvo.casa === casa ? porTitulo[alvo.titulo] : null;
        if (ponto) irAo(ponto, { semEndereco: true });
      }
    };
  });
  /* #v=espera&c=cd&m=cd-PL-179-2026&s=urgencia,plenario&t=politica: a Casa, a matéria em foco e os filtros. */
  aoEndereco.espera = function (q) {
    var p = {};
    (q || '').split('&').forEach(function (par) {
      var i = par.indexOf('=');
      if (i > 0) { try { p[par.slice(0, i)] = decodeURIComponent(par.slice(i + 1)); } catch (erro) { /* parâmetro malformado: ignorado */ } }
    });
    if (!p.c && !p.m && !p.s && !p.t && !p.q && !p.n) return;
    var casa = p.c === 'sf' || (!p.c && /^sf-/.test(p.m || '')) ? 'sf' : 'cd';
    if (!pautaDaCasa[casa]) return;
    if (casas && !casas.hidden && root.getAttribute('data-ver') !== casa) verCasa(casa);
    pautaDaCasa[casa].doEndereco(p);
  };
