    function titulo5(texto, valor) { return h('h5', { cls: 'cg-pa-c-h' }, [texto, valor != null ? h('b', { text: String(valor) }) : null]); }
    function pe(p, m) {
      var k = chaveDaMateria(casa, p.t);
      return h('p', { cls: 'cg-pa-c-l' }, [
        h('a', { cls: 'cg-mt', href: '#m=' + k, 'data-m': k, text: 'Abrir a ficha' }),
        m && m.u ? ' · ' : null,
        m && m.u ? h('a', { href: m.u, target: '_blank', rel: 'noopener noreferrer', text: 'Página oficial' }) : null
      ]);
    }
    function cartaoDaAprovada(p, m) {
      var rel = m.rel || {}, caminho = rel.cam || {}, meio = [], nos = [cabeca(p, m, 'aprovada'), h('p', { cls: 'cg-pa-c-e', text: m.e || '' })];
      if (caminho.urgencia) meio.push({ d: caminho.urgencia.d || '', o: 'Urgência aprovada', x: caminho.urgencia.por ? 'a pedido de ' + caminho.urgencia.por : '' });
      if (caminho.parecer_plenario) meio.push({ d: caminho.parecer_plenario.d || '', o: 'Parecer em Plenário', x: caminho.parecer_plenario.relator ? 'relator: ' + caminho.parecer_plenario.relator : 'no lugar das comissões' });
      meio.sort(function (x, y) { return x.d < y.d ? -1 : x.d > y.d ? 1 : 0; });
      nos.push(titulo5('Do protocolo ao voto', emDias(rel.dias)));
      nos.push(passosNoTempo([{ d: m.da || '', o: 'Protocolo', x: (M.origens || {})[m.o || 'parlamentar'] || '' }].concat(meio, [{ d: rel.apv || '', o: 'Aprovada pelo Plenário', x: '' }])));
      if (casa !== 'cd') nos.push(h('p', { cls: 'cg-pa-c-o', text: 'O registro do Senado não traz a urgência nem o parecer.' }));
      var sinais = (rel.sin || []).filter(function (s) { return ROTULO[s]; });
      if (sinais.length) {
        nos.push(titulo5('Os sinais desta matéria', sinais.length));
        nos.push(h('ul', { cls: 'cg-pa-c-s' }, sinais.map(function (s) {
          var x = LINHA[s];
          if (s === 'relampago') x = 'do protocolo ao voto ' + emDias(rel.dias) + (m.o === 'outra_casa' ? ' (veio ' + outra + ' já votada lá)' : m.o === 'executivo' ? ' (veio do Executivo)' : '');
          else if (s === 'fraca') x = 'nota ' + rel.n + ', abaixo de ' + baixa;
          return h('li', {}, [h('b', { text: ROTULO[s] }), h('span', { text: x })]);
        })));
      }
      var enq = rel.enq, tema = (M.temasCurtos || {})[(m.tm || [])[0]] || '';
      if (enq && tema) {
        var linha = h('p', { cls: 'cg-pa-c-enq' }, [h('b', { text: 'Enquanto isso' }), ', em ' + tema + ': ']);
        if (!enq.n) linha.appendChild(d.createTextNode('nenhuma matéria com nota maior espera pronta para o Plenário.'));
        else {
          var ha = enq.da ? tempo(dias(enq.da)) : '';
          linha.appendChild(d.createTextNode(enq.n === 1 ? '1 matéria com nota maior espera pronta para o Plenário, ' : num(enq.n) + ' matérias com nota maior esperam prontas para o Plenário; a mais antiga, '));
          linha.appendChild(linkDaMateria(casa, enq.t));
