      return nos;
    }
    function cartaoDaQueEspera(p, m) {
      var nos = [cabeca(p, m, 'esperando'), h('p', { cls: 'cg-pa-c-e', text: m.e || '' })];
      var desde = m.mov || m.da || '';
      nos.push(titulo5('Pronta para o Plenário, fora da pauta', desde ? 'há ' + tempo(dias(desde)) : null));
      var passos = [{ d: m.da || '', o: 'Protocolo', x: [(M.origens || {})[m.o || 'parlamentar'] || '', m.da ? 'há ' + tempo(dias(m.da)) : ''].filter(Boolean).join(' · '), semConta: true }];
      if (m.mov) passos.push({ d: m.mov, o: 'Último andamento', x: [m.sit || 'pronta para a pauta', 'há ' + tempo(dias(m.mov))].join(' · '), semConta: true });
      nos.push(passosNoTempo(passos));
      nos.push(h('p', { cls: 'cg-pa-c-o' }, [h('b', { text: 'Com quem está: ' }), 'com quem faz a pauta do Plenário' + (m.rl ? '. Relator: ' + m.rl : '') + (m.urg ? '. Está em regime de urgência, e não foi votada' : '') + '.']));
      var sinais = [];
      if (p.n >= alta) sinais.push(['Sinais fortes', 'nota ' + p.n + ', ' + alta + ' ou mais']);
      if (p.s.indexOf('proprio') >= 0 && ROTULO.proprio) sinais.push([ROTULO.proprio, LINHA.proprio]);
      if (p.s.indexOf('fraca') >= 0) sinais.push([ROTULO.fraca || 'Sinais fracos', 'nota ' + p.n + ', abaixo de ' + baixa]);
      if (sinais.length) {
        nos.push(titulo5('O que dá para dizer antes do voto', null));
        nos.push(h('ul', { cls: 'cg-pa-c-s' }, sinais.map(function (x) { return h('li', {}, [h('b', { text: x[0] }), h('span', { text: x[1] })]); })));
      }
      nos.push(pe(p, m));
      return nos;
    }
    function porNoCartao(nos, semAnimar) {
      esvaziar(card);
      nos.forEach(function (no) { if (no) card.appendChild(no); });
      if (semAnimar || parado) return;
      card.classList.remove('cg-pa-vira');
      void card.offsetWidth;
      card.classList.add('cg-pa-vira');
    }
    function desenhar(p) {
      if (p.t === noCartao) return;
      noCartao = p.t;
      var minha = ++vez, pronto = false;
      materiasDa(casa, function (erro, mat) {
        pronto = true;
        if (minha !== vez) return;
        var m = !erro && mat ? mat.materias[p.t] : null;
        if (!m) { porNoCartao([cabeca(p, null, p.a ? 'aprovada' : 'esperando'), h('p', { cls: 'cg-pa-c-o', text: erro ? 'Não foi possível abrir os dados desta matéria agora. Tente de novo em instantes.' : 'Sem ficha para esta matéria.' })]); if (erro) noCartao = ''; return; }
        porNoCartao(p.a && m.rel && m.rel.q === 'passou' ? cartaoDaAprovada(p, m) : cartaoDaQueEspera(p, m));
      });
      if (!pronto) porNoCartao([cabeca(p, null, p.a ? 'aprovada' : 'esperando'), h('p', { cls: 'cg-pa-c-o', text: 'Carregando…' })], true);
    }
    function rolarAte(el) {
      if (!el || !barraFixa) return;
      var topo = w.pageYOffset + el.getBoundingClientRect().top - barraFixa.offsetHeight - 10;
      if (w.scrollTo) { try { w.scrollTo({ top: Math.max(0, topo), behavior: parado ? 'auto' : 'smooth' }); } catch (erro) { w.scrollTo(0, Math.max(0, topo)); } }
    }
    function irAo(p, o) {
      o = o || {};
      if (!p) return;
      emFoco = p;
      if (halo) { halo.setAttribute('cx', p.x + '%'); halo.setAttribute('cy', p.y + '%'); halo.removeAttribute('visibility'); }
      quadrados.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-ver') === p.t ? 'true' : 'false'); });
      atualizarPasso();
      desenhar(p);
      if (!o.semEndereco) gravarEndereco();
      if (o.rolar) rolarAte(plot);
    }
    /* Um atalho de fora do gráfico (a lista, a semana): se o filtro esconde a matéria, o filtro sai. */
    function mostrarMateria(t) {
      var p = porTitulo[t];
      if (!p) return;
      if (temFiltro() && !passa(p)) { F = { s: [], q: '', forte: false, tema: '' }; aplicar(true); }
      irAo(p, { rolar: true });
    }
    function passo(delta) {
      if (!ordem.length) return;
      var i = emFoco ? ordem.indexOf(emFoco) : -1;
      var alvo = i < 0 ? (delta > 0 ? 0 : ordem.length - 1) : Math.max(0, Math.min(ordem.length - 1, i + delta));
      if (ordem[alvo] !== emFoco) irAo(ordem[alvo]);
    }
    navEl.hidden = false;
    ant.addEventListener('click', function () { passo(-1); });
    prox.addEventListener('click', function () { passo(1); });
    function teclas(ev) {
      if (ev.target && ev.target.closest && ev.target.closest('a, select, input')) return;
      var delta = ev.key === 'ArrowRight' || ev.key === 'ArrowDown' ? 1 : ev.key === 'ArrowLeft' || ev.key === 'ArrowUp' ? -1 : ev.key === 'Home' ? -1e6 : ev.key === 'End' ? 1e6 : 0;
      if (!delta) return;
      ev.preventDefault();
      passo(delta);
    }
    plot.setAttribute('tabindex', '0');
    plot.setAttribute('role', 'group');
    plot.setAttribute('aria-label', 'Gráfico das matérias. As setas do teclado andam pelas matérias realçadas; a matéria em foco aparece no cartão ao lado.');
    plot.addEventListener('keydown', teclas);
    cw.addEventListener('keydown', teclas);

    /* ── O ponteiro no gráfico: a dica do ponto mais perto; o clique o põe em foco ── */
    function maisPerto(ev, raio) {
      var r = svg.getBoundingClientRect(), mx = ev.clientX - r.left, my = ev.clientY - r.top, melhor = null, dist = raio * raio, filtro = temFiltro();
      pontos.forEach(function (p) {
        var dx = p.x * r.width / 100 - mx, dy = p.y * r.height / 100 - my, d2 = dx * dx + dy * dy;
        if (d2 >= raio * raio) return;
        d2 += (p.a ? 0 : 9) + (filtro && !passa(p) ? 64 : 0);  // na dúvida, a aprovada (desenhada por cima) e a que está realçada
