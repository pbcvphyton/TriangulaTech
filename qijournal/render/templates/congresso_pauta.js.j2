    /* ── O cartão em foco ── */
    function emDias(n) { return n === 0 ? 'no mesmo dia' : 'em ' + tempo(n); }
    function entreDatas(a, b) {
      var x = Date.parse((a || '').slice(0, 10) + 'T00:00:00Z'), y = Date.parse((b || '').slice(0, 10) + 'T00:00:00Z');
      return isNaN(x) || isNaN(y) ? null : Math.round((y - x) / 864e5);
    }
    function cabeca(p, m, situacao) {
      return h('p', { cls: 'cg-pa-c-k' }, [
