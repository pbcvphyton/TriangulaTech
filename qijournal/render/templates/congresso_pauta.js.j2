        h('a', { cls: 'cg-mt cg-pa-c-t', href: '#m=' + chaveDaMateria(casa, p.t), 'data-m': chaveDaMateria(casa, p.t), text: p.t }),
        m && m.ap ? h('span', { cls: 'cg-apel', text: m.ap }) : null,
