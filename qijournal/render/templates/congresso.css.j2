{#- Aba Congresso (só esta página inclui este arquivo; a estrutura az-… vem de analitico.css.j2).
    A cor diz uma coisa só: de que lado o voto cai. Verde-azulado × âmbar = com a esquerda ×
    com a direita, o mesmo par do termômetro, em cinco degraus com o cinza no meio, e nunca
    vai sozinha: o saldo (com sinal) ou a posição na régua (esquerda × direita) a acompanha.
    Verde × vermelho só marca aprovada × rejeitada, sempre com a palavra ao lado. -#}
:root{--cg-esp:#3B5BDB;--cg-e3:#0B5F6B;--cg-e2:#7FBCC4;--cg-c0:#AEB6C2;--cg-d2:#E2A66E;--cg-d3:#8F4A0E;--cg-na:#E4E7EC;
  --cg-on3:#fff;--cg-on2:#1a2332;--cg-ok:#197B5B;--cg-no:#B3260E;--cg-trk:rgba(var(--qi-rgb),.1)}
:root[data-theme="dark"]{--cg-esp:#6A82E6;--cg-e3:#86D3DC;--cg-e2:#327E88;--cg-c0:#4A576B;--cg-d2:#9A6536;--cg-d3:#F2B577;--cg-na:#1f2937;
  --cg-on3:#0b0f17;--cg-on2:#e8edf7;--cg-ok:#4DA684;--cg-no:#EB5E45;--cg-trk:rgba(143,176,245,.14)}
.cg-e3{background:var(--cg-e3)}.cg-e2{background:var(--cg-e2)}.cg-m{background:var(--cg-c0)}.cg-d2{background:var(--cg-d2)}.cg-d3{background:var(--cg-d3)}.cg-na{background:var(--cg-na)}
.cg [id]{scroll-margin-top:104px}
.cg-mo [id]{scroll-margin-top:0}
.cg small{font-family:var(--mn);font-size:10px;font-weight:400;color:var(--faint)}

/* Nomes que abrem o dossiê */
.cg-p{color:var(--link);font-weight:600;cursor:pointer}
.cg-p:hover{text-decoration:underline}
.cg-abrir{margin-left:4px;font-family:var(--ss);font-size:11.5px;white-space:nowrap}
.cg-achar{margin-top:22px}
.cg-achar label{display:block;margin-bottom:8px}
.cg-achar .az-fil-in{width:100%}

/* Uma Casa por vez (com script); sem script, as duas, uma depois da outra */
.cg-casas{position:sticky;top:41px;z-index:39;display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:26px calc(-1*var(--gut)) 0;padding:9px var(--gut);border-bottom:1px solid var(--rl);background:var(--paper)}
.cg-casa-b{padding:5px 14px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--ss);font-size:12.5px;font-weight:700;color:var(--mute2);cursor:pointer}
.cg-casa-b span{margin-left:4px;font-family:var(--mn);font-size:10.5px;font-weight:500}
.cg-casa-b[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.cg-casas-n{font-family:var(--ss);font-size:11.5px;color:var(--faint)}
.cg[data-ver="cd"] .cg-c[data-casa="sf"],.cg[data-ver="sf"] .cg-c[data-casa="cd"],
.cg[data-ver="cd"] .cg-todos tr[data-casa="sf"],.cg[data-ver="sf"] .cg-todos tr[data-casa="cd"]{display:none}
.cg-c+.cg-c{margin-top:40px}
.cg[data-ver] .cg-c+.cg-c{margin-top:0}
.cg-ct{margin-top:26px;font-family:var(--ss);font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--ink)}
.cg-ct span{display:block;margin-top:5px;font-size:12.5px;font-weight:400;letter-spacing:0;text-transform:none;line-height:1.55;color:var(--muted)}

/* Régua e legenda do saldo */
.cg-leg{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:10px;font-family:var(--ss);font-size:11px;color:var(--muted)}
.cg-leg span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}
.cg-leg i{width:11px;height:11px;border-radius:2px}
.cg-regua{display:flex;justify-content:space-between;margin:0 0 4px 132px;font-family:var(--mn);font-size:10px;color:var(--faint)}
.cg-regua span{display:flex;flex-direction:column;align-items:center}
.cg-regua span:first-child{align-items:flex-start}.cg-regua span:last-child{align-items:flex-end}
.cg-regua i{font-family:var(--ss);font-style:normal;font-size:10px}

/* Onde cada um está: uma faixa por partido, um ponto por parlamentar */
.cg-fx{max-width:1180px;margin-top:14px}
.cg-fx-l{display:grid;grid-template-columns:120px minmax(0,1fr);gap:0 12px;align-items:center;padding:5px 0;border-top:1px solid var(--rl)}
.cg-fx-n{font-family:var(--ss);font-size:12.5px;line-height:1.2;color:var(--ink)}
.cg-fx-n span{display:block;font-family:var(--mn);font-size:10px;color:var(--faint)}
.cg-fx-p{position:relative;min-height:16px;border-left:1px solid var(--rule);border-right:1px solid var(--rule);background:linear-gradient(var(--rule),var(--rule)) 50% 0/1px 100% no-repeat}
.cg-pt{position:absolute;width:7px;height:7px;margin:4px 0 0 -3.5px;border-radius:50%;box-shadow:0 0 0 1px var(--paper)}
.cg-pt:hover,.cg-pt:focus-visible{z-index:2;outline:2px solid var(--link);outline-offset:1px}

/* Partido × tema */
.cg-mx td{color:var(--cg-on2)}
.cg-mx td.cg-e3,.cg-mx td.cg-d3{color:var(--cg-on3)}
.cg-mx td.cg-na{color:var(--faint)}
.cg-mx th small{display:inline-block}
.cg-mx thead th{font-size:11px}
.cg-mx .cg-mx-g{font-weight:700;box-shadow:inset -3px 0 0 var(--paper)}
.az-mx.cg-mx .az-mx-v,.az-mx.cg-mx tbody th{width:164px}

/* Barra do saldo: parte do centro para o lado do sinal */
.cg-bar{position:relative;display:inline-block;width:132px;height:9px;vertical-align:middle;border-radius:2px;background:linear-gradient(var(--ink),var(--ink)) 50% 0/1px 100% no-repeat var(--cg-trk)}
.cg-bar i{position:absolute;top:0;bottom:0;border-radius:2px}
.cg-tb th small{display:block;font-weight:400}
.cg-tb tbody th{white-space:normal}

/* A fila */
.cg-fl{list-style:none;max-width:980px;margin-top:10px}
.cg-fl li{padding:11px 0;border-bottom:1px solid var(--rl)}
.cg-fl-n{font-family:var(--sf);font-size:15.5px;line-height:1.35;color:var(--ink)}
.cg-fl-n b{font-family:var(--mn);font-size:17px;font-weight:600}
.cg-fl-n span{margin-left:8px;font-family:var(--ss);font-size:11.5px;color:var(--muted)}
.cg-fl-b{display:block;height:8px;margin:6px 0 5px;border-radius:2px;background:var(--cg-trk)}
.cg-fl-b i{display:block;height:100%;min-width:2px;border-radius:2px;background:var(--qi)}
:root[data-theme="dark"] .cg-fl-b i{background:var(--link)}
.cg-fl-x{font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--muted)}
.cg-fl-x b{color:var(--ink)}
.cg-ls{list-style:none;margin-top:6px}
.cg-ls li{padding:10px 0;border-bottom:1px solid var(--rl)}
.cg-ls-k{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;font-family:var(--ss);font-size:13px;color:var(--ink)}
.cg-ls-k a{color:var(--link)}
.cg-ls-k a:hover{text-decoration:underline}
.cg-ls-k span{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-ls-x{margin-top:3px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-ls-x i{color:var(--muted)}

/* O Plenário */
.cg-vs{list-style:none;max-width:1100px;margin-top:8px}
.cg-v{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:6px 28px;padding:16px 0;border-bottom:1px solid var(--rl)}
.cg-v-k{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-res{padding:0 6px;border-radius:3px;font-weight:600;line-height:1.7;color:#fff}
.cg-res-ok{background:var(--cg-ok)}.cg-res-no{background:var(--cg-no)}
:root[data-theme="dark"] .cg-res{color:#0b0f17}
.cg-div{padding:0 6px;border:1px solid var(--rule);border-radius:3px;line-height:1.6}
.cg-v-t{margin-top:6px;font-family:var(--sf);font-size:16px;font-weight:400;line-height:1.4;color:var(--ink)}
.cg-v-t b{font-weight:700}
.cg-v-e{margin-top:4px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--muted)}
.cg-v-n{font-family:var(--ss);font-size:13px;color:var(--ink)}
.cg-v-n b{font-family:var(--mn);font-size:20px;font-weight:600}
.cg-v-o{margin-top:5px;font-family:var(--ss);font-size:11.5px;line-height:1.6;color:var(--muted)}
.cg-v-o b{color:var(--ink)}
.cg-v-b,.cg-v-d{grid-column:1/-1}
.cg-v-b{display:flex;flex-wrap:wrap;gap:4px}
.cg-pb{padding:1px 6px;border:1px solid var(--rule);border-radius:3px;font-family:var(--mn);font-size:10.5px;color:var(--muted);white-space:nowrap}
.cg-pb b{color:var(--ink)}
.cg-pb i{font-style:normal;color:var(--faint)}
.cg-pb-n{background:var(--soft)}
.cg-v-d summary{cursor:pointer;font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.cg-v-d ul{list-style:none;margin-top:6px;font-family:var(--ss);font-size:12.5px;line-height:1.7;color:var(--body)}

/* Listas e a tabela de todos */
.cg-lts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px 40px;margin-top:6px}
.cg-lt-d{margin-top:5px;font-family:var(--ss);font-size:11.5px;line-height:1.5;color:var(--muted)}
.cg-lt ol{list-style:none;counter-reset:cgl;margin-top:6px}
.cg-lt li{counter-increment:cgl;display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:12.5px}
.cg-lt li::before{content:counter(cgl);flex:none;width:16px;font-family:var(--mn);font-size:10px;color:var(--faint)}
.cg-lt-n{flex:1;min-width:0}
.cg-lt-v{flex:none;max-width:55%;text-align:right;font-family:var(--mn);font-size:12px;color:var(--ink)}
.cg-lt-v small{display:block;white-space:normal}
.cg-fil{margin-top:12px}
.cg-todos th[data-ord]{cursor:pointer;user-select:none}
.cg-todos th[data-ord]:hover{color:var(--link)}
.cg-todos th[aria-sort]::after{content:" ↓";font-family:var(--mn)}
.cg-todos th[aria-sort="ascending"]::after{content:" ↑"}
.cg-todos tr.cg-fora th,.cg-todos tr.cg-fora td{opacity:.62}

/* O dossiê */
.cg-mo{position:fixed;inset:0;z-index:9000;overflow-y:auto;background:rgba(10,14,22,.62)}
.cg-mo[hidden]{display:none}
.cg-ml{position:relative;width:min(1040px,100%);min-height:100%;margin:0 auto;padding:30px var(--gut) 60px;background:var(--paper);outline:none}
.cg-mc{position:sticky;top:10px;float:right;z-index:3;width:38px;height:38px;border:1.5px solid var(--rule);border-radius:50%;background:var(--paper);font-size:22px;line-height:1;color:var(--ink);cursor:pointer}
.cg-mc:hover{border-color:var(--ink)}
.cg-d-h{display:flex;gap:20px;align-items:flex-start}
.cg-d-f{flex:none;width:92px;height:118px;border-radius:4px;background:var(--hl) center/cover no-repeat;overflow:hidden}
.cg-d-f img{width:100%;height:100%;object-fit:cover}
.cg-d-f.img-fail img{display:none}
.cg-d-k{font-family:var(--ss);font-size:10.5px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--link)}
.cg-d-t{margin-top:6px;font-family:var(--sf);font-size:clamp(26px,calc(14px + 1.4vw),40px);font-weight:700;line-height:1.1;color:var(--head)}
.cg-d-s{margin-top:6px;font-family:var(--ss);font-size:13px;color:var(--muted)}
.cg-d-s a{color:var(--link);font-weight:600}
.cg-d-s a:hover{text-decoration:underline}
.cg-d-fr{list-style:none;margin-top:18px;padding:14px 18px;border-left:3px solid var(--qc);background:var(--soft)}
.cg-d-fr li{position:relative;padding-left:16px;font-family:var(--sf);font-size:16px;line-height:1.55;color:var(--ink)}
.cg-d-fr li+li{margin-top:6px}
.cg-d-fr li::before{content:"";position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--qc)}
.cg-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin-top:22px;border:1px solid var(--az-fr)}
.cg-tile{min-width:0;padding:13px 16px 14px;border-left:1px solid var(--rl)}
.cg-tile:first-child{border-left:0}
.cg-tile-k{font-family:var(--ss);font-size:10px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted)}
.cg-tile-v{margin-top:6px;font-family:var(--mn);font-size:26px;font-weight:600;line-height:1.1;color:var(--ink)}
.cg-tile-v small{margin-left:6px;font-size:11px}
.cg-tile-x{margin-top:6px;font-family:var(--ss);font-size:11.5px;line-height:1.5;color:var(--muted)}
.cg-tile .cg-bar{width:100%;margin-top:8px}
.cg-d-sec{margin-top:30px}
.cg-d-sec>h3{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;padding-bottom:6px;border-bottom:2px solid var(--ink);font-family:var(--sf);font-size:18px;font-weight:700;color:var(--ink)}
.cg-d-sec>h3 span{font-family:var(--ss);font-size:12px;font-weight:400;color:var(--muted)}
.cg-d-n{margin-top:8px;font-family:var(--ss);font-size:12.5px;line-height:1.6;color:var(--muted)}
.cg-d-2c{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px}
.cg-ms{list-style:none}
.cg-ms li{padding:10px 0;border-bottom:1px solid var(--rl)}
.cg-ms-k{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-ms-v{padding:0 6px;border-radius:3px;background:var(--ink);font-weight:600;line-height:1.7;color:var(--paper)}
.cg-ms-t{margin-top:4px;font-family:var(--ss);font-size:13px;line-height:1.45;color:var(--ink)}
.cg-ms-t b{font-weight:700}
.cg-ms-e{margin-top:2px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--muted)}
.cg-sm{display:flex;align-items:flex-end;gap:3px;height:74px;margin-top:12px;border-bottom:1px solid var(--rule)}
.cg-sm span{position:relative;flex:1;min-width:0;border-radius:2px 2px 0 0;background:var(--qi)}
:root[data-theme="dark"] .cg-sm span{background:var(--link)}
.cg-sm-x{display:flex;gap:3px;margin-top:3px;font-family:var(--mn);font-size:9px;color:var(--faint)}
.cg-sm-x span{flex:1;min-width:0;text-align:center;overflow:hidden;white-space:nowrap}
.cg-kv{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:10px;font-family:var(--ss);font-size:12.5px;color:var(--body)}
.cg-kv b{font-family:var(--mn);color:var(--ink)}
.cg-d-st{padding:40px 0;font-family:var(--ss);font-size:14px;color:var(--muted)}
.cg-d-back{margin-top:30px}
.cg-d-back button{padding:8px 16px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--ss);font-size:12.5px;font-weight:700;cursor:pointer}
body.cg-aberto{overflow:hidden}

@media (max-width:1023px){
  .az-2c{grid-template-columns:minmax(0,1fr)}
  .cg-lts{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cg-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cg-tile:nth-child(3){border-left:0}
  .cg-tile:nth-child(n+3){border-top:1px solid var(--rl)}
}
@media (max-width:720px){
  .cg-v{grid-template-columns:minmax(0,1fr)}
  .cg-lts,.cg-d-2c{grid-template-columns:minmax(0,1fr)}
  .cg-fx-l{grid-template-columns:78px minmax(0,1fr)}
  .cg-regua{margin-left:90px}
  .cg-regua i{display:none}
  .cg-d-h{gap:14px}
  .cg-d-f{width:68px;height:88px}
  .cg-casas{top:38px}
  .cg-bar{width:92px}
}

/* Onde cada polo racha */
.cg-rc{max-width:1100px;margin-top:18px;padding-top:12px;border-top:1px solid var(--rl)}
.cg-rc:first-of-type{border-top:0;padding-top:0}
.cg-rc-h{font-family:var(--ss);font-size:15px;line-height:1.5;color:var(--ink)}
.cg-rc-s{display:inline-block;padding:1px 7px;border-radius:3px;font-family:var(--mn);font-size:12px;color:var(--cg-on3)}
.cg-rc-t{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.cg-chip{display:inline-flex;gap:5px;align-items:baseline;padding:2px 8px;border:1px solid var(--rl);border-radius:999px;font-family:var(--ss);font-size:12px;color:var(--body)}
.cg-chip b{font-family:var(--mn);font-weight:600;color:var(--ink)}
.cg-rc-l{list-style:none;margin-top:10px}
.cg-rc-l li{padding:9px 0;border-top:1px dotted var(--rl)}
.cg-rc-l li:first-child{border-top:0}
.cg-rc-k{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-rc-e{margin-top:3px;font-family:var(--ss);font-size:13.5px;line-height:1.5;color:var(--body)}
.cg-rc-e b{color:var(--ink)}
.cg-rc-v{margin-top:3px;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-rc-v b{color:var(--ink)}
.cg-div-r{background:transparent;border:1px dashed var(--muted)}

/* Divergência por assunto, no dossiê */
.cg-ms-tm{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
.cg-ms-tm .cg-chip{font-size:11px;padding:1px 7px}
.cg-vira th{font-weight:700}
.cg-vira-s{display:inline-block;margin-left:8px;padding:0 6px;border:1px dashed var(--muted);border-radius:3px;font-family:var(--mn);font-size:10px;font-weight:400;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}

/* O que espera × o que passa: azul vazio = esperando; verde cheio = aprovada (o verde de "aprovada" da página).
   Paleta validada (validate_palette.js) no claro (#fff) e no escuro (#111827); a forma (vazio × cheio) repete a cor. */
.cg-gr{position:relative;margin-top:10px}
.cg-gr-w{overflow-x:auto}
.cg-gr svg{display:block;width:100%;max-width:980px;min-width:600px;height:auto}
.cg-gr-faixa{fill:var(--rl);opacity:.45}
.cg-gr-grade{stroke:var(--rl);stroke-width:1}
.cg-gr-guia{stroke:var(--rule);stroke-width:1}
.cg-gr-ty{fill:var(--muted);font-family:var(--mn);font-size:11px;text-anchor:end}
.cg-gr-tx{fill:var(--muted);font-family:var(--mn);font-size:11px;text-anchor:middle}
.cg-gr-tx-fim{text-anchor:end}
.cg-gr-tg{fill:var(--muted);font-family:var(--mn);font-size:10px;text-anchor:end}
.cg-gr-fx{fill:var(--muted);font-family:var(--ss);font-size:11px}
.cg-gr-ex{fill:var(--muted);font-family:var(--ss);font-size:11px;text-anchor:middle}
.cg-gr-e{fill:var(--paper);fill-opacity:.01;stroke:var(--cg-esp);stroke-width:1.5;stroke-opacity:.8}
.cg-gr-a{fill:var(--cg-ok);fill-opacity:.9;stroke:var(--paper);stroke-width:1.5}
.cg-gr circle.on{stroke:var(--ink);stroke-width:2.5;stroke-opacity:1}
.cg-gr-dica{position:absolute;z-index:3;max-width:280px;padding:7px 10px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);box-shadow:0 4px 14px rgba(0,0,0,.12);font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body);pointer-events:none}
.cg-gr-dica b{display:block;font-family:var(--mn);font-size:14px;color:var(--ink)}
.cg-gr-leg{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:8px;font-family:var(--ss);font-size:12px;color:var(--muted)}
.cg-gr-leg span{display:inline-flex;align-items:center;gap:6px}
.cg-gr-le,.cg-gr-la{display:inline-block;width:10px;height:10px;border-radius:50%}
.cg-gr-le{border:1.5px solid var(--cg-esp)}
.cg-gr-la{background:var(--cg-ok)}
.cg-rv-h{margin-top:16px;font-family:var(--sf);font-size:16px;color:var(--ink)}
.cg-rv-h span{display:block;margin-top:2px;font-family:var(--ss);font-size:12.5px;font-weight:400;color:var(--muted)}
.cg-rv-n{font-family:var(--mn);font-weight:700;color:var(--ink)}
.cg-rv-s{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}
.cg-rv-s .cg-chip{font-size:11.5px}
.cg-rv-q{margin-top:4px;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-rv-c{margin-top:4px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-rv-tb{margin-top:14px}
.cg-rv-tb summary{cursor:pointer;font-family:var(--ss);font-size:13px;color:var(--link)}
.cg-rv-tb .an-tbl-wrap{max-height:420px;overflow:auto;margin-top:8px}

/* Rankings no dossiê */
.cg-tile-r{margin-top:2px;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-rk td{font-family:var(--mn)}

/* Onde cada um está, por tema */
.cg-fx-f{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin:10px 0 4px}
.cg-fx-f .az-lbl{margin:0}
.cg-fx-s{max-width:100%;padding:6px 10px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:13px}
.cg-fx-st{flex-basis:100%;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-pt-vira{box-shadow:0 0 0 1.5px var(--paper),0 0 0 3px var(--ink)}
.cg-pt[hidden]{display:none}

/* Comparativo */
.cg-cp-th,.cg-cp-td{width:30px;padding-left:4px !important;padding-right:4px !important;text-align:center}
.cg-cp-ck{width:16px;height:16px;cursor:pointer;accent-color:var(--link)}
.cg-cp-bar{position:fixed;left:50%;bottom:16px;z-index:40;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;max-width:calc(100% - 32px);padding:10px 14px;border:1px solid var(--rule);border-radius:10px;background:var(--paper);box-shadow:0 8px 24px rgba(0,0,0,.18);transform:translateX(-50%);font-family:var(--ss);font-size:13.5px;color:var(--body)}
.cg-cp-bar b{color:var(--ink)}
.cg-cp-sel span{color:var(--ink);font-weight:600}
.cg-cp-ir,.cg-cp-x{padding:7px 12px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:13px;cursor:pointer}
.cg-cp-ir{border-color:var(--link);background:var(--link);color:#fff;font-weight:600}
.cg-cp-ir:disabled{opacity:.45;cursor:not-allowed}
.cg-cp-add{padding:0;border:0;background:none;color:var(--link);font:inherit;font-weight:600;cursor:pointer;text-decoration:underline;text-underline-offset:2px}
.cg-cp-add:disabled{color:var(--muted);text-decoration:none;cursor:default;font-weight:400}
.cg-cp-k{margin-bottom:6px}
.cg-cp-h{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 28px;padding-bottom:14px;border-bottom:1px solid var(--rl)}
.cg-cp-n{font-family:var(--sf);font-size:26px;line-height:1.15;color:var(--ink)}
.cg-cp-n a{color:inherit;text-decoration:none}
.cg-cp-n a:hover{text-decoration:underline}
.cg-cp-b{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;margin-top:8px;font-family:var(--mn);font-size:12px;color:var(--ink)}
.cg-cp-b span{white-space:nowrap}
.cg-cp-b .cg-bar{width:140px}
.cg-cp-f{margin-top:8px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
.cg-cp-t{table-layout:fixed}
.cg-cp-t thead th:first-child{width:30%}
.cg-cp-t th,.cg-cp-t td{white-space:normal;overflow-wrap:break-word}
.cg-cp-t th[scope="row"]{min-width:0}
.cg-cp-c{text-align:left !important}
.cg-cp-c b{display:block;font-family:var(--mn);color:var(--ink)}
.cg-cp-c small{display:block;margin-top:1px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-cp-c .cg-bar{display:block;width:120px;margin-bottom:3px}
.cg-cp-j{font-family:var(--ss);font-size:15px;line-height:1.5;color:var(--body)}
.cg-cp-j b{font-family:var(--mn);font-size:22px;color:var(--ink);margin-right:4px}
.cg-cp-l{font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-cp-v{margin-top:3px;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-cp-v b{color:var(--ink)}
.cg-cmpf{margin:14px 0 6px;padding:12px 14px;border:1px solid var(--rule);border-radius:10px;background:var(--paper)}
.cg-cmpf-k{font-family:var(--ss);font-size:13.5px;line-height:1.45;color:var(--muted)}
.cg-cmpf-k b{margin-right:6px;color:var(--ink)}
.cg-cmpf-c{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:9px}
.cg-cmpf-c .az-fil-in{flex:1 1 220px;min-width:0}
.cg-cmpf-x{font-family:var(--ss);color:var(--muted)}
.cg-cmpf-st,.cg-cp-st{font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-cmpf-st{margin-top:6px}
.cg-cmpf-st:empty{display:none}
.cg-cp-tr,.cg-cp-com{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;margin-top:10px;font-family:var(--ss);font-size:13px;color:var(--muted)}
.cg-cp-tr .az-fil-in,.cg-cp-com .az-fil-in{flex:1 1 170px;max-width:280px;min-width:0;padding:6px 10px;font-size:13px}
.cg-cp-trb{padding:6px 11px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:12.5px;font-weight:600;cursor:pointer}
.cg-cp-trb:hover{border-color:var(--link);color:var(--link)}
@media (max-width:640px){
  .cg-cp-h{gap:10px}
  .cg-cp-n{font-size:19px}
  .cg-cp-b .cg-bar,.cg-cp-c .cg-bar{width:84px}
  .cg-cp-t thead th:first-child{width:28%}
  .cg-cp-t th,.cg-cp-t td{padding-right:6px}
  .cg-cp-tr .az-fil-in,.cg-cp-com .az-fil-in{flex-basis:100%;max-width:none}
  .cg-cp-bar{bottom:10px;font-size:12.5px}
}

/* Apelidos e "no jornal × no voto" */
.cg-apel{display:inline-block;margin:0 6px;padding:0 7px;border-radius:999px;background:var(--rl);font-family:var(--ss);font-size:11.5px;font-weight:600;color:var(--ink)}
.cg-rv-jor{margin-left:8px;font-family:var(--mn);font-size:11px;color:var(--link)}
.cg-jv{list-style:none;max-width:1100px;margin-top:8px}
.cg-jv li{padding:11px 0;border-top:1px solid var(--rl)}
.cg-jv li:first-child{border-top:0}
.cg-jv-k{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;font-family:var(--ss);font-size:13px;color:var(--muted)}
.cg-jv-k span,.cg-jv-k time{font-family:var(--mn);font-size:11px}
.cg-jv-t{margin-top:3px;font-family:var(--sf);font-size:17px;line-height:1.35;color:var(--ink)}
.cg-jv-t a{color:inherit}
.cg-jv-v{margin-top:4px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
.cg-jv-v b{color:var(--ink)}

/* O atributo hidden vale mesmo onde o CSS dá display ao elemento */
.cg-cp-bar[hidden],.cg-fx-f[hidden],.cg-fx-l[hidden],.cg-casas[hidden],.cg-achar[hidden],.cg-cmpf[hidden]{display:none}
