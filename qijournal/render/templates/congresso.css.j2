{#- Aba Congresso (só esta página inclui este arquivo; a estrutura az-… vem de analitico.css.j2).
    A cor diz uma coisa só: de que lado o voto cai. Verde-azulado × âmbar = com a esquerda ×
    com a direita, o mesmo par do termômetro, em cinco degraus com o cinza no meio, e nunca
    vai sozinha: o saldo (com sinal) ou a posição na régua (esquerda × direita) a acompanha.
    Verde × vermelho só marca aprovada × rejeitada, sempre com a palavra ao lado. -#}
:root{--cg-esp:#3B5BDB;--cg-e3:#0B5F6B;--cg-e2:#7FBCC4;--cg-c0:#AEB6C2;--cg-d2:#E2A66E;--cg-d3:#8F4A0E;--cg-na:#E4E7EC;
  --cg-on3:#fff;--cg-on2:#1a2332;--cg-ok:#197B5B;--cg-no:#B3260E;--cg-trk:rgba(var(--qi-rgb),.1)}
:root[data-theme="dark"]{--cg-esp:#6A82E6;--cg-e3:#86D3DC;--cg-e2:#327E88;--cg-c0:#4A576B;--cg-d2:#9A6536;--cg-d3:#F2B577;--cg-na:#1f2937;
  --cg-on3:#0b0f17;--cg-on2:#e8edf7;--cg-ok:#4DA684;--cg-no:#EB5E45;--cg-trk:rgba(143,176,245,.14)}
.cg-e3{background:var(--cg-e3)}.cg-e2{background:var(--cg-e2)}.cg-m{background:var(--cg-c0)}.cg-d2{background:var(--cg-d2)}.cg-d3{background:var(--cg-d3)}.cg-na{background:var(--cg-na)}
.cg [id]{scroll-margin-top:104px}
.cg-mo [id]{scroll-margin-top:0}
.cg small{font-family:var(--mn);font-size:10px;font-weight:400;color:var(--faint)}

/* Nomes que abrem o dossiê */
.cg-p{color:var(--link);font-weight:600;cursor:pointer}
.cg-p:hover{text-decoration:underline}
.cg-abrir{margin-left:4px;font-family:var(--ss);font-size:11.5px;white-space:nowrap}
.cg-achar{margin-top:22px}
.cg-achar label{display:block;margin-bottom:8px}
.cg-achar .az-fil-in{width:100%}

/* A barra fixa: a Casa e, logo abaixo, as vistas dela. Com script, uma Casa e uma vista por
   vez; sem script, tudo em sequência. */
.cg-barra{position:sticky;top:0;z-index:40;margin:8px calc(-1*var(--gut)) 0;padding:0 var(--gut);border-bottom:1px solid var(--rl);background:var(--paper)}
.cg-casas{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:9px 0 3px}
.cg-vistas ul{list-style:none;display:flex;gap:0 22px;padding:4px 0 0;overflow-x:auto;scrollbar-width:none}
.cg-vistas ul::-webkit-scrollbar{display:none}
/* Fora do celular, as abas quebram a linha em vez de rolar: todas ficam à vista. */
@media (min-width:761px){.cg-vistas ul{flex-wrap:wrap;gap:0 20px;overflow-x:visible}}
.cg-vistas a{display:block;padding:5px 0 9px;font-family:var(--ss);font-size:13px;font-weight:600;color:var(--mute2);white-space:nowrap;box-shadow:inset 0 -2px 0 transparent;transition:color .2s,box-shadow .2s}
.cg-vistas a:hover,.cg-vistas a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--qc)}
.cg-abas .cg-vista{display:none}
.cg-abas .cg-vista.on{display:block}
.cg-abas .cg-vista.on>.az-lh:first-child,.cg-abas .az-sec.cg-vista.on{margin-top:0}
.cg-abas .az-sec.cg-vista.on{padding-top:26px;border-top:0}
.cg-vs-h{margin-top:30px}
.cg-casa-b{padding:5px 14px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--ss);font-size:12.5px;font-weight:700;color:var(--mute2);cursor:pointer}
.cg-casa-b span{margin-left:4px;font-family:var(--mn);font-size:10.5px;font-weight:500}
.cg-casa-b[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.cg-casas-n{font-family:var(--ss);font-size:11.5px;color:var(--faint)}
.cg[data-ver="cd"] .cg-c[data-casa="sf"],.cg[data-ver="sf"] .cg-c[data-casa="cd"],
.cg[data-ver="cd"] .cg-todos tr[data-casa="sf"],.cg[data-ver="sf"] .cg-todos tr[data-casa="cd"]{display:none}
.cg-c+.cg-c{margin-top:40px}
.cg[data-ver] .cg-c+.cg-c{margin-top:0}
.cg-ct{margin-top:26px;font-family:var(--ss);font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--ink)}
.cg-ct span{display:block;margin-top:5px;font-size:12.5px;font-weight:400;letter-spacing:0;text-transform:none;line-height:1.55;color:var(--muted)}

/* Régua e legenda do saldo */
.cg-leg{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:10px;font-family:var(--ss);font-size:11px;color:var(--muted)}
.cg-leg span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}
.cg-leg i{width:11px;height:11px;border-radius:2px}
.cg-regua{display:flex;justify-content:space-between;margin:0 0 4px 132px;font-family:var(--mn);font-size:10px;color:var(--faint)}
.cg-regua span{display:flex;flex-direction:column;align-items:center}
.cg-regua span:first-child{align-items:flex-start}.cg-regua span:last-child{align-items:flex-end}
.cg-regua i{font-family:var(--ss);font-style:normal;font-size:10px}

/* Onde cada um está: uma faixa por partido, um ponto por parlamentar */
.cg-fx{max-width:1180px;margin-top:14px}
.cg-fx-l{display:grid;grid-template-columns:120px minmax(0,1fr);gap:0 12px;align-items:center;padding:5px 0;border-top:1px solid var(--rl)}
.cg-fx-n{font-family:var(--ss);font-size:12.5px;line-height:1.2;color:var(--ink)}
.cg-fx-n span{display:block;font-family:var(--mn);font-size:10px;color:var(--faint)}
.cg-fx-p{position:relative;min-height:16px;border-left:1px solid var(--rule);border-right:1px solid var(--rule);background:linear-gradient(var(--rule),var(--rule)) 50% 0/1px 100% no-repeat}
.cg-pt{position:absolute;width:7px;height:7px;margin:4px 0 0 -3.5px;border-radius:50%;box-shadow:0 0 0 1px var(--paper)}
.cg-pt:hover,.cg-pt:focus-visible{z-index:2;outline:2px solid var(--link);outline-offset:1px}

/* Partido × tema */
.cg-mx td{color:var(--cg-on2)}
.cg-mx td.cg-e3,.cg-mx td.cg-d3{color:var(--cg-on3)}
.cg-mx td.cg-na{color:var(--faint)}
.cg-mx th small{display:inline-block}
.cg-mx thead th{font-size:11px}
.cg-mx .cg-mx-g{font-weight:700;box-shadow:inset -3px 0 0 var(--paper)}
.az-mx.cg-mx .az-mx-v,.az-mx.cg-mx tbody th{width:164px}

/* Barra do saldo: parte do centro para o lado do sinal */
.cg-bar{position:relative;display:inline-block;width:132px;height:9px;vertical-align:middle;border-radius:2px;background:linear-gradient(var(--ink),var(--ink)) 50% 0/1px 100% no-repeat var(--cg-trk)}
.cg-bar i{position:absolute;top:0;bottom:0;border-radius:2px}
.cg-tb th small{display:block;font-weight:400}
.cg-tb tbody th{white-space:normal}

/* A fila */
.cg-fl{list-style:none;max-width:980px;margin-top:10px}
.cg-fl li{padding:11px 0;border-bottom:1px solid var(--rl)}
.cg-fl-n{font-family:var(--sf);font-size:15.5px;line-height:1.35;color:var(--ink)}
.cg-fl-n b{font-family:var(--mn);font-size:17px;font-weight:600}
.cg-fl-n span{margin-left:8px;font-family:var(--ss);font-size:11.5px;color:var(--muted)}
.cg-fl-b{display:block;height:8px;margin:6px 0 5px;border-radius:2px;background:var(--cg-trk)}
.cg-fl-b i{display:block;height:100%;min-width:2px;border-radius:2px;background:var(--qi)}
:root[data-theme="dark"] .cg-fl-b i{background:var(--link)}
.cg-fl-x{font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--muted)}
.cg-fl-x b{color:var(--ink)}
.cg-ls{list-style:none;margin-top:6px}
.cg-ls li{padding:10px 0;border-bottom:1px solid var(--rl)}
.cg-ls-k{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;font-family:var(--ss);font-size:13px;color:var(--ink)}
.cg-ls-k a{color:var(--link)}
.cg-ls-k a:hover{text-decoration:underline}
.cg-ls-k span{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-ls-x{margin-top:3px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-ls-x i{color:var(--muted)}

/* O Plenário */
.cg-vs{list-style:none;max-width:1100px;margin-top:8px}
.cg-v{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:6px 28px;padding:16px 0;border-bottom:1px solid var(--rl)}
.cg-v-k{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-res{padding:0 6px;border-radius:3px;font-weight:600;line-height:1.7;color:#fff}
.cg-res-ok{background:var(--cg-ok)}.cg-res-no{background:var(--cg-no)}
:root[data-theme="dark"] .cg-res{color:#0b0f17}
.cg-div{padding:0 6px;border:1px solid var(--rule);border-radius:3px;line-height:1.6}
.cg-v-t{margin-top:6px;font-family:var(--sf);font-size:16px;font-weight:400;line-height:1.4;color:var(--ink)}
.cg-v-t b{font-weight:700}
.cg-v-e{margin-top:4px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--muted)}
.cg-v-n{font-family:var(--ss);font-size:13px;color:var(--ink)}
.cg-v-n b{font-family:var(--mn);font-size:20px;font-weight:600}
.cg-v-o{margin-top:5px;font-family:var(--ss);font-size:11.5px;line-height:1.6;color:var(--muted)}
.cg-v-o b{color:var(--ink)}
.cg-v-b,.cg-v-d{grid-column:1/-1}
.cg-v-b{display:flex;flex-wrap:wrap;gap:4px}
.cg-pb{padding:1px 6px;border:1px solid var(--rule);border-radius:3px;font-family:var(--mn);font-size:10.5px;color:var(--muted);white-space:nowrap}
.cg-pb b{color:var(--ink)}
.cg-pb i{font-style:normal;color:var(--faint)}
.cg-pb-n{background:var(--soft)}
.cg-v-d summary{cursor:pointer;font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.cg-v-d ul{list-style:none;margin-top:6px;font-family:var(--ss);font-size:12.5px;line-height:1.7;color:var(--body)}

/* Listas e a tabela de todos */
.cg-lts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px 40px;margin-top:6px}
.cg-lt-d{margin-top:5px;font-family:var(--ss);font-size:11.5px;line-height:1.5;color:var(--muted)}
.cg-lt ol{list-style:none;counter-reset:cgl;margin-top:6px}
.cg-lt li{counter-increment:cgl;display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:12.5px}
.cg-lt li::before{content:counter(cgl);flex:none;width:16px;font-family:var(--mn);font-size:10px;color:var(--faint)}
.cg-lt-n{flex:1;min-width:0}
.cg-lt-v{flex:none;max-width:55%;text-align:right;font-family:var(--mn);font-size:12px;color:var(--ink)}
.cg-lt-v small{display:block;white-space:normal}
.cg-fil{margin-top:12px}
.cg-todos th[data-ord]{cursor:pointer;user-select:none}
.cg-todos th[data-ord]:hover{color:var(--link)}
.cg-todos th[aria-sort]::after{content:" ↓";font-family:var(--mn)}
.cg-todos th[aria-sort="ascending"]::after{content:" ↑"}
.cg-todos tr.cg-fora th,.cg-todos tr.cg-fora td{opacity:.62}

/* O dossiê */
.cg-mo{position:fixed;inset:0;z-index:9000;overflow-y:auto;background:rgba(10,14,22,.62)}
.cg-mo[hidden]{display:none}
.cg-ml{position:relative;width:min(1040px,100%);min-height:100%;margin:0 auto;padding:30px var(--gut) 60px;background:var(--paper);outline:none}
.cg-mc{position:sticky;top:10px;float:right;z-index:3;width:38px;height:38px;border:1.5px solid var(--rule);border-radius:50%;background:var(--paper);font-size:22px;line-height:1;color:var(--ink);cursor:pointer}
.cg-mc:hover{border-color:var(--ink)}
.cg-d-h{display:flex;gap:20px;align-items:flex-start}
.cg-d-f{flex:none;width:92px;height:118px;border-radius:4px;background:var(--hl) center/cover no-repeat;overflow:hidden}
.cg-d-f img{width:100%;height:100%;object-fit:cover}
.cg-d-f.img-fail img{display:none}
.cg-d-k{font-family:var(--ss);font-size:10.5px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--link)}
.cg-d-t{margin-top:6px;font-family:var(--sf);font-size:clamp(26px,calc(14px + 1.4vw),40px);font-weight:700;line-height:1.1;color:var(--head)}
.cg-d-s{margin-top:6px;font-family:var(--ss);font-size:13px;color:var(--muted)}
.cg-d-s a{color:var(--link);font-weight:600}
.cg-d-s a:hover{text-decoration:underline}
.cg-d-fr{list-style:none;margin-top:18px;padding:14px 18px;border-left:3px solid var(--qc);background:var(--soft)}
.cg-d-fr li{position:relative;padding-left:16px;font-family:var(--sf);font-size:16px;line-height:1.55;color:var(--ink)}
.cg-d-fr li+li{margin-top:6px}
.cg-d-fr li::before{content:"";position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--qc)}
.cg-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin-top:22px;border:1px solid var(--az-fr)}
.cg-tile{min-width:0;padding:13px 16px 14px;border-left:1px solid var(--rl)}
.cg-tile:first-child{border-left:0}
.cg-tile-k{font-family:var(--ss);font-size:10px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted)}
.cg-tile-v{margin-top:6px;font-family:var(--mn);font-size:26px;font-weight:600;line-height:1.1;color:var(--ink)}
.cg-tile-v small{margin-left:6px;font-size:11px}
.cg-tile-x{margin-top:6px;font-family:var(--ss);font-size:11.5px;line-height:1.5;color:var(--muted)}
.cg-tile .cg-bar{width:100%;margin-top:8px}
.cg-d-sec{margin-top:30px}
.cg-d-sec>h3{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;padding-bottom:6px;border-bottom:2px solid var(--ink);font-family:var(--sf);font-size:18px;font-weight:700;color:var(--ink)}
.cg-d-sec>h3 span{font-family:var(--ss);font-size:12px;font-weight:400;color:var(--muted)}
.cg-d-n{margin-top:8px;font-family:var(--ss);font-size:12.5px;line-height:1.6;color:var(--muted)}
.cg-d-2c{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px}
.cg-ms{list-style:none}
.cg-ms li{padding:10px 0;border-bottom:1px solid var(--rl)}
.cg-ms-k{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-ms-v{padding:0 6px;border-radius:3px;background:var(--ink);font-weight:600;line-height:1.7;color:var(--paper)}
.cg-ms-t{margin-top:4px;font-family:var(--ss);font-size:13px;line-height:1.45;color:var(--ink)}
.cg-ms-t b{font-weight:700}
.cg-ms-e{margin-top:2px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--muted)}
.cg-sm{display:flex;align-items:flex-end;gap:3px;height:74px;margin-top:12px;border-bottom:1px solid var(--rule)}
.cg-sm span{position:relative;flex:1;min-width:0;border-radius:2px 2px 0 0;background:var(--qi)}
:root[data-theme="dark"] .cg-sm span{background:var(--link)}
.cg-sm-x{display:flex;gap:3px;margin-top:3px;font-family:var(--mn);font-size:9px;color:var(--faint)}
.cg-sm-x span{flex:1;min-width:0;text-align:center;overflow:hidden;white-space:nowrap}
.cg-kv{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:10px;font-family:var(--ss);font-size:12.5px;color:var(--body)}
.cg-kv b{font-family:var(--mn);color:var(--ink)}
.cg-d-st{padding:40px 0;font-family:var(--ss);font-size:14px;color:var(--muted)}
.cg-d-back{margin-top:30px}
.cg-d-back button{padding:8px 16px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--ss);font-size:12.5px;font-weight:700;cursor:pointer}
body.cg-aberto{overflow:hidden}

@media (max-width:1023px){
  .az-2c{grid-template-columns:minmax(0,1fr)}
  .cg-lts{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cg-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cg-tile:nth-child(3){border-left:0}
  .cg-tile:nth-child(n+3){border-top:1px solid var(--rl)}
}
@media (max-width:720px){
  .cg-v{grid-template-columns:minmax(0,1fr)}
  .cg-lts,.cg-d-2c{grid-template-columns:minmax(0,1fr)}
  .cg-fx-l{grid-template-columns:78px minmax(0,1fr)}
  .cg-regua{margin-left:90px}
  .cg-regua i{display:none}
  .cg-d-h{gap:14px}
  .cg-d-f{width:68px;height:88px}
  .cg-barra{margin-left:-16px;margin-right:-16px;padding:0 16px}
  .cg-vistas ul{gap:0 18px}
  .cg-casas-n{display:none}
  .cg-bar{width:92px}
}

/* Onde cada polo racha */
.cg-rc{max-width:1100px;margin-top:18px;padding-top:12px;border-top:1px solid var(--rl)}
.cg-rc:first-of-type{border-top:0;padding-top:0}
.cg-rc-h{font-family:var(--ss);font-size:15px;line-height:1.5;color:var(--ink)}
.cg-rc-s{display:inline-block;padding:1px 7px;border-radius:3px;font-family:var(--mn);font-size:12px;color:var(--cg-on3)}
.cg-rc-t{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.cg-chip{display:inline-flex;gap:5px;align-items:baseline;padding:2px 8px;border:1px solid var(--rl);border-radius:999px;font-family:var(--ss);font-size:12px;color:var(--body)}
.cg-chip b{font-family:var(--mn);font-weight:600;color:var(--ink)}
.cg-rc-l{list-style:none;margin-top:10px}
.cg-rc-l li{padding:9px 0;border-top:1px dotted var(--rl)}
.cg-rc-l li:first-child{border-top:0}
.cg-rc-k{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-rc-e{margin-top:3px;font-family:var(--ss);font-size:13.5px;line-height:1.5;color:var(--body)}
.cg-rc-e b{color:var(--ink)}
.cg-rc-v{margin-top:3px;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-rc-v b{color:var(--ink)}
.cg-div-r{background:transparent;border:1px dashed var(--muted)}

/* Divergência por assunto, no dossiê */
.cg-ms-tm{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
.cg-ms-tm .cg-chip{font-size:11px;padding:1px 7px}
.cg-vira th{font-weight:700}
.cg-vira-s{display:inline-block;margin-left:8px;padding:0 6px;border:1px dashed var(--muted);border-radius:3px;font-family:var(--mn);font-size:10px;font-weight:400;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}

/* O que espera × o que passa: azul vazio = esperando; verde cheio = aprovada (o verde de "aprovada" da página).
   Paleta validada (validate_palette.js) no claro (#fff) e no escuro (#111827); a forma (vazio × cheio) repete a cor. */
.cg-gr{position:relative;margin-top:10px}
.cg-gr-w{overflow-x:auto}
.cg-gr svg{display:block;width:100%;max-width:980px;min-width:600px;height:auto}
.cg-gr-faixa{fill:var(--rl);opacity:.45}
.cg-gr-grade{stroke:var(--rl);stroke-width:1}
.cg-gr-guia{stroke:var(--rule);stroke-width:1}
.cg-gr-ty{fill:var(--muted);font-family:var(--mn);font-size:11px;text-anchor:end}
.cg-gr-tx{fill:var(--muted);font-family:var(--mn);font-size:11px;text-anchor:middle}
.cg-gr-tx-fim{text-anchor:end}
.cg-gr-tg{fill:var(--muted);font-family:var(--mn);font-size:10px;text-anchor:end}
.cg-gr-fx{fill:var(--muted);font-family:var(--ss);font-size:11px}
.cg-gr-ex{fill:var(--muted);font-family:var(--ss);font-size:11px;text-anchor:middle}
.cg-gr-e{fill:var(--paper);fill-opacity:.01;stroke:var(--cg-esp);stroke-width:1.5;stroke-opacity:.8}
.cg-gr-a{fill:var(--cg-ok);fill-opacity:.9;stroke:var(--paper);stroke-width:1.5}
.cg-gr circle.on{stroke:var(--ink);stroke-width:2.5;stroke-opacity:1}
.cg-gr-dica{position:absolute;z-index:3;max-width:280px;padding:7px 10px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);box-shadow:0 4px 14px rgba(0,0,0,.12);font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body);pointer-events:none}
.cg-gr-dica b{display:block;font-family:var(--mn);font-size:14px;color:var(--ink)}
.cg-gr-leg{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:8px;font-family:var(--ss);font-size:12px;color:var(--muted)}
.cg-gr-leg span{display:inline-flex;align-items:center;gap:6px}
.cg-gr-le,.cg-gr-la{display:inline-block;width:10px;height:10px;border-radius:50%}
.cg-gr-le{border:1.5px solid var(--cg-esp)}
.cg-gr-la{background:var(--cg-ok)}
.cg-rv-h{margin-top:16px;font-family:var(--sf);font-size:16px;color:var(--ink)}
.cg-rv-h span{display:block;margin-top:2px;font-family:var(--ss);font-size:12.5px;font-weight:400;color:var(--muted)}
.cg-rv-n{font-family:var(--mn);font-weight:700;color:var(--ink)}
.cg-rv-s{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}
.cg-rv-s .cg-chip{font-size:11.5px}
.cg-rv-q{margin-top:4px;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-rv-c{margin-top:4px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-rv-tb{margin-top:14px}
.cg-rv-tb summary{cursor:pointer;font-family:var(--ss);font-size:13px;color:var(--link)}
.cg-rv-tb .an-tbl-wrap{max-height:420px;overflow:auto;margin-top:8px}

/* Rankings no dossiê */
.cg-tile-r{margin-top:2px;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-rk td{font-family:var(--mn)}

/* Onde cada um está, por tema */
.cg-fx-f{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin:10px 0 4px}
.cg-fx-f .az-lbl{margin:0}
.cg-fx-s{max-width:100%;padding:6px 10px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:13px}
.cg-fx-st{flex-basis:100%;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-pt-vira{box-shadow:0 0 0 1.5px var(--paper),0 0 0 3px var(--ink)}
.cg-pt[hidden]{display:none}

/* Comparativo */
.cg-cp-th,.cg-cp-td{width:30px;padding-left:4px !important;padding-right:4px !important;text-align:center}
.cg-cp-ck{width:16px;height:16px;cursor:pointer;accent-color:var(--link)}
.cg-cp-bar{position:fixed;left:50%;bottom:16px;z-index:40;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;max-width:calc(100% - 32px);padding:10px 14px;border:1px solid var(--rule);border-radius:10px;background:var(--paper);box-shadow:0 8px 24px rgba(0,0,0,.18);transform:translateX(-50%);font-family:var(--ss);font-size:13.5px;color:var(--body)}
.cg-cp-bar b{color:var(--ink)}
.cg-cp-sel span{color:var(--ink);font-weight:600}
.cg-cp-ir,.cg-cp-x{padding:7px 12px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:13px;cursor:pointer}
.cg-cp-ir{border-color:var(--link);background:var(--link);color:#fff;font-weight:600}
.cg-cp-ir:disabled{opacity:.45;cursor:not-allowed}
.cg-cp-add{padding:0;border:0;background:none;color:var(--link);font:inherit;font-weight:600;cursor:pointer;text-decoration:underline;text-underline-offset:2px}
.cg-cp-add:disabled{color:var(--muted);text-decoration:none;cursor:default;font-weight:400}
.cg-cp-k{margin-bottom:6px}
.cg-cp-h{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 28px;padding-bottom:14px;border-bottom:1px solid var(--rl)}
.cg-cp-n{font-family:var(--sf);font-size:26px;line-height:1.15;color:var(--ink)}
.cg-cp-n a{color:inherit;text-decoration:none}
.cg-cp-n a:hover{text-decoration:underline}
.cg-cp-b{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;margin-top:8px;font-family:var(--mn);font-size:12px;color:var(--ink)}
.cg-cp-b span{white-space:nowrap}
.cg-cp-b .cg-bar{width:140px}
.cg-cp-f{margin-top:8px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
.cg-cp-t{table-layout:fixed}
.cg-cp-t thead th:first-child{width:30%}
.cg-cp-t th,.cg-cp-t td{white-space:normal;overflow-wrap:break-word}
.cg-cp-t th[scope="row"]{min-width:0}
.cg-cp-c{text-align:left !important}
.cg-cp-c b{display:block;font-family:var(--mn);color:var(--ink)}
.cg-cp-c small{display:block;margin-top:1px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-cp-c .cg-bar{display:block;width:120px;margin-bottom:3px}
.cg-cp-j{font-family:var(--ss);font-size:15px;line-height:1.5;color:var(--body)}
.cg-cp-j b{font-family:var(--mn);font-size:22px;color:var(--ink);margin-right:4px}
.cg-cp-l{font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-cp-v{margin-top:3px;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-cp-v b{color:var(--ink)}
.cg-cmpf{margin:14px 0 6px;padding:12px 14px;border:1px solid var(--rule);border-radius:10px;background:var(--paper)}
.cg-cmpf-k{font-family:var(--ss);font-size:13.5px;line-height:1.45;color:var(--muted)}
.cg-cmpf-k b{margin-right:6px;color:var(--ink)}
.cg-cmpf-c{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:9px}
.cg-cmpf-c .az-fil-in{flex:1 1 220px;min-width:0}
.cg-cmpf-x{font-family:var(--ss);color:var(--muted)}
.cg-cmpf-st,.cg-cp-st{font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-cmpf-st{margin-top:6px}
.cg-cmpf-st:empty{display:none}
.cg-cp-tr,.cg-cp-com{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;margin-top:10px;font-family:var(--ss);font-size:13px;color:var(--muted)}
.cg-cp-tr .az-fil-in,.cg-cp-com .az-fil-in{flex:1 1 170px;max-width:280px;min-width:0;padding:6px 10px;font-size:13px}
.cg-cp-trb{padding:6px 11px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:12.5px;font-weight:600;cursor:pointer}
.cg-cp-trb:hover{border-color:var(--link);color:var(--link)}
@media (max-width:640px){
  .cg-cp-h{gap:10px}
  .cg-cp-n{font-size:19px}
  .cg-cp-b .cg-bar,.cg-cp-c .cg-bar{width:84px}
  .cg-cp-t thead th:first-child{width:28%}
  .cg-cp-t th,.cg-cp-t td{padding-right:6px}
  .cg-cp-tr .az-fil-in,.cg-cp-com .az-fil-in{flex-basis:100%;max-width:none}
  .cg-cp-bar{bottom:10px;font-size:12.5px}
}

/* Apelidos e "no jornal × no voto" */
.cg-apel{display:inline-block;margin:0 6px;padding:0 7px;border-radius:999px;background:var(--rl);font-family:var(--ss);font-size:11.5px;font-weight:600;color:var(--ink)}
.cg-rv-jor{margin-left:8px;font-family:var(--mn);font-size:11px;color:var(--link)}
.cg-jv{list-style:none;max-width:1100px;margin-top:8px}
.cg-jv li{padding:11px 0;border-top:1px solid var(--rl)}
.cg-jv li:first-child{border-top:0}
.cg-jv-k{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;font-family:var(--ss);font-size:13px;color:var(--muted)}
.cg-jv-k span,.cg-jv-k time{font-family:var(--mn);font-size:11px}
.cg-jv-t{margin-top:3px;font-family:var(--sf);font-size:17px;line-height:1.35;color:var(--ink)}
.cg-jv-t a{color:inherit}
.cg-jv-v{margin-top:4px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
.cg-jv-v b{color:var(--ink)}

/* ── As matérias: o número que abre a ficha, a ficha e as votações por extenso ── */
:root{--cg-j0:#EEF2FD;--cg-j1:#D3DDFA;--cg-j2:#A6B9F2;--cg-j3:#4F68CC;--cg-j4:#2A429F;--cg-jon:#14203f;--cg-jon2:#fff}
:root[data-theme="dark"]{--cg-j0:#182136;--cg-j1:#22305A;--cg-j2:#30458C;--cg-j3:#4560C2;--cg-j4:#A3B5F7;--cg-jon:#e8edf7;--cg-jon2:#0b0f17}
.cg-mt{color:var(--link);font-weight:700;cursor:pointer}
.cg-mt:hover{text-decoration:underline}
.cg-fx-d{margin-top:6px;font-family:var(--ss);font-size:12.5px;color:var(--muted)}
.cg-fx-d b{color:var(--ink)}
.cg-mx-polo th i{margin-left:5px;padding:0 4px;border:1px dashed var(--muted);border-radius:3px;font-family:var(--mn);font-size:9px;font-style:normal;font-weight:400;letter-spacing:.4px;text-transform:uppercase;color:var(--muted);cursor:help}

/* Quanto os partidos votam juntos */
.cg-jt{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;max-width:980px;margin-top:14px;border:1px solid var(--az-fr)}
.cg-jt li{min-width:0;padding:12px 14px 13px;border-left:1px solid var(--rl)}
.cg-jt li:first-child{border-left:0}
.cg-jt b{display:block;font-family:var(--mn);font-size:26px;font-weight:600;line-height:1.1;color:var(--ink)}
.cg-jt span{display:block;margin-top:5px;font-family:var(--ss);font-size:12.5px;line-height:1.35;color:var(--body)}
.cg-jt small{display:block;margin-top:3px}
.cg-jt li::before{content:"";display:block;width:22px;height:4px;margin-bottom:9px;border-radius:2px}
.cg-jt-a::before,i.cg-jt-a{background:var(--cg-ok)}
.cg-jt-b::before,i.cg-jt-b{background:var(--ink)}
.cg-jt-c::before,i.cg-jt-c{background:var(--muted)}
.cg-jt-d::before,i.cg-jt-d{background:var(--cg-na)}
.cg-jt-bar{display:flex;gap:2px;max-width:980px;height:10px;margin-top:10px}
.cg-jt-bar i{display:block;height:100%;min-width:2px;border-radius:2px}
.cg-jx td{min-width:38px;color:var(--cg-jon)}
.cg-jx td.cg-x{background:repeating-linear-gradient(135deg,var(--rl) 0 2px,transparent 2px 6px)}
.cg-j0{background:var(--cg-j0)}.cg-j1{background:var(--cg-j1)}.cg-j2{background:var(--cg-j2)}.cg-j3{background:var(--cg-j3)}.cg-j4{background:var(--cg-j4)}
.cg-jx td.cg-j3,.cg-jx td.cg-j4{color:var(--cg-jon2)}
:root[data-theme="dark"] .cg-jx td.cg-j3{color:var(--cg-jon)}
.cg-jx tr.cg-mx-polo th{font-weight:800}

/* O detalhe de um tema e as listas de matérias */
.cg-td{max-width:1180px;margin-top:26px;padding-top:16px;border-top:2px solid var(--ink)}
.cg-td-h{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;font-family:var(--sf);font-size:19px;font-weight:700;color:var(--ink)}
.cg-td-h span{font-family:var(--ss);font-size:12.5px;font-weight:400;color:var(--muted)}
.cg-td-def{margin-top:8px;font-family:var(--ss);font-size:13px;line-height:1.55;color:var(--body)}
.cg-td-def b{color:var(--ink)}
.cg-td-r{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.cg-td-l,.cg-vls,.cg-mb-l{list-style:none}
.cg-td-l{margin-top:12px}
.cg-td-m{padding:14px 0;border-top:1px solid var(--rl)}
.cg-mh{display:flex;flex-wrap:wrap;align-items:center;gap:5px 8px;font-family:var(--ss);font-size:14.5px;color:var(--ink)}
.cg-mh .cg-apel{margin:0}
.cg-mh .cg-chip{font-size:11.5px;padding:1px 8px}
.cg-mh .cg-div{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-td-lado{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-mh-e{max-width:980px;margin-top:5px;font-family:var(--ss);font-size:13.5px;line-height:1.5;color:var(--body)}
.cg-mh-x{max-width:980px;margin-top:3px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--muted)}
.cg-mh-u{margin-top:3px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-vls{margin:8px 0 0 2px;padding-left:14px;border-left:2px solid var(--rl)}
.cg-vl{padding:8px 0}
.cg-vl+.cg-vl{border-top:1px dotted var(--rl)}
.cg-vl-k{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-vl-pl{color:var(--ink)}
.cg-vl-ss{padding:0 6px;border-radius:3px;background:var(--rl);color:var(--body)}
.cg-vl-v{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.cg-vp{padding:1px 8px;border-radius:999px;border:1px solid var(--rule);font-family:var(--ss);font-size:12px;color:var(--body)}
.cg-vp b{font-weight:700}
.cg-vp-e{border-color:var(--cg-e3);background:var(--cg-e3);color:var(--cg-on3)}
.cg-vp-d{border-color:var(--cg-d3);background:var(--cg-d3);color:var(--cg-on3)}
.cg-vp-j{border-color:var(--cg-c0);background:var(--cg-c0);color:var(--cg-on2)}
.cg-vp-x{border-style:dashed;color:var(--ink)}
.cg-vp-0{color:var(--muted)}
.cg-vl-x{max-width:980px;margin-top:4px;font-family:var(--ss);font-size:13px;line-height:1.45;color:var(--ink)}
.cg-vl-ab,.cg-vl-s{max-width:980px;margin-top:2px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--muted)}
.cg-vl-s{font-style:italic}
.cg-vl-p{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 8px;margin-top:4px;font-family:var(--ss);font-size:12.5px;color:var(--body)}
.cg-pl b{color:var(--ink)}
.cg-pl small{font-size:10.5px;color:var(--muted)}
.cg-pl-e::before,.cg-pl-d::before{content:"";display:inline-block;width:9px;height:9px;margin-right:5px;border-radius:2px;vertical-align:-1px}
.cg-pl-e::before{background:var(--cg-e3)}.cg-pl-d::before{background:var(--cg-d3)}
.cg-pl-x{color:var(--faint)}
.cg-pl-g{padding-left:8px;border-left:1px solid var(--rule)}
.cg-vl-dif{margin-left:-16px;padding-left:12px;border-left:4px solid var(--qc)}
.cg-div-j{background:var(--rl);border-color:transparent}
.cg-chip-dif{border-color:var(--qc)}
.cg-mais{margin-top:8px;padding:5px 12px;border:1px solid var(--rule);border-radius:999px;background:var(--paper);font-family:var(--ss);font-size:12px;font-weight:600;color:var(--link);cursor:pointer}
.cg-mais:hover{border-color:var(--link)}
.cg-mb-f{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin-top:10px}
.cg-mb-f .az-fil-in{flex:1 1 280px;min-width:0;max-width:520px}
.cg-mb-m{padding:10px 0}

/* A ficha da matéria */
.cg-mf-h .cg-d-t{font-size:clamp(24px,calc(14px + 1.2vw),34px)}
.cg-mf-h .cg-apel{margin-left:12px;font-size:13px;vertical-align:middle}
.cg-mf-e{max-width:920px;margin-top:10px;font-family:var(--sf);font-size:18px;line-height:1.45;color:var(--ink)}
.cg-mf-x{max-width:920px;margin-top:10px;font-family:var(--ss);font-size:14px;line-height:1.55;color:var(--body)}
.cg-mf-x b{color:var(--ink)}
.cg-mf-kw{display:flex;flex-wrap:wrap;align-items:center;gap:5px;margin-top:10px}
.cg-mf-kw .cg-chip{font-size:11.5px;padding:1px 8px}
.cg-mf-dl{max-width:920px;margin-top:6px}
.cg-mf-dl>div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:0 14px;padding:7px 0;border-bottom:1px solid var(--rl)}
.cg-mf-dl dt{font-family:var(--ss);font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}
.cg-mf-dl dd{font-family:var(--ss);font-size:13.5px;line-height:1.5;color:var(--ink)}
.cg-mf-n{display:flex;align-items:baseline;gap:6px;margin-top:10px;font-family:var(--ss);font-size:13px;color:var(--body)}
.cg-mf-n>b{font-family:var(--mn);font-size:32px;font-weight:600;line-height:1;color:var(--ink)}

/* O mapa das abas (no Resumo) e o que entra em cada tema (no Como ler) */
.cg-mapa{list-style:none}
.cg-mapa li{position:relative;padding:11px 0;border-top:1px solid var(--rl)}
.cg-mapa li:first-child{border-top:0}
.cg-mapa a{font-family:var(--sf);font-size:17px;font-weight:700;color:var(--ink)}
.cg-mapa a:hover{color:var(--link)}
.cg-mapa p{margin-top:3px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--muted)}
.cg-mapa b{font-family:var(--mn);color:var(--ink)}
.cg-tdef{max-width:1180px;margin-top:10px}
.cg-tdef td,.cg-tdef th{white-space:normal;text-align:left !important;vertical-align:top;font-family:var(--ss) !important;font-size:12.5px !important;line-height:1.5}
.cg-tdef th[scope="row"]{min-width:190px}

/* O que cada um propõe */
.cg-cp-pr{padding-bottom:0;border-bottom:0}
.cg-cp-n2{font-family:var(--ss);font-size:13px;font-weight:800;letter-spacing:.3px;color:var(--ink)}
.cg-pr-r{max-width:920px;margin-top:10px;font-family:var(--sf);font-size:17px;line-height:1.5;color:var(--ink)}
.cg-pr-c{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.cg-d-sec .az-h5{margin-top:18px}

/* Os temas que se abrem (no dossiê e no comparativo) */
.cg-tb-b{padding:0;border:0;background:none;font:inherit;font-weight:700;color:var(--link);text-align:left;cursor:pointer}
.cg-tb-b::before{content:"▸";display:inline-block;width:14px;font-size:11px;color:var(--muted)}
.cg-tb-b[aria-expanded="true"]::before{content:"▾"}
.cg-tb-b:hover{text-decoration:underline}
.cg-tb-t tr.cg-dt>td{padding:4px 0 18px;text-align:left !important;white-space:normal;font-family:var(--ss);font-size:13px;background:var(--soft)}
.cg-dt-in{padding:10px 14px 4px}
.cg-dt-r{max-width:980px;margin-top:4px;font-family:var(--ss);font-size:13.5px;line-height:1.5;color:var(--ink)}
.cg-dt-o{margin-top:12px;font-family:var(--ss);font-size:13px}
.cg-dt-o summary{color:var(--link);font-weight:600;cursor:pointer}
.cg-dt .cg-td-def{margin-top:0}

/* As dicas (ⓘ): a definição de cada número e de cada tema */
.cg-i{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;margin-left:5px;padding:0;border:1px solid var(--muted);border-radius:50%;background:none;font-family:var(--sf);font-size:10px;font-style:italic;font-weight:700;line-height:1;text-transform:none;letter-spacing:0;color:var(--muted);vertical-align:1px;cursor:help}
.cg-i:hover,.cg-i:focus-visible{border-color:var(--link);color:var(--link)}
[data-dica]{cursor:help}
.cg-tem{border-style:dashed}
.cg-dica{position:fixed;z-index:90;padding:9px 12px;border:1px solid var(--rule);border-radius:8px;background:var(--paper);box-shadow:0 8px 24px rgba(0,0,0,.2);font-family:var(--ss);font-size:12.5px;font-weight:400;line-height:1.5;text-transform:none;letter-spacing:0;white-space:normal;color:var(--ink);pointer-events:none}
.cg-dica[hidden]{display:none}
.cg-gr-clica circle{cursor:pointer}
.cg-rv-tb tbody th a{font-weight:600}
@media (max-width:760px){
  .cg-jt{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cg-jt li:nth-child(3){border-left:0}
  .cg-jt li:nth-child(n+3){border-top:1px solid var(--rl)}
  .cg-mf-dl>div{grid-template-columns:minmax(0,1fr)}
  .cg-vls{padding-left:10px}
  .cg-vl-dif{margin-left:-12px;padding-left:8px}
  .cg-dt-in{padding:8px 6px 2px}
}

/* Escolha o seu candidato: os filtros e a lista de quem está no mandato */
.cg-esc-f{margin:14px 0 6px;padding:14px 16px;border:1px solid var(--rule);border-radius:8px;background:var(--soft);font-family:var(--ss)}
.cg-esc-l,.cg-esc-b{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px 16px}
.cg-esc-l label,.cg-esc-b label{min-width:0;max-width:100%}
.cg-esc-f label>span,.cg-esc-f legend{display:block;margin-bottom:4px;font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
.cg-esc-f select{max-width:100%;padding:6px 8px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:13px}
.cg-esc-ck{display:flex;align-items:center;gap:6px;padding-bottom:6px;font-size:13px;color:var(--ink)}
.cg-esc-tm{margin-top:14px;padding:0;border:0;min-width:0}
.cg-esc-f legend span{display:block;margin-top:2px;font-size:11.5px;font-weight:400;letter-spacing:0;text-transform:none;line-height:1.45}
.cg-esc-tg{display:grid;grid-template-columns:repeat(4,max-content minmax(0,150px));align-items:center;gap:6px 10px;margin-top:6px}
.cg-esc-tl{font-size:13px;color:var(--ink);text-align:right}
.cg-esc-tl small{display:block;font-size:10.5px;color:var(--faint)}
.cg-esc-tg select{width:100%}
.cg-esc-b{margin-top:14px;padding-top:12px;border-top:1px solid var(--rl)}
.cg-esc-lp{padding:6px 12px;border:1px solid var(--rule);border-radius:16px;background:var(--paper);color:var(--link);font-family:var(--ss);font-size:12.5px;font-weight:600;cursor:pointer}
.cg-esc-n{flex:1 1 220px;padding-bottom:6px;font-size:13px;font-weight:600;color:var(--ink)}
/* Os cartões: a foto, o nome, o saldo, de que lado vota em cada tema e os números do pé. O nome é o
   link; ele cobre o cartão inteiro, então o cartão todo abre o dossiê. */
.cg-esc{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(272px,1fr));gap:18px;margin-top:14px;perspective:1600px}
.cg-cd{display:flex;flex-direction:column;min-width:0;padding:14px 16px 12px;border:1px solid var(--rule);border-radius:14px;background:var(--paper);box-shadow:var(--cg-sombra);font-family:var(--ss)}
.cg-cd.cg-3d-on,.cg-cd:focus-within{box-shadow:var(--cg-sombra-alta);border-color:var(--link)}
.cg-cd-h{display:flex;gap:12px;align-items:flex-start;margin-bottom:8px}
.cg-cd-f{position:relative;flex:none;display:flex;align-items:center;justify-content:center;width:72px;height:96px;overflow:hidden;border-radius:10px;box-shadow:0 0 0 1px var(--rule),0 6px 12px -6px rgba(16,24,40,.35);transform:translateZ(18px)}
.cg-cd-f>span{font-family:var(--sf);font-size:24px;font-weight:700;letter-spacing:.5px;color:var(--cg-on2)}
.cg-cd-f.cg-e3>span,.cg-cd-f.cg-d3>span{color:var(--cg-on3)}
.cg-cd-f.cg-na>span{color:var(--muted)}
.cg-cd-f img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 20%}
.cg-cd-i{min-width:0}
.cg-cd-n{font-family:var(--sf);font-size:16.5px;font-weight:700;line-height:1.25}
.cg-cd-n .cg-p{color:var(--ink)}
.cg-cd-n .cg-p::after{content:"";position:absolute;inset:0;z-index:1;border-radius:14px}
.cg-cd-n .cg-p:focus-visible{outline:none}
.cg-cd:hover .cg-cd-n .cg-p{color:var(--link)}
.cg-cd-l{margin-top:3px;font-family:var(--mn);font-size:11px;letter-spacing:.3px;color:var(--muted)}
.cg-cd-tr{margin-top:5px;font-size:11.5px;line-height:1.4;color:var(--body)}
.cg-cd-v{margin-top:2px;font-family:var(--sf);font-size:15px;font-weight:700;line-height:1.3;color:var(--ink)}
.cg-cd-sem{font-family:var(--ss);font-size:12.5px;font-weight:400;color:var(--muted)}
.cg-cd-rg{display:flex;align-items:center;gap:10px;margin-top:6px;font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-cd-rg b{font-size:12.5px;color:var(--ink)}
.cg-cd-tk{position:relative;flex:1 1 auto;max-width:120px;height:4px;border-radius:2px;background:linear-gradient(90deg,var(--cg-e2),var(--cg-c0) 50%,var(--cg-d2))}
.cg-cd-tk::before{content:"";position:absolute;left:50%;top:-3px;bottom:-3px;border-left:1px solid var(--ink)}
.cg-cd-tk i{position:absolute;top:50%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;box-shadow:0 0 0 2px var(--paper)}
.cg-cd-tc{list-style:none;margin-top:10px;padding-top:8px;border-top:1px solid var(--rl);font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-cd-tc li+li{margin-top:3px}
.cg-cd-tc b{font-family:var(--mn);font-weight:600;color:var(--ink)}
.cg-cd-tc small{font-family:var(--ss);font-size:11.5px;color:var(--muted);white-space:nowrap}
.cg-cd-ex{margin:6px 0 !important;padding:5px 8px;border-left:3px solid var(--qc);border-radius:0 6px 6px 0;background:var(--soft);color:var(--ink)}
.cg-cd-ex b{font-family:var(--ss)}
.cg-cd-mais{position:relative;z-index:2;margin-top:auto;padding-top:10px;font-size:12px}
.cg-cd-mais summary{width:fit-content;padding:2px 0;color:var(--link);font-weight:700;cursor:pointer}
.cg-cd-mais dl{margin-top:6px;padding:8px 10px;border-radius:8px;background:var(--soft)}
.cg-cd-mais div+div{margin-top:6px}
.cg-cd-mais dt{font-size:9.5px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:var(--muted)}
.cg-cd-mais dd{margin-top:1px;line-height:1.45;color:var(--ink)}
.cg-esc-at{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;margin-bottom:12px}
.cg-esc-at .cg-esc-rot{margin:0 4px 0 0}
.cg-esc-atb{display:inline-flex;align-items:baseline;gap:6px;padding:5px 11px;border:1px solid var(--rule);border-radius:999px;background:var(--paper);color:var(--body);font-family:var(--ss);font-size:12.5px;cursor:pointer}
.cg-esc-atb b{font-family:var(--mn);font-size:11.5px;color:var(--ink)}
.cg-esc-atb:hover{border-color:var(--link);color:var(--link)}
.cg-esc-atb[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.cg-esc-atb[aria-pressed="true"] b{color:var(--paper)}
.cg-esc-mf>summary{width:fit-content;color:var(--link);font-size:13px;font-weight:700;cursor:pointer}
.cg-esc-mf>summary span{margin-left:6px;font-size:12px;font-weight:400;color:var(--muted)}
.cg-esc-mf[open]>summary{margin-bottom:12px}
.cg-esc-mais{display:block;margin:18px auto 0;padding:9px 22px;border:1px solid var(--rule);border-radius:999px;background:var(--paper);color:var(--link);font-family:var(--ss);font-size:13px;font-weight:700;cursor:pointer}
.cg-esc-mais:hover{border-color:var(--link)}
.cg-esc-e1{margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--rl)}
.cg-esc-rot{margin-bottom:6px;font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
.cg-esc-ufs{display:flex;flex-wrap:wrap;gap:5px;margin-top:2px}
.cg-esc-uf{min-width:38px;padding:5px 8px;border:1px solid var(--rule);border-radius:8px;background:var(--paper);color:var(--body);font-family:var(--mn);font-size:12px;font-weight:600;cursor:pointer}
.cg-esc-uf:hover{border-color:var(--link);color:var(--link)}
.cg-esc-uf[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.cg-esc-uf0{font-family:var(--ss)}
.cg-esc-sd{margin-left:auto;padding:0 6px;border-radius:3px;font-family:var(--mn);font-size:11.5px;font-weight:600;color:var(--cg-on2)}
.cg-esc-sd.cg-e3,.cg-esc-sd.cg-d3{color:var(--cg-on3)}
.cg-esc-x{margin-top:3px;font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-esc-e,.cg-esc-d{font-weight:700}
.cg-esc-e{color:var(--cg-e3)}.cg-esc-d{color:var(--cg-d3)}
.cg-esc-num{color:var(--muted)}
.cg-esc-m{order:-1;margin:-2px 0 10px;padding:6px 9px;border-left:3px solid var(--qc);border-radius:0 6px 6px 0;background:var(--soft);font-size:12.5px;line-height:1.45;color:var(--ink)}
@media (max-width:1100px){
  .cg-esc-tg{grid-template-columns:repeat(2,max-content minmax(0,170px))}
}
@media (max-width:760px){
  .cg-esc{grid-template-columns:minmax(0,1fr);gap:14px}
  .cg-esc-tg{grid-template-columns:max-content minmax(0,1fr)}
  .cg-esc-l label{flex:1 1 140px}
  .cg-esc-l select{width:100%}
}

/* ── Cartões com profundidade: camadas, sombra e uma inclinação leve sob o ponteiro ── */
:root{--cg-sombra:0 1px 0 rgba(16,24,40,.04),0 2px 6px rgba(16,24,40,.07),0 22px 38px -22px rgba(16,24,40,.34);--cg-sombra-alta:0 1px 0 rgba(16,24,40,.04),0 6px 14px rgba(16,24,40,.1),0 34px 50px -24px rgba(16,24,40,.42);--cg-brilho:rgba(255,255,255,.55)}
:root[data-theme="dark"]{--cg-sombra:0 0 0 1px rgba(255,255,255,.03),0 2px 6px rgba(0,0,0,.4),0 22px 38px -20px rgba(0,0,0,.8);--cg-sombra-alta:0 0 0 1px rgba(255,255,255,.05),0 8px 16px rgba(0,0,0,.5),0 34px 50px -22px rgba(0,0,0,.9);--cg-brilho:rgba(143,176,245,.09)}
.cg-3d{position:relative;transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transform-style:preserve-3d;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .25s}
.cg-3d.cg-3d-on{transition:transform .08s linear,box-shadow .25s}
.cg-3d::after{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(420px circle at var(--mx,50%) var(--my,0%),var(--cg-brilho),transparent 60%);opacity:0;transition:opacity .25s;pointer-events:none}
.cg-3d.cg-3d-on::after{opacity:1}
@media (prefers-reduced-motion:reduce){.cg-3d,.cg-3d.cg-3d-on{transform:none;transition:none}.cg-3d::after{display:none}}

/* Pontos de gente: um ponto por parlamentar (a ficha de cada frente usa; o tema tem os seus em congresso_tema.css.j2) */
.cg-pv{display:inline-block;flex:none;width:var(--cg-pv,8px);height:var(--cg-pv,8px);border-radius:50%;vertical-align:middle}
.cg-pv-s{background:var(--cg-ok)}
.cg-pv-n{border-radius:1.5px;background:var(--cg-no)}
.cg-pv-o{border:1.5px solid var(--cg-no);border-radius:1.5px}
.cg-pv-a{border:1.5px solid var(--muted)}
.cg-pv-x{outline:1.5px solid var(--ink);outline-offset:.5px}
a.cg-pv{transition:transform .12s}
a.cg-pv:hover,a.cg-pv:focus-visible{transform:scale(1.7);outline:1.5px solid var(--link);outline-offset:.5px;position:relative;z-index:2}
.cg-qv{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px 13px;margin-top:8px;padding:2px;border-radius:6px}
.cg-qv:focus-visible{outline:2px solid var(--link);outline-offset:4px}
.cg-qv-g{display:grid;grid-auto-flow:column;grid-template-rows:repeat(var(--cg-pv-l,7),var(--cg-pv,8px));grid-auto-columns:var(--cg-pv,8px);gap:3px;width:fit-content}
.cg-qv-s{margin-top:5px;font-family:var(--mn);font-size:9.5px;line-height:1.2;color:var(--muted);white-space:nowrap}
.cg-qv-s b{display:block;font-weight:600;color:var(--ink)}
.cg-qv-s span{display:block}
@media (pointer:coarse){.cg-qv{--cg-pv:10px;--cg-pv-l:6}}
@media (max-width:760px){.cg-qv{gap:10px 10px;--cg-pv-l:6}}

/* Frentes: um cartão por frente de causa; cada ponto é um deputado que assina */
.cg-wf{display:inline-block;flex:none;width:calc(var(--c,1)*7px);height:calc(var(--l,var(--cg-wf-l,8))*7px);background:radial-gradient(circle at 3.5px 3.5px,currentColor 0 2.5px,transparent 3px) 0 0/7px 7px;vertical-align:top}
.cg-wf-e{color:var(--cg-e3)}.cg-wf-c{color:var(--cg-c0)}.cg-wf-d{color:var(--cg-d3)}.cg-wf-sem{color:var(--rule)}
.cg-fr-ctl{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 24px;margin-top:16px}
.cg-fr-leg{display:flex;flex-wrap:wrap;align-items:center;gap:4px 16px;font-family:var(--ss);font-size:12px;color:var(--body)}
.cg-fr-lk{display:inline-flex;align-items:center;gap:5px}
.cg-fr-ord{display:inline-flex;align-items:center;gap:8px;font-family:var(--ss);font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
.cg-fr-ord select{max-width:100%;padding:6px 8px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);color:var(--ink);font-family:var(--ss);font-size:13px;font-weight:400;letter-spacing:0;text-transform:none}
.cg-fr-g{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px 22px;margin-top:16px;perspective:1600px}
.cg-fr{display:flex;flex-direction:column;padding:18px 20px 14px;border:1px solid var(--rule);border-radius:14px;background:var(--paper);box-shadow:var(--cg-sombra);font-family:var(--ss)}
.cg-abas .cg-fr{cursor:pointer}
.cg-fr.cg-3d-on,.cg-fr:focus-within{box-shadow:var(--cg-sombra-alta)}
.cg-fr-k{display:flex;align-items:baseline;justify-content:space-between;gap:10px;font-size:10.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted)}
.cg-fr-k a{position:relative;z-index:1;font-size:11px;font-weight:600;letter-spacing:0;text-transform:none;color:var(--link);white-space:nowrap}
.cg-fr-t{margin-top:4px;font-family:var(--sf);font-size:19px;font-weight:700;line-height:1.25;color:var(--ink)}
.cg-fr-m{margin-top:10px;font-size:13px;line-height:1.45;color:var(--body)}
.cg-fr-m b{display:block;font-size:30px;font-weight:700;line-height:1.1;letter-spacing:-.5px;color:var(--ink)}
.cg-fr-w{display:flex;flex-wrap:wrap;align-items:flex-start;gap:6px 9px;margin-top:14px}
.cg-fr-wg{display:inline-flex;align-items:flex-start}
.cg-fr-l{display:flex;flex-wrap:wrap;gap:2px 14px;margin-top:8px;font-size:12px;color:var(--body)}
.cg-fr-n b{font-family:var(--mn);font-weight:600;color:var(--ink)}
.cg-fr-n i{margin-left:4px;padding:0 6px;border:1px solid var(--rule);border-radius:999px;font-size:10px;font-style:normal;color:var(--muted);white-space:nowrap}
.cg-fr-ne b{color:var(--cg-e3)}.cg-fr-nd b{color:var(--cg-d3)}
.cg-fr-esc{max-width:980px;margin-top:8px;font-family:var(--ss);font-size:13px;line-height:1.55;color:var(--body)}
.cg-fr-c{margin-top:6px;font-size:12.5px;line-height:1.5;color:var(--body)}
.cg-fr-x{margin-top:12px;padding-top:10px;border-top:1px solid var(--rl);font-size:13px;line-height:1.5;color:var(--body)}
.cg-fr-x b{font-family:var(--mn);color:var(--ink)}
.cg-fr-p{margin-top:6px;font-size:11.5px;line-height:1.5;color:var(--muted)}
.cg-fr-p b{color:var(--ink)}
.cg-fr-p a{position:relative;z-index:1;font-weight:600;color:var(--link)}
.cg-fr-pouco .cg-fr-m{opacity:.62}
.cg-fr-c small{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-fr-c b{color:var(--ink)}
.cg-fr-c .cg-p,.cg-fr-d .cg-p{position:relative;z-index:1}
.cg-fr-d{margin-top:8px;font-size:12.5px}
.cg-fr-d summary{width:fit-content;color:var(--link);font-weight:600;cursor:pointer}
.cg-fr-v{margin-top:auto;padding-top:12px}
.cg-fr-v button{padding:0;border:0;background:none;color:var(--link);font-family:var(--ss);font-size:12.5px;font-weight:700;cursor:pointer}
.cg-fr-v button:hover{text-decoration:underline}
.cg-fr-o{list-style:none;margin-top:3px}
.cg-fr-o li{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 8px;padding:4px 0;border-bottom:1px solid var(--rl);font-size:12.5px}
.cg-fr-o small{font-family:var(--mn);font-size:10.5px;color:var(--muted)}
.cg-fr-o span{margin-left:auto;font-family:var(--mn);font-size:11.5px;color:var(--ink)}
.cg-fr-mais{columns:2;column-gap:28px}
.cg-fr-mais li{break-inside:avoid}
@media (max-width:1100px){.cg-fr-g{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:760px){
  .cg-fr-g{grid-template-columns:minmax(0,1fr);gap:16px}
  .cg-fr{padding:16px 16px 12px}
  .cg-fr-mais{columns:1}
}

/* Cota parlamentar */
.cg-ct-cat{list-style:none;margin-top:8px;font-family:var(--ss)}
.cg-ct-cat li{display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr) max-content;align-items:center;gap:4px 14px;padding:5px 0;border-bottom:1px solid var(--rl);font-size:13px}
.cg-ct-cn{color:var(--ink)}
.cg-ct-cb{display:block;height:9px;border-radius:2px;background:var(--cg-trk)}
.cg-ct-cb i{display:block;height:100%;border-radius:2px;background:var(--link)}
.cg-ct-cv{font-family:var(--mn);font-size:12px;text-align:right;color:var(--ink)}
.cg-ct-cv small{margin-left:4px;color:var(--muted)}
.cg-ct-cat-d li{grid-template-columns:minmax(0,1fr) 70px max-content}
.cg-ct-f td{font-family:var(--mn);font-size:12px}
.cg-ls-k .cg-res{color:#fff}
:root[data-theme="dark"] .cg-ls-k .cg-res{color:#0b0f17}
.cg-ct-o .cg-ls-x small{font-family:var(--mn);font-size:11px;color:var(--muted)}
.cg-ct-o .cg-ls-x a{font-weight:600;color:var(--link);white-space:nowrap}
@media (max-width:760px){
  .cg-ct-cat li{grid-template-columns:minmax(0,1fr) max-content}
  .cg-ct-cat .cg-ct-cb{grid-column:1/-1;grid-row:2}
}

/* O atributo hidden vale mesmo onde o CSS dá display ao elemento */
.cg-cp-bar[hidden],.cg-fx-f[hidden],.cg-fx-l[hidden],.cg-casas[hidden],.cg-achar[hidden],.cg-cmpf[hidden],.cg-td[hidden],.cg-mb[hidden],.cg-esc-f[hidden],.cg-esc li[hidden],.cg-esc-m[hidden],.cg-fr-ord[hidden],.cg-fr-v[hidden],.cg-esc-mais[hidden],.cg-esc-f label[hidden]{display:none}
