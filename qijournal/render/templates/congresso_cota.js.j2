            vz.appendChild(d.createTextNode('Nenhum ' + UM + (S.pt ? ' do ' + S.pt : '') + (S.uf ? ' ' + deUf(S.uf) : '') + (S.g ? ' entre ' + rotuloFaixa() : '') + ' teve despesa' + (S.cat >= 0 ? ' com ' + minusc(catCurto()) : '') + ' ' + deJanela() + '. Aumente o período ou tire um filtro. '));
            vz.appendChild(botaoLimpar());
          }
        }
      }

      /* A parte do recorte no total da Casa, no mesmo período (só quando os dois saldos são positivos). */
      function parteDaCasa() { return R.casaAll > 0 && R.total >= 0 ? 100 * R.total / R.casaAll : null; }

      /* ── Os três números ── */
      function numero(el, n, un, linhas, acao) {
        esvaziar(el);
        el.appendChild(h('span', { cls: 'cg-pa-m-n' }, [h('b', { text: n }), un ? ' ' + un : null]));
        linhas.forEach(function (t, i) { if (t) el.appendChild(h('span', { cls: i ? 'cg-pa-m-x' : 'cg-pa-m-f', text: t })); });
        if (acao) el.appendChild(h('span', { cls: 'cg-pa-m-ir', 'aria-hidden': 'true', text: acao }));
