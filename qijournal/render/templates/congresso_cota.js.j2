          somaMes: somaMes, nMes: nMes, grCat: grCat, casaCat: casaCat, casaAll: casaAll, grAll: grAll,
          total: cat < 0 ? grAll : grCat[cat], casaTotal: cat < 0 ? casaAll : casaCat[cat],
          ord: ord, grPts: grPts, med: med, q1: q1, q3: q3, meio: meio, casaMed: casaMed, nGente: nGente, nFaixa: nf * 2 <= porTotal.length ? nf : 0,
          fora: P.filter(function (x) { return x.ex && !x.ponto && (!S.uf || x.uf === S.uf) && (!S.pt || x.pt === S.pt); }).sort(cmpNome)
        };
      }

      /* ── Os textos do recorte ── */
      function deUf(uf) { return ((CR.ufDe || {})[uf] || 'de') + ' ' + uf; }
      function emUf(uf) { var x = (CR.ufDe || {})[uf] || 'de'; return (x === 'do' ? 'no' : x === 'da' ? 'na' : 'em') + ' ' + uf; }
      function janela(longa) {
