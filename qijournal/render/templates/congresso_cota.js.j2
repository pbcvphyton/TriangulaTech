      var k = Math.pow(10, Math.floor(Math.log(maximo) / Math.LN10 + 1e-9)), opcoes = [5 * k, 2 * k, k, k / 2];
      for (var i = 0; i < opcoes.length; i++) if (maximo / opcoes[i] >= 2) return opcoes[i];
