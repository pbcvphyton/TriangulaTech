        var ord = casaPts.slice().sort(function (a, b) { return a.pm - b.pm || cmpNome(a, b); });
        var valores = ord.map(function (x) { return x.v; }).sort(function (a, b) { return a - b; });
        ord.forEach(function (x) {
          var lo = 0, hi = valores.length;
          while (lo < hi) { var mid = (lo + hi) >> 1; if (valores[mid] <= x.v) lo = mid + 1; else hi = mid; }
          x.pos = valores.length - lo + 1;
        });
        var grPts = ord.filter(function (x) { return x.gr; }), exatos = grPts.map(function (x) { return x.pm; });
        var med = null, q1 = null, q3 = null, meio = null;
        if (exatos.length) {
          var n = exatos.length;
          med = n % 2 ? exatos[(n - 1) / 2] : (exatos[n / 2 - 1] + exatos[n / 2]) / 2;
          q1 = n === 1 ? exatos[0] : quantil(exatos, 0.25);
          q3 = n === 1 ? exatos[0] : quantil(exatos, 0.75);
          /* O do meio: a medida mais próxima da mediana (empate: a menor, depois o nome). */
          grPts.forEach(function (x) {
            x.dm = Number(Math.abs(x.pm - med).toFixed(6));
            if (!meio || x.dm < meio.dm || (x.dm === meio.dm && (x.pm < meio.pm || (x.pm === meio.pm && cmpNome(x, meio) < 0)))) meio = x;
          });
        }
        var casaMed = null;
        if (comGrupo && ord.length) casaMed = ord.length % 2 ? ord[(ord.length - 1) / 2].pm : (ord[ord.length / 2 - 1].pm + ord[ord.length / 2].pm) / 2;
        R = {
