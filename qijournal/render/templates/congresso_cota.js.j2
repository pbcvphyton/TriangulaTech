        if (de === ate) return mesBr(de) + (longa ? ' (1 mês)' : '');
        var curta = de.slice(0, 4) === ate.slice(0, 4) ? MES[parseInt(de.slice(5, 7), 10) - 1] + ' a ' + mesBr(ate) : mesBr(de) + ' a ' + mesBr(ate);
        return longa ? curta + ' (' + num(n) + ' meses' + (inteira ? ' fechados' : '') + ')' : curta;
      }
      function deJanela() { return (S.i0 === S.i1 ? 'em ' : 'de ') + janela(false); }
      function catCurto() { return S.cat >= 0 ? D.cats[S.cat].curto : ''; }
      function rotuloFaixa() { return 'os ' + (CR.faixaPct || 10) + '% que ' + (S.g === 'mais' ? 'mais' : 'menos') + ' gastam'; }
      function grupoTxt() {  // "deputados do PL de SP · os 10% que menos gastam"
        var t = [];
        if (S.pt || S.uf) t.push(UNS + (S.pt ? ' do ' + S.pt : '') + (S.uf ? ' ' + deUf(S.uf) : ''));
        if (S.g) t.push(rotuloFaixa());
        return t.join(' · ');
      }
      function temFiltro() { return !!(S.cat >= 0 || S.uf || S.pt || S.g || S.i0 !== 0 || S.i1 !== D.nm - 1); }
      function unidade() { return S.cat >= 0 ? 'R$ por mês com ' + minusc(catCurto()) : 'R$ por mês com despesa'; }

      /* ── A frase "Você está vendo": cada trecho filtrado é um botão que tira só aquele filtro ── */
      function trecho(txt, tirar) {
        var b = h('button', { type: 'button', cls: 'cg-co-x', 'aria-label': 'Tirar o filtro: ' + txt }, [txt + ' ', h('span', { 'aria-hidden': 'true', text: '✕' })]);
        b.addEventListener('click', function () { tirar(); mudou(); });
        return b;
      }
      function limparTudo() { S.i0 = 0; S.i1 = D.nm - 1; S.cat = -1; S.uf = ''; S.pt = ''; S.g = ''; }
      function botaoLimpar() {
        var b = h('button', { type: 'button', cls: 'cg-pa-limpa', text: 'Limpar' });
        b.addEventListener('click', function () { limparTudo(); mudou(); });
        return b;
      }
      function renderFrase() {
        var nos = [NOME], inteira = S.i0 === 0 && S.i1 === D.nm - 1;
        function mais(no) { nos.push(' · '); nos.push(no); }
        mais(inteira ? janela(true) : trecho(janela(true), function () { S.i0 = 0; S.i1 = D.nm - 1; }));
        mais(S.cat < 0 ? 'todas as despesas' : trecho('só ' + minusc(catCurto()), function () { S.cat = -1; }));
        if (!R.comGrupo) mais('todos os ' + UNS);
        if (S.pt) mais(trecho(UNS + ' do ' + S.pt, function () { S.pt = ''; }));
        if (S.uf) mais(trecho((S.pt ? '' : UNS + ' ') + deUf(S.uf), function () { S.uf = ''; }));
        if (S.g) mais(trecho(rotuloFaixa(), function () { S.g = ''; }));
        if (REC_TXT && S.i1 >= D.nm - D.recentes) mais(h('i', { text: REC_TXT }));
        if (temFiltro()) { nos.push(' · '); nos.push(botaoLimpar()); }
        esvaziar(veT);
        nos.forEach(function (no) { veT.appendChild(typeof no === 'string' ? d.createTextNode(no) : no); });
        /* Recorte vazio: a frase diz o recorte; os gráficos mantêm a moldura. */
        if (vz) {
