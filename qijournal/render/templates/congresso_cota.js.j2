        var somaMes = zeros(nm), nMes = zeros(nm), grCat = zeros(nc), casaCat = zeros(nc), nGente = 0;
        for (i = 0; i < P.length; i++) {
          p = P[i];
          p.gr = (!S.uf || p.uf === S.uf) && (!S.pt || p.pt === S.pt) && (!S.g || p.fx === S.g);
          for (c = 0; c < nc; c++) { casaCat[c] += p.cw[c]; if (p.gr) grCat[c] += p.cw[c]; }
          if (!p.gr) continue;
          if (p.val !== 0) nGente++;
          for (m = 0; m < nm; m++) { v = cat < 0 ? p.mes[m] : p.cubo[cat * nm + m]; somaMes[m] += v; if (v > 0) nMes[m]++; }
        }
