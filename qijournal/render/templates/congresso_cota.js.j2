      var s = Math.abs(v).toFixed(casasDec), partes = s.split('.');
      return (v < 0 && parseFloat(s) !== 0 ? '-' : '') + partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + (partes[1] ? ',' + partes[1] : '');
    }
    function parInt(v) {  // o inteiro mais próximo; no empate, o par (como o round do gerador)
      var r = Math.round(v);
      return Math.abs(v % 1) === 0.5 && r % 2 !== 0 ? r - 1 : r;
    }
    function r1(v) { return Number(v.toFixed(1)); }
    function r2(v) { return Number(v.toFixed(2)); }
    function reaisC(v) { return v == null || isNaN(v) ? '—' : 'R$ ' + (Math.abs(v) < 1000 ? nPt(v, 2) : nPt(parInt(v), 0)); }
    function reaisS(v) { return v == null || isNaN(v) ? '—' : (v < 0 ? '−' : '') + reaisC(Math.abs(v)); }
    function reaisK(v) {  // valor da Casa ou de um recorte: "R$ 774,7 milhões", "R$ 84,8 mil"
      if (v == null || isNaN(v)) return '—';
      var a = Math.abs(v), sinal = v < 0 ? '−' : '';
      if (a >= 999950) { var mi = r1(a / 1e6); return sinal + 'R$ ' + nPt(mi, 1) + (mi < 2 ? ' milhão' : ' milhões'); }
      if (a >= 10000) return sinal + 'R$ ' + nPt(a / 1000, 1) + ' mil';
      return sinal + reaisC(a);
    }
    function pctC(v) {
      if (v == null || isNaN(v)) return '—';
      if ((v >= 99.5 && v < 100) || (v > 0 && v < 0.5)) return nPt(v, 1) + '%';
      return parInt(v) + '%';
    }
    function pct1(v) { return v == null || isNaN(v) ? '—' : nPt(v, 1) + '%'; }
    function mesBr(am) { return MES[parseInt(am.slice(5, 7), 10) - 1] + '/' + am.slice(0, 4); }
    function minusc(t) { return t ? t.charAt(0).toLowerCase() + t.slice(1) : ''; }
    function limitar(v, a, b) { return Math.max(a, Math.min(b, v)); }
