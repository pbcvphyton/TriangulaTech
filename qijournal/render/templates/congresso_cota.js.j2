    function zeros(n) { var a = []; for (var i = 0; i < n; i++) a.push(0); return a; }
    function texto(no, t) { if (no && no.textContent !== t) no.textContent = t; }

    lista(d.querySelectorAll('[data-cota]')).forEach(function (bloco) {
      var casa = bloco.getAttribute('data-cota');
      var NOME = bloco.getAttribute('data-nome') || '', UM = bloco.getAttribute('data-um') || 'parlamentar', UNS = bloco.getAttribute('data-uns') || 'parlamentares';
      var REC_TXT = bloco.getAttribute('data-rec') || '', NA_CASA = casa === 'cd' ? 'na Câmara' : 'no Senado';
      var form = bloco.querySelector('.cg-co-fil'), falhaEl = bloco.querySelector('.cg-co-falha');
      var ve = bloco.querySelector('.cg-co-ve'), veT = bloco.querySelector('.cg-co-ve-t'), vz = bloco.querySelector('.cg-co-vz');
      var nQuanto = bloco.querySelector('[data-n="quanto"]'), nQuem = bloco.querySelector('[data-n="quem"]'), nOque = bloco.querySelector('[data-n="oque"]');
      var pq = bloco.querySelector('[data-plot="quando"]'), pp = bloco.querySelector('[data-plot="quem"]');
      var oq = bloco.querySelector('.cg-co-oq'), card = bloco.querySelector('.cg-co-card'), navEl = bloco.querySelector('.cg-co-nav');
      var tabMeses = bloco.querySelector('[data-tab="meses"]'), tabTodos = bloco.querySelector('[data-tab="todos"]');
      var blocoPontas = bloco.querySelector('.cg-co-pls'), foraEl = bloco.querySelector('.cg-co-fo'), acharF = bloco.querySelector('.cg-co-ach');
      if (!form || !ve || !veT || !nQuanto || !nQuem || !nOque || !pq || !pp || !oq || !card || !navEl || !blocoPontas) return;
      var figQd = pq.parentNode, figQm = pp.parentNode;
      var cols = lista(pq.querySelectorAll('.cg-co-cols i')), grade = pq.querySelector('.cg-co-gr'), picoEl = pq.querySelector('.cg-co-pico');
      var unQd = figQd.querySelector('.cg-co-un'), dicaQd = figQd.querySelector('.cg-co-dica'), capQd = figQd.querySelector('figcaption');
      var pts = pp.querySelector('.cg-co-pts'), unQm = figQm.querySelector('.cg-co-un'), dicaQm = figQm.querySelector('.cg-co-dica'), capQm = figQm.querySelector('figcaption');
      var eixoQm = figQm.querySelector('.cg-co-exq'), chaveQm = figQm.querySelector('.cg-co-ch');
      var botoes = lista(oq.querySelectorAll('.cg-co-b')), outras = oq.querySelector('.cg-co-out');
      var ant = navEl.querySelector('.cg-pa-ant'), prox = navEl.querySelector('.cg-pa-prox'), posEl = navEl.querySelector('.cg-pa-pos');
      var iQuanto = nQuanto.parentNode.querySelector('.cg-i'), iQuem = nQuem.parentNode.querySelector('.cg-i'), iFaixa = form.querySelector('.cg-co-fx .cg-i');
      var dicaPadrao = { quanto: iQuanto ? iQuanto.getAttribute('data-dica') : '', quem: iQuem ? iQuem.getAttribute('data-dica') : '', faixa: iFaixa ? iFaixa.getAttribute('data-dica') : '' };
      var SEM_LIMITE = bloco.getAttribute('data-limite') || '';  // "o limite mensal muda por estado e não entra nesta conta"
      var tit = {};
      lista(bloco.querySelectorAll('[data-t]')).forEach(function (el) { tit[el.getAttribute('data-t')] = { el: el, padrao: el.textContent }; });
      var cabTodos = tabTodos ? tabTodos.querySelector('summary') : null;
      /* O cartão que veio no HTML (o parlamentar do meio): os fornecedores dele já estão ali; servem até a ficha chegar. */
      var doHtml = { k: '', nos: [] };
      (function () {
        var a = card.querySelector('a[data-k]'), q = card.querySelector('.cg-co-c-q');
        if (a && q) { doHtml.k = a.getAttribute('data-k'); doHtml.nos = lista(q.childNodes).map(function (no) { return no.cloneNode(true); }); }
      })();

      var D = null, R = null, carregando = false, falhou = false, pendente = null;
      var S = { i0: 0, i1: 0, cat: -1, uf: '', pt: '', g: '', k: '' };
      var els = {};  // chave da pessoa → o ponto dela
      lista(pts.querySelectorAll('i')).forEach(function (el) { els[el.getAttribute('data-p')] = el; });
      var ordTab = { chave: 'pos', sobe: true }, sujo = { meses: false, todos: false };
      var cursorMes = -1, sobre = null, vezFicha = 0;

      /* ── O arquivo: uma pessoa por registro, as despesas em séries de meses seguidos ── */
      function preparar(x) {
        var nm = x.meses.length, nc = x.cats.length, por = {};
        var P = x.pessoas.map(function (r) {
          var cubo = new Int32Array(nc * nm), mes = new Int32Array(nm);
          (r[5] || []).forEach(function (s) {
            for (var i = 2; i < s.length; i++) { cubo[s[0] * nm + s[1] + i - 2] = s[i]; mes[s[1] + i - 2] += s[i]; }
          });
          var p = { k: r[0], nome: r[1], pt: r[2] || '', uf: r[3] || '', ex: r[4] === 1, cubo: cubo, mes: mes, cw: new Int32Array(nc), sig: r[6] || null, b: semAcento(r[1]).replace(/[^a-z0-9&]+/g, ' ').trim() };
          var tot = 0, n = 0;
          for (var m = 0; m < nm; m++) { tot += mes[m]; if (mes[m] > 0) n++; }
          p.v0 = r2((n ? tot / n : 0) / 100);  // a medida do estado padrão (a altura do gráfico não encolhe abaixo dele)
          p.ponto0 = p.ex && n >= Math.min(CR.minimoMeses || 6, Math.ceil(nm / 2));
          por[p.k] = p;
          return p;
        });
        D = {
          meses: x.meses, nm: nm, nc: nc, P: P, por: por, recentes: Math.min(x.recentes || 0, nm), sigAte: x.sigepa_ate || '',
          cats: x.cats.map(function (c) { return { id: c[0], curto: c[1], oficial: c[2] }; })
        };
        D.catPorId = {};
        D.cats.forEach(function (c, i) { D.catPorId[c.id] = i; });
        S.i0 = 0; S.i1 = nm - 1;
      }

      /* ── A conta ── */
      function calcular() {
        var nm = D.nm, nc = D.nc, P = D.P, i0 = S.i0, i1 = S.i1, nW = i1 - i0 + 1, cat = S.cat;
        var minimo = Math.min(CR.minimoMeses || 6, Math.ceil(nW / 2)), comGrupo = !!(S.uf || S.pt || S.g);
        var i, m, c, p, v, casaPts = [];
        for (i = 0; i < P.length; i++) {
          p = P[i];
          var tot = 0, nmes = 0;
          for (m = i0; m <= i1; m++) { v = p.mes[m]; tot += v; if (v > 0) nmes++; }
          for (c = 0; c < nc; c++) {
            var s = 0, base = c * nm;
            for (m = i0; m <= i1; m++) s += p.cubo[base + m];
            p.cw[c] = s;
          }
          p.tot = tot; p.nmes = nmes; p.val = cat < 0 ? tot : p.cw[cat];
          p.pmT = nmes ? tot / nmes : 0;  // centavos por mês com despesa, no total (a régua da faixa)
          p.pm = nmes ? p.val / nmes : 0;  // na medida do eixo (o total ou a despesa escolhida)
          p.v = r2(p.pm / 100);  // em reais, como a página mostra
          p.ponto = p.ex && nmes >= minimo;
          p.fx = '';
          if (p.ponto) casaPts.push(p);
        }
        /* A faixa: os 10% de menor e de maior gasto por mês no total, entre os pontos da Casa. */
        var nf = parInt(casaPts.length * (CR.faixaPct || 10) / 100);
        var porTotal = casaPts.slice().sort(function (a, b) { return a.pmT - b.pmT || cmpNome(a, b); });
        if (nf * 2 <= porTotal.length) {
          for (i = 0; i < nf; i++) { porTotal[i].fx = 'menos'; porTotal[porTotal.length - 1 - i].fx = 'mais'; }
        }
