{#- Aba "Analítico Político": como a imprensa cobre a política. A página se organiza pelo
    que os dados têm a dizer: a leitura (manchete e achados), as três lentes (manchetes,
    enquadramento, texto) e, recolhida, a base completa do termômetro.
    Variáveis: a (AnaliticoView), nm (DestaquesView ou none), brand, home_href, archive_href,
    base_url, repo_url. Blocos em analitico_lentes.html.j2; estilos em analitico.css.j2. -#}
{% extends "layout.html.j2" %}
{% import "termometro.html.j2" as tm %}
{% import "macros.html.j2" as m %}
{% import "analitico_lentes.html.j2" as an %}

{% block title %}{{ brand.name }} — Analítico Político{% endblock %}
{% block description %}Como a imprensa cobre a política: de quem fala e em que tom, onde os veículos racham e o que o Termômetro de Viés Editorial diz do texto, com a prova de cada achado.{% endblock %}
{% block meta %}
<link rel="canonical" href="{{ base_url }}edicoes/analitico.html">
{% endblock %}
{% block home_link %}{{ home_href }}{% endblock %}
{% block dateline %}Analítico Político{% if a.atualizado %}&nbsp;· <span class="nw">atualizado em {{ a.atualizado }}</span>{% endif %}{% endblock %}

{% block tools %}
    <a class="tool" href="{{ archive_href }}" title="Edições anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span>Edições</span></a>
    {% if brand.congresso %}{{ m.congresso_tool(archive_href) }}{% endif %}
    {{ m.search_tool(archive_href) }}
{% endblock %}

{% block styles %}
{% if nm %}{% include "midia.css.j2" %}{% endif %}
{% include "analitico.css.j2" %}
{% endblock %}

{#- Um bloco da base completa: fechado, com o que tem dentro escrito no título. -#}
{% macro base(id, titulo, resumo, aberto=False) -%}
<details class="az-base" id="{{ id }}"{% if aberto %} open{% endif %}>
  <summary><span class="az-base-t">{{ titulo }}</span>{% if resumo %}<span class="az-base-r">{{ resumo }}</span>{% endif %}</summary>
  <div class="az-base-in">
{{ caller() }}
  </div>
</details>
{%- endmacro %}

{% block content %}
<section class="an az" id="analitico" aria-labelledby="an-h">
  <div class="arch-top">
    <h2 class="kicker" id="an-h">Analítico Político</h2>
    <a class="arch-home" href="{{ home_href }}">&larr; Edição mais recente</a>
  </div>
  <nav class="az-nav" id="azNav" aria-label="Nesta página">
    <ul>
      {% if a.leitura %}<li><a href="#an-leitura">A leitura</a></li>{% endif %}
      {% if nm %}<li><a href="#an-nomes"><b>{{ a.ordens.manchetes }}</b>Manchetes</a></li>{% endif %}
      {% if a.lados %}<li><a href="#an-lados"><b>{{ a.ordens.lados }}</b>Enquadramento</a></li>{% endif %}
      <li><a href="#an-texto"><b>{{ a.ordens.texto }}</b>Texto</a></li>
      {% if not a.vazio %}<li><a href="#an-base">Base completa</a></li>{% endif %}
      <li><a href="#an-metodo">Como ler</a></li>
    </ul>
  </nav>

  {% if a.leitura %}{{ an.leitura(a.leitura, a.placar) }}{% endif %}

  {% if nm %}
  <section class="az-sec" aria-labelledby="an-nomes-h">
    <header class="az-lh" id="an-nomes">
      <p class="az-ln"><b>{{ a.ordens.manchetes }}</b>Manchetes</p>
      <h3 class="az-lt" id="an-nomes-h">De quem a imprensa fala, e em que tom</h3>
      <p class="az-ld">Os nomes mais citados nas {{ "{:,}".format(nm.manchetes).replace(",", ".") }} manchetes de {{ nm.secao_titulo }} das edições de {{ nm.periodo }} ({{ nm.edicoes }} {{ "edição" if nm.edicoes == 1 else "edições" }}): quanto espaço cada um ocupa, se sobe ou cai, em que contexto aparece e que veículo destoa.</p>
    </header>
    {{ an.placar(a.placar, nm) }}
    {% if a.matriz %}{{ an.matriz(a.matriz) }}{% endif %}
  </section>
  {% endif %}

  {% if a.lados %}{% set ld = a.lados %}
  <section class="az-sec" aria-labelledby="an-lados-h">
    <header class="az-lh" id="an-lados">
      <p class="az-ln"><b>{{ a.ordens.lados }}</b>Enquadramento</p>
      <h3 class="az-lt" id="an-lados-h">Onde a imprensa rachou</h3>
      <p class="az-ld">O mesmo fato, dois enfoques. Nos {{ "{:,}".format(ld.comparados).replace(",", ".") }} assuntos de {{ ld.secao_titulo }} que dois ou mais veículos cobriram nas edições de {{ ld.periodo }}: onde eles tomaram lados diferentes, quem fica com quem e quem destoa.</p>
    </header>
    {{ an.lados(ld) }}
  </section>
  {% endif %}

  <section class="az-sec" aria-labelledby="an-texto-h">
    <header class="az-lh" id="an-texto">
      <p class="az-ln"><b>{{ a.ordens.texto }}</b>Texto</p>
      <h3 class="az-lt" id="an-texto-h">Como as reportagens escrevem: o termômetro</h3>
      <p class="az-ld">{{ a.intro }}</p>
    </header>
    {% if not a.vazio %}
    {% set r = a.em_resumo %}
    {% if r %}
    <div class="az-blk an-res" id="an-resumo">
      <h4 class="az-h">O que o termômetro diz</h4>
      <p class="an-res-t">{{ r.titulo }}</p>
      <ul class="an-res-l">
        {% for f in r.frases %}<li>{{ f }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    <div class="az-blk">
      <h4 class="az-h" id="an-onde">Onde estamos</h4>
      {% if a.gauge %}{{ tm.placar(a.gauge, "T médio de todo o histórico", a.base) }}{% else %}<p class="tm-dek">{{ a.resumo }}.</p>{% endif %}
      {{ tm.indicadores(a.tiles) }}
      {% if a.indo.resumo %}<p class="az-indo"><b>Para onde vamos.</b> {{ a.indo.resumo }} <a href="#an-indo">Ver a tendência e a janela recente <span aria-hidden="true">&darr;</span></a></p>{% endif %}
    </div>

    {#- À esquerda, o padrão (os desvios, os sinais por critério e por veículo); à direita, a
        prova (os textos mais inclinados, com a citação que pesou). -#}
    <div class="az-2c az-2c-t">
      <div class="az-col">
        {% if a.desvios %}{% set d = a.desvios %}
        <div class="az-blk" id="an-desvios">
          <h4 class="az-h">Os desvios <span>as {{ d.esq + d.dir }} {{ "notícia que saiu" if d.esq + d.dir == 1 else "notícias que saíram" }} do zero</span></h4>
          <p class="az-ph">{{ d.titulo }}.</p>
          {{ an.desvios(d) }}
          <p class="az-dek">{{ d.leitura }}</p>
        </div>
        {% endif %}
        {% if r %}
        <div class="az-blk">
          <h4 class="az-h" id="an-sinais">Onde aparecem os sinais <span>por critério e lado</span></h4>
          <p class="az-dek">Sinais confirmados no texto de todas as notícias do histórico, por critério e lado favorecido.</p>
          <div class="az-sg">{{ tm.sinais(r.sinais) }}</div>
        </div>
        {% if r.veiculos %}
        <div class="az-blk">
          <h4 class="az-h" id="an-desig">Tratamento desigual, por veículo</h4>
          <p class="az-dek">Parte das notícias de cada veículo com algum sinal à esquerda ou à direita (veículos com 10 ou mais notícias analisadas).</p>
          <ol class="an-crit">
            {% for v in r.veiculos %}
            <li><span class="an-cn">{{ v.nome }}</span><span class="an-cb" aria-hidden="true"><i class="neu" style="width:{{ v.barra }}%"></i></span><span class="an-cv"><b>{{ v.pct }}</b> · {{ v.com_sinal }} de {{ v.textos }}</span></li>
            {% endfor %}
          </ol>
        </div>
        {% endif %}
        {% endif %}
      </div>
      <div class="az-col">
        {% if a.inclinados %}
        <div class="az-blk" id="an-pendeu">
          <h4 class="az-h">{{ a.inclinados_titulo }} <span>com o sinal que mais pesou</span></h4>
          <ol class="az-incs">
            {% for i in a.inclinados %}{{ an.inclinado(i) }}{% endfor %}
          </ol>
          {% if a.recordes %}
          <h5 class="az-h5">Os mais inclinados de todo o histórico</h5>
          <ol class="az-recs">
            {% for x in a.recordes %}{{ an.curto(x) }}{% endfor %}
          </ol>
          {% endif %}
        </div>
        {% endif %}
        {% if a.opiniao %}
        <div class="az-blk" id="an-opiniao">
          <h4 class="az-h">Opinião, à parte <span>colunas, editoriais e análises não entram na média</span></h4>
          <ol class="az-recs">
            {% for x in a.opiniao %}{{ an.curto(x) }}{% endfor %}
          </ol>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="az-blk" id="an-q">
      <h4 class="az-h">Qualidade da apuração <span>de 0 a 100, pelo que o texto mostra</span></h4>
      {% if a.q_partes %}{% set q = a.q_partes %}
      <div class="az-qp">
        <div class="az-qp-bar" role="img" aria-label="{{ q.aria }}">{% for classe, rotulo, n, largura, parcela in q.partes %}<span class="az-q-{{ classe }}" style="width:{{ largura }}%" title="{{ rotulo }}: {{ n }} {{ "notícia" if n == 1 else "notícias" }} ({{ parcela }})"></span>{% endfor %}</div>
        <ul class="az-qp-k">{% for classe, rotulo, n, largura, parcela in q.partes %}<li><i class="az-q-{{ classe }}" aria-hidden="true"></i>{{ rotulo }} <b>{{ parcela }}</b> <span>{{ n }} {{ "notícia" if n == 1 else "notícias" }}</span></li>{% endfor %}</ul>
      </div>
      {% endif %}
      {% if a.qualidade %}
      {% if a.q_firmes %}
      <p class="az-dek">Veículos com {{ a.q_minimo }} ou mais notícias com T (a nota ajustada puxa os grupos pequenos para a média geral).</p>
      <ol class="qb">
        {% for q in a.q_firmes %}
        <li><span class="rk-n">{{ q.nome }}</span><span class="qb-bar" aria-hidden="true"><span style="width:{{ q.pct }}%"></span></span><span class="rk-v"><b>{{ q.valor }}</b> {{ q.rotulo }}<span class="rk-x">{{ q.detalhe }}</span></span></li>
        {% endfor %}
      </ol>
      {% endif %}
      {% if a.q_pequenas %}
      <details class="az-more"{% if not a.q_firmes %} open{% endif %}>
        <summary>{{ "Ver" if a.q_firmes else "Só há" }} {{ "o veículo" if a.q_pequenas|length == 1 else "os " ~ a.q_pequenas|length ~ " veículos" }} com amostra pequena (menos de {{ a.q_minimo }} notícias)</summary>
        <ol class="qb">
          {% for q in a.q_pequenas %}
          <li class="rk-pq"><span class="rk-n">{{ q.nome }}</span><span class="qb-bar" aria-hidden="true"><span style="width:{{ q.pct }}%"></span></span><span class="rk-v"><b>{{ q.valor }}</b> {{ q.rotulo }}<span class="rk-x">{{ q.detalhe }}</span></span></li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}
      {% else %}
      <p class="term-note">{{ a.qualidade_fora }}</p>
      {% endif %}
      {% if r and r.checklist %}
      <div class="az-ck">
        <h5 class="az-h5" id="an-check">Item a item <span>em quantas notícias cada boa prática aparece, entre as {{ r.checklist.textos }} que guardam o checklist</span></h5>
        {{ tm.checklist(r.checklist) }}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </section>

  {% if not a.vazio %}
  <section class="az-sec az-bases" aria-labelledby="an-base-h">
    <header class="az-lh" id="an-base">
      <p class="az-ln">Para conferir</p>
      <h3 class="az-lt" id="an-base-h">Base completa do termômetro</h3>
      <p class="az-ld">Tudo o que sustenta a lente do texto, bloco a bloco: abra o que quiser conferir. Os números usam todo o histórico ({{ a.periodo }}).</p>
    </header>

    {% if a.distribuicao %}
    {% call base("an-dist", "Distribuição por faixa", a.bases.faixas) %}
    <p class="term-note">Quantas notícias de todo o histórico caíram em cada faixa do termômetro.</p>
    <div class="az-dist">{{ tm.dist(a.distribuicao) }}</div>
    {% endcall %}
    {% endif %}

    {% call base("an-indo", "Para onde estamos indo", a.indo.resumo, a.indo.aberto) %}
    <ul class="an-reads">
      {% for r in a.leituras %}
      <li class="rd-{{ r.classe }}"><span class="an-tl">{{ r.titulo }}</span><b>{{ r.leitura }}</b><p>{{ r.texto }}</p></li>
      {% endfor %}
    </ul>
    {% if a.puxadores %}
    <div class="an-pux">
      {% for titulo, itens in a.puxadores %}
      <div class="an-tbl-wrap">
        <table class="an-tbl">
          <caption>Quem puxou a mudança · {{ titulo }}</caption>
          <thead><tr><th scope="col">Grupo</th><th scope="col">Contribuição</th><th scope="col">Inclinação</th><th scope="col">Pauta</th><th scope="col" class="an-l">No grupo</th></tr></thead>
          <tbody>
            {% for p in itens %}
            <tr><th scope="row">{{ p.nome }}</th><td>{{ p.contribuicao }}</td><td>{{ p.inclinacao }}</td><td>{{ p.pauta }}</td><td class="an-l">{{ p.leitura }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% endcall %}

    {% call base("an-series", "Semana a semana", a.bases.series) %}
    {% if a.series_msg %}<p class="term-note">{{ a.series_msg }}</p>{% endif %}
    {% for s in a.series %}
    <figure class="ts">
      <figcaption>{{ s.titulo }}</figcaption>
      <div class="ts-plot" role="img" aria-label="{{ s.aria }}">
        {% for top, rot in s.grade %}<span class="ts-g" style="top:{{ top }}%"><i>{{ rot }}</i></span>{% endfor %}
        {% if s.zero is not none %}<span class="ts-g ts-z" style="top:{{ s.zero }}%"></span>{% endif %}
        <svg class="ts-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
          <path class="ts-band" d="{{ s.faixa }}"/>
          <path class="ts-line" d="{{ s.linha }}" vector-effect="non-scaling-stroke"/>
        </svg>
        {% for p in s.pontos %}<span class="ts-pt" style="left:{{ p.left }}%;top:{{ p.top }}%" title="{{ p.title }}"></span>{% endfor %}
      </div>
      <div class="ts-x" aria-hidden="true">{% for left, rot in s.eixo_x %}<span style="left:{{ left }}%">{{ rot }}</span>{% endfor %}</div>
    </figure>
    {% endfor %}
    {% endcall %}

    {% for r in a.rankings %}
    {% call base("an-rk-" ~ loop.index, "Ranking · " ~ r.titulo, a.bases.veiculos if loop.first else a.bases.editorias) %}
    {% if r.itens %}
    {% if r.nota %}<p class="term-note rk-nota">{{ r.nota }}</p>{% endif %}
    <ol class="rk">
      {% for i in r.itens %}
      <li class="rk-i{% if i.pequena %} rk-pq{% endif %}" title="{{ i.title }}">
        <span class="rk-n">{{ i.nome }}</span>
        <span class="rk-p" aria-hidden="true"><span class="rk-z" style="left:{{ r.zero }}%"></span>{% if i.ic_left is not none %}<span class="rk-ic" style="left:{{ i.ic_left }}%;width:{{ i.ic_width }}%"></span>{% endif %}<span class="rk-d" style="left:{{ i.pct }}%"><i class="t-{{ i.classe }}"></i></span></span>
        <span class="rk-v"><b>{{ i.valor }}</b> {{ i.rotulo }}<span class="rk-x">{{ i.detalhe }}</span></span>
      </li>
      {% endfor %}
    </ol>
    <div class="rk-axis" aria-hidden="true"><span class="rk-n"></span><span class="rk-p">{% for left, rot in r.escala %}<i style="left:{{ left }}%">{{ rot }}</i>{% endfor %}</span><span class="rk-v"></span></div>
    {% endif %}
    {% if r.fora %}<p class="term-note">{{ r.fora }}</p>{% elif not r.itens %}<p class="term-note">Sem grupos no ranking ainda.</p>{% endif %}
    {% endcall %}
    {% endfor %}

    {% if a.eixos %}
    {% call base("an-eixos", "Por eixo", a.bases.eixos) %}
    <div class="an-tbl-wrap">
      <table class="an-tbl">
        <thead><tr><th scope="col">Eixo</th><th scope="col">Textos</th><th scope="col">Com T</th><th scope="col">T médio</th><th scope="col" class="an-l">Rótulo</th><th scope="col">Qualidade</th></tr></thead>
        <tbody>
          {% for e in a.eixos %}
          <tr><th scope="row">{{ e.nome }}</th><td>{{ e.textos }}</td><td>{{ e.validas }}</td><td><i class="sw t-{{ e.classe }}" aria-hidden="true"></i>{{ e.valor }}</td><td class="an-l">{{ e.rotulo }}</td><td>{{ e.q }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endcall %}
    {% endif %}

    {% call base("an-dias", "Dia a dia", a.bases.dias) %}
    <p class="term-note">Por data de publicação dos textos; o link abre a edição em que eles foram analisados.</p>
    <div class="an-tbl-wrap">
      <table class="an-tbl">
        <thead><tr><th scope="col">Publicação</th><th scope="col">Textos</th><th scope="col">Notícias com T</th><th scope="col">T médio</th><th scope="col" class="an-l">Rótulo</th><th scope="col">Qualidade</th></tr></thead>
        <tbody>
          {% for d in a.dias %}
          <tr><th scope="row">{% if d.href %}<a href="{{ d.href }}">{{ d.nome }}</a>{% else %}{{ d.nome }}{% endif %}</th><td>{{ d.textos }}</td><td>{{ d.validas }}</td><td><i class="sw t-{{ d.classe }}" aria-hidden="true"></i>{{ d.valor }}</td><td class="an-l">{{ d.rotulo }}</td><td>{{ d.q }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endcall %}

    {% call base("an-todas", "Todas as análises", a.bases.todas) %}
    <p class="term-note">Uma linha por texto, do mais recente para o mais antigo. Clique na linha para abrir o texto original (em nova aba) e conferir; o resumo do cálculo e os sinais de cada texto ficam no Termômetro do dia da edição.</p>
    <div class="az-fil" id="azFil" hidden>
      <label class="sr-only" for="azQ">Filtrar as análises por veículo, título ou rótulo</label>
      <input class="az-fil-in" id="azQ" type="search" autocomplete="off" spellcheck="false" placeholder="Filtrar: veículo, palavra do título, rótulo…">
      <label class="az-fil-ck"><input type="checkbox" id="azNz"> só com T diferente de zero</label>
      <span class="az-fil-n" id="azN" role="status"></span>
    </div>
    {% for mes in a.meses %}
    <details class="term-det"{% if mes.aberto %} open{% endif %}>
      <summary>{{ mes.rotulo }}</summary>
      <ol class="tl-list">
        {% for x in mes.analises %}
        {{ tm.linha(x) }}
        {% endfor %}
      </ol>
    </details>
    {% endfor %}
    {% if a.lista_fora %}
    <p class="term-note tl-fora">A lista mostra as {{ a.lista_total - a.lista_fora }} análises mais recentes de {{ a.lista_total }}. As {{ a.lista_fora }} análises mais antigas estão na <a href="{{ a.pesquisa_href }}">Pesquisa analítica</a> (tipo Termômetro), com busca, filtros e CSV; os números desta página usam todo o histórico.</p>
    {% endif %}
    {% endcall %}
  </section>
  {% endif %}

  <section class="az-sec az-met" aria-labelledby="an-metodo-h">
    <header class="az-lh" id="an-metodo">
      <p class="az-ln">Método</p>
      <h3 class="az-lt" id="an-metodo-h">Como ler</h3>
    </header>
    <dl class="az-dl">
      {% for titulo, texto in a.metodo %}
      <div><dt>{{ titulo }}</dt><dd>{{ texto }}</dd></div>
      {% endfor %}
    </dl>
  </section>
</section>
{% endblock %}

{% block footer %}
<footer class="ft">
  <p><strong>{{ brand.name }}</strong> · Analítico Político · cálculo v{{ a.versao }}{% if a.periodo %} · {{ a.periodo }}{% endif %}</p>
  <p class="ft-links"><a href="{{ home_href }}">Edição mais recente</a> · <a href="{{ archive_href }}">Edições anteriores</a>{% if repo_url %} · <a href="{{ repo_url }}" rel="noopener">Código-fonte</a>{% endif %}</p>
</footer>
{% endblock %}

{% block after %}
<script>
{% include "analitico.js.j2" %}
</script>
{% endblock %}
