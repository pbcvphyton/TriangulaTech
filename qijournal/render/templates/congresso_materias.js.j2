    bloco.hidden = false;
    conta.textContent = 'carregando…';
    materiasDa(casa, function (erro, mat) {
      if (erro) { conta.textContent = 'não foi possível carregar agora'; return; }
      var todas = [];
      Object.keys(mat.materias).forEach(function (t) {
        var m = mat.materias[t], votos = m.vot || [];
        if (!votos.length) return;
        var conteudo = votos.filter(function (v) { return v.t === 'merito' || v.t === 'destaque'; });
        todas.push({
          t: t, m: m, n: votos.length, div: votos.filter(function (v) { return v.dv; }).length, ultima: votos[votos.length - 1],
          conteudo: conteudo.length, busca: semAcento([t, m.ap || '', m.e || '', m.ex || '', (m.kw || []).join(' ')].join(' '))
        });
      });
      todas.sort(function (a, b) { return a.ultima.d < b.ultima.d ? 1 : a.ultima.d > b.ultima.d ? -1 : 0; });
      var temas = {};
      todas.forEach(function (x) { (x.m.tm || []).forEach(function (t) { temas[t] = (temas[t] || 0) + 1; }); });
      Object.keys(temas).sort(function (a, b) { return temas[b] - temas[a]; }).forEach(function (t) {
        sel.appendChild(h('option', { value: t, text: nomeDoTema(t) + ' (' + temas[t] + ')' }));
      });
      var mostrados = MB_PAGINA;
      function desenhar() {
        var termos = semAcento(q.value).split(/\s+/).filter(Boolean), tema = sel.value, soDiv = so.checked;
        var achadas = todas.filter(function (x) {
          return (!tema || (x.m.tm || []).indexOf(tema) >= 0) && (!soDiv || x.div) && termos.every(function (t) { return x.busca.indexOf(t) >= 0; });
        });
        while (ol.firstChild) ol.removeChild(ol.firstChild);
        achadas.slice(0, mostrados).forEach(function (x) {
          var u = x.ultima, res = resultadoDaVotacao(u);
          var extras = [h('span', { cls: 'cg-chip' }, [h('b', { text: num(x.n) }), x.n === 1 ? ' votação nominal' : ' votações nominais'])];
          if (x.div) extras.push(h('span', { cls: 'cg-div', text: x.div === 1 ? '1 dividiu os polos' : x.div + ' dividiram os polos' }));
          var lados = ladosNoTexto(x.m);
          if (lados) extras.push(h('span', { cls: 'cg-td-lado', text: lados }));
          ol.appendChild(h('li', { cls: 'cg-td-m' }, [
            cabecaDaMateria(casa, x.t, x.m, extras),
            h('p', { cls: 'cg-mh-e', text: curto(x.m.e, 260) }),
            h('p', { cls: 'cg-mh-u', text: 'Última votação: ' + dataBr(u.d) + ' · ' + tipoDaVotacao(u) + (res ? ' · ' + res : '') + ' · ' + num(u.s) + ' × ' + num(u.n) + ((x.m.tm || []).length ? ' · ' + x.m.tm.map(nomeDoTema).join(', ') : '') })
          ]));
        });
        if (achadas.length > mostrados) ol.appendChild(h('li', { cls: 'cg-mb-m' }, [botaoMais('mostrar mais ' + Math.min(MB_PAGINA, achadas.length - mostrados) + ' de ' + (achadas.length - mostrados), function () { mostrados += MB_PAGINA; desenhar(); })]));
        conta.textContent = plural(achadas.length, 'matéria', 'matérias');
      }
      function refazer() { mostrados = MB_PAGINA; desenhar(); }
      q.addEventListener('input', refazer);
      sel.addEventListener('change', refazer);
      so.addEventListener('change', refazer);
      desenhar();
    });
  }
  aoAbrirVista.votacoes = function () {
    lista(root.querySelectorAll('[data-materias]')).forEach(function (bloco) {
      var casaVista = root.getAttribute('data-ver');
      if (!casaVista || bloco.getAttribute('data-materias') === casaVista) iniciarBuscador(bloco);
    });
  };
