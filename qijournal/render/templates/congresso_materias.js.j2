{#- Aba Congresso: a ficha de cada matéria, o detalhe de cada tema e os votos de cada um por
    tema (incluído por congresso.js.j2, dentro da mesma função). Tudo sai de
    data/congresso/materias-<casa>.json, lido só quando alguém abre um detalhe, e, para o voto
    de cada pessoa, de votos-<casa>.json. Sempre com textContent: nada do arquivo vira HTML. -#}
  /* ════ As matérias ════ */
  var cacheMat = {}, filaMat = {};
  function materiasDa(casa, pronto) {
    if (cacheMat[casa]) { pronto(null, cacheMat[casa]); return; }
    if (filaMat[casa]) { filaMat[casa].push(pronto); return; }
    filaMat[casa] = [pronto];
    buscar(M.materiasArq + casa + '.json', function (erro, x) {
      var ok = !erro && x && x.materias;
      if (ok) cacheMat[casa] = x;
      var fila = filaMat[casa];
      filaMat[casa] = null;
      fila.forEach(function (fn) { fn(ok ? null : (erro || new Error('formato')), cacheMat[casa]); });
    });
  }
  function chaveDaMateria(casa, titulo) {
    var m = /^([A-Z]+) (\d+)\/(\d{4})$/.exec(titulo || '');
    return m ? casa + '-' + m[1] + '-' + m[2] + '-' + m[3] : '';
  }
  function materiaDaChave(k) {
    var m = /^(cd|sf)-([A-Z]+)-(\d+)-(\d{4})$/.exec(k || '');
    return m ? { casa: m[1], titulo: m[2] + ' ' + m[3] + '/' + m[4] } : null;
  }
  /* id da votação → { t: matéria, m: ficha, v: votação } */
  function indiceDeVotacoes(mat) {
    if (!mat._idx) {
      mat._idx = {};
      Object.keys(mat.materias).forEach(function (t) {
        (mat.materias[t].vot || []).forEach(function (v) { mat._idx[v.id] = { t: t, m: mat.materias[t], v: v }; });
      });
    }
    return mat._idx;
  }
  function curto(texto, limite) {
    texto = texto || '';
    if (texto.length <= limite) return texto;
    var corte = texto.slice(0, limite + 1), i = corte.lastIndexOf(' ');
    return (i > limite * 0.6 ? corte.slice(0, i) : corte.slice(0, limite)).replace(/[ ,;:.–—-]+$/, '') + '…';
  }
  function plural(n, um, varios) { return num(n) + ' ' + (n === 1 ? um : varios); }
  function nomeDoTema(t) { return (M.temas || {})[t] || t; }
  /* O que entra num tema: as áreas temáticas oficiais da Casa. */
  function definicaoDoTema(t, casa) {
    var def = (M.temasDef || {})[t], areas = def ? (def[casa] || []) : [];
    if (!areas.length) return '';
    return (casa === 'cd' ? 'Matérias que a Câmara classifica em ' : 'Matérias que o Senado classifica em ') +
      areas.map(function (a) { return '“' + a + '”'; }).join(areas.length > 2 ? ', ' : ' e ') + '.';
  }
  function chipDoTema(t, casa) {
    var def = definicaoDoTema(t, casa);
    return h('span', { cls: 'cg-chip' + (def ? ' cg-tem' : ''), 'data-dica': def || null, tabindex: def ? '0' : null, text: nomeDoTema(t) });
  }

  /* As dicas: um rótulo com data-dica mostra a definição ao passar o ponteiro, ao receber o foco ou ao toque. */
  var GLOSS = {
    saldo: 'De −100 (votou sempre com a esquerda) a +100 (sempre com a direita). Conta só as votações de conteúdo em que a maioria da esquerda e a da direita ficaram em lados opostos: (votos com a direita − votos com a esquerda) ÷ votações.',
    divisivas: 'Votações de conteúdo (texto principal, destaques e emendas) em que esquerda e direita ficaram em lados opostos e a pessoa votou Sim ou Não. São as que entram no saldo.',
    governo: 'Nas votações em que a liderança do Governo orientou Sim ou Não, a parte em que a pessoa votou igual. Obstrução conta como Não.',
    presenca: 'A parte das votações nominais em que a pessoa podia votar e votou.',
    partido: 'A parte dos votos iguais ao da maioria do próprio partido naquele dia.',
    simnao: 'Quantas vezes votou Sim e quantas votou Não em todas as votações do tema, não só nas que opuseram os polos.',
    vira: 'O tema fica do lado oposto ao do saldo geral, e a diferença passa do acaso (teste binomial, 99%).',
    nota: 'Nota de relevância, de 0 a 100: soma de sinais que dá para medir nos registros (projetos parecidos anexados, origem, alcance da norma, apoio entre partidos). Não diz se a matéria é boa.',
    polos: 'Esquerda: ' + ((M.polos || {}).esquerda || []).join(', ') + '. Direita: ' + ((M.polos || {}).direita || []).join(', ') + '. O lado de cada polo numa votação é o da maioria dos seus parlamentares (75% ou mais).',
    juntos: 'Das votações de conteúdo em que os dois votaram Sim ou Não, a parte em que votaram igual.',
    contagem: 'Sim–Não de cada partido do polo nessa votação.'
  };
  function dica(chave) {
    return h('button', { cls: 'cg-i', type: 'button', 'aria-label': 'O que é isto', 'data-dica': GLOSS[chave] || chave, text: 'i' });
  }
  var popDica = null, donoDaDica = null;
  function mostrarDica(el) {
    var texto = el.getAttribute('data-dica');
    if (!texto) return;
    if (!popDica) { popDica = h('div', { cls: 'cg-dica', role: 'tooltip' }); d.body.appendChild(popDica); }
    popDica.textContent = texto;
    popDica.hidden = false;
    donoDaDica = el;
    var r = el.getBoundingClientRect(), largura = Math.min(320, w.innerWidth - 24);
    popDica.style.maxWidth = largura + 'px';
    var x = Math.max(12, Math.min(r.left + r.width / 2 - popDica.offsetWidth / 2, w.innerWidth - popDica.offsetWidth - 12));
    var y = r.bottom + 8;
    if (y + popDica.offsetHeight > w.innerHeight - 8) y = Math.max(8, r.top - popDica.offsetHeight - 8);
    popDica.style.left = x + 'px';
    popDica.style.top = y + 'px';
  }
  function esconderDica() { if (popDica) popDica.hidden = true; donoDaDica = null; }
  d.addEventListener('mouseover', function (ev) { var el = ev.target.closest ? ev.target.closest('[data-dica]') : null; if (el) mostrarDica(el); else if (donoDaDica) esconderDica(); });
  d.addEventListener('focusin', function (ev) { var el = ev.target.closest ? ev.target.closest('[data-dica]') : null; if (el) mostrarDica(el); });
  d.addEventListener('focusout', esconderDica);
  d.addEventListener('click', function (ev) {
    var el = ev.target.closest ? ev.target.closest('[data-dica]') : null;
    if (el) { if (donoDaDica === el && ev.detail === 0) esconderDica(); else mostrarDica(el); } else esconderDica();
  });
  w.addEventListener('scroll', esconderDica, true);

  /* ── Uma votação, por extenso ── */
  var LADO = { S: 'Sim', N: 'Não' };
  var SENTIDO = {
    texto: 'O Sim era para aprovar o texto em votação.',
    emenda: 'O Sim era para aprovar a emenda.',
    trecho: 'O Sim era para manter no texto o trecho destacado; o Não, para retirá-lo.',
    requerimento: 'O Sim era para aprovar o requerimento.'
  };
  var SENTIDO_CURTO = { texto: 'Sim = aprovar o texto', emenda: 'Sim = aprovar a emenda', trecho: 'Sim = manter o trecho', requerimento: 'Sim = aprovar o requerimento' };
  function tipoDaVotacao(v) { return ((M.tipos || {})[v.t] || v.t) + (v.tu ? ', ' + v.tu + 'º turno' : ''); }
  function resultadoDaVotacao(v) {
    if (v.apv == null) return '';
    if (v.ss === 'trecho') return v.apv ? 'trecho mantido' : 'trecho retirado';
    if (v.ss === 'emenda') return v.apv ? 'emenda aprovada' : 'emenda rejeitada';
    if (v.ss === 'requerimento') return v.apv ? 'requerimento aprovado' : 'requerimento rejeitado';
    return v.apv ? 'aprovado' : 'rejeitado';
  }
  function chipDosPolos(v) {
    if (v.dv) return h('span', { cls: 'cg-div', text: 'dividiu os polos' });
    if (v.rc) return h('span', { cls: 'cg-div cg-div-r', text: 'racha: ' + Object.keys(v.rc).map(function (s) { return s + ' com a ' + v.rc[s]; }).join(', ') });
    if (v.e && v.dr && v.e === v.dr) return h('span', { cls: 'cg-div cg-div-j', text: 'os polos votaram juntos' });
    return null;
  }
  /* Com que polo um voto ficou. */
  function ladoDoVoto(v, voto) {
    var p = voto === 'O' ? 'N' : voto;
    if (p !== 'S' && p !== 'N') return '';
    if (v.e && v.dr) {
      if (v.e === v.dr) return p === v.e ? 'j' : 'x';
      return p === v.e ? 'e' : 'd';
    }
    return '';
  }
  var COM = { e: 'com a esquerda', d: 'com a direita', j: 'com os dois polos', x: 'contra os dois polos' };
  function contagemDoPolo(v, polo) {
    return (v.pp || []).filter(function (x) { return x[3] === polo; }).map(function (x) { return x[0] + ' ' + x[1] + '–' + x[2]; }).join(' · ');
  }
  function linhaDosPolos(v) {
    function um(nome, lado, polo) {
      var conta = contagemDoPolo(v, polo);
      return h('span', { cls: 'cg-pl cg-pl-' + polo }, [h('b', { text: nome + ': ' + (lado ? LADO[lado] : 'sem maioria clara') }), conta ? h('small', { text: ' (' + conta + ')' }) : null]);
    }
    var nos = [um('Esquerda', v.e, 'e'), h('span', { cls: 'cg-pl-x', 'aria-hidden': 'true', text: '×' }), um('Direita', v.dr, 'd')];
    if (v.g) nos.push(h('span', { cls: 'cg-pl cg-pl-g' }, [h('b', { text: 'Governo: ' + LADO[v.g] })]));
    return h('p', { cls: 'cg-vl-p' }, nos);
  }
  function chipDaPessoa(v, p) {
    var lado = ladoDoVoto(v, p.voto), nomeVoto = (M.votos || {})[p.voto] || p.voto;
    return h('span', { cls: 'cg-vp' + (lado ? ' cg-vp-' + lado : ' cg-vp-0') }, [p.nome ? p.nome + ': ' : '', h('b', { text: nomeVoto }), lado ? ' · ' + COM[lado] : '']);
  }
  /* opts: pessoas [{nome, voto}], completo (os demais partidos), curto (uma linha a menos) */
  function itemDaVotacao(v, opts) {
    opts = opts || {};
    var res = resultadoDaVotacao(v);
    var nos = [h('p', { cls: 'cg-vl-k' }, [
      h('time', { text: dataBr(v.d) }), h('span', { cls: 'az-selo', text: tipoDaVotacao(v) }),
      res ? h('span', { cls: 'cg-res cg-res-' + (v.apv ? 'ok' : 'no'), text: res }) : null,
      h('span', { cls: 'cg-vl-pl', text: num(v.s) + ' Sim × ' + num(v.n) + ' Não' }),
      chipDosPolos(v),
      opts.curto && v.ss ? h('span', { cls: 'cg-vl-ss', text: SENTIDO_CURTO[v.ss] }) : null
    ])];
    if ((opts.pessoas || []).length) nos.push(h('p', { cls: 'cg-vl-v' }, opts.pessoas.map(function (p) { return chipDaPessoa(v, p); })));
    nos.push(h('p', { cls: 'cg-vl-x' }, [v.dq ? h('b', { text: 'Destaque pedido por ' + v.dq + '. ' }) : null, v.x]));
    if (v.ab && (v.t === 'destaque' || v.dq) && !opts.curto) nos.push(h('p', { cls: 'cg-vl-ab', text: 'A Mesa pôs em votação: ' + v.ab }));
    if (v.ss && !opts.curto) nos.push(h('p', { cls: 'cg-vl-s', text: SENTIDO[v.ss] }));
    nos.push(linhaDosPolos(v));
    if (opts.completo && (v.pt || []).length) {
      nos.push(h('p', { cls: 'cg-v-b' }, v.pt.map(function (x) {
        return h('span', { cls: 'cg-pb cg-pb-' + (x[1] === 'S' ? 's' : 'n'), title: x[0] + ': ' + x[2] + '% votaram ' + LADO[x[1]] }, [x[0] + ' ', h('b', { text: LADO[x[1]] }), x[2] < 100 ? h('i', { text: ' ' + x[2] + '%' }) : null]);
      })));
    }
    return h('li', { cls: 'cg-vl' + (opts.cls ? ' ' + opts.cls : '') }, nos);
  }
  function linkDaMateria(casa, t) {
    var k = chaveDaMateria(casa, t);
    return k ? h('a', { cls: 'cg-mt', href: '#m=' + k, 'data-m': k, text: t }) : h('span', { text: t });
  }
  function cabecaDaMateria(casa, t, m, chips) {
    return h('p', { cls: 'cg-mh' }, [linkDaMateria(casa, t), m && m.ap ? h('span', { cls: 'cg-apel', text: m.ap }) : null].concat(chips || []));
  }
  /* Como os polos votaram o texto principal de uma matéria (a última dessas votações). */
  function ladosNoTexto(m) {
    var principais = (m.vot || []).filter(function (v) { return v.t === 'merito' && v.e && v.dr; });
    if (!principais.length) return '';
    var v = principais[principais.length - 1];
    if (v.e === v.dr) return v.e === 'S' ? 'texto principal: os dois polos a favor' : 'texto principal: os dois polos contra';
    return v.e === 'S' ? 'texto principal: esquerda a favor, direita contra' : 'texto principal: direita a favor, esquerda contra';
  }

  /* ── A ficha da matéria (#m=cd-PL-2630-2020) ── */
  function linhaDl(rotulo, filhos) { return h('div', {}, [h('dt', { text: rotulo }), h('dd', {}, filhos)]); }
  function sinaisDaNota(titulo, m, mat) {
    var rel = m.rel, pesos = mat.pesos || {}, pt = rel.pt || {}, linhas = [], sigla = titulo.split(' ')[0];
    var partidos = m.pa || [];
    var diz = {
      demanda: rel.dem == null ? '' : (rel.dem ? plural(rel.dem, 'projeto parecido anexado a esta matéria', 'projetos parecidos anexados a esta matéria') : 'nenhum projeto parecido anexado'),
      origem: (M.origens || {})[m.o || ''] || 'origem não informada',
      alcance: (M.siglas || {})[sigla] || sigla,
      apoio: partidos.length > 1 ? 'autores de ' + partidos.length + (partidos.length >= 6 ? ' ou mais' : '') + ' partidos (' + partidos.join(', ') + ')' : (partidos.length === 1 ? 'autores de um partido só (' + partidos[0] + ')' : 'sem autor parlamentar')
    };
    ['demanda', 'origem', 'alcance', 'apoio'].forEach(function (k) {
      if (pesos[k] == null) return;
      linhas.push(h('tr', {}, [h('th', { scope: 'row', text: (M.relNomes || {})[k] || k }), h('td', { cls: 'an-l', text: diz[k] }), h('td', { text: num(pt[k] || 0) + ' de ' + num(pesos[k]) })]));
    });
    return linhas;
  }
  function montarMateria(casa, titulo, m, mat) {
    var nos = [], sigla = titulo.split(' ')[0];
    var links = h('p', { cls: 'cg-d-s' }, []);
    function link(href, texto, externo) {
      if (links.childNodes.length) links.appendChild(d.createTextNode(' · '));
      links.appendChild(h('a', externo ? { href: href, target: '_blank', rel: 'noopener noreferrer', text: texto } : { href: href, text: texto }));
    }
    if (m.u) link(m.u, 'Página oficial ↗', true);
    if (m.ut) link(m.ut, 'Texto integral ↗', true);
    link(M.pesquisa + '?q=' + encodeURIComponent('"' + (m.ap || titulo) + '"'), 'O que o jornal publicou →', false);
    nos.push(h('div', { cls: 'cg-mf-h' }, [
      h('p', { cls: 'cg-d-k', text: (casa === 'cd' ? 'Câmara dos Deputados' : 'Senado Federal') + ' · ' + ((M.siglas || {})[sigla] || 'matéria') + (m.est ? ' · ' + ((M.estados || {})[m.est] || m.est) : '') }),
      h('h2', { cls: 'cg-d-t', id: 'cgDossieT' }, [titulo, m.ap ? h('span', { cls: 'cg-apel', text: m.ap }) : null]),
      links
    ]));

    /* Sobre o quê. */
    var sobre = [h('p', { cls: 'cg-mf-e', text: m.e || 'Sem ementa no registro.' })];
    if (m.ex) sobre.push(h('p', { cls: 'cg-mf-x' }, [h('b', { text: casa === 'cd' ? 'Ementa detalhada (da Câmara): ' : 'Explicação da ementa (do Senado): ' }), m.ex]));
    if (m.eo) sobre.push(h('p', { cls: 'cg-d-n', text: 'A ementa mudou no caminho. A original dizia: ' + m.eo }));
    if ((m.tm || []).length) sobre.push(h('p', { cls: 'cg-mf-kw' }, [h('span', { cls: 'cg-cp-l', text: 'Tema: ' })].concat(m.tm.map(function (t) { return chipDoTema(t, casa); }))));
    if ((m.kw || []).length) sobre.push(h('p', { cls: 'cg-mf-kw' }, [h('span', { cls: 'cg-cp-l', text: 'Palavras-chave do registro: ' })].concat(m.kw.map(function (x) { return h('span', { cls: 'cg-chip', text: x }); }))));
    sobre.push(h('p', { cls: 'cg-d-n', text: 'A página não resume o projeto: mostra o que a Casa registrou sobre ele. O conteúdo completo está no texto integral.' }));
    nos.push(secao('Sobre o quê', 'a ementa e a indexação oficiais', sobre));

    /* De onde veio e onde está. */
    var dl = [];
    if (m.au) dl.push(linhaDl('Autoria', [m.auk ? h('a', { cls: 'cg-p', href: '#p=' + m.auk, 'data-k': m.auk, text: m.au }) : m.au, m.o && (M.origens || {})[m.o] ? ' · ' + M.origens[m.o] : '', (m.pa || []).length ? ' · ' + m.pa.join(', ') : '']));
    if (m.da) dl.push(linhaDl('Apresentada em', [dataBr(m.da) + (dias(m.da) != null ? ' (há ' + tempo(dias(m.da)) + ')' : '')]));
    if (m.sit || m.f) dl.push(linhaDl('Situação', [(m.sit || '') + (m.f && (M.filas || {})[m.f] ? (m.sit ? ': ' : '') + M.filas[m.f] : '') + (m.org ? ' · ' + m.org : '') + (m.mov ? ' · último andamento em ' + dataBr(m.mov) : '')]));
    if (m.urg) dl.push(linhaDl('Regime', ['Urgência']));
    if (m.rl) dl.push(linhaDl('Relator', [m.rlk ? h('a', { cls: 'cg-p', href: '#p=' + m.rlk, 'data-k': m.rlk, text: m.rl }) : m.rl]));
    if (m.jor) dl.push(linhaDl('No jornal', [plural(m.jor, 'texto cita esta matéria', 'textos citam esta matéria') + ' nas edições lidas']));
    if (dl.length) nos.push(secao('De onde veio e onde está', 'do registro oficial', [h('dl', { cls: 'cg-mf-dl' }, dl)]));

    /* Os sinais de relevância. */
    if (m.rel) {
      var rel = m.rel, blocos = [];
      var quando = rel.q === 'espera' ? 'Pronta para o Plenário e fora da pauta: a nota é a de hoje.'
        : rel.q === 'passou' ? 'Aprovada pelo Plenário em ' + dataBr(rel.apv) + (rel.dias != null ? ', ' + tempo(rel.dias) + ' depois do protocolo' : '') + '.'
        : 'Nota na data da última votação (' + dataBr(rel.ref) + '). Não está no gráfico “o que espera × o que passa”: não é das prontas para a pauta nem das aprovadas nos últimos 12 meses.';
      blocos.push(h('p', { cls: 'cg-mf-n' }, [h('b', { text: num(rel.n) }), h('span', { text: ' de 100 · ' + (rel.n >= (M.rel || {}).alta ? 'sinais fortes' : rel.n < (M.rel || {}).baixa ? 'sinais fracos' : 'sinais médios') }), dica('nota')]));
      blocos.push(h('p', { cls: 'cg-d-n', text: quando }));
      blocos.push(h('div', { cls: 'an-tbl-wrap' }, [h('table', { cls: 'an-tbl cg-tb' }, [
        h('thead', {}, [h('tr', {}, ['Sinal', 'O que o registro diz', 'Pontos'].map(function (x, i) { return h('th', { scope: 'col', cls: i === 1 ? 'an-l' : null, text: x }); }))]),
        h('tbody', {}, sinaisDaNota(titulo, m, mat))
      ])]));
      if (rel.simb) blocos.push(h('p', { cls: 'cg-d-n', text: 'Matéria simbólica (dia nacional, denominação, título, rota turística…): a nota não passa de 10, seja qual for a soma.' }));
      var cam = rel.cam || {}, passos = [];
      if (cam.urgencia) passos.push('urgência aprovada em ' + dataBr(cam.urgencia.d) + (cam.urgencia.por ? ', a pedido de ' + cam.urgencia.por : ''));
      if (cam.parecer_plenario) passos.push('parecer dado direto no Plenário em ' + dataBr(cam.parecer_plenario.d) + ', no lugar das comissões' + (cam.parecer_plenario.relator ? ', pelo relator ' + cam.parecer_plenario.relator : ''));
      if (passos.length) blocos.push(h('p', { cls: 'cg-rv-c', text: 'Por que andou (do histórico oficial): ' + passos.join('; ') + '.' }));
      else if (rel.q === 'passou' && casa === 'cd') blocos.push(h('p', { cls: 'cg-d-n', text: 'O histórico oficial não registra urgência aprovada nem parecer dado direto no Plenário antes da aprovação.' }));
      blocos.push(h('p', { cls: 'cg-d-n', text: 'A nota não diz se a matéria é boa ou ruim: diz quantos sinais de relevância pública ela tem nos registros. Os pesos são escolha editorial e estão em “Como ler”.' }));
      nos.push(secao('Sinais de relevância', 'a mesma régua para o que espera e o que passa', blocos));
    }

    /* Como o Plenário votou. */
    var votos = (m.vot || []).slice().reverse();
    if (votos.length) {
      var divisivas = votos.filter(function (v) { return v.dv; }).length;
      var juntas = votos.filter(function (v) { return v.e && v.dr && v.e === v.dr && (v.t === 'merito' || v.t === 'destaque'); }).length;
      nos.push(secao('Como o Plenário votou', plural(votos.length, 'votação nominal', 'votações nominais') + ' nesta legislatura, da mais recente', [
