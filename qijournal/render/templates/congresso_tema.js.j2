    }
    nomes.addEventListener('toggle', function () { if (nomes.open) listarNomes(estado.v); });

    /* O ponteiro só precisa estar perto: vale o ponto mais próximo (até 14 px). */
    var centros = [], ponteiro = '';
    function medir() {
      centros = [];
      lista(plot.querySelectorAll('.cg-vt')).forEach(function (n) { centros.push({ x: n.offsetLeft + n.offsetWidth / 2, y: n.offsetTop + n.offsetHeight / 2, k: n.getAttribute('data-k'), no: n }); });
    }
    function maisPerto(ev) {
      var base = plot.getBoundingClientRect(), x = ev.clientX - base.left, y = ev.clientY - base.top, melhor = null, dist = 14 * 14;
      centros.forEach(function (c) { var dx = c.x - x, dy = c.y - y, d2 = dx * dx + dy * dy; if (d2 < dist) { dist = d2; melhor = c; } });
