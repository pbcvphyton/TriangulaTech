  });
  /* #v=posicoes&c=cd&t=politica&m=cd-PL-2162-2023&vt=…&s=cd-74158: abre o tema na matéria e na
     votação pedidas, seguindo quem o endereço diz. */
  aoEndereco.posicoes = function (q) {
    var p = {};
    (q || '').split('&').forEach(function (par) {
      var i = par.indexOf('=');
      if (i > 0) { try { p[par.slice(0, i)] = decodeURIComponent(par.slice(i + 1)); } catch (erro) { /* parâmetro malformado: ignorado */ } }
    });
    if (!p.t) return;
    var casa = p.c === 'sf' ? 'sf' : 'cd', sel = d.getElementById('cgFxTema-' + casa);
    if (!sel) return;
    var existe = lista(sel.options).some(function (o) { return o.value === p.t && !o.disabled; });
    if (!existe) return;
    var pedido = { m: p.m || '', v: p.vt || '', s: /^(cd|sf)-\d+$/.test(p.s || '') ? p.s : '' };
    if (casas && !casas.hidden && root.getAttribute('data-ver') !== casa) verCasa(casa);
    /* O mesmo tema já está na tela: só muda a votação em foco e quem se segue. */
