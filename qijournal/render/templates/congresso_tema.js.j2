    /* ── Escolher uma votação: a fita marca, o cartão vira, os pontos mudam de lado ── */
    function mostrarVotacao(v, comEndereco) {
      if (!v || v === estado.v) return;
      if (estado.v) { estado.v.btn.setAttribute('aria-pressed', 'false'); estado.v.btn.setAttribute('tabindex', '-1'); estado.v.M.col.classList.remove('on'); }
