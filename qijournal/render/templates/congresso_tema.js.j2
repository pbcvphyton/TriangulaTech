      w.history.replaceState(null, '', '#v=posicoes&c=' + casa + '&t=' + tema + (chave ? '&m=' + chave : '') + '&vt=' + encodeURIComponent(estado.v.r.id) + (estado.q ? '&s=' + estado.q : ''));
