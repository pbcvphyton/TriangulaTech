      var v = estado.v;
      abrirDicaDoTema('p:' + casa + ':' + v.i + ':' + k + ':' + como, function () {
        var g = G[k], pt = partidoDe(k, v), o = v.por[pt], linhas = [
          h('b', { text: g.nome }), h('span', { cls: 'cg-tv-mn', text: pt + (g.uf ? '-' + g.uf : '') }),
          h('span', { text: ' · ' + VOTO_NO_TEMA[votoDe(k, v)] + (v.contra[k] ? ', contra o partido' : '') })
        ];
        if (o) linhas.push(h('br'), h('span', { cls: 'cg-tv-mn', text: pt + ': ' + o.S.length + ' Sim × ' + (o.N.length + o.O.length) + ' Não' }));
        linhas.push(h('br'), g.s == null ? 'Poucas votações no tema para ter saldo' : 'No tema: saldo ' + saldo(g.s) + ' em ' + num(g.n), h('br'), como + ': abre o dossiê');
