    });
    plot.addEventListener('keydown', function (ev) {
      if (!centros.length || ev.altKey || ev.ctrlKey || ev.metaKey) return;
      var i = -1, alvo = -1;
      centros.forEach(function (c, n) { if (c.k === estado.cur) i = n; });
      if (ev.key === 'Enter' && i >= 0) { ev.preventDefault(); abrirDossie(centros[i].k); return; }
      if (ev.key === 'Escape' && i >= 0) { desmarcar(); return; }
