{#- Aba Congresso, "Onde cada um está": as votações de um tema e QUEM VOTOU em cada uma, em pontos
    (incluído por congresso.js.j2, dentro da mesma função, depois de congresso_cartoes.js.j2, que
    traz pessoaDe, partidoNoDia e colunaDe). Três peças: a FITA (um ponto por votação do tema, no
    tempo, as da mesma matéria juntas), o CARTÃO da matéria em foco (o que se votou) e o PLENÁRIO
    (uma linha por partido, o Sim à esquerda do eixo e o Não à direita, um ponto por parlamentar,
    na cor de como ele costuma votar no tema). Tudo sai de materias-<casa>.json e
    votos-<casa>.json, lidos quando o tema abre. Sempre com textContent: nada dos arquivos vira HTML. -#}
  var CADEIRAS = { cd: 513, sf: 81 };
  /* Só quem registrou voto ou presença vira ponto: ausência não é voto. */
  var VOTO_NO_TEMA = { S: 'Sim', N: 'Não', A: 'Abstenção', O: 'Obstrução', P: 'Presidia a sessão', E: 'Presente, sem voto' };
  var FRASE_DO_VOTO = { S: ['votou ', 'Sim'], N: ['votou ', 'Não'], O: ['ficou em ', 'obstrução'], A: ['registrou ', 'abstenção'], P: ['', 'presidia a sessão'], E: ['estava ', 'presente, sem voto'] };
  var PARTIDO_CURTO = { REPUBLICANOS: 'REPUB.', SOLIDARIEDADE: 'SOLID.', CIDADANIA: 'CIDAD.', 'S/PARTIDO': 'S/PART.', PATRIOTA: 'PATRI.' };
  function esvaziar(no) { while (no.firstChild) no.removeChild(no.firstChild); }
  function instante(v) { return (v.d || '') + 'T' + (v.h || '00:00'); }
  function iniciaisDe(nome) {
    var p = (nome || '').split(' ').filter(function (x) { return x.length > 2 || /^[A-ZÀ-Ý]/.test(x); });
    return ((p[0] || '').charAt(0) + (p.length > 1 ? p[p.length - 1].charAt(0) : '')).toUpperCase();
  }
  /* O retrato oficial; se a foto não vem, ficam as iniciais. */
  function retratoDe(casa, k, nome) {
    var cx = h('span', { cls: 'cg-tv-ft', 'aria-hidden': 'true', text: iniciaisDe(nome) }), molde = (M.fotos || {})[casa];
    if (!molde) return cx;
    var img = h('img', { alt: '', decoding: 'async', referrerpolicy: 'no-referrer' });
    img.addEventListener('error', function () { if (img.parentNode) img.parentNode.removeChild(img); });
    img.src = molde.replace('{id}', k.slice(3));
    cx.appendChild(img);
    return cx;
  }
  /* A dica rica (com retrato) dos pontos do tema: segue o ponteiro, o foco ou o toque. Nunca é o
     único jeito de ler: a linha de leitura, abaixo do gráfico, diz o mesmo por extenso. */
  var dicaDoTema = null, dicaDoTemaDe = '';
  function abrirDicaDoTema(de, filhos, x, y) {
    if (!dicaDoTema) { dicaDoTema = h('div', { cls: 'cg-tv-dica', role: 'tooltip' }); d.body.appendChild(dicaDoTema); }
    if (de !== dicaDoTemaDe || dicaDoTema.hidden) {
      esvaziar(dicaDoTema);
      filhos().forEach(function (n) { dicaDoTema.appendChild(n); });
      dicaDoTemaDe = de;
    }
    dicaDoTema.hidden = false;
    var lx = Math.max(8, Math.min(x + 14, w.innerWidth - dicaDoTema.offsetWidth - 8)), ly = y + 16;
    if (ly + dicaDoTema.offsetHeight > w.innerHeight - 8) ly = Math.max(8, y - dicaDoTema.offsetHeight - 12);
    dicaDoTema.style.left = lx + 'px';
    dicaDoTema.style.top = ly + 'px';
  }
  function fecharDicaDoTema() { if (dicaDoTema) dicaDoTema.hidden = true; }
  w.addEventListener('scroll', fecharDicaDoTema, true);

  /* ════ As votações de um tema ════ */
  var pedidoDoTema = null;  // { m: chave da matéria, v: id da votação, s: chave de quem seguir }: o que o endereço pede
  var temaMontado = {};     // Casa → o tema que está na tela: { tema, ir(pedido), sair() }
  var vezDoTema = {};       // Casa → quantos pedidos já houve (só o último monta)
  function detalharTema(caixa, casa, tema) {
    var pedido = pedidoDoTema, vez = (vezDoTema[casa] = (vezDoTema[casa] || 0) + 1);
    pedidoDoTema = null;
    if (temaMontado[casa]) { temaMontado[casa].sair(); temaMontado[casa] = null; }
    fecharDicaDoTema();
    esvaziar(caixa);
    caixa.removeAttribute('role');
    caixa.removeAttribute('aria-labelledby');
    if (!tema) { caixa.hidden = true; return; }
    caixa.hidden = false;
    caixa.classList.add('cg-tv');
    caixa.appendChild(h('p', { cls: 'cg-d-st', text: 'Carregando as votações de ' + nomeDoTema(tema) + '…' }));
    materiasDa(casa, function (erro, mat) {
      if (vezDoTema[casa] !== vez) return;  // já escolheram outro tema
      if (erro) { esvaziar(caixa); caixa.appendChild(h('p', { cls: 'cg-d-st', text: 'Não foi possível carregar as matérias agora. Tente de novo em instantes.' })); return; }
      /* Os votos de cada um desenham os pontos; sem eles, a fita e o cartão saem só com os números. */
      votosDa(casa, function (erroV, vt) {
        if (vezDoTema[casa] !== vez) return;
        montarTema(caixa, casa, tema, mat, erroV ? null : vt, pedido);
      });
    });
  }
  function montarTema(caixa, casa, tema, mat, vt, pedido) {
    esvaziar(caixa);
    var nome = nomeDoTema(tema), quem = casa === 'cd' ? 'deputado' : 'senador', quemPl = casa === 'cd' ? 'deputados' : 'senadores';
    var cadeiras = CADEIRAS[casa] || 0, lim = M.limiares || {}, polos = M.polos || {};
    var coesao = parseFloat(lim.coesao_partido) || 0.8, minimo = parseInt(lim.minimo_partido, 10) || 4;
    var semMovimento = !!(w.matchMedia && w.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var uid = 'cgTv-' + casa + '-', aperto = Math.max(3, Math.round(cadeiras * 30 / 513));  // "diferença pequena": 30 votos na Câmara, 5 no Senado

    /* ── Os dados: as matérias do tema com votação que opôs os polos, no tempo; as votações de cada
       uma, em ordem. V é a ordem de leitura da fita (matéria a matéria). ── */
    var MT = [], V = [], chaves = vt ? Object.keys(vt.votos || {}) : [];
    Object.keys(mat.materias).forEach(function (t) {
      var m = mat.materias[t];
      if ((m.tm || []).indexOf(tema) < 0) return;
      var votos = (m.vot || []).filter(function (r) { return r.dv; });
      if (!votos.length) return;
      votos.sort(function (a, b) { var x = instante(a), y = instante(b); return x < y ? -1 : x > y ? 1 : 0; });
      MT.push({ t: t, m: m, r: votos, v: [], de: instante(votos[0]) });
    });
    if (!MT.length) { caixa.appendChild(h('p', { cls: 'cg-d-st', text: 'Nenhuma votação de ' + nome + ' opôs esquerda e direita nesta legislatura.' })); return; }
    MT.sort(function (a, b) { return a.de < b.de ? -1 : a.de > b.de ? 1 : (a.t < b.t ? -1 : 1); });
    MT.forEach(function (m, mi) {
      m.i = mi;
      m.r.forEach(function (r) {
        var col = vt ? colunaDe(vt, r.id) : null, c = { S: 0, N: 0, O: 0, A: 0, P: 0, E: 0 };
        var v = { r: r, i: V.length, M: m, col: col == null ? -1 : col, por: null };
        /* O placar é a contagem dos votos registrados (a obstrução à parte, como no texto oficial). */
        if (v.col >= 0) chaves.forEach(function (k) { var x = vt.votos[k].charAt(v.col); if (c[x] != null) c[x] += 1; });
        v.s = v.col >= 0 ? c.S : (r.s || 0);
        v.n = v.col >= 0 ? c.N : (r.n || 0);
        v.o = c.O; v.a = v.col >= 0 ? c.A : (r.a || 0); v.pe = c.P + c.E;
        v.reg = c.S + c.N + c.O + c.A + c.P + c.E;
        v.lado = r.apv == null || !r.e ? '' : ((r.apv ? 'S' : 'N') === r.e ? 'e' : 'd');  // de que polo era o lado que prevaleceu
        v.gperdeu = !!r.g && r.apv != null && ((r.g === 'S') !== !!r.apv);
        v.dif = Math.abs(v.s - v.n);
        m.v.push(v);
        V.push(v);
      });
    });
    /* Quem tem voto registrado em alguma votação do tema, e como costuma votar nele: nas votações
       acima (todas opuseram os polos), voto igual ao da maioria da direita conta +1 e igual ao da
       esquerda, −1 (a obstrução conta como Não); o saldo só aparece com 5 ou mais. */
    var G = {}, todos = [];
    chaves.forEach(function (k) {
      var linha = vt.votos[k] || '', dir = 0, esq = 0, algum = false;
      V.forEach(function (v) {
        if (v.col < 0) return;
        var c = linha.charAt(v.col), p = c === 'O' ? 'N' : c;
        if (VOTO_NO_TEMA[c]) algum = true;
        if (p === 'S' || p === 'N') { if (p === v.r.dr) dir += 1; else if (p === v.r.e) esq += 1; }
      });
      if (!algum) return;
      var p = pessoaDe(k), n = dir + esq, s = n >= 5 ? Math.round(100 * (dir - esq) / n) : null;
      G[k] = { k: k, nome: p.nome, uf: p.uf, partido: p.partido, fora: p.fora, s: s, n: n, cls: s == null ? 'na' : classe(s) };
      todos.push(k);
    });
    /* A ordem dos partidos, da esquerda para a direita: a média do saldo no tema de quem está em exercício. */
    var media = {};
    (function () {
      var soma = {}, conta = {};
      todos.forEach(function (k) {
        var g = G[k];
        if (g.fora || g.s == null || !g.partido) return;
        soma[g.partido] = (soma[g.partido] || 0) + g.s;
        conta[g.partido] = (conta[g.partido] || 0) + 1;
      });
      Object.keys(conta).forEach(function (s) { media[s] = soma[s] / conta[s]; });
    })();
    /* O plenário de uma votação: partido (o do dia) → quem votou Sim, Não, obstruiu ou ficou sem Sim
       nem Não; e quem votou contra o próprio partido fechado (a regra da página: coesão e mínimo de
       config/congresso.yaml; a obstrução conta como Não). Feito quando a votação é aberta. */
    function porPartido(v) {
      if (v.por || v.col < 0) return v.por;
      var por = {}, pt = {}, contra = {}, nContra = 0;
      todos.forEach(function (k) {
        var c = vt.votos[k].charAt(v.col);
        if (!VOTO_NO_TEMA[c]) return;
        var sigla = partidoNoDia(vt, k, v.col) || 'S/PARTIDO', o = por[sigla] || (por[sigla] = { S: [], N: [], O: [], X: [] });
        pt[k] = sigla;
        o[c === 'S' || c === 'N' || c === 'O' ? c : 'X'].push(k);
      });
      Object.keys(por).forEach(function (sigla) {
        var o = por[sigla], s = o.S.length, nn = o.N.length + o.O.length, t = s + nn;
        o.maioria = t >= minimo ? (s / t >= coesao ? 'S' : nn / t >= coesao ? 'N' : '') : '';
        (o.maioria === 'S' ? o.N.concat(o.O) : o.maioria === 'N' ? o.S : []).forEach(function (k) { contra[k] = 1; nContra += 1; });
      });
      v.por = por; v.pt = pt; v.contra = contra; v.nContra = nContra;
      v.ordem = Object.keys(por).sort(function (a, b) { return (media[a] || 0) - (media[b] || 0) || (a < b ? -1 : 1); });
      return por;
    }
    /* A votação que representa a matéria: a de texto principal em que mais gente votou Sim, Não ou
       obstruiu (no empate, a última); sem texto principal, a última. */
    function principalDe(m) {
      var melhor = null;
      m.v.forEach(function (v) { if (v.r.t === 'merito' && (!melhor || v.s + v.n + v.o >= melhor.s + melhor.n + melhor.o)) melhor = v; });
      return melhor || m.v[m.v.length - 1];
    }
    function tituloDe(m, sep) { return m.t + (m.m.ap ? (sep === '(' ? ' (' + m.m.ap + ')' : sep + m.m.ap) : ''); }
    function placarDe(v, sep) { return num(v.s) + ' Sim' + sep + num(v.n) + ' Não'; }
    function prevaleceu(v) { return v.lado ? 'prevaleceu o lado da ' + (v.lado === 'e' ? 'esquerda' : 'direita') : ''; }
    var estado = { v: null, f: '', q: '', cur: '' };  // votação em foco, realce, quem se segue, ponto sob o cursor

    /* ── A tela ── */
    var ganhou = { e: 0, d: 0 };
    V.forEach(function (v) { if (v.lado) ganhou[v.lado] += 1; });
    var chips = h('div', { cls: 'cg-tv-chips', role: 'group', 'aria-labelledby': uid + 'fk' });
    var irPara = h('select', { 'aria-label': 'Ir para a matéria' }), irParaM = h('select', { 'aria-label': 'Ir para a matéria' });
    var cols = h('div', { cls: 'cg-tv-cols' });
    var fita = h('div', { cls: 'cg-tv-fita', role: 'toolbar', 'aria-label': 'As votações do tema, no tempo: uma coluna por matéria, um ponto por votação. Setas mudam de votação.' }, [cols]);
    var legFita = h('p', { cls: 'cg-tv-leg' });
    var antM = h('button', { type: 'button', 'aria-label': 'Votação anterior', text: '‹' }), proxM = h('button', { type: 'button', 'aria-label': 'Próxima votação', text: '›' });
    var faceVoto = h('button', { type: 'button', role: 'tab', 'aria-selected': 'true', 'aria-controls': uid + 'cw', text: 'O que se votou' });
    var faceQuem = h('button', { type: 'button', role: 'tab', 'aria-selected': 'false', 'aria-controls': uid + 'pn', text: 'Quem votou' });
    var card = h('article', { cls: 'cg-tv-card cg-3d', 'data-3d': '0.6', 'aria-live': 'polite' });
    var cw = h('div', { cls: 'cg-tv-cw', id: uid + 'cw' }, [card]);
    var nReg = h('span'), segN = h('span'), segX = h('button', { type: 'button', 'aria-label': 'Parar de seguir', text: '×' });
    var seg = h('span', { cls: 'cg-pn-seg' }, [segN, segX]);
    var buscaK = h('span', { text: 'Seguir um ' + quem }), busca = h('input', { type: 'search', list: uid + 'nomes', placeholder: 'nome', autocomplete: 'off', spellcheck: 'false' });
    var nomesLista = h('datalist', { id: uid + 'nomes' });
    var rotBusca = h('label', { cls: 'cg-pn-busca' }, [buscaK, ' ', busca]);
    var cab = h('div', { cls: 'cg-pn-g cg-pn-cab' });
    var plot = h('div', { cls: 'cg-pn-plot', tabindex: '0', role: 'group', 'aria-describedby': uid + 'le' });
    var legPl = h('p', { cls: 'cg-pn-leg' }), le = h('div', { cls: 'cg-pn-le', id: uid + 'le', 'aria-live': 'polite' });
    var nomesC = h('div'), nomes = h('details', { cls: 'cg-pn-nomes' }, [h('summary', { text: 'Ver os nomes, partido a partido' }), nomesC]);
    var pn = h('div', { cls: 'cg-pn', id: uid + 'pn' }, [
      h('div', { cls: 'cg-pn-top' }, [h('h6', {}, ['Quem votou ', nReg]), seg, rotBusca, nomesLista]),
      cab, plot, legPl, le, nomes
    ]);
    var focoCx = h('div', { cls: 'cg-tv-foco', 'data-face': 'voto' }, [cw, pn]);
    var listaC = h('ol'), listaV = h('details', { cls: 'cg-tv-lista' }, [h('summary', { text: V.length === 1 ? 'Ver a votação em lista' : 'Ver as ' + num(V.length) + ' votações em lista' }), listaC]);
    var def = definicaoDoTema(tema, casa);
    [
      h('div', { cls: 'cg-tv-h' }, [
        h('h5', { id: uid + 't', text: (V.length === 1 ? 'A votação de ' : 'As ' + num(V.length) + ' votações de ') + nome }),
        h('span', { text: 'em ' + plural(MT.length, 'matéria', 'matérias') + ' · só as que opuseram esquerda e direita' })
      ]),
      h('div', { cls: 'cg-tv-f' }, [
        h('span', { cls: 'cg-tv-fk', id: uid + 'fk', text: 'Realçar' }), chips,
        h('label', { cls: 'cg-tv-ir' }, [h('span', { cls: 'cg-tv-fk', text: 'Ir para' }), irPara])
      ]),
      fita, legFita,
      h('div', { cls: 'cg-tv-ir-m' }, [antM, irParaM, proxM]),
      h('div', { cls: 'cg-tv-faces', role: 'tablist', 'aria-label': 'As duas faces do cartão' }, [faceVoto, faceQuem]),
      focoCx, listaV,
      h('p', { cls: 'cg-tv-pe', text: (def ? 'O que entra no tema: ' + def.charAt(0).toLowerCase() + def.slice(1) + ' ' : '') +
        'O lado de cada polo numa votação é o da maioria dos seus parlamentares (' + (polos.esquerda || []).join(', ') + ' × ' + (polos.direita || []).join(', ') + '). ' +
        'A cor de cada ponto é o saldo da pessoa nas votações esquerda × direita do tema (5 ou mais). O partido é o do dia da votação. ' +
        (V.some(function (v) { return v.o > 0; }) ? 'A obstrução aparece do lado do Não, vazada: a página a conta como posição contrária, como nos outros números. ' : '') +
        'Registros oficiais ' + (casa === 'cd' ? 'da Câmara dos Deputados' : 'do Senado Federal') + ', atualizados em ' + dataBr(M.hoje) + '.' })
    ].forEach(function (no) { caixa.appendChild(no); });
    caixa.setAttribute('role', 'region');
    caixa.setAttribute('aria-labelledby', uid + 't');

    /* ── Realçar e ir para ── */
    var FILTROS = [
      ['', 'Todas', function () { return true; }],
      ['m', 'Texto principal', function (v) { return v.r.t === 'merito'; }],
      ['g', 'Governo derrotado', function (v) { return v.gperdeu; }],
      ['a', 'Diferença menor que ' + aperto + ' votos', function (v) { return v.dif < aperto; }],
      ['o', 'Com obstrução', function (v) { return v.o > 0; }]
    ].filter(function (f) { return f[0] === '' || V.some(f[2]); });
    FILTROS.forEach(function (f) {
      var b = h('button', { type: 'button', cls: 'cg-tv-chip', 'aria-pressed': f[0] === '' ? 'true' : 'false', 'data-f': f[0] }, [f[1] + ' ', h('b', { text: num(V.filter(f[2]).length) })]);
      b.addEventListener('click', function () { realcar(f[0]); });
      chips.appendChild(b);
    });
    function realcar(id) {
      var f = FILTROS.filter(function (x) { return x[0] === id; })[0] || FILTROS[0], primeira = null;
      estado.f = f[0];
      lista(chips.children).forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-f') === f[0] ? 'true' : 'false'); });
      if (f[0]) fita.setAttribute('data-f', f[0]); else fita.removeAttribute('data-f');
      V.forEach(function (v) { v.btn.classList.toggle('cg-tv-hit', !!f[2](v)); });
      if (f[0] && !f[2](estado.v)) {  // a votação em foco ficou de fora: vai para a primeira realçada
        V.some(function (v) { if (f[2](v)) { primeira = v; return true; } return false; });
        if (primeira) mostrarVotacao(primeira, true);
      }
    }
    [irPara, irParaM].forEach(function (sel) {
      MT.forEach(function (m, mi) { sel.appendChild(h('option', { value: String(mi), text: tituloDe(m, ' · ') + ' (' + m.v.length + ')' })); });
      sel.addEventListener('change', function () { var m = MT[parseInt(sel.value, 10)]; if (m) mostrarVotacao(principalDe(m), true); });
    });

    /* ── A fita ── */
    function rotulo(v) {
      var res = resultadoDaVotacao(v.r);
      return tituloDe(v.M, '(') + ', ' + tipoDaVotacao(v.r) + ', ' + dataBr(v.r.d) + ': ' + (res ? res + ', ' : '') + num(v.s) + ' Sim e ' + num(v.n) + ' Não' +
        (v.o ? ' e ' + num(v.o) + ' em obstrução' : '') + (v.lado ? '; ' + prevaleceu(v) : '');
    }
    var anoAntes = '';
    MT.forEach(function (m) {
      var ano = m.v[0].r.d.slice(0, 4), novo = ano !== anoAntes;
      m.col = h('div', { cls: 'cg-tv-col' + (novo ? ' cg-tv-col-ano' : ''), role: 'group', 'aria-label': tituloDe(m, '('), 'data-ano': novo ? ano : null });
      anoAntes = ano;
      m.v.forEach(function (v) {
        v.btn = h('button', { type: 'button', cls: 'cg-tv-v cg-tv-v-' + (v.r.t === 'merito' ? 'm' : 'd') + (v.lado ? ' cg-tv-v-' + v.lado : '') + ' cg-tv-hit', tabindex: '-1', 'aria-pressed': 'false', 'aria-label': rotulo(v), 'data-i': String(v.i) });
        m.col.appendChild(v.btn);
      });
      cols.appendChild(m.col);
    });
    /* Os apelidos, anotados acima da coluna (em degraus, para não se atropelarem); a fita ganha a
       altura da coluna ou do apelido mais alto. No celular a fita vira linhas, sem anotação. */
    function anotar() {
      lista(cols.querySelectorAll('.cg-tv-ap')).forEach(function (x) { x.parentNode.removeChild(x); });
      cols.style.height = '';
      if (w.innerWidth <= 760 || !cols.clientWidth) return;
      var passo = MT[0].col.offsetWidth || cols.clientWidth / MT.length, postos = [], PV = 12, teto = 0;
      MT.forEach(function (m) { teto = Math.max(teto, m.v.length * PV + 3); });
      MT.forEach(function (m, mi) {
        if (!m.m.ap) return;
        var px = m.m.ap.length * 5.6 + 10, larg = Math.ceil(px / passo), centro = m.col.offsetLeft + m.col.offsetWidth / 2;
        function nivel(de, ate) {  // a altura livre acima das colunas que o rótulo cobre e dos rótulos já postos
