    /* ── Seguir alguém: o ponto dele fica marcado em toda votação, e a fita mostra com que lado ele votou ── */
    var porNomeDe = {};
    todos.slice().sort(function (a, b) { return semAcento(G[a].nome).localeCompare(semAcento(G[b].nome)); }).forEach(function (k) {
      var g = G[k], rot = g.nome + ' (' + [g.partido, g.uf].filter(Boolean).join('-') + ')', simples = semAcento(g.nome);
