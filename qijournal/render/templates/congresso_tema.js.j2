    plot.addEventListener('focusout', fecharDicaDoTema);

    /* A dica da fita (ponteiro e foco): a matéria e o placar; o cartão diz o mesmo por extenso. */
    function dicaDaFita(b, x, y) {
      var v = V[parseInt(b.getAttribute('data-i'), 10)];
      abrirDicaDoTema('v:' + casa + ':' + v.i + ':' + estado.q, function () {
        var res = resultadoDaVotacao(v.r), linhas = [
          h('b', { text: tituloDe(v.M, ' · ') }), h('span', { cls: 'cg-tv-mn', text: dataBr(v.r.d) + ' · ' + tipoDaVotacao(v.r) + (res ? ' · ' + res : '') }),
          h('br'), h('span', { cls: 'cg-tv-mn', text: placarDe(v, ' × ') + (v.o ? ' + ' + num(v.o) + ' em obstrução' : '') })
        ];
        if (v.lado) linhas.push(h('br'), prevaleceu(v).charAt(0).toUpperCase() + prevaleceu(v).slice(1) + '.');
        if (estado.q) linhas.push(h('br'), G[estado.q].nome + ': ' + (VOTO_NO_TEMA[votoDe(estado.q, v)] || 'sem voto registrado'));
