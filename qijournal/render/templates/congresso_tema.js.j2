    }
    function noPonto(c, como) { var q = c.no.getBoundingClientRect(); dicaDoPonto(c.k, como, q.left + q.width / 2, q.top + q.height / 2); }
    function abrirDossie(k) { fecharDicaDoTema(); abrir(k); }
    plot.addEventListener('pointerdown', function (ev) { ponteiro = ev.pointerType || ''; });
    plot.addEventListener('pointermove', function (ev) {
      if (ev.pointerType === 'touch') return;  // no toque, vale o toque (abaixo)
      var c = maisPerto(ev);
