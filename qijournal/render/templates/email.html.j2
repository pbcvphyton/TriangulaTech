{#- E-mail HTML, no modelo do e-mail do TSA Tech: tabelas + CSS inline (o <style> é só
    melhoria progressiva para o celular), sem JS, sem SVG, fontes do sistema, 600 px,
    modo claro. Cabeçalho (faixa com o logo, slogan e data), "Hoje em N notícias" com
    a manchete em destaque e as demais em linhas de 2 e 3 colunas, "Ler a edição
    completa" e um rodapé curto.
    Variáveis: v (EditionView), brand, subject, preheader, lead (EmailItem ou None),
    rows (linhas de EmailItem), total, footer. -#}
{% set c = brand.colors %}
{% set serif = "Georgia,Times New Roman,serif" %}
{% set sans = "Helvetica Neue,Helvetica,Arial,sans-serif" %}
{% set mono = "Menlo,Consolas,monospace" %}
{% set ink = "#1a2332" %}
{% set muted = "#5f6b7e" %}
{% set body = "#363b45" %}
{% set rule = "#E2E2E2" %}
{% set bg = "#EDF2F5" %}
{% set topo = brand.masthead or c.navy %}
{% macro lang(s) -%}{% if s.lang %} lang="{{ s.lang }}"{% endif %}{%- endmacro %}
{#- "1 · Política": a posição e a editoria. -#}
{% macro rotulo(item, margem) -%}
<p style="margin:0 0 {{ margem }};font:bold 11px/14px {{ sans }};letter-spacing:.6px;text-transform:uppercase;color:{{ muted }};"><span style="color:{{ ink }};">{{ item.n }}</span>&nbsp;·&nbsp;{{ item.story.section_title }}</p>
{%- endmacro %}
{#- Uma linha de notícias depois da manchete: 1, 2 ou 3 colunas (no celular, uma embaixo da outra). -#}
{% macro linha(itens) -%}
{% set n = itens|length %}
{% set larguras = {1: ["100%"], 2: ["49.9%", "49.9%"], 3: ["34.1%", "34.1%", "31.7%"]}[n] %}
{% set mso = {1: [542], 2: [271, 271], 3: [185, 185, 172]}[n] %}
{% set fonte = "18px/23px" if n < 3 else "16px/20px" %}
<tr><td style="padding:0;border-top:1px solid {{ rule }};font-size:0;line-height:0;">
<!--[if mso]><table role="presentation" width="542" cellpadding="0" cellspacing="0" border="0"><tr><![endif]-->
{% for item in itens %}
<!--[if mso]><td width="{{ mso[loop.index0] }}" valign="top"><![endif]-->
<div class="col" style="display:inline-block;width:{{ larguras[loop.index0] }};vertical-align:top;">
<div class="tp" style="padding:16px {{ '0' if loop.last else '14px' }} 16px 0;">
{{ rotulo(item, "6px") }}
<h2 style="margin:0;font:bold {{ fonte }} {{ serif }};color:{{ ink }};"{{ lang(item.story) }}><a href="{{ item.href }}" style="color:{{ ink }};text-decoration:none;">{{ item.story.headline }}</a></h2>
{% if item.outlets %}<p style="margin:8px 0 0;font:11px/15px {{ sans }};color:{{ muted }};">{{ item.outlets }} {{ "veículo" if item.outlets == 1 else "veículos" }}</p>{% endif %}
</div>
</div>
<!--[if mso]></td><![endif]-->
{% endfor %}
<!--[if mso]></tr></table><![endif]-->
</td></tr>
{%- endmacro %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light only">
<title>{{ subject }}</title>
<style>
  :root{color-scheme:light only;supported-color-schemes:light only;}
  body{margin:0;padding:0;-webkit-text-size-adjust:100%;}
  a{text-decoration:none;}
  @media (max-width:620px){
    .px{padding-left:18px!important;padding-right:18px!important;}
    .r1{font-size:24px!important;line-height:30px!important;}
  }
  @media (max-width:480px){
    .col{display:block!important;width:100%!important;}
    .tp{padding-right:0!important;}
  }
</style>
</head>
<body style="margin:0;padding:0;background:{{ bg }};">
<div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:{{ bg }};">{{ preheader }}{% for _ in range(12) %}&#847;&zwnj;&nbsp;{% endfor %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ bg }}" style="background:{{ bg }};">
<tr><td align="center" style="padding:12px 8px 28px;">
<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;margin:0 auto;">
<tr><td align="right" style="padding:0 2px 8px;font:11px/16px {{ sans }};color:{{ muted }};"><a href="{{ v.edition_url }}" style="color:{{ muted }};text-decoration:underline;">Abrir no navegador</a></td></tr>

{# Cabeçalho: a faixa com o logo (JPG servido pelo GitHub Pages; com imagens
   bloqueadas, vale o alt), o slogan e a data, sobre a cor do topo do site. #}
{% if brand.masthead %}
{% set mh, on = brand.masthead, brand.on_masthead %}
<tr><td align="center" bgcolor="{{ mh }}" style="padding:{{ '0 0 20px' if brand.email_header else '28px 20px 20px' }};background:{{ mh }};border-bottom:3px solid {{ c.navy }};">
{% if brand.email_header %}
<a href="{{ v.base_url }}" style="text-decoration:none;"><img src="{{ brand.email_header.src }}" width="{{ brand.email_header.width }}" height="{{ brand.email_header.height }}" alt="{{ brand.name }}" style="display:block;width:100%;max-width:{{ brand.email_header.width }}px;height:auto;border:0;font:bold 30px/40px {{ serif }};color:{{ on }};text-align:center;"></a>
{% elif brand.email_logo %}
<a href="{{ v.base_url }}" style="text-decoration:none;"><img src="{{ brand.email_logo.src }}" width="{{ brand.email_logo.width }}" height="{{ brand.email_logo.height }}" alt="{{ brand.name }}" style="display:block;margin:0 auto;width:{{ brand.email_logo.width }}px;max-width:100%;height:auto;border:0;font:bold 30px/40px {{ serif }};color:{{ on }};text-align:center;"></a>
{% else %}
<p style="margin:0;font:bold 34px/40px {{ sans }};letter-spacing:-1px;color:{{ on }};">
{%- for part, cls in brand.wordmark %}<span style="color:{{ on }};{% if cls == 'journal' %}font-weight:900;{% endif %}">{{ part }}</span>{% endfor -%}
</p>
{% endif %}
{% if brand.tagline %}<p style="margin:14px 20px 0;font:bold 10px/14px {{ sans }};letter-spacing:3px;text-transform:uppercase;color:{{ on|blend(mh, 0.8) }};">{{ brand.tagline }}</p>{% endif %}
<p style="margin:8px 20px 0;font:10px/14px {{ mono }};letter-spacing:1px;color:{{ on|blend(mh, 0.72) }};">{{ v.date_label }}</p>
</td></tr>
{% else %}
<tr><td align="center" bgcolor="#ffffff" style="padding:26px 20px 20px;background:#ffffff;border-bottom:3px solid {{ c.navy }};">
{% if brand.email_logo %}
<a href="{{ v.base_url }}" style="text-decoration:none;"><img src="{{ brand.email_logo.src }}" width="{{ brand.email_logo.width }}" height="{{ brand.email_logo.height }}" alt="{{ brand.name }}" style="display:block;margin:0 auto;width:{{ brand.email_logo.width }}px;max-width:100%;height:auto;border:0;font:bold 28px/36px {{ serif }};color:{{ c.navy }};text-align:center;"></a>
{% else %}
<p style="margin:0;font:bold 34px/40px {{ sans }};letter-spacing:-1px;color:{{ c.navy }};">
{%- for part, cls in brand.wordmark %}<span style="color:{{ c.accent if cls == 'q' else c.navy }};{% if cls == 'journal' %}font-weight:900;{% endif %}">{{ part }}</span>{% endfor -%}
</p>
{% endif %}
{% if brand.tagline %}<p style="margin:14px 20px 0;font:bold 10px/14px {{ sans }};letter-spacing:3px;text-transform:uppercase;color:{{ muted }};">{{ brand.tagline }}</p>{% endif %}
<p style="margin:8px 20px 0;font:10px/14px {{ mono }};letter-spacing:1px;color:{{ muted }};">{{ v.date_label }}</p>
</td></tr>
{% endif %}
<tr><td style="height:14px;line-height:14px;font-size:1px;">&nbsp;</td></tr>

{# As notícias do dia #}
<tr><td bgcolor="#ffffff" class="px" style="padding:20px 28px 22px;background:#ffffff;border:1px solid #D2D7DE;border-top:3px solid {{ topo }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td style="padding:0 0 10px;border-bottom:1px solid {{ ink }};font:bold 11px/14px {{ sans }};letter-spacing:1.2px;text-transform:uppercase;color:{{ ink }};">Hoje em {{ total }} {{ "notícia" if total == 1 else "notícias" }}</td></tr>
{% if lead %}
{% set s = lead.story %}
<tr><td style="padding:18px 0 18px;">
{{ rotulo(lead, "8px") }}
<h1 class="r1" style="margin:0 0 10px;font:bold 28px/34px {{ serif }};color:{{ ink }};"{{ lang(s) }}><a href="{{ lead.href }}" style="color:{{ ink }};text-decoration:none;">{{ s.headline }}</a></h1>
{% if s.dek %}<p style="margin:0;font:16px/25px {{ serif }};color:{{ body }};"{{ lang(s) }}>{{ s.dek }}</p>{% endif %}
{% if s.sources %}<p style="margin:8px 0 0;font:12px/16px {{ sans }};color:{{ muted }};">{% for src in s.sources[:3] %}{% if not loop.first %} · {% endif %}{{ src.name }}{% endfor %}{% if s.sources|length > 3 %} · +{{ s.sources|length - 3 }}{% endif %}</p>{% endif %}
</td></tr>
{% endif %}
{% for itens in rows %}
{{ linha(itens) }}
{% endfor %}
<tr><td style="padding:14px 0 0;border-top:1px solid {{ ink }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td align="left" style="font:bold 13px/18px {{ sans }};"><a href="{{ v.base_url }}" style="color:{{ ink }};text-decoration:underline;">Ler a edição completa &rarr;</a></td>
{% if v.index_url %}<td align="right" style="font:12px/18px {{ sans }};"><a href="{{ v.index_url }}" style="color:{{ muted }};text-decoration:underline;">{{ v.index_total|num }} notícias hoje</a></td>{% endif %}
</tr></table>
</td></tr>
</table>
</td></tr>

<tr><td align="center" class="px" style="padding:18px 40px 0;">
<p style="margin:0;font:11px/17px {{ sans }};color:{{ muted }};">{{ brand.name }}{% if brand.tagline %} · {{ brand.tagline }}{% endif %}{% if v.sources_total %} · {{ v.sources_total }} fontes{% endif %} · <a href="{{ footer.archive_url }}" style="color:{{ muted }};text-decoration:underline;">Edições anteriores</a>{% if v.instagram_url %} · <a href="{{ v.instagram_url }}" style="color:{{ muted }};text-decoration:underline;">Instagram</a>{% endif %}</p>
</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</body>
</html>
