{#- Interações das páginas (sem bibliotecas), incluídas em todas elas: tema, efeito do
    cabeçalho em canvas 2D, linha de indicadores, abas, busca, gavetas, janelas das
    matérias, progresso de leitura e voltar ao topo. Cada parte verifica se seus elementos
    existem (a página do arquivo e as abas usam só algumas; a edição não tem a barra de
    progresso nem o botão de voltar ao topo). Nada se move sozinho na página da edição.
    A parte da agenda da semana só entra nas páginas que a mostram (agenda_script). -#}
(function () {
  'use strict';
  var d = document, w = window, root = d.documentElement;
  var THEME_KEY = 'qij-theme';
  var noMedia = { matches: false, addEventListener: function () {} };
  function media(query) { return w.matchMedia ? w.matchMedia(query) : noMedia; }
  var reduceMotion = media('(prefers-reduced-motion: reduce)');
  var prefersDark = media('(prefers-color-scheme: dark)');

  function storageGet(key) {
    try { return w.localStorage.getItem(key); } catch (e) { return null; }
  }
  function storageSet(key, value) {
    try { w.localStorage.setItem(key, value); } catch (e) { /* armazenamento indisponível (modo privado) */ }
  }
  function onMediaChange(query, handler) {
    if (query.addEventListener) query.addEventListener('change', handler);
  }
  function onResize(handler) {
    var timer = 0;
    w.addEventListener('resize', function () {
      clearTimeout(timer);
      timer = setTimeout(handler, 150);
    });
  }
  function smooth() { return reduceMotion.matches ? 'auto' : 'smooth'; }

  /* ── Tema claro/escuro ─────────────────────────────────────────────── */
  var themeListeners = [];
  function setupTheme() {
    var button = d.getElementById('dmBtn');
    var label = button && button.querySelector('.lbl');
    function apply(theme) {
      root.setAttribute('data-theme', theme);
      if (label) label.textContent = theme === 'dark' ? 'Claro' : 'Escuro';
      if (button) button.title = theme === 'dark' ? 'Mudar para o modo claro' : 'Mudar para o modo escuro';
      themeListeners.forEach(function (fn) { fn(theme); });
    }
    apply(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
    if (button) {
      button.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        storageSet(THEME_KEY, next);
        apply(next);
      });
    }
    onMediaChange(prefersDark, function (event) {
      var saved = storageGet(THEME_KEY);
      if (saved !== 'dark' && saved !== 'light') apply(event.matches ? 'dark' : 'light');
    });
  }

  /* ── Cabeçalho: rede de partículas em canvas 2D (bem sutil). Na página da edição
     (classe "ed" do corpo da página) a rede fica desenhada e não se mexe: ali nada se move
     sozinho. ─────────────────────────────────────────────────────────── */
  function setupCanvas() {
    var canvas = d.getElementById('mast-canvas');
    var ctx = canvas && canvas.getContext ? canvas.getContext('2d') : null;
    if (!ctx) return;
    var LINK = 110, width = 0, height = 0, points = [], frame = 0, visible = true, colors = {};
    var fixa = d.body.classList.contains('ed');

    function readColors() {
      // --fx-* valem no próprio canvas: o cabeçalho em bloco de cor os redefine.
      var style = getComputedStyle(canvas);
      colors.dot = style.getPropertyValue('--fx-dot').trim() || '#394A7A';
      colors.line = style.getPropertyValue('--fx-line').trim() || '#FF5A1F';
    }
    function resize() {
      var rect = canvas.getBoundingClientRect();
      var ratio = Math.min(w.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      var count = Math.round(Math.min(90, Math.max(24, (width * height) / 2600)));
      points = [];
      for (var i = 0; i < count; i++) {
        points.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.25
        });
      }
    }
    function draw() {
      ctx.clearRect(0, 0, width, height);
      ctx.lineWidth = 1;
      ctx.strokeStyle = colors.line;
      for (var i = 0; i < points.length; i++) {
        for (var j = i + 1; j < points.length; j++) {
          var dx = points[i].x - points[j].x, dy = points[i].y - points[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < LINK) {
            ctx.globalAlpha = 1 - dist / LINK;
            ctx.beginPath();
            ctx.moveTo(points[i].x, points[i].y);
            ctx.lineTo(points[j].x, points[j].y);
            ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 1;
      ctx.fillStyle = colors.dot;
      points.forEach(function (p) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
        ctx.fill();
      });
    }
    function step() {
      frame = 0;
      points.forEach(function (p) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
      });
      draw();
      schedule();
    }
    function schedule() {
      if (!fixa && !frame && visible && !d.hidden && !reduceMotion.matches) frame = w.requestAnimationFrame(step);
    }
    function stop() {
      if (frame) w.cancelAnimationFrame(frame);
      frame = 0;
    }
    readColors();
    resize();
    draw();
    schedule();
    onResize(function () { resize(); draw(); });
    themeListeners.push(function () { readColors(); draw(); });
    onMediaChange(reduceMotion, function () { stop(); schedule(); });
    d.addEventListener('visibilitychange', function () { stop(); schedule(); });
    if ('IntersectionObserver' in w) {
      new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        stop();
        schedule();
      }).observe(canvas);
    }
  }

  /* ── Linha de indicadores: fixa. No toque, o navegador já rola para o lado; com o
     mouse, arrasta-se. A classe "tem-mais" esmaece a ponta direita enquanto há
     cotações além da tela. ─────────────────────────────────────────────────────── */
  function setupIndicadores() {
    var tk = d.querySelector('.tk'), rail = tk && tk.querySelector('.tk-rail');
    if (!rail) return;
    var x0 = 0, inicio = 0, ativo = false;
    function ponta() {
      tk.classList.toggle('tem-mais', rail.scrollLeft + rail.clientWidth < rail.scrollWidth - 2);
    }
    rail.addEventListener('mousedown', function (event) {
      if (event.button !== 0) return;
      ativo = true;
      x0 = event.clientX;
      inicio = rail.scrollLeft;
    });
    w.addEventListener('mousemove', function (event) {
      if (!ativo) return;
      if (Math.abs(event.clientX - x0) > 3) rail.classList.add('arr');
      rail.scrollLeft = inicio - (event.clientX - x0);
    });
    w.addEventListener('mouseup', function () {
      ativo = false;
      rail.classList.remove('arr');
    });
    rail.addEventListener('scroll', ponta, { passive: true });
    onResize(ponta);
    ponta();
  }

  /* Funções que refazem medidas de largura (as setas das abas). Dentro de uma gaveta
     fechada tudo mede zero: setupGavetas as chama de novo quando uma gaveta abre. */
  var medidores = [];

  /* ── Abas das matérias por editoria ────────────────────────────────── */
  function setupTabs() {
    var wrap = d.querySelector('.tabs-wrap');
    if (!wrap) return null;
    var tabs = Array.prototype.slice.call(wrap.querySelectorAll('[role="tab"]'));
    var panes = Array.prototype.slice.call(wrap.querySelectorAll('.tab-pane'));
    var bar = wrap.querySelector('.tabs-bar');
    var api = { wrap: wrap, onSelect: null };

    function reveal(tab) {
      var left = tab.offsetLeft, right = left + tab.offsetWidth;
      if (left < bar.scrollLeft) bar.scrollLeft = left - 16;
      else if (right > bar.scrollLeft + bar.clientWidth) bar.scrollLeft = right - bar.clientWidth + 16;
    }
    function select(tab, focus) {
      var key = tab.getAttribute('data-tab');
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      wrap.classList.toggle('all', key === 'all');
      panes.forEach(function (p) { p.classList.toggle('active', key === 'all' || p.id === 'pane-' + key); });
      if (focus) tab.focus();
      reveal(tab);
    }
    setupTabArrows(bar);
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        if (api.onSelect) api.onSelect();
        select(tab, false);
      });
    });
    bar.addEventListener('keydown', function (event) {
      var index = tabs.indexOf(d.activeElement);
      if (index < 0) return;
      var next = null;
      if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
      else if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
      else if (event.key === 'Home') next = tabs[0];
      else if (event.key === 'End') next = tabs[tabs.length - 1];
      if (!next) return;
      event.preventDefault();
      if (api.onSelect) api.onSelect();
      select(next, true);
    });
    return api;
  }

  /* Setas de rolagem quando as abas não cabem numa linha (atalho para o mouse). */
  function setupTabArrows(bar) {
    var nav = bar.parentNode;
    var prev = nav.querySelector('.tabs-arrow.prev'), next = nav.querySelector('.tabs-arrow.next');
    if (!prev || !next) return;
    function update() {
      prev.hidden = bar.scrollLeft <= 2;
      next.hidden = bar.scrollLeft + bar.clientWidth >= bar.scrollWidth - 2;
    }
    function scrollBy(direction) {
      bar.scrollBy({ left: direction * bar.clientWidth * 0.6, behavior: smooth() });
    }
    prev.addEventListener('click', function () { scrollBy(-1); });
    next.addEventListener('click', function () { scrollBy(1); });
    bar.addEventListener('scroll', update, { passive: true });
    onResize(update);
    medidores.push(update);
    update();
  }

  /* ── Busca em tempo real nas matérias do dia (sem acento e sem diferenciar
     maiúsculas); Enter leva o termo à Pesquisa analítica (todas as edições) ── */
  var modalIsOpen = function () { return false; };
  function setupSearch(tabsApi) {
    var input = d.getElementById('srchInput');
    if (!input || !tabsApi) return;
    var wrap = tabsApi.wrap;
    var count = d.getElementById('srchCount'), none = d.getElementById('noRes');
    var panes = Array.prototype.slice.call(wrap.querySelectorAll('.tab-pane'));
    function norm(value) {
      return value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }
    var cards = Array.prototype.slice.call(wrap.querySelectorAll('.cl'));
    cards.forEach(function (card) { card.searchText = norm(card.textContent.replace(/\s+/g, ' ')); });

    function run() {
      var terms = norm(input.value).split(/\s+/).filter(Boolean);
      var total = 0;
      wrap.classList.toggle('searching', terms.length > 0);
      panes.forEach(function (pane) {
        var shown = 0;
        Array.prototype.forEach.call(pane.querySelectorAll('.cl'), function (card) {
          var match = terms.every(function (t) { return card.searchText.indexOf(t) !== -1; });
          card.classList.toggle('is-hidden', !match);
          if (match) shown++;
        });
        total += shown;
      });
      if (count) count.textContent = terms.length ? (total === 1 ? '1 matéria' : total + ' matérias') : '';
      if (none) none.hidden = !terms.length || total > 0;
    }
    function clear() {
      if (!input.value) return;
      input.value = '';
      run();
    }
    function focusSearch() {
      // O campo mora no bloco recolhido das matérias: abre o bloco antes de focar.
      var gaveta = input.closest ? input.closest('details') : null;
      if (gaveta) gaveta.open = true;
      input.scrollIntoView({ block: 'center', behavior: smooth() });
      input.focus({ preventScroll: true });
    }
    tabsApi.onSelect = clear;
    input.addEventListener('input', run);
    input.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && input.value) {
        event.preventDefault();
        clear();
      }
    });
    // Enter (ou o botão "Todas as edições") envia o formulário: a busca segue para a
    // Pesquisa analítica, com o termo, em todas as edições.
    d.addEventListener('keydown', function (event) {
      var target = event.target;
      var typing = target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
      if (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey && !event.altKey && !modalIsOpen()) {
        event.preventDefault();
        focusSearch();
      }
    });
    if (input.value) run();
  }

  /* ── Gavetas (elementos details): uma função só abre toda gaveta que contém o alvo da âncora
     do endereço, no carregamento e a cada troca de âncora. Vale para as gavetas de
     detalhe da cópia arquivada, para o bloco das matérias por editoria e para
     qualquer id dentro de uma gaveta fechada. Quando uma gaveta abre, as medidas
     das abas são refeitas. ──────────────────────────────────────────── */
  function setupGavetas() {
    function abrir(alvo) {
      var abriu = false;
      for (var el = alvo; el && el.nodeType === 1; el = el.parentNode) {
        if (el.tagName === 'DETAILS' && !el.open) {
          el.open = true;
          abriu = true;
        }
      }
      return abriu;
    }
    function sync(rolar) {
      var id;
      try { id = decodeURIComponent(w.location.hash.slice(1)); } catch (e) { return; }
      var alvo = id ? d.getElementById(id) : null;
      if (!alvo || alvo.classList.contains('mo')) return;
      if (abrir(alvo) || rolar) alvo.scrollIntoView({ block: 'start' });
    }
    d.addEventListener('toggle', function (event) {
      if (event.target.open) medidores.forEach(function (medir) { medir(); });
    }, true);
    w.addEventListener('hashchange', function () { sync(false); });
    // Link para a âncora que já está no endereço não dispara "hashchange".
    d.addEventListener('click', function (event) {
      var link = event.target.closest ? event.target.closest('a[href^="#"]') : null;
      if (link && link.getAttribute('href') === w.location.hash) w.setTimeout(function () { sync(true); }, 0);
    });
    sync(false);
  }

  /* ── Modais das matérias (#s-<id>) ─────────────────────────────────── */
  function setupModals() {
    var modals = d.querySelectorAll('.mo');
    if (!modals.length) return;
    var paper = d.querySelector('.paper');
    var FOCUSABLE = 'a[href],button:not([disabled]),input:not([disabled]),[tabindex]:not([tabindex="-1"])';
    var current = null, lastFocus = null, trigger = null, pushed = false;

    function find(hash) {
      if (!hash || hash.indexOf('#s-') !== 0) return null;
      var id;
      try { id = decodeURIComponent(hash.slice(1)); } catch (e) { return null; }
      var el = d.getElementById(id);
      return el && el.classList.contains('mo') ? el : null;
    }
    function open(modal) {
      if (current === modal) return;
      if (current) current.classList.remove('on');
      else lastFocus = trigger || d.activeElement;
      trigger = null;
      current = modal;
      modal.classList.add('on');
      modal.scrollTop = 0;
      d.body.classList.add('modal-open');
      if (paper) paper.inert = true;
      var box = modal.querySelector('.ml');
      (box || modal).focus({ preventScroll: true });
    }
    function close() {
      if (!current) return;
      var modal = current;
      current = null;
      modal.classList.remove('on');
      d.body.classList.remove('modal-open');
      if (paper) paper.inert = false;
      if (w.location.hash === '#' + modal.id) {
        // Aberto por um link desta página: voltar no histórico; aberto por URL: só limpar a âncora.
        if (pushed) w.history.back();
        else if (w.history.replaceState) w.history.replaceState(null, '', w.location.pathname + w.location.search);
      }
      pushed = false;
      if (lastFocus && lastFocus.focus && d.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
      lastFocus = null;
    }
    function sync() {
      var modal = find(w.location.hash);
      if (modal) open(modal);
      else close();
    }
    modalIsOpen = function () { return current !== null; };

    d.addEventListener('click', function (event) {
      var link = event.target.closest ? event.target.closest('a[href^="#s-"]') : null;
      if (link && find(link.getAttribute('href'))) {
        pushed = true;
        trigger = link;
      }
    });
    Array.prototype.forEach.call(modals, function (modal) {
      modal.addEventListener('click', function (event) {
        if (event.target === modal || (event.target.closest && event.target.closest('.mc,.mc2'))) close();
      });
    });
    d.addEventListener('keydown', function (event) {
      if (!current) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') {
        var items = Array.prototype.filter.call(current.querySelectorAll(FOCUSABLE), function (el) {
          return el.offsetParent !== null;
        });
        if (!items.length) return;
        var first = items[0], last = items[items.length - 1];
        if (event.shiftKey && (d.activeElement === first || !current.contains(d.activeElement))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && d.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    w.addEventListener('hashchange', sync);
    // Aberto pelo link do e-mail (…/AAAA-MM-DD.html#s-id): uma entrada da edição
    // entra no histórico antes da matéria, para o "voltar" do sistema fechar o
    // modal e cair na edição (em vez de sair do site).
    var initial = find(w.location.hash);
    if (initial && w.history.pushState && w.history.replaceState) {
      w.history.replaceState(null, '', w.location.pathname + w.location.search);
      w.history.pushState(null, '', '#' + initial.id);
      pushed = true;
    }
    sync();
    // O Chromium limpa o foco depois da navegação por âncora: devolve o foco ao
    // diálogo quando a página termina de carregar (leitor de tela anuncia a matéria).
    w.addEventListener('load', function () {
      if (current) (current.querySelector('.ml') || current).focus({ preventScroll: true });
    });
  }

  /* ── Cobertura comparada: uma aba por editoria (como as abas das matérias) ── */
  function setupCompareTabs() {
    var wrap = d.querySelector('.cmp-tabs');
    var bar = wrap && wrap.querySelector('.tabs-bar');
    if (!bar) return;
    var tabs = Array.prototype.slice.call(bar.querySelectorAll('[role="tab"]'));
    var panes = Array.prototype.slice.call(wrap.querySelectorAll('.cmp-pane'));
    function reveal(tab) {
      var left = tab.offsetLeft, right = left + tab.offsetWidth;
      if (left < bar.scrollLeft) bar.scrollLeft = left - 16;
      else if (right > bar.scrollLeft + bar.clientWidth) bar.scrollLeft = right - bar.clientWidth + 16;
    }
    function select(tab, focus) {
      var key = tab.getAttribute('data-cmp-tab');
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      wrap.classList.toggle('all', key === 'all');
      panes.forEach(function (p) { p.classList.toggle('active', key === 'all' || p.id === 'cmp-pane-' + key); });
      if (focus) tab.focus();
      reveal(tab);
    }
    setupTabArrows(bar);
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () { select(tab, false); });
    });
    bar.addEventListener('keydown', function (event) {
      var index = tabs.indexOf(d.activeElement);
      if (index < 0) return;
      var next = null;
      if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
      else if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
      else if (event.key === 'Home') next = tabs[0];
      else if (event.key === 'End') next = tabs[tabs.length - 1];
      if (!next) return;
      event.preventDefault();
      select(next, true);
    });
  }

{% if agenda_script is defined and agenda_script %}
  /* ── Agenda da semana: HOJE, AMANHÃ e os dias que já passaram ───────────
     A data é a de Brasília na hora da leitura. Sem script (ou sem a data), os dias
     ficam só com o rótulo ("qua 25"). ─────────────────────────────────── */
  function setupAgenda() {
    var dias = d.querySelectorAll('[data-ag-dia]');
    if (!dias.length || !w.Intl || !w.Intl.DateTimeFormat) return;
    var hoje = '', amanha = '';
    try {
      var partes = {};
      new w.Intl.DateTimeFormat('en-US', { timeZone: 'America/Sao_Paulo', year: 'numeric', month: '2-digit', day: '2-digit' })
        .formatToParts(new Date()).forEach(function (parte) { partes[parte.type] = parte.value; });
      hoje = partes.year + '-' + partes.month + '-' + partes.day;
      var seguinte = new Date(hoje + 'T12:00:00Z');
      seguinte.setUTCDate(seguinte.getUTCDate() + 1);
      amanha = seguinte.toISOString().slice(0, 10);
    } catch (e) { return; }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(hoje)) return;
    Array.prototype.forEach.call(dias, function (el) {
      var dia = el.getAttribute('data-ag-dia'), marca = el.querySelector('.ag-q');
      if (dia < hoje) el.classList.add('passou');
      else if (dia === hoje) { el.classList.add('hoje'); if (marca) marca.textContent = 'HOJE'; }
      else if (dia === amanha && marca) marca.textContent = 'AMANHÃ';
    });
  }

{% endif %}
  /* ── Idade relativa ("há 3 h") recalculada na hora da leitura ───────── */
  function setupAges() {
    var now = Date.now();
    Array.prototype.forEach.call(d.querySelectorAll('time[data-age]'), function (el) {
      var then = Date.parse(el.getAttribute('datetime') || '');
      if (isNaN(then)) return;
      var minutes = Math.floor((now - then) / 60000), label;
      if (minutes < 1) label = 'agora';
      else if (minutes < 60) label = 'há ' + minutes + ' min';
      else if (minutes < 24 * 60) label = 'há ' + Math.floor(minutes / 60) + ' h';
      else if (minutes < 48 * 60) label = 'ontem';
      else {
        var day = new Date(then);
        label = ('0' + day.getDate()).slice(-2) + '/' + ('0' + (day.getMonth() + 1)).slice(-2);
      }
      el.textContent = label;
    });
  }

  /* ── Progresso de leitura e voltar ao topo ─────────────────────────── */
  function setupScroll() {
    var progress = d.getElementById('rdprog'), top = d.getElementById('btt');
    if (!progress && !top) return;  // a página da edição não tem nenhum dos dois
    var ticking = false;
    function update() {
      ticking = false;
      var y = w.pageYOffset || root.scrollTop;
      var max = root.scrollHeight - w.innerHeight;
      if (progress) progress.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, y / max) : 0) + ')';
      if (top) top.classList.toggle('show', y > 400);
    }
    w.addEventListener('scroll', function () {
      if (!ticking) {
        ticking = true;
        w.requestAnimationFrame(update);
      }
    }, { passive: true });
    if (top) {
      top.addEventListener('click', function () {
        w.scrollTo({ top: 0, behavior: smooth() });
        var skipTarget = d.querySelector('.mast h1');
        if (skipTarget) {
          skipTarget.setAttribute('tabindex', '-1');
          skipTarget.focus({ preventScroll: true });
        }
      });
    }
    update();
  }

  /* ── Termômetro do dia (gaveta da cópia arquivada): filtros, ordem e "mostrar todos"
     na lista de textos. Sem script, a lista aparece inteira na ordem da página (mais
     inclinados primeiro) e os filtros ficam ocultos. */
  function setupTermometro() {
    var list = d.getElementById('tmList'), form = d.getElementById('tmFil');
    if (!list || !form) return;
    var more = d.getElementById('tmMore'), none = d.getElementById('tmNone');
    var shown = form.querySelector('.tm-shown');
    var rows = Array.prototype.slice.call(list.children);
    var chips = Array.prototype.slice.call(form.querySelectorAll('.tm-chip'));
    var selV = form.querySelector('select[name="v"]');
    var selE = form.querySelector('select[name="e"]');
    var selO = form.querySelector('select[name="o"]');
    var visiveis = parseInt(list.getAttribute('data-visiveis'), 10) || 12;
    var filtro = 'all', todos = false;
    function num(row, key, vazio) {
      var v = parseFloat(row.getAttribute('data-' + key));
      return isNaN(v) ? vazio : v;
    }
    function pos(a, b) { return num(a, 'i', 0) - num(b, 'i', 0); }
    var ordens = {
      inc: function (a, b) { return Math.abs(num(b, 't', 0)) - Math.abs(num(a, 't', 0)) || num(b, 's', 0) - num(a, 's', 0) || pos(a, b); },
      lr: function (a, b) { return num(a, 't', 1000) - num(b, 't', 1000) || pos(a, b); },
      q: function (a, b) { return num(a, 'q', 1000) - num(b, 'q', 1000) || pos(a, b); },
      sig: function (a, b) { return num(b, 's', 0) - num(a, 's', 0) || pos(a, b); },
      v: function (a, b) { return (a.getAttribute('data-v') || '').localeCompare(b.getAttribute('data-v') || '', 'pt-BR') || pos(a, b); }
    };
    function passa(row) {
      if (filtro === 'sig' && !(num(row, 's', 0) > 0)) return false;
      if (filtro === 'inc' && (row.getAttribute('data-t') === '' || row.getAttribute('data-c') === 'eq')) return false;
      if (filtro === 'op' && row.getAttribute('data-o') !== '1') return false;
      if (selV.value && row.getAttribute('data-v') !== selV.value) return false;
      if (selE.value && row.getAttribute('data-e') !== selE.value) return false;
      return true;
    }
    function render() {
      var sel = rows.filter(passa).sort(ordens[selO.value] || ordens.inc);
      var filtrado = filtro !== 'all' || selV.value || selE.value;
      var limite = todos || filtrado ? sel.length : Math.min(visiveis, sel.length);
      rows.forEach(function (r) { r.hidden = true; });
      sel.forEach(function (r, i) { list.appendChild(r); r.hidden = i >= limite; });
      none.hidden = sel.length > 0;
      more.hidden = limite >= sel.length;
      if (limite < sel.length) more.textContent = 'Mostrar todos os ' + sel.length + ' textos';
      shown.textContent = limite < sel.length
        ? 'Mostrando ' + limite + ' de ' + sel.length
        : sel.length + (sel.length === 1 ? ' texto' : ' textos');
    }
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        filtro = chip.getAttribute('data-f');
        chips.forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
        render();
      });
    });
    [selV, selE, selO].forEach(function (s) { s.addEventListener('change', render); });
    more.addEventListener('click', function () { todos = true; render(); });
    form.addEventListener('submit', function (event) { event.preventDefault(); });
    form.hidden = false;
    render();
  }

  setupTheme();
  setupCanvas();
  setupIndicadores();
  var tabsApi = setupTabs();
  setupSearch(tabsApi);
  setupAges();
{% if agenda_script is defined and agenda_script %}
  setupAgenda();
{% endif %}
  setupCompareTabs();
  setupGavetas();
  setupModals();
  setupScroll();
  setupTermometro();
})();
