{#- Blocos reutilizados na página da edição. "s" é sempre uma StoryView (textos já limpos). -#}

{% macro figure(s, cls) -%}
<figure class="{{ cls }}" data-img><img src="{{ s.image }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"></figure>
{%- endmacro %}

{% macro lang(s) -%}{% if s.lang %} lang="{{ s.lang }}"{% endif %}{%- endmacro %}

{#- Botão "Buscar" do cabeçalho: abre a Pesquisa analítica (todas as edições).
    base: caminho da pasta das edições ("edicoes/" na capa, "./" ou "" dentro dela). -#}
{% macro search_tool(base) -%}
<a class="tool" href="{{ base }}pesquisa.html" title="Pesquisa analítica: buscar em todas as edições"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Buscar</span></a>
{%- endmacro %}

{#- Botão "Congresso" do cabeçalho: a aba com o que faz quem está sentado na Câmara e no
    Senado. base: caminho da pasta das edições, como em search_tool. -#}
{% macro congresso_tool(base) -%}
<a class="tool tool-cg" href="{{ base }}congresso.html" title="Congresso: com quem cada um vota, o que propõe e o que deixa parado" aria-label="Congresso"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V10M9.7 21V10M14.3 21V10M19 21V10M2.5 10 12 4l9.5 6z"/></svg><span>Congresso</span></a>
{%- endmacro %}

{#- Envia a caixa de busca da edição para a Pesquisa analítica. -#}
{% macro search_all() -%}
<button class="srch-all" type="submit" title="Buscar em todas as edições (Pesquisa analítica)"><span class="sr-only">Buscar em </span>Todas as edições<span aria-hidden="true"> &rarr;</span></button>
{%- endmacro %}

{% macro meta(s) -%}
{% if s.source_names or s.age %}
<p class="meta">{% if s.source_names %}<span>{{ s.source_names }}</span>{% endif %}{% if s.age %}<time datetime="{{ s.published }}" data-age>{{ s.age }}</time>{% endif %}</p>
{% endif %}
{%- endmacro %}

{#- Medidor da cobertura comparada (c: CoverageView). Cada veículo é um trecho da
    barra: lado A à esquerda, neutros no meio, lado B à direita — a barra cresce
    para o lado com mais veículos. -#}
{% macro bar(c) -%}
<div class="cov-bar" role="img" aria-label="{{ c.aria }}">
  {%- if c.pct_a %}<span class="cov-a" style="width:{{ c.pct_a }}%"></span>{% endif -%}
  {%- if c.pct_n %}<span class="cov-n" style="width:{{ c.pct_n }}%"></span>{% endif -%}
  {%- if c.pct_b %}<span class="cov-b" style="width:{{ c.pct_b }}%"></span>{% endif -%}
</div>
{%- endmacro %}

{#- Selo do card: barra fina e o lado para onde a cobertura pendeu. -#}
{% macro badge(c) -%}
<div class="cov mini lean-{{ c.lean }}" lang="pt-BR">
  {{ bar(c) }}
  <p class="cov-lean">{{ c.lean_label }}</p>
</div>
{%- endmacro %}

{% macro outlet_list(title, cls, outlets) -%}
<div class="cov-col {{ cls }}">
  <h4>{{ title }} <span>({{ outlets|length }})</span></h4>
  <ul>
    {% for o in outlets %}
    <li>{% if o.url %}<a href="{{ o.url }}" target="_blank" rel="noopener noreferrer">{{ o.name }}<span class="sr-only"> (abre em nova aba)</span></a>{% else %}<b>{{ o.name }}</b>{% endif %}{% if o.framing %}<p class="cov-f">{{ o.framing }}</p>{% endif %}</li>
    {% endfor %}
  </ul>
</div>
{%- endmacro %}

{#- Bloco completo: lados, medidor, conclusão e veículos por lado. -#}
{% macro coverage(c, open=False) -%}
<div class="cov full lean-{{ c.lean }}" lang="pt-BR">
  {% if c.side_a %}
  <div class="cov-scale"><span class="cov-sa">{{ c.side_a }} <b>{{ c.a|length }}</b></span><span class="cov-sb"><b>{{ c.b|length }}</b> {{ c.side_b }}</span></div>
  {% endif %}
  {{ bar(c) }}
  <p class="cov-lean">{{ c.lean_label }}</p>
  {% if c.conclusion %}
  <p class="cov-c">{{ c.conclusion }}</p>
  {% endif %}
  <details class="cov-who"{% if open %} open{% endif %}>
    <summary>Análise por veículo: o foco de cada um e o lado que seguiu ({{ c.total }})</summary>
    <div class="cov-cols">
      {% if c.a %}{{ outlet_list(c.side_a, "ca", c.a) }}{% endif %}
      {% if c.b %}{{ outlet_list(c.side_b, "cb", c.b) }}{% endif %}
      {% if c.neutral %}{{ outlet_list("Neutros" if c.side_a else "Veículos", "cn", c.neutral) }}{% endif %}
    </div>
  </details>
</div>
{%- endmacro %}

{% macro card(s) -%}
<article class="cl" style="--sc:{{ s.color }}">
  <p class="cat">{{ s.section_title }}</p>
  {% if s.image %}
  {{ figure(s, "ci") }}
  {% endif %}
  <h3{{ lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
  {% if s.dek %}
  <p class="dk"{{ lang(s) }}>{{ s.dek }}</p>
  {% endif %}
  {{ meta(s) }}
  {% if s.coverage %}
  {{ badge(s.coverage) }}
  {% endif %}
</article>
{%- endmacro %}

{#- cg_href: endereço da aba Congresso (as fichas dos parlamentares citados abrem o dossiê lá). -#}
{% macro modal(s, tz_label, cg_href="") -%}
<div class="mo" id="{{ s.anchor }}" role="dialog" aria-modal="true" aria-labelledby="t-{{ s.id }}" style="--sc:{{ s.color }}">
  <article class="ml" tabindex="-1"{{ lang(s) }}>
    <button class="mc" type="button" aria-label="Fechar matéria">&times;</button>
    <header class="mhd">
      <p class="mcat">{{ s.section_title }}</p>
      <h2 id="t-{{ s.id }}">{{ s.headline }}</h2>
      {% if s.dek and not s.dek_in_body %}
      <p class="mdek">{{ s.dek }}</p>
      {% endif %}
    </header>
    {% if s.image %}
    {{ figure(s, "mi") }}
    {% endif %}
    {% if s.body %}
    <div class="bt">
      {% for paragraph in s.body %}
      <p>{{ paragraph|md_lite }}</p>
      {% endfor %}
    </div>
    {% endif %}
    {% if s.why %}
    <aside class="why">
      <h3>Por que importa</h3>
      <p>{{ s.why }}</p>
    </aside>
    {% endif %}
    {% if s.coverage %}
    <section class="mcov" aria-label="Análise da cobertura">
      <h3>Análise da cobertura</h3>
      {{ coverage(s.coverage, open=True) }}
    </section>
    {% endif %}
    {% if s.congresso and cg_href %}
    <section class="mcg" aria-label="No Congresso" lang="pt-BR">
      <h3>No Congresso <span>o que os registros dizem de quem a matéria cita</span></h3>
      <ul>
        {% for p in s.congresso %}
        <li>
          <p class="mcg-n"><a href="{{ cg_href }}#p={{ p.k }}">{{ p.nome }}</a><span>{{ p.legenda }}</span></p>
          {% if p.saldo_txt %}<p class="mcg-s"><span class="mcg-b" aria-hidden="true"><i class="mcg-{{ p.lado }}" style="left:{{ p.left }}%;width:{{ p.width }}%"></i></span><b>{{ p.saldo_txt }}</b> {{ p.campo }}</p>{% endif %}
          <p class="mcg-x">{{ p.texto }}</p>
        </li>
        {% endfor %}
      </ul>
      <p class="mcg-f">Saldo: de −100 (sempre com a esquerda) a +100 (sempre com a direita), nas votações em que os polos divergem. <a href="{{ cg_href }}">Ver a aba Congresso<span aria-hidden="true"> &rarr;</span></a></p>
    </section>
    {% endif %}
    {% if s.sources %}
    <div class="bb">
      <h3>Fontes</h3>
      {% if s.compiled %}<p class="mcomp">{{ s.compiled }}</p>{% endif %}
      <ul>
        {% for src in s.sources %}
        <li>{% if src.url %}<a href="{{ src.url }}" target="_blank" rel="noopener noreferrer">{{ src.name }} <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>{% else %}<span>{{ src.name }}</span>{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if s.time %}
    <p class="mtime" lang="pt-BR">Publicado: <time datetime="{{ s.published }}">{{ s.time }}</time> {{ tz_label }}{% if s.age %} · <time datetime="{{ s.published }}" data-age>{{ s.age }}</time>{% endif %}</p>
    {% endif %}
    <p class="mback" lang="pt-BR"><button class="mc2" type="button">&larr; Voltar à edição</button></p>
  </article>
</div>
{%- endmacro %}
