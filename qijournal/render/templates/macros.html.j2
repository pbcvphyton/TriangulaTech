{#- Blocos reutilizados na página da edição. "s" é sempre uma StoryView (textos já limpos). -#}

{#- lazy=False na foto da manchete, que já está na primeira tela. -#}
{% macro figure(s, cls, lazy=True) -%}
<figure class="{{ cls }}" data-img><img src="{{ s.image }}" alt=""{% if lazy %} loading="lazy"{% endif %} decoding="async" referrerpolicy="no-referrer"></figure>
{%- endmacro %}

{% macro lang(s) -%}{% if s.lang %} lang="{{ s.lang }}"{% endif %}{%- endmacro %}

{#- Botão "Buscar" do cabeçalho: abre a Pesquisa analítica (todas as edições).
    base: caminho da pasta das edições ("edicoes/" na capa, "./" ou "" dentro dela). -#}
{% macro search_tool(base) -%}
<a class="tool" href="{{ base }}pesquisa.html" title="Pesquisa analítica: buscar em todas as edições"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Buscar</span></a>
{%- endmacro %}

{#- Botão "Congresso" do cabeçalho: a aba com o que faz quem está sentado na Câmara e no
    Senado. base: caminho da pasta das edições, como em search_tool. atual: na própria aba. -#}
{% macro congresso_tool(base, atual=False) -%}
<a class="tool tool-cg" href="{{ base }}congresso.html" title="Congresso: com quem cada um vota, o que propõe e o que deixa parado" aria-label="Congresso"{% if atual %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V10M9.7 21V10M14.3 21V10M19 21V10M2.5 10 12 4l9.5 6z"/></svg><span>Congresso</span></a>
{%- endmacro %}

{#- Botão "Tribunais" do cabeçalho: que ministro do STF e do STJ está com o quê. O ícone é a
    balança (a coluna já é o Congresso), 24 × 24, traço 2, um path só, como o do Congresso. -#}
{% macro tribunais_tool(base, atual=False) -%}
<a class="tool tool-tb" href="{{ base }}tribunais.html" title="Tribunais: que ministro do STF e do STJ está com o quê" aria-label="Tribunais"{% if atual %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M8 20h8M5 7h14M5 7 2.5 13M5 7l2.5 6M19 7l-2.5 6M19 7l2.5 6M2.5 13a2.5 2.5 0 0 0 5 0M16.5 13a2.5 2.5 0 0 0 5 0"/></svg><span>Tribunais</span></a>
{%- endmacro %}

{#- Botão "Analítico" do cabeçalho (o histórico do termômetro). -#}
{% macro analitico_tool(href, titulo="Analítico Político: todo o histórico do termômetro", atual=False) -%}
<a class="tool tool-an" href="{{ href }}" title="{{ titulo }}" aria-label="Analítico Político"{% if atual %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18"/><path d="M6 16v-5M11 16V7M16 16v-8M21 16V4"/></svg><span>Analítico</span></a>
{%- endmacro %}

{#- Botão "Edições" do cabeçalho (o arquivo). -#}
{% macro edicoes_tool(href) -%}
<a class="tool" href="{{ href }}" title="Edições anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span>Edições</span></a>
{%- endmacro %}

{#- Os botões do cabeçalho em dois grupos (designer.md §5): as abas especiais (Analítico ·
    Congresso · Tribunais) e as ferramentas (Edições · Buscar; o Escuro vem do layout, logo
    depois). A ordem do HTML é a ordem na tela, então o Tab segue o que se vê. O CSS põe os dois
    grupos em duas linhas no celular e de 1024 a 1599 px, e numa linha no resto; na página da
    edição, o celular leva uma fileira só (as abas com o nome escrito, as ferramentas com o ícone).
    brand: BrandView (os macros não veem o contexto da página); base: caminho da pasta das
    edições; analitico: endereço do Analítico ("" sem ele); atual: "analitico", "congresso" ou
    "tribunais" na própria aba (o botão dela leva aria-current); edicoes/buscar: False na página
    que já é o arquivo ou a busca. -#}
{% macro ferramentas(brand, base, analitico="", analitico_titulo="Analítico Político: todo o histórico do termômetro", atual="", edicoes=True, buscar=True) -%}
{% if analitico or brand.congresso or brand.tribunais %}
    <nav class="mt-g mt-abas" aria-label="Abas especiais">
      {% if analitico %}{{ analitico_tool(analitico, analitico_titulo, atual == "analitico") }}{% endif %}
      {% if brand.congresso %}{{ congresso_tool(base, atual == "congresso") }}{% endif %}
      {% if brand.tribunais %}{{ tribunais_tool(base, atual == "tribunais") }}{% endif %}
    </nav>
{% endif %}
{% if edicoes or buscar %}
    <div class="mt-g mt-fer">
      {% if edicoes %}{{ edicoes_tool(base) }}{% endif %}
      {% if buscar %}{{ search_tool(base) }}{% endif %}
    </div>
{% endif %}
{%- endmacro %}

{#- Envia a caixa de busca da edição para a Pesquisa analítica. -#}
{% macro search_all() -%}
<button class="srch-all" type="submit" title="Buscar em todas as edições (Pesquisa analítica)"><span class="sr-only">Buscar em </span>Todas as edições<span aria-hidden="true"> &rarr;</span></button>
{%- endmacro %}

{#- Agenda da semana (bloco da home). Os objetos vêm de render/agenda.py (AgendaView): os
    textos chegam prontos e validados; aqui eles só são juntados. As classes "so-larga" e
    "so-cel" trocam a versão do computador pela do celular (nome curto, "mais N" com um item
    só), sem repetir o texto que as duas têm em comum; o segundo item de uma linha (classe
    "larga") some no celular.

    Um item: palavra de área, o ASSUNTO, e só depois o identificador (link oficial), a marca
    de mídia (quando há ligação) e a situação em português claro. -#}
{% macro agenda_item(i) -%}
<p class="ag-i{% if i.so_tela_larga %} larga{% endif %}"><span class="ag-nk"><span class="ag-n"{% if i.nome %} title="{{ i.nome }}"{% endif %}>{% if i.area %}<b class="ag-a">{{ i.area }}</b> {% endif %}{% if i.nome_comum %}{{ i.nome_comum }}<span class="so-larga">{{ i.nome_resto }}</span><span class="so-cel">…</span>{% elif i.nome_curto %}<span class="so-larga">{{ i.nome }}</span><span class="so-cel">{{ i.nome_curto }}</span>{% else %}{{ i.nome }}{% endif %}</span><span class="ag-k">{% if i.nome %}<span class="ag-s"> · </span>{% endif %}{% if i.link %}<a href="{{ i.link }}" target="_blank" rel="noopener noreferrer">{{ i.identificador }}<span class="sr-only"> (abre em nova aba)</span></a>{% else %}{{ i.identificador }}{% endif %}{% if i.midia %}<span class="ag-s"> · </span>{% if i.midia_href %}<a class="ag-md" href="{{ i.midia_href }}">{{ i.midia }}</a>{% else %}{{ i.midia }}{% endif %}{% endif %}</span></span>{% if i.situacao %}<span class="ag-t">{{ i.situacao }}</span>{% endif %}</p>
{%- endmacro %}

{#- Uma linha de pauta: a hora (ou o dia, na faixa "Já decidido"), a instituição e o órgão
    por extenso, sempre na mesma posição; depois a situação da linha, os itens e o resto
    ("mais N"). Linha sem item nomeado leva o link oficial na própria cabeça. -#}
{% macro agenda_linha(l, com_dia=False) -%}
<li class="ag-l{% if l.aberta %} ab{% endif %}">
  <p class="ag-c"><span class="ag-h">{{ l.dia if com_dia else l.hora }}</span> {% if l.link and not l.itens %}<a href="{{ l.link }}" target="_blank" rel="noopener noreferrer">{{ l.cabeca }}<span class="sr-only"> (abre em nova aba)</span></a>{% else %}<b>{{ l.cabeca }}</b>{% endif %}</p>
  <div class="ag-x">
    {%- if l.situacao %}<p class="ag-ls">{{ l.situacao }}</p>{% endif -%}
    {%- for i in l.itens %}{{ agenda_item(i) }}{% endfor -%}
    {%- if l.situacao_comum or l.mais or l.mais_celular %}{% set sep = " · " if l.situacao_comum else "" %}<p class="ag-m">{{ l.situacao_comum }}{% if l.mais == l.mais_celular %}{{ sep }}{{ l.mais }}{% else %}{% if l.mais %}<span class="so-larga">{{ sep }}{{ l.mais }}</span>{% endif %}{% if l.mais_celular %}<span class="so-cel">{{ sep }}{{ l.mais_celular }}</span>{% endif %}{% endif %}</p>{% endif -%}
  </div>
</li>
{%- endmacro %}

{#- Um dia da agenda. A data vai no atributo data-ag-dia: é por ela que o navegador marca
    HOJE, AMANHÃ e o que já passou (page.js.j2); sem script, fica só a data. -#}
{% macro agenda_dia(d) -%}
<div class="ag-dia{% if not d.linhas %} sem{% endif %}"{% if d.data %} data-ag-dia="{{ d.data }}"{% endif %}>
  <h3 class="ag-d"><span class="ag-q"></span><span{% if d.rotulo_longo %} title="{{ d.rotulo_longo }}"{% endif %}>{{ d.rotulo }}</span></h3>
  {% if d.linhas %}
  <ul class="ag-ll">
    {% for l in d.linhas %}
    {{ agenda_linha(l) }}
    {% endfor %}
  </ul>
  {% else %}
  <p class="ag-vz">{{ d.vazio }}</p>
  {% endif %}
</div>
{%- endmacro %}

{#- Linha de serviço de uma chamada (itens: lista de ServicoView, montada em web.py): os
    trechos separados por " · ". A idade ("há 3 h") é recalculada no navegador; a marca de
    divergência leva ao item de "Onde os veículos divergiram". -#}
{% macro servico(itens) -%}
{% if itens %}
<p class="sv">
  {%- for i in itens -%}
  {%- if not loop.first %}<span class="sv-s"> · </span>{% endif -%}
  {%- if i.tipo == "idade" %}<time datetime="{{ i.quando }}" data-age>{{ i.texto }}</time>
  {%- elif i.tipo == "hora" %}<time datetime="{{ i.quando }}">{{ i.texto }}</time>
  {%- elif i.tipo == "diverge" %}<a class="sv-dv" href="{{ i.href }}">{{ i.texto }}</a>
  {%- elif i.href %}<a href="{{ i.href }}">{{ i.texto }}</a>
  {%- else %}<span>{{ i.texto }}</span>
  {%- endif -%}
  {%- endfor -%}
</p>
{% endif %}
{%- endmacro %}

{#- Medidor da cobertura comparada (c: CoverageView). Cada veículo é um trecho da
    barra: lado A à esquerda, neutros no meio, lado B à direita — a barra cresce
    para o lado com mais veículos. -#}
{% macro bar(c) -%}
<div class="cov-bar" role="img" aria-label="{{ c.aria }}">
  {%- if c.pct_a %}<span class="cov-a" style="width:{{ c.pct_a }}%"></span>{% endif -%}
  {%- if c.pct_n %}<span class="cov-n" style="width:{{ c.pct_n }}%"></span>{% endif -%}
  {%- if c.pct_b %}<span class="cov-b" style="width:{{ c.pct_b }}%"></span>{% endif -%}
</div>
{%- endmacro %}

{% macro outlet_list(title, cls, outlets) -%}
<div class="cov-col {{ cls }}">
  <h4>{{ title }} <span>({{ outlets|length }})</span></h4>
  <ul>
    {% for o in outlets %}
    <li>{% if o.url %}<a href="{{ o.url }}" target="_blank" rel="noopener noreferrer">{{ o.name }}<span class="sr-only"> (abre em nova aba)</span></a>{% else %}<b>{{ o.name }}</b>{% endif %}{% if o.framing %}<p class="cov-f">{{ o.framing }}</p>{% endif %}</li>
    {% endfor %}
  </ul>
</div>
{%- endmacro %}

{#- Bloco completo: lados, medidor, conclusão e veículos por lado. -#}
{% macro coverage(c, open=False) -%}
<div class="cov full lean-{{ c.lean }}" lang="pt-BR">
  {% if c.side_a %}
  <div class="cov-scale"><span class="cov-sa">{{ c.side_a }} <b>{{ c.a|length }}</b></span><span class="cov-sb"><b>{{ c.b|length }}</b> {{ c.side_b }}</span></div>
  {% endif %}
  {{ bar(c) }}
  <p class="cov-lean">{{ c.lean_label }}</p>
  {% if c.conclusion %}
  <p class="cov-c">{{ c.conclusion }}</p>
  {% endif %}
  <details class="cov-who"{% if open %} open{% endif %}>
    <summary>Análise por veículo: o foco de cada um e o lado que seguiu ({{ c.total }})</summary>
    <div class="cov-cols">
      {% if c.a %}{{ outlet_list(c.side_a, "ca", c.a) }}{% endif %}
      {% if c.b %}{{ outlet_list(c.side_b, "cb", c.b) }}{% endif %}
      {% if c.neutral %}{{ outlet_list("Neutros" if c.side_a else "Veículos", "cn", c.neutral) }}{% endif %}
    </div>
  </details>
</div>
{%- endmacro %}

{#- Cartão de "Todas as matérias, por editoria": só a editoria, o título e a linha fina; a
    marca de divergência só quando o assunto teve veículos dos dois lados. Foto, lista de
    veículos, hora e barra da cobertura ficam na janela da matéria. -#}
{% macro card(s) -%}
<article class="cl" style="--sc:{{ s.color }}">
  <p class="cat">{{ s.section_title }}</p>
  <h3{{ lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
  {% if s.dek %}
  <p class="dk"{{ lang(s) }}>{{ s.dek }}</p>
  {% endif %}
  {% if s.marca %}
  <p class="sv"><span class="sv-dv">{{ s.marca }}</span></p>
  {% endif %}
</article>
{%- endmacro %}

{#- cg_href: endereço da aba Congresso (as fichas dos parlamentares citados abrem o dossiê lá). -#}
{% macro modal(s, tz_label, cg_href="") -%}
<div class="mo" id="{{ s.anchor }}" role="dialog" aria-modal="true" aria-labelledby="t-{{ s.id }}" style="--sc:{{ s.color }}">
  <article class="ml" tabindex="-1"{{ lang(s) }}>
    <button class="mc" type="button" aria-label="Fechar matéria">&times;</button>
    <header class="mhd">
      <p class="mcat">{{ s.section_title }}</p>
      <h2 id="t-{{ s.id }}">{{ s.headline }}</h2>
      {% if s.dek and not s.dek_in_body %}
      <p class="mdek">{{ s.dek }}</p>
      {% endif %}
    </header>
    {% if s.image %}
    {{ figure(s, "mi") }}
    {% endif %}
    {% if s.body %}
    <div class="bt">
      {% for paragraph in s.body %}
      <p>{{ paragraph|md_lite }}</p>
      {% endfor %}
    </div>
    {% endif %}
    {% if s.why %}
    <aside class="why">
      <h3>Por que importa</h3>
      <p>{{ s.why }}</p>
    </aside>
    {% endif %}
    {% if s.coverage %}
    <section class="mcov" aria-label="Análise da cobertura">
      <h3>Análise da cobertura</h3>
      {{ coverage(s.coverage, open=True) }}
    </section>
    {% endif %}
    {% if s.congresso and cg_href %}
    <section class="mcg" aria-label="No Congresso" lang="pt-BR">
      <h3>No Congresso <span>o que os registros dizem de quem a matéria cita</span></h3>
      <ul>
        {% for p in s.congresso %}
        <li>
          <p class="mcg-n"><a href="{{ cg_href }}#p={{ p.k }}">{{ p.nome }}</a><span>{{ p.legenda }}</span></p>
          {% if p.saldo_txt %}<p class="mcg-s"><span class="mcg-b" aria-hidden="true"><i class="mcg-{{ p.lado }}" style="left:{{ p.left }}%;width:{{ p.width }}%"></i></span><b>{{ p.saldo_txt }}</b> {{ p.campo }}</p>{% endif %}
          <p class="mcg-x">{{ p.texto }}</p>
        </li>
        {% endfor %}
      </ul>
      <p class="mcg-f">Saldo: de −100 (sempre com a esquerda) a +100 (sempre com a direita), nas votações em que os polos divergem. <a href="{{ cg_href }}">Ver a aba Congresso<span aria-hidden="true"> &rarr;</span></a></p>
    </section>
    {% endif %}
    {% if s.sources %}
    <div class="bb">
      <h3>Fontes</h3>
      {% if s.compiled %}<p class="mcomp">{{ s.compiled }}</p>{% endif %}
      <ul>
        {% for src in s.sources %}
        <li>{% if src.url %}<a href="{{ src.url }}" target="_blank" rel="noopener noreferrer">{{ src.name }} <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>{% else %}<span>{{ src.name }}</span>{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if s.time %}
    <p class="mtime" lang="pt-BR">Publicado: <time datetime="{{ s.published }}">{{ s.time }}</time> {{ tz_label }}{% if s.age %} · <time datetime="{{ s.published }}" data-age>{{ s.age }}</time>{% endif %}</p>
    {% endif %}
    <p class="mback" lang="pt-BR"><button class="mc2" type="button">&larr; Voltar à edição</button></p>
  </article>
</div>
{%- endmacro %}
