    var nomes = {};
    [maj, contra, emp, neu].forEach(function (m) { Object.keys(m).forEach(function (o) { nomes[o] = true; }); });
    var veiculos = Object.keys(nomes).map(function (o) {
      var com = maj[o] || 0, cont = contra[o] || 0;
      return { o: o, maj: com, contra: cont, emp: emp[o] || 0, neu: neu[o] || 0, n: com + cont, t: com + cont ? cont / (com + cont) : 0 };
    }).filter(function (v) { return v.n >= MD.lado; })
      .sort(function (a, b) { return b.t - a.t || b.n - a.n || cmp(a.o, b.o); });
    var listaPares = Object.keys(pares).map(function (k) { var p = pares[k]; p.t = p.s / p.n; return p; })
      .filter(function (p) { return p.n >= MD.par; });
    var juntos = listaPares.slice().sort(function (a, b) { return b.t - a.t || b.n - a.n || cmp(a.a + a.b, b.a + b.b); });
    var opostos = listaPares.slice().sort(function (a, b) { return a.t - b.t || b.n - a.n || cmp(a.a + a.b, b.a + b.b); });
    if (listaPares.length > 6) { juntos = juntos.slice(0, 3); opostos = opostos.slice(0, 3); }
    else { opostos = []; }  // poucos pares: uma lista só, do mais ao menos alinhado
    itens.sort(function (x, y) { return y.dv - x.dv || (y.a + y.b) - (x.a + x.b) || cmp(y.r.d, x.r.d) || cmp(x.r.t, y.r.t); });
    return {
      total: comps.length, debates: itens.length, consenso: consenso, media: itens.length ? soma / itens.length : null,
      itens: itens, veiculos: veiculos, juntos: juntos, opostos: opostos
    };
  }

  /* ── tom das manchetes (a mesma conta de tom_do_nome em qijournal/render/midia.py) ── */
  var TOM = tomCriar(M.tom || {});
  var TP = M.tomP || { min: 20, minV: 10, z: 2.58, zT: 1.96, minSem: 20, semV: 3, semD: 10, padS: 3, padF: 0.75, barra: 50 };
  var proprioCache = {};
  // Nomes próprios do dia (como corpus_do_dia): manchetes de veículos brasileiros de todas as
  // editorias da edição, a mesma notícia uma vez.
  function propriosDoDia(dia) {
    if (proprioCache[dia]) return proprioCache[dia];
    var vistos = {}, itens = [];
    (cache[dia] || []).forEach(function (r) {
