  // Palavras de rotina das manchetes que não dizem o tema ("nesta 3ª feira", "agenda do dia").
  'nesta neste feira agenda principal pede vence antes segunda terca quarta quinta sexta sabado domingo'
    .split(' ').forEach(function (p) { VAZIAS[p] = true; });
  var MD = {
    base: 30,        // manchetes do veículo no período para a tabela "vs. esperado" da base completa
    semana: 7,       // espaço e tom: últimas 7 edições contra as 7 anteriores
    baseSemana: 50,  // manchetes coletadas em cada janela para comparar o espaço (midia.py)
    minTend: 10,     // manchetes do termo nas duas janelas para comparar o espaço
    pequena: 5,
    topo: 12,
    espMin: 3,       // atenção: o veículo entra na comparação com 3+ manchetes esperadas sobre o termo
    picoK: 5,        // pico: 5+ manchetes do termo no dia…
    picoR: 1.5,      // … e 1,5 vez a parte dos outros dias
    pares: 10,       // pares mostrados em "quem fica com quem" (os mais longe do acaso)
