      B: x.base.total, n: x.nots.length, nBr: at ? at.br.k : 0, nveic: at ? at.nveic : 0, diasCom: at ? at.diasCom : 0, dCom: at ? at.serie.length : 0,
      jan: at ? at.jan : null, antes: at ? at.antes : 0, tend: at ? at.tend : null, picos: at ? at.picos : null, serie: at ? at.serie : [],
      ext: at ? at.ext : null, mAt: at ? at.mAt : 0, mVei: tm && !tm.falta ? tm.mVei : 0,
      hist: x.hist, pauta: x.pz ? { grupos: x.pz.grupos, temas: x.pz.temas } : null, lados: x.ld, texto: x.tx, az: az, veic: []
    };
    // O tom só se lê com um termo e 20+ manchetes brasileiras com palavra de tom.
    if (x.nots.length) {
      var ok = tm && !tm.falta, motivo = '';
      if (!umTermo) motivo = 'a busca tem mais de um termo; use aspas para buscar a frase';
      else if (!F.nBr) motivo = 'nenhuma manchete brasileira cita o termo';
      else if (!ok) motivo = 'só ' + plural(tm.n, 'manchete brasileira cita', 'manchetes brasileiras citam') + ' o termo (o mínimo é ' + TP.min + ')';
      else if (tm.comTom < TP.min) motivo = 'só ' + num(tm.comTom) + ' das ' + num(tm.n) + ' manchetes brasileiras têm palavra de tom (o mínimo é ' + TP.min + ')';
      F.tom = {
        aplica: !motivo, motivo: motivo, n: tm ? tm.n : 0, comTom: ok ? tm.comTom : 0, saldo: ok ? tm.saldo : null, desf: ok ? tm.neg : 0, fav: ok ? tm.pos : 0,
        tend: ok && tm.tend ? { sa: tm.tend.sa, sr: tm.tend.sr, na: tm.tend.na, nr: tm.tend.nr, z: tm.tend.z, p: tm.tend.p, passa: tm.tend.passa } : null
      };
    }
    // O placar: os veículos brasileiros com 3+ manchetes sobre o termo, do que mais cita ao que
    // menos; e os que a atenção marca mesmo sem lugar no placar (os que quase não citam).
    var tomV = {};
    (tm && !tm.falta ? tm.veiculos : []).forEach(function (v) { tomV[v.o] = v; });
    function linha(o, idx) {
      var pv = at.porV[o] || {}, tv = tomV[o];
      return { o: o, idx: idx, k: at.k[o] || 0, b: x.base.veiculo[o] || 0, esp: pv.esp || 0, i: pv.i === undefined ? null : pv.i, pAt: pv.pAt, atForte: !!pv.atForte,
        sv: tv ? tv.sv : null, so: tv ? tv.so : null, z: tv ? tv.z : null, tomForte: !!(tv && tv.forte), tomIsolado: tv ? tv.classe : '',
        kTom: tv ? tv.k : 0, desf: tv ? tv.desf : 0, fav: tv ? tv.fav : 0, pequena: tv ? tv.pequena : true, tv: tv || null };
    }
    if (at) {
      var placar = at.veiculos.filter(function (v) { return !v.ex && v.o && v.k >= 3; });
      F.veic = placar.map(function (v, i) { return linha(v.o, i + 1); });
      Object.keys(at.porV).forEach(function (o) {
        if (at.porV[o].atForte && !placar.some(function (v) { return v.o === o; })) F.veic.push(linha(o, 0));
      });
    }
    // Chegando do Analítico com a mesma base de um nome do placar dele: valem os vereditos de lá.
    if (az) {
      if (F.tend) F.tend.passa = az.esp && F.tend.v !== null && Math.abs(F.tend.v) > 0.15 || (az.esp && F.tend.v === null);
      if (F.tom && F.tom.tend) F.tom.tend.passa = az.tom;
      F.veic.forEach(function (v) { v.tomForte = az.vei.indexOf(v.o) >= 0; });
      if (tm && !tm.falta) tm.veiculos.forEach(function (v) { v.forte = az.vei.indexOf(v.o) >= 0; });
    }
    if (tm && !tm.falta) tm.familia = az ? 'as ' + num(az.mVei) + ' comparações veículo × nome do Analítico' : 'os ' + num(tm.mVei) + ' veículos comparados';
    return F;
  }

  // Período de 7 a 13 edições: as edições logo antes dele completam as duas janelas de sete
  // ("o que mudou"); só para essas contas — nada entra na lista, no CSV ou nas outras lentes.
  function edicoesExtras(e) {
    var D = e.dias.length;
    if (D < MD.semana || D >= 2 * MD.semana || e.res.length <= 10 || !e.f.tipos.n) return [];
    if (!e.res.some(function (x) { return x.r.k === 'n'; })) return [];
    var maisAntiga = e.dias[D - 1].d;
    return DIAS.filter(function (x) { return x.d < maisAntiga; }).slice(0, 2 * MD.semana - D);
  }
  function janelasEstendidas(e, ts, extras) {
    var f = {}, k;
    for (k in e.f) if (Object.prototype.hasOwnProperty.call(e.f, k)) f[k] = e.f[k];
    f.de = extras[extras.length - 1].d;
    f.ate = extras[0].d;
    // As notícias do período ficam onde estão; das edições anteriores entra só o que o período não tem.
    var eX = { f: e.f, ts: e.ts, dias: e.dias.concat(extras), res: e.res.slice() }, links = {};
    e.res.forEach(function (x) { if (x.r.k === 'n') links[x.r.u] = true; });
    extras.slice().reverse().forEach(function (x) {
      (cache[x.d] || []).forEach(function (r) {
        if (r.k !== 'n' || links[r.u] || !passa(r, f) || !casa(r, e.ts, f.tit)) return;
        links[r.u] = true;
        eX.res.push({ r: r, n: 1 });
      });
    });
    var nots = eX.res.filter(function (x) { return x.r.k === 'n'; }).map(function (x) { return x.r; });
    if (!nots.length) return null;
    var at = atencao(nots, mdBase(e, extras, f), eX), tm = tomDoTermo(nots, eX, ts, at);
    return { tend: at.tend, jan: at.jan, antes: at.antes, tomTend: tm && !tm.falta ? tm.tend : null };
  }

  function leituraMidia(e, ts) {
    var qs = [];
    ts.forEach(function (t) { t.n.split(' ').forEach(function (p) { if (p && qs.indexOf(p) < 0) qs.push(p); }); });
    // A leitura não depende da ordem escolhida para a lista (os empates saem sempre iguais).
    var nots = [], comps = [];
    e.res.slice().sort(function (x, y) { return cmp(x.r.d, y.r.d) || cmp(x.r.u || '', y.r.u || '') || cmp(x.r.t || '', y.r.t || ''); })
      .forEach(function (x) { if (x.r.k === 'n') nots.push(x.r); else if (x.r.k === 'c') comps.push(x.r); });
    var base = mdBase(e);
    var x = { nots: nots, base: base };
    x.at = nots.length ? atencao(nots, base, e) : null;
    x.tm = nots.length ? tomDoTermo(nots, e, ts, x.at) : null;
    x.pz = nots.length ? pauta(nots, qs) : null;
    x.hist = nots.length ? historias(nots) : [];
    x.ld = ladosBusca(comps, e);
    x.tx = textoBusca(e);
    x.qs = qs;
    x.F = fatos(e, x);
    var extras = e.extras || [];
    if (e.extrasFalharam) x.F.f.extraFalhou = true;
    if (extras.length && x.F.n && !x.F.jan) {
      var J = janelasEstendidas(e, ts, extras);
      if (J && J.jan) {
        x.F.jan = J.jan;
        x.F.tend = J.tend;
        x.F.antes = J.antes;
        x.F.f.extra = extras.length;
        if (x.F.tom && x.F.tom.aplica) {
          var t = J.tomTend;
          x.F.tom.tend = t ? { sa: t.sa, sr: t.sr, na: t.na, nr: t.nr, z: t.z, p: t.p, passa: t.passa } : null;
        }
      }
    }
    return x;
  }

  /* ── as tabelas da base completa (recolhidas) ───────────────────────── */
  // O que cada veículo enfatiza: palavras que ele usa bem mais que os outros veículos
  // brasileiros nas manchetes sobre o termo (log-odds com prior de Dirichlet informativo).
  function vozes(nots, qs) {
    var porVeiculo = {}, tudo = {}, total = 0, formas = {};
    nots.forEach(function (r) {
      var o = r.f[0];
      if (!o || EXTERIOR[o]) return;
      var ps = r.ps || (r.ps = palavras(r.t)), s = porVeiculo[o] || (porVeiculo[o] = { n: 0, c: {}, t: 0 });
      s.n++;
      ps.forEach(function (p, k) {
        var n = p.n;
        if (n.length < 3 || VAZIAS[n] || FORA[n] || /^\d+$/.test(n) || doTermo(n, qs)) return;
        somar(s.c, n);
        s.t++;
        somar(tudo, n);
        total++;
        var f = formas[n] || (formas[n] = { meio: {}, inicio: {} });
        if (inicioFrase(r.t, ps, k)) somar(f.inicio, p.p === p.p.toUpperCase() || maiuscula(p.p.slice(1)) ? p.p : p.p.toLowerCase());
        else somar(f.meio, p.p);
      });
    });
    var a0 = 0.1 * total;  // força do prior: 10% das palavras dos resultados, na proporção de cada uma
    var veiculos = Object.keys(porVeiculo).filter(function (o) { return porVeiculo[o].n >= MD.voc; })
      .sort(function (a, b) { return porVeiculo[b].n - porVeiculo[a].n || cmp(a, b); }).slice(0, 8);
    if (veiculos.length < 2) return { veiculos: [], faltam: veiculos.length };
    return {
      veiculos: veiculos.map(function (o) {
        var s = porVeiculo[o], ni = s.t, nj = total - ni, termos = [];
        if (nj > 0) {
          Object.keys(s.c).forEach(function (pal) {
            var yi = s.c[pal];
            if (yi < 3) return;
            var yw = tudo[pal], aw = a0 * yw / total, yj = yw - yi;
            var di = ni + a0 - yi - aw, dj = nj + a0 - yj - aw;
            if (di <= 0 || dj <= 0) return;
            var delta = Math.log((yi + aw) / di) - Math.log((yj + aw) / dj);
            var z = delta / Math.sqrt(1 / (yi + aw) + 1 / (yj + aw));
            if (z > MD.z) termos.push({ f: maisFrequente(Object.keys(formas[pal].meio).length ? formas[pal].meio : formas[pal].inicio), y: yi, z: z });
          });
        }
        termos.sort(function (a, b) { return b.z - a.z || cmp(a.f, b.f); });
        return { o: o, n: s.n, termos: termos.slice(0, MD.termos) };
      }),
      faltam: 0
    };
  }

  function blocoVozes(vz) {
    if (!vz) return '';
    var h = '<div class="md-blk"><h4>O que cada veículo enfatiza</h4>';
    if (!vz.veiculos.length) {
      return h + '<p class="md-note">Para comparar o vocabulário, são precisos dois ou mais veículos brasileiros com ' + MD.voc + '+ manchetes sobre o termo.</p></div>';
    }
    h += '<p class="md-note">Palavras que o veículo usa bem mais que os outros veículos brasileiros nas manchetes sobre o termo — o ângulo de cada um.</p><ul class="md-voc">';
    vz.veiculos.forEach(function (v) {
      h += '<li><button type="button" class="md-vn" data-v="' + esc(v.o) + '" title="Filtrar por ' + esc(v.o) + '">' + esc(v.o) + '</button><span class="md-vc">' + plural(v.n, 'manchete', 'manchetes') + '</span>' +
        (v.termos.length ? '<span class="md-chips">' + v.termos.map(function (t) {
          return '<button type="button" data-q="' + esc(t.f) + '" data-v="' + esc(v.o) + '" title="' + esc(t.f) + ': ' + plural(t.y, 'vez', 'vezes') + ' (clique para ver essas manchetes)">' + esc(t.f) + ' <b>' + t.y + '</b></button>';
        }).join('') + '</span>' : '<span class="md-vt">sem diferença clara de vocabulário</span>') + '</li>';
    });
    return h + '</ul></div>';
  }

  function blocoAtencao(at) {
    var h = '<div class="md-blk"><ul class="md-tiles">';
    h += '<li><span>Participação nas manchetes</span><b>' + pct(at.n, at.base) + '</b><small>' + num(at.n) + ' de ' + num(at.base) + '</small></li>';
    if (at.ex.b >= MD.base && at.br.b >= MD.base) {
      h += '<li><span>Brasil × exterior</span><b>' + pct(at.br.k, at.br.b) + ' × ' + pct(at.ex.k, at.ex.b) + '</b><small>' + num(at.br.k) + ' e ' + num(at.ex.k) + ' manchetes</small></li>';
    }
    h += '<li><span>Veículos que citam</span><b>' + num(at.nveic) + '</b><small>' + plural(at.veiculos.filter(function (v) { return v.ex; }).length, 'do exterior', 'do exterior') + '</small></li>';
    h += '</ul>';
    // vs. esperado: o da comparação (3+ manchetes esperadas) ou, sem ela, o da tabela (30+ manchetes do veículo)
    function indice(v) {
      var pv = at.porV[v.o];
      if (pv && pv.esp >= MD.espMin) return v.k / pv.esp;
      return v.i;
    }
    var maior = 0;
    at.veiculos.forEach(function (v) { var i = indice(v); if (i !== null && i !== undefined) maior = Math.max(maior, i); });
    h += '<div class="an-tbl-wrap"><table class="md-tbl"><thead><tr><th scope="col">Veículo</th><th scope="col">Manchetes</th>' +
      '<th scope="col" title="Parte das manchetes do veículo no período que cita o termo">% do que publicou</th>' +
      '<th scope="col" title="Manchetes do veículo sobre o termo ÷ as esperadas pelo espaço que o termo tem em cada editoria em que o veículo publica (1× = o esperado)">Espaço vs. esperado</th></tr></thead><tbody>';
    at.veiculos.concat(at.semCitar || []).forEach(function (v) {
      var pv = at.porV[v.o], forte = pv && pv.atForte, iv = indice(v);
      h += '<tr><th scope="row"><button type="button" data-v="' + esc(v.o) + '" title="Filtrar por ' + esc(v.o) + '">' + esc(v.o) + '</button>' +
        (v.ex ? '<span class="md-ex">exterior</span>' : '') + '</th><td>' + num(v.k) + '</td><td>' + (v.b ? pct(v.k, v.b) : '—') + '</td>' +
        '<td class="md-ix' + (forte ? ' pq-on' : '') + '"' + (forte ? ' title="Passa do acaso, mesmo contando os ' + num(at.mAt) + ' veículos comparados (99%)"' : '') + '>' +
        (iv === null || iv === undefined ? '<span title="Poucas manchetes do veículo no período para comparar">—</span>' :
          !v.k ? '0× <small>(umas ' + num(Math.max(1, ST.arred(pv.esp, 0))) + ' esperadas)</small>' :
          '<i style="--w:' + Math.round(iv / (maior || 1) * 100) + '%" aria-hidden="true"></i>' + dec(iv, 1) + '×') + '</td></tr>';
    });
    h += '</tbody></table></div>';
    return h + '<p class="md-note">Com o contorno: a diferença para o esperado passa do acaso, mesmo contando todos os veículos comparados (Poisson exato, Holm a 99%).</p></div>';
  }

  function blocoTom(tm) {
    var h = '<div class="md-blk" id="md-tom">';
    if (!tm || tm.falta) {
      return h + '<p class="md-note">Para ler o tom, são precisas ' + TP.min + '+ manchetes de veículos brasileiros com o termo' + (tm ? ' (há ' + num(tm.n) + ')' : '') + '.</p></div>';
    }
    var cls = tm.saldo <= -10 ? 'neg' : tm.saldo >= 10 ? 'pos' : 'est';
    h += '<ul class="md-tiles"><li><span>Desfavoráveis</span><b class="tom-neg">' + pct(tm.neg, tm.n) + '</b><small>' + plural(tm.neg, 'manchete', 'manchetes') + ' · ' + pct(tm.alvo, tm.n) + ' como alvo</small></li>' +
      '<li><span>Favoráveis</span><b class="tom-pos">' + pct(tm.pos, tm.n) + '</b><small>' + plural(tm.pos, 'manchete', 'manchetes') + '</small></li>' +
      '<li><span>Saldo</span><b class="tom-' + cls + '">' + barraTom(tm.saldo) + saldoTxt(tm.saldo) + '</b><small>favoráveis − desfavoráveis, em ' + num(tm.n) + '</small></li>' +
      '<li><span>Neutras ou mistas</span><b>' + pct(tm.n - tm.neg - tm.pos, tm.n) + '</b><small>sem palavra de tom perto do termo</small></li></ul>';
    if (tm.semanas.length > 1) {
      h += '<h5>Semana a semana</h5><ol class="md-sem pq-sem">';
      tm.semanas.forEach(function (w) {
        h += '<li><span class="md-sw">' + dataCurta(w.de) + '–' + dataCurta(w.ate) + '</span>' + barraTom(w.s) + '<b class="tom-' + (w.s <= -10 ? 'neg' : w.s >= 10 ? 'pos' : 'est') + '">' + saldoTxt(w.s) + '</b><small>' + plural(w.n, 'manchete', 'manchetes') + '</small></li>';
      });
      h += '</ol>';
    }
    h += '<h5>Veículo a veículo · contra os demais</h5><div class="an-tbl-wrap"><table class="md-tbl qf-tbl"><thead><tr><th scope="col">Veículo · o assunto que mais rendeu</th><th scope="col">Manchetes</th>' +
      '<th scope="col" title="Manchetes do veículo sobre o termo ÷ as esperadas pelo que ele publica (1× = o esperado)">vs. esperado</th><th scope="col">Desfav.</th><th scope="col">Fav.</th>' +
      '<th scope="col" title="Favoráveis menos desfavoráveis; entre parênteses, o dos demais veículos">Saldo · demais</th><th scope="col" title="Manchetes em que o termo é alvo de crítica, acusação ou punição">É alvo</th></tr></thead><tbody>';
    tm.veiculos.forEach(function (v) {
      var tag = v.classe ? ' <span class="qf-tag qf-' + v.classe + '" title="' + esc(v.forte ? 'Passa do acaso, mesmo contando ' + tm.familia : 'Comparação isolada (99%); não passa contando ' + tm.familia) + '">' +
        (v.classe === 'neg' ? 'mais crítico' : 'mais favorável') + (v.forte ? '' : ' · isolado') + '</span>' : '';
      h += '<tr' + (v.pequena ? ' class="md-pq" title="Amostra pequena: menos de ' + TP.minV + ' manchetes (sem comparação de tom)"' : '') + '><th scope="row"><button type="button" data-v="' + esc(v.o) + '" title="Filtrar por ' + esc(v.o) + '">' + esc(v.o) + '</button>' + tag +
        (v.assunto ? '<span class="qf-as">' + esc(v.assunto) + ' (' + v.assuntoN + ')</span>' : '') + '</th>' +
        '<td>' + num(v.k) + '<span class="qf-pr">' + v.presenca + ' de ' + tm.dias + ' ed.</span></td><td class="md-ix">' + (v.i === null ? '—' : dec(v.i, 1) + '×') + '</td>' +
        '<td>' + pct(v.desf, v.k) + '</td><td>' + pct(v.fav, v.k) + '</td>' +
        '<td class="qf-sd">' + barraTom(v.sv) + '<b class="tom-' + (v.classe || 'est') + '">' + saldoTxt(v.sv) + '</b> <small>(' + saldoTxt(v.so) + ')</small></td>' +
        '<td>' + pct(v.alvo, v.k) + '</td></tr>';
    });
    h += '</tbody></table></div>';
    return h + '</div>';
  }

  function chips(itens, titulo) {
    if (!itens.length) return '';
    return '<section><h4>' + titulo + '</h4><p class="md-chips">' + itens.map(function (x) {
      return '<button type="button" data-q="' + esc(x.f) + '" title="Refinar a busca: ' + esc(aspas(x.f)) + ' junto do termo">' + esc(x.f) + ' <b>' + num(x.n) + '</b></button>';
    }).join('') + '</p></section>';
  }
  function blocoPauta(pz) {
    if (!pz || (!pz.nomes.length && !pz.temas.length)) return '';
    return '<div class="md-blk"><div class="md-2c">' + chips(pz.nomes, 'Nomes') + chips(pz.temas, 'Temas') + '</div>' +
      '<p class="md-note">Nas manchetes de veículos brasileiros; o número é de manchetes. Clique para refinar a busca.</p></div>';
  }
