  function blocoLados(ld) {
    var h = '<div class="md-blk"><h4>Lados e divergência · cobertura comparada</h4>';
    if (!ld.total) {
      return h + '<p class="md-note">Nenhum assunto da cobertura comparada do período cita o termo' + (estado.f.tipos.c ? '' : ' (o tipo “Cobertura comparada” está desmarcado)') + '.</p></div>';
    }
    h += '<ul class="md-tiles"><li><span>Assuntos comparados</span><b>' + num(ld.total) + '</b><small>que citam o termo</small></li>' +
      '<li><span>Com dois lados</span><b>' + num(ld.debates) + '</b><small>' + pct(ld.debates, ld.total) + ' dos assuntos</small></li>' +
      '<li><span>Sem divergência</span><b>' + num(ld.consenso) + '</b><small>todos do mesmo lado ou sem lado</small></li>' +
      '<li><span>Divergência média</span><b>' + (ld.media === null ? '—' : dec(ld.media * 100, 0)) + '</b><small>nos com dois lados · 100 = meio a meio</small></li></ul>';
    if (!ld.debates) return h + '</div>';
    h += '<h5>Assuntos mais divididos</h5><ol class="md-div">';
