  // Com quem e com que temas o termo aparece (manchetes de veículos brasileiros). Um nome que
  // começa outro ("Flávio" e "Flávio Bolsonaro") forma um grupo com ele, contado uma vez por
  // manchete; o fim de um nome não junta ("Bolsonaro" não é "Flávio Bolsonaro").
  function pauta(nots, qs) {
    var itens = nots.filter(function (r) { return !EXTERIOR[r.f[0]]; })
      .map(function (r) { return { r: r, t: r.t, ps: r.ps || (r.ps = palavras(r.t)), nk: [] }; });
