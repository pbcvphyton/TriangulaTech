        .map(function (k) { return { f: maisFrequente(formas[k]), n: mapa[k] }; });
    }
    var chaves = Object.keys(nomes).filter(function (k) { return nomes[k] >= 2; })
      .sort(function (a, b) { return nomes[b] - nomes[a] || cmp(a, b); }).slice(0, 60);
    var grupos = [];
    chaves.forEach(function (k) {
      var bk = k + ' ', g = null;
      for (var i = 0; i < grupos.length && !g; i++) {
        if (grupos[i].membros.some(function (m) { var bm = m + ' '; return bm.indexOf(bk) === 0 || bk.indexOf(bm) === 0; })) g = grupos[i];
      }
      if (g) g.membros.push(k);
      else grupos.push({ membros: [k] });
    });
    grupos.forEach(function (g) {
      var mem = {};
      g.membros.forEach(function (m) { mem[m] = true; });
