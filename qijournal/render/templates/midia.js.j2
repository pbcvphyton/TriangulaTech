{#- Como a mídia cobre o termo: o analítico da busca, incluído dentro de pesquisa.js.j2
    (usa o estado da busca e as edições já carregadas). Roda quando a busca termina,
    sobre os resultados (com os mesmos filtros) e, como base, todas as notícias das
    edições do período:
    - atenção: quanto espaço cada veículo dá ao termo, proporcionalmente ao que publicou;
      Brasil × exterior; picos e tendência;
    - pauta: com quem e com que temas o termo aparece; os assuntos que mais renderam;
    - o que cada veículo enfatiza: vocabulário distintivo (log-odds com prior de Dirichlet
      informativo, Monroe, Colaresi e Quinn, 2008);
    - lados e divergência na cobertura comparada (a análise da IA de cada edição): quão
      dividida ficou, quem destoa da maioria e quais veículos andam juntos ou se opõem.
    A regra dos nomes é a mesma de qijournal/render/midia.py. Nada disso diz se a menção
    é favorável ou desfavorável. -#}
  /* ── Como a mídia cobre o termo (o analítico da busca) ─────────────── */
  var mdEl = $('midia'), irParaMidia = w.location.hash === '#midia';
  var EXTERIOR = {}, FORA = {}, FORA_NOMES = {}, VAZIAS = {};
  (M.exterior || []).forEach(function (n) { EXTERIOR[n] = true; });
  (M.fora || []).forEach(function (n) { FORA[n] = true; });
  (M.foraNomes || []).forEach(function (n) { FORA_NOMES[n] = true; });
  ('a o as os um uma uns umas de da do das dos em na no nas nos por para pra pro pelo pela pelos pelas com sem sob sobre ' +
   'entre ate apos ante contra desde e ou mas nem que se ja nao sim mais menos muito muita muitos muitas como quando onde ' +
   'quem qual quais seu sua seus suas ele ela eles elas isso isto esse essa este esta esses essas estes estas aquele aquela ' +
   'lhe lhes ao aos diz dizem afirma afirmam disse dizer foi ser sao era sera tem ter vai vao pode podem deve devem faz ' +
   'fazem fica ficam estao ha veja entenda saiba confira assista leia acompanhe vivo video videos foto fotos ano anos dia ' +
   'dias hoje ontem amanha agora cerca durante segundo tambem ainda apenas so sobre outro outra novo nova the of to in on ' +
   'for and or is are at by with from as after over new says said will be has have its it his her their this that an vs')
    .split(' ').forEach(function (p) { if (p) VAZIAS[p] = true; });
  var MD = {
    base: 30,        // manchetes do veículo no período para comparar a atenção com a média
    semana: 7,       // tendência: últimas 7 edições contra as 7 anteriores
    baseSemana: 50,  // manchetes por semana para dizer a tendência
    voc: 15,         // manchetes do veículo sobre o termo para o vocabulário distintivo
    termos: 6,       // palavras por veículo
    z: 1.96,         // vocabulário: só diferenças com 95% de confiança
    lado: 3,         // assuntos com lado para entrar em "quem destoa"
    pequena: 5,      // abaixo disso, amostra pequena (esmaecida)
    par: 3,          // assuntos em comum para comparar dois veículos
    topo: 12
  };

  function pct(parte, todo) {
    if (!todo) return '—';
    var v = 100 * parte / todo, casas = v < 10 ? 1 : 0;
    return v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }) + '%';
  }
  function dec(v, casas) { return v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }); }
  function aspas(s) { return '“' + s + '”'; }
  function rotulo(q) { return String(q || '').replace(/"/g, '').replace(/\s+/g, ' ').trim(); }  // o termo, sem as aspas da busca
  function maiuscula(s) { var c = s.charAt(0); return c !== c.toLowerCase(); }
  function somar(mapa, chave, n) { mapa[chave] = (mapa[chave] || 0) + (n == null ? 1 : n); }
  function maisFrequente(mapa) {
    var melhor = null;
    Object.keys(mapa).forEach(function (k) { if (melhor === null || mapa[k] > mapa[melhor]) melhor = k; });
    return melhor;
  }
  function juntar(nomes) {
    if (nomes.length < 2) return nomes.join('');
    return nomes.slice(0, -1).join(', ') + ' e ' + nomes[nomes.length - 1];
  }

  /* palavras e nomes de um título (a mesma regra de qijournal/render/midia.py) */
  var PALAVRA = /[0-9A-Za-zÀ-ÖØ-öø-ÿ]+(?:['’\-][0-9A-Za-zÀ-ÖØ-öø-ÿ]+)*/g;
  var PONTUACAO = /[:.!?|–—"“”‘']/;
  var CONECTORES = { de: 1, da: 1, 'do': 1, das: 1, dos: 1, del: 1, di: 1, van: 1, von: 1 };
  function palavras(t) {
    var saida = [], m;
    PALAVRA.lastIndex = 0;
    while ((m = PALAVRA.exec(t))) saida.push({ a: m.index, b: m.index + m[0].length, p: m[0], n: norm(m[0]) });
    return saida;
  }
  function inicioFrase(t, ps, k) { return k === 0 || PONTUACAO.test(t.slice(ps[k - 1].b, ps[k].a)); }
  function nomesProprios(itens) {
    var cima = {}, baixo = {}, proprios = {};
    itens.forEach(function (it) {
      it.ps.forEach(function (p, k) {
        if (!inicioFrase(it.t, it.ps, k)) somar(maiuscula(p.p) ? cima : baixo, p.n);
      });
    });
    Object.keys(cima).forEach(function (n) { if (cima[n] >= 2 && cima[n] >= 2 * (baixo[n] || 0)) proprios[n] = true; });
    return proprios;
  }
  function nomesDoTitulo(t, ps, proprios) {
    var saida = [], i = 0;
    function nome(k) {
      var p = ps[k];
      if (p.p.length < 2 || !maiuscula(p.p) || FORA[p.n]) return false;
      return !inicioFrase(t, ps, k) || !!proprios[p.n] || p.p === p.p.toUpperCase();
    }
    function junto(k) { return t.slice(ps[k].b, ps[k + 1].a) === ' '; }
    while (i < ps.length) {
      if (!nome(i)) { i++; continue; }
      var j = i;
      for (;;) {
        if (j + 1 < ps.length && junto(j) && nome(j + 1)) j++;
        else if (j + 2 < ps.length && CONECTORES[ps[j + 1].n] && junto(j) && junto(j + 1) && nome(j + 2)) j += 2;
        else break;
      }
      var achado = t.slice(ps[i].a, ps[j].b);
