  }

  // Espaço, picos e atenção: as manchetes que citam o termo contra a base do período.
  function atencao(nots, base, e) {
    var k = {}, kd = {}, br = { k: 0, b: 0 }, ex = { k: 0, b: 0 }, nE = 0, nEc = 0;
    var ks = { br: {}, ex: {} }, bs = { br: {}, ex: {} };
    nots.forEach(function (r) { var o = r.f[0] || ''; somar(k, o); somar(kd, r.d); somar(ks[EXTERIOR[o] ? 'ex' : 'br'], r.s || ''); });
    Object.keys(base.vs).forEach(function (o) {
