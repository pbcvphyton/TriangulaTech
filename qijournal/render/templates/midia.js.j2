  }

  // As histórias: as manchetes de um mesmo assunto da edição (ou da mesma matéria) juntas,
  // com quantos veículos e quantas manchetes; um assunto com o mesmo título em dias
  // diferentes conta junto.
  function historias(nots) {
    var grupos = {}, ordem = [];
    nots.forEach(function (r) {
      if (!r.as) return;
      var chave = r.as[1] ? 'm' + r.as[1] : 't' + norm(r.as[0]).replace(/[^a-z0-9]+/g, ' ').trim().slice(0, 60);
      var g = grupos[chave];
      if (!g) {
        g = grupos[chave] = { titulo: r.as[0], id: r.as[1] || '', dId: r.d, comp: '', n: 0, v: {}, d0: r.d, d1: r.d, itens: [] };
        ordem.push(g);
      }
      g.n++;
      if (r.f[0]) g.v[r.f[0]] = true;
      if (r.d < g.d0) g.d0 = r.d;
      if (r.d > g.d1) g.d1 = r.d;
      if (r.as[2] && !g.comp) g.comp = r.d;
      g.itens.push(r);
    });
    var lista = ordem.filter(function (g) { return g.n >= 2; }).map(function (g) {
      g.nv = Object.keys(g.v).length;
      g.veiculos = Object.keys(g.v).sort(function (a, b) {
        var na = g.itens.filter(function (r) { return r.f[0] === a; }).length, nb = g.itens.filter(function (r) { return r.f[0] === b; }).length;
        return nb - na || cmp(a, b);
      });
      if (g.id) {
        var regs = cache[g.dId] || [];
        for (var i = 0; i < regs.length; i++) if (regs[i].k === 'm' && regs[i].id === g.id) { g.titulo = regs[i].t; break; }
