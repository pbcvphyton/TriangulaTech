    var tend = null, jan = null, antes = 0, lista = e.dias.map(function (x) { return x.d; });  // da mais recente para a mais antiga
    if (lista.length >= 2 * MD.semana) {
      var soma = function (ds, mapa) { var s = 0; ds.forEach(function (d) { s += mapa[d] || 0; }); return s; };
      var rec = lista.slice(0, MD.semana), ant = lista.slice(MD.semana, 2 * MD.semana);
      jan = { r0: rec[rec.length - 1], r1: rec[0], a0: ant[ant.length - 1], a1: ant[0] };
