    function conta(dias, f) {
      dias.slice().reverse().forEach(function (x) {
        (cache[x.d] || []).forEach(function (r) {
          if (r.k !== 'n' || vistos[r.u] || !passa(r, f)) return;
          vistos[r.u] = true;
