    if (t.v >= 1) return 'mais que dobrou (' + dec(t.sr / t.sa, 1) + '×)';
    return (t.v > 0 ? 'subiu ' : 'caiu ') + dec(Math.abs(t.v) * 100, 0) + '%';
  }
  function sintese(e, at, pz, ld) {
    var frases = [], termo = esc(aspas(rotulo(e.f.q))), filtrada = e.f.ed || e.f.v;
    if (at) {
      frases.push(termo + ' aparece em <b>' + plural(at.n, 'manchete', 'manchetes') + '</b> de <b>' + plural(at.nveic, 'veículo', 'veículos') +
        '</b> — <b>' + pct(at.n, at.base) + '</b> ' + (filtrada ? 'das notícias coletadas com os filtros ' : 'de todas as notícias coletadas ') +
        (e.dias.length === 1 ? 'na edição.' : 'nas ' + num(e.dias.length) + ' edições do período.'));
      var comparaveis = at.veiculos.filter(function (v) { return v.i !== null && v.k >= 3; });
      var nacionais = comparaveis.filter(function (v) { return !v.ex; });
      if (nacionais.length >= 2) comparaveis = nacionais;  // o exterior tem a frase dele
      if (comparaveis.length >= 2) {
        var mais = comparaveis.slice().sort(function (a, b) { return b.i - a.i; })[0];
        var menos = comparaveis.slice().sort(function (a, b) { return a.i - b.i; })[0];
        frases.push('Proporcionalmente, quem mais dá espaço é <b>' + esc(mais.o) + '</b> (' + pct(mais.k, mais.b) + ' das manchetes do veículo, ' +
          dec(mais.i, 1) + '× a média); quem menos dá é <b>' + esc(menos.o) + '</b> (' + pct(menos.k, menos.b) + ').');
      }
      if (at.ex.b >= MD.base && at.br.b >= MD.base && !at.ex.k) {
        frases.push('Nenhuma das ' + num(at.ex.b) + ' manchetes de veículos do exterior no período cita o termo.');
      } else if (at.ex.b >= MD.base && at.br.b >= MD.base) {
        frases.push('No exterior, o termo ocupa <b>' + pct(at.ex.k, at.ex.b) + '</b> das manchetes, contra <b>' + pct(at.br.k, at.br.b) + '</b> nos veículos brasileiros.');
      }
      if (at.picos.length && e.dias.length > 1) {
        var p = at.picos[0];
        frases.push('O pico foi em <b>' + dataCurta(p.d) + '</b>, com ' + plural(p.k, 'manchete', 'manchetes') + ' (' + pct(p.k, p.b) + ' do dia)' +
          (p.as ? ', puxado por ' + esc(aspas(p.as)) : '') + '.');
      }
      var tt = tendenciaTexto(at.tend);
      if (at.tend && at.tend.v !== null && !at.tend.sr) {
        frases.push('Nas últimas ' + MD.semana + ' edições, o termo não apareceu nas manchetes (nas ' + MD.semana + ' anteriores, ' + pct(Math.round(at.tend.sa * 1e4), 1e4) + ').');
      } else if (tt) {
        frases.push('Nas últimas ' + MD.semana + ' edições, a participação do termo nas manchetes ' + tt + ' em relação às ' + MD.semana + ' anteriores.');
      }
    }
    if (ld.total) {
      if (ld.debates) {
        var top = ld.itens[0];
        frases.push('Na cobertura comparada, <b>' + num(ld.debates) + '</b> ' + (ld.total === 1 ? 'assunto' : 'dos ' + num(ld.total) + ' assuntos') +
          ' que citam o termo ' + (ld.debates === 1 ? 'teve' : 'tiveram') + ' dois lados; a divergência média foi de <b>' + dec(ld.media * 100, 0) +
          '</b> em 100 (100 = veículos meio a meio). O mais dividido: ' + esc(aspas(top.r.t)) + ' (' + top.a + ' × ' + top.b + ').');
      } else {
        frases.push('Nos ' + plural(ld.total, 'assunto', 'assuntos') + ' da cobertura comparada que citam o termo, os veículos relataram de forma semelhante (sem dois lados).');
      }
      var destoa = ld.veiculos.filter(function (v) { return v.n >= MD.pequena && v.contra > 0; })[0];
      if (destoa) {
        frases.push('<b>' + esc(destoa.o) + '</b> é quem mais destoa: ficou contra a maioria em ' + destoa.contra + ' de ' + plural(destoa.n, 'assunto', 'assuntos') + ' com lado.');
      }
      var oposto = (ld.opostos.length ? ld.opostos : ld.juntos.slice().reverse())[0];
      var junto = ld.juntos[0];
      if (oposto && oposto.t < 0.5) {
        frases.push('<b>' + esc(oposto.a) + '</b> e <b>' + esc(oposto.b) + '</b> ficaram do mesmo lado em só ' + oposto.s + ' de ' + plural(oposto.n, 'assunto', 'assuntos') +
          (junto && junto !== oposto && junto.t > 0.5 ? '; <b>' + esc(junto.a) + '</b> e <b>' + esc(junto.b) + '</b>, em ' + junto.s + ' de ' + junto.n : '') + '.');
      } else if (junto && junto.t > 0.5) {
        frases.push('<b>' + esc(junto.a) + '</b> e <b>' + esc(junto.b) + '</b> ficaram do mesmo lado em ' + junto.s + ' de ' + plural(junto.n, 'assunto', 'assuntos') + '.');
      }
    }
    if (pz && (pz.nomes.length || pz.temas.length)) {
      var escolhidos = [];
      pz.nomes.forEach(function (x) {
        var a = ' ' + norm(x.f) + ' ';
        var repete = escolhidos.some(function (y) { var b = ' ' + norm(y) + ' '; return a.indexOf(b) >= 0 || b.indexOf(a) >= 0; });
        if (!repete && escolhidos.length < 3) escolhidos.push(x.f);
      });
      var ns = escolhidos.map(function (f) { return '<b>' + esc(f) + '</b>'; });
      var tm = pz.temas.slice(0, 3).map(function (x) { return esc(x.f); });
      if (ns.length && tm.length) frases.push('Aparece mais ao lado de ' + juntar(ns) + ', em manchetes sobre ' + juntar(tm) + '.');
      else if (ns.length) frases.push('Aparece mais ao lado de ' + juntar(ns) + '.');
      else frases.push('As manchetes falam mais de ' + juntar(tm) + '.');
    }
    return frases.length ? '<ul class="md-sint">' + frases.map(function (f) { return '<li>' + f + '</li>'; }).join('') + '</ul>' : '';
  }

  function blocoAtencao(at) {
    var h = '<div class="md-blk"><h4>Atenção · quem dá mais espaço</h4><ul class="md-tiles">';
    h += '<li><span>Participação nas manchetes</span><b>' + pct(at.n, at.base) + '</b><small>' + num(at.n) + ' de ' + num(at.base) + '</small></li>';
    if (at.ex.b >= MD.base && at.br.b >= MD.base) {
      h += '<li><span>Brasil × exterior</span><b>' + pct(at.br.k, at.br.b) + ' × ' + pct(at.ex.k, at.ex.b) + '</b><small>' + num(at.br.k) + ' e ' + num(at.ex.k) + ' manchetes</small></li>';
    }
    if (at.tend) {
      var t = at.tend, classe = t.v === null || Math.abs(t.v) <= 0.15 ? 'est' : t.v > 0 ? 'sobe' : 'cai';
      var valor = t.v === null ? '—' : !t.sr ? 'zerou' : Math.abs(t.v) <= 0.15 ? 'estável' : t.v >= 1 ? '▲ ' + dec(t.sr / t.sa, 1) + '×' : (t.v > 0 ? '▲ ' : '▼ ') + dec(Math.abs(t.v) * 100, 0) + '%';
      h += '<li class="md-' + classe + '"><span>Últimas ' + MD.semana + ' edições</span><b>' + valor + '</b><small>' + pct(Math.round(t.sr * 1e4), 1e4) + ' contra ' + pct(Math.round(t.sa * 1e4), 1e4) + ' antes</small></li>';
    }
    h += '<li><span>Veículos que citam</span><b>' + num(at.nveic) + '</b><small>' + plural(at.veiculos.filter(function (v) { return v.ex; }).length, 'do exterior', 'do exterior') + '</small></li>';
    h += '</ul>';
    var maior = 0;
    at.veiculos.forEach(function (v) { if (v.i !== null) maior = Math.max(maior, v.i); });
    h += '<div class="an-tbl-wrap"><table class="md-tbl"><thead><tr><th scope="col">Veículo</th><th scope="col">Manchetes</th>' +
      '<th scope="col" title="Parte das manchetes do veículo no período que cita o termo">% do que publicou</th>' +
      '<th scope="col" title="Participação no veículo ÷ participação em todas as manchetes (1× = na média)">Espaço vs. média</th></tr></thead><tbody>';
    at.veiculos.slice(0, MD.topo).forEach(function (v) {
      var classe = v.i === null ? '' : v.i >= 1.5 ? ' md-acima' : v.i <= 0.67 ? ' md-abaixo' : '';
      h += '<tr><th scope="row"><button type="button" data-v="' + esc(v.o) + '" title="Filtrar por ' + esc(v.o) + '">' + esc(v.o) + '</button>' +
        (v.ex ? '<span class="md-ex">exterior</span>' : '') + '</th><td>' + num(v.k) + '</td><td>' + (v.b ? pct(v.k, v.b) : '—') + '</td>' +
        '<td class="md-ix' + classe + '">' + (v.i === null ? '<span title="Menos de ' + MD.base + ' manchetes do veículo no período">—</span>' :
          '<i style="--w:' + Math.round(v.i / (maior || 1) * 100) + '%" aria-hidden="true"></i>' + dec(v.i, 1) + '×') + '</td></tr>';
    });
    h += '</tbody></table></div>';
    if (at.veiculos.length > MD.topo) h += '<p class="md-note">E mais ' + plural(at.veiculos.length - MD.topo, 'veículo', 'veículos') + ' com menos manchetes.</p>';
    return h + '</div>';
  }

  function blocoPicos(at) {
    if (!at.picos.length) return '';
    var h = '<div class="md-blk"><h4>Picos · o que puxou a cobertura</h4><ol class="md-picos">';
    at.picos.forEach(function (p) {
      h += '<li><button type="button" data-dia="' + p.d + '" title="Ver só a edição de ' + dataLonga(p.d) + '"><b>' + dataCurta(p.d) + '</b></button>' +
        '<span class="md-pn">' + plural(p.k, 'manchete', 'manchetes') + ' · ' + pct(p.k, p.b) + ' do dia</span>' +
        (p.as ? '<span class="md-pa">' + esc(p.as) + ' <small>(' + plural(p.asn, 'manchete', 'manchetes') + ')</small></span>' : '') + '</li>';
    });
    return h + '</ol></div>';
  }

  function chips(itens, titulo) {
    if (!itens.length) return '';
    return '<section><h4>' + titulo + '</h4><p class="md-chips">' + itens.map(function (x) {
      return '<button type="button" data-q="' + esc(x.f) + '" title="Refinar a busca: ' + esc(aspas(x.f)) + ' junto do termo">' + esc(x.f) + ' <b>' + num(x.n) + '</b></button>';
    }).join('') + '</p></section>';
  }
  function blocoPauta(pz) {
    if (!pz || (!pz.nomes.length && !pz.temas.length && !pz.assuntos.length)) return '';
    var h = '';
    if (pz.nomes.length || pz.temas.length) {
      h += '<div class="md-blk"><div class="md-2c">' + chips(pz.nomes, 'Quem aparece junto') + chips(pz.temas, 'Temas mais associados') + '</div>' +
        '<p class="md-note">Nas manchetes de veículos brasileiros; o número é de manchetes. Clique para refinar a busca.</p></div>';
    }
    if (pz.assuntos.length) {
      h += '<div class="md-blk"><h4>Assuntos que mais renderam</h4><ol class="md-as">';
      pz.assuntos.forEach(function (a) {
        var href = a.as[1] ? edicao(a.d) + '#s-' + encodeURIComponent(a.as[1]) : a.as[2] ? edicao(a.d) + '#cobertura' : edicao(a.d);
        h += '<li><a href="' + esc(href) + '">' + esc(a.as[0]) + '</a><span>' + dataCurta(a.d) + ' · ' + plural(a.nv, 'veículo', 'veículos') + ' · ' +
          plural(a.n, 'manchete', 'manchetes') + (a.as[1] ? ' · virou matéria' : a.as[2] ? ' · na cobertura comparada' : '') + '</span></li>';
      });
      h += '</ol></div>';
    }
    return h;
  }

  function blocoVozes(vz) {
    if (!vz) return '';
    var h = '<div class="md-blk"><h4>O que cada veículo enfatiza</h4>';
    if (!vz.veiculos.length) {
      return h + '<p class="md-note">Para comparar o vocabulário, são precisos dois ou mais veículos brasileiros com ' + MD.voc + '+ manchetes sobre o termo.</p></div>';
    }
    h += '<p class="md-note">Palavras que o veículo usa bem mais que os outros veículos brasileiros nas manchetes sobre o termo — o ângulo de cada um.</p><ul class="md-voc">';
    vz.veiculos.forEach(function (v) {
      h += '<li><button type="button" class="md-vn" data-v="' + esc(v.o) + '" title="Filtrar por ' + esc(v.o) + '">' + esc(v.o) + '</button><span class="md-vc">' + plural(v.n, 'manchete', 'manchetes') + '</span>' +
        (v.termos.length ? '<span class="md-chips">' + v.termos.map(function (t) {
          return '<button type="button" data-q="' + esc(t.f) + '" data-v="' + esc(v.o) + '" title="' + esc(t.f) + ': ' + plural(t.y, 'vez', 'vezes') + ' (clique para ver essas manchetes)">' + esc(t.f) + ' <b>' + t.y + '</b></button>';
        }).join('') + '</span>' : '<span class="md-vt">sem diferença clara de vocabulário</span>') + '</li>';
    });
    return h + '</ul></div>';
  }

  function blocoLados(ld) {
    var h = '<div class="md-blk"><h4>Lados e divergência · cobertura comparada</h4>';
    if (!ld.total) {
      return h + '<p class="md-note">Nenhum assunto da cobertura comparada do período cita o termo' + (estado.f.tipos.c ? '' : ' (o tipo “Cobertura comparada” está desmarcado)') + '.</p></div>';
    }
    h += '<ul class="md-tiles"><li><span>Assuntos comparados</span><b>' + num(ld.total) + '</b><small>que citam o termo</small></li>' +
      '<li><span>Com dois lados</span><b>' + num(ld.debates) + '</b><small>' + pct(ld.debates, ld.total) + ' dos assuntos</small></li>' +
      '<li><span>Sem divergência</span><b>' + num(ld.consenso) + '</b><small>todos relataram igual</small></li>' +
      '<li><span>Divergência média</span><b>' + (ld.media === null ? '—' : dec(ld.media * 100, 0)) + '</b><small>0 = mesmo lado · 100 = meio a meio</small></li></ul>';
    if (!ld.debates) return h + '</div>';
    h += '<h5>Assuntos mais divididos</h5><ol class="md-div">';
    ld.itens.slice(0, 5).forEach(function (x) {
      var r = x.r, total = x.a + x.b + x.n;
      h += '<li><a class="md-dt" href="' + esc(edicao(r.d) + '#cobertura') + '">' + esc(r.t) + '</a>' +
        '<span class="md-dm">' + dataCurta(r.d) + ' · ' + plural(total, 'veículo', 'veículos') + ' · divergência ' + dec(x.dv * 100, 0) + '</span>' +
        '<span class="cov-bar" aria-hidden="true">' + (x.a ? '<span class="cov-a" style="width:' + (100 * x.a / total) + '%"></span>' : '') +
        (x.n ? '<span class="cov-n" style="width:' + (100 * x.n / total) + '%"></span>' : '') +
        (x.b ? '<span class="cov-b" style="width:' + (100 * x.b / total) + '%"></span>' : '') + '</span>' +
        '<span class="md-dl"><span class="ca">' + esc(r.c.a) + '</span> <b>' + x.a + '</b> × <b>' + x.b + '</b> <span class="cb">' + esc(r.c.b) + '</span>' +
        (x.n ? ' · ' + plural(x.n, 'neutro', 'neutros') : '') + '</span>' +
        '<span class="md-dv">' + r.vs.filter(function (o) { return o.lado !== 'neutro'; }).map(function (o) {
          return '<span class="' + (o.lado === 'a' ? 'ca' : 'cb') + '">' + esc(o.n) + '</span>';
        }).join(' · ') + '</span></li>';
    });
    h += '</ol>';
    if (ld.itens.length > 5) h += '<p class="md-note">E mais ' + plural(ld.itens.length - 5, 'assunto', 'assuntos') + ' com dois lados nos resultados (tipo “Cobertura comparada”).</p>';
    var col1 = '', col2 = '';
    if (ld.veiculos.length) {
      col1 = '<section><h5>Quem destoa da maioria</h5><div class="an-tbl-wrap"><table class="md-tbl"><thead><tr><th scope="col">Veículo</th>' +
        '<th scope="col" title="No lado com mais veículos">Com a maioria</th><th scope="col" title="No lado com menos veículos">Contra</th>' +
        '<th scope="col" title="Assuntos empatados">Empate</th><th scope="col">Neutro</th><th scope="col" title="Contra ÷ (com a maioria + contra)">Destoa</th></tr></thead><tbody>';
      ld.veiculos.forEach(function (v) {
        col1 += '<tr' + (v.n < MD.pequena ? ' class="md-pq" title="Amostra pequena: menos de ' + MD.pequena + ' assuntos com lado definido"' : '') + '><th scope="row">' + esc(v.o) + '</th><td>' + v.maj + '</td><td>' + v.contra + '</td><td>' +
          v.emp + '</td><td>' + v.neu + '</td><td class="md-ix"><i style="--w:' + Math.round(v.t * 100) + '%" aria-hidden="true"></i>' + pct(v.contra, v.n) + '</td></tr>';
      });
      col1 += '</tbody></table></div></section>';
    }
    if (ld.juntos.length) {
      var linha = function (p) {
        return '<li><span>' + esc(p.a) + ' <i>e</i> ' + esc(p.b) + '</span><b>' + p.s + ' de ' + p.n + '</b><i class="md-pb" style="--w:' + Math.round(p.t * 100) + '%" aria-hidden="true"></i></li>';
      };
      col2 = '<section><h5>' + (ld.opostos.length ? 'Quem anda junto' : 'Mesmo lado, par a par') + '</h5><ol class="md-par">' + ld.juntos.map(linha).join('') + '</ol>';
      if (ld.opostos.length) col2 += '<h5>Quem se opõe</h5><ol class="md-par">' + ld.opostos.map(linha).join('') + '</ol>';
      col2 += '<p class="md-note">Assuntos em que os dois tomaram lado e ficaram do mesmo lado.</p></section>';
    }
    if (col1 || col2) h += '<div class="md-2c">' + col1 + col2 + '</div>';
    return h + '</div>';
  }

  function blocoComoLer() {
    return '<details class="md-como" id="md-como"><summary>Como ler</summary>' +
      '<p><b>O que entra:</b> as notícias cujo título casa com a busca e os assuntos da cobertura comparada que citam o termo, com os mesmos filtros de período, editoria e veículo. A mesma notícia em mais de uma edição conta uma vez.</p>' +
      '<p><b>Atenção:</b> a parte das manchetes de cada veículo no período que cita o termo; “× a média” compara com a parte em todas as manchetes (1× = na média), só para veículos com ' + MD.base + '+ manchetes no período. Exterior: veículos de fora do Brasil. Tendência: as últimas ' + MD.semana + ' edições do período contra as ' + MD.semana + ' anteriores.</p>' +
      '<p><b>Pauta:</b> nomes (palavras com inicial maiúscula) e palavras mais frequentes nas manchetes de veículos brasileiros, fora o próprio termo. Os assuntos são os agrupamentos de cada edição.</p>' +
      '<p><b>O que cada veículo enfatiza:</b> vocabulário distintivo — log-odds com prior de Dirichlet informativo (Monroe, Colaresi e Quinn, 2008): palavras que o veículo usa mais que os demais veículos brasileiros nas manchetes sobre o termo, com diferença significativa (z &gt; 1,96) e 3+ usos; veículos com ' + MD.voc + '+ manchetes.</p>' +
      '<p><b>Lados:</b> da análise da cobertura feita pela IA em cada edição (o mesmo medidor das matérias): em cada assunto, os dois enfoques e o lado de cada veículo. Divergência = 2 × o lado menor ÷ (lado A + lado B): 0 = todos do mesmo lado; 100 = meio a meio. “Contra a maioria” = no lado com menos veículos (empates à parte); amostras com menos de ' + MD.pequena + ' assuntos ficam esmaecidas.</p>' +
      '<p><b>Limites:</b> a busca não sabe se a menção é favorável ou desfavorável; os lados são os enfoques de cada assunto, não “a favor” ou “contra” a pessoa; nomes iguais de pessoas diferentes se somam (“Bolsonaro”).</p></details>';
  }

  function leituraMidia(e, ts) {
    var qs = [];
    ts.forEach(function (t) { t.n.split(' ').forEach(function (p) { if (p && qs.indexOf(p) < 0) qs.push(p); }); });
    var nots = [], comps = [];
    e.res.forEach(function (x) { if (x.r.k === 'n') nots.push(x.r); else if (x.r.k === 'c') comps.push(x.r); });
    var at = nots.length ? atencao(nots, mdBase(e), e) : null;
    var pz = nots.length ? pauta(nots, qs) : null;
    var vz = nots.length ? vozes(nots, qs) : null;
    var ld = lados(comps);
    var dias = e.dias.map(function (x) { return x.d; }).sort();
    var h = '<p class="md-sub">Leitura automática dos resultados: ' + (dias.length ? (dias.length === 1 ? 'edição de ' + dataCurta(dias[0]) : num(dias.length) + ' edições, de ' + dataCurta(dias[0]) + ' a ' + dataCurta(dias[dias.length - 1])) : '') +
      (e.f.ed || e.f.v ? ' · com os filtros de ' + [e.f.ed ? 'editoria' : '', e.f.v ? 'veículo (' + esc(e.f.v) + ')' : ''].filter(Boolean).join(' e ') : '') +
      '. <a href="#md-como">Como ler</a></p>';
    h += sintese(e, at, pz, ld);
    if (!nots.length) {
      h += '<p class="md-note">Atenção, pauta e vocabulário usam as notícias coletadas: ' + (e.f.tipos.n ? 'nenhuma manchete casa com a busca.' : 'marque o tipo “Todas as notícias”.') + '</p>';
    } else {
      h += blocoAtencao(at) + blocoPicos(at) + blocoPauta(pz) + blocoVozes(vz);
    }
    h += blocoLados(ld) + blocoComoLer();
    return h;
  }

  function midia(e) {
    if (!mdEl) return;
    var ts = e.ts.filter(function (t) { return !t.neg; });
    if (!ts.length || !e.res.length) {
      mdEl.hidden = true;
      mdEl.innerHTML = '';
      return;
    }
    mdEl.hidden = false;
    var titulo = '<h3 class="md-h" id="mdH">Como a mídia cobre ' + esc(aspas(rotulo(e.f.q))) + '</h3>';
    if (!e.fim) {
      mdEl.innerHTML = titulo + '<p class="md-sub">A leitura da cobertura sai quando a busca terminar…</p>';
      return;
    }
    if (!e.md) e.md = titulo + leituraMidia(e, ts);
    mdEl.innerHTML = e.md;
    if (irParaMidia) {
      irParaMidia = false;
      mdEl.scrollIntoView({ block: 'start' });
    }
  }

  if (mdEl) {
    mdEl.addEventListener('click', function (event) {
      var alvo = event.target.closest ? event.target.closest('button') : null;
      if (!alvo) return;
      if (alvo.hasAttribute('data-q')) {
        var extra = alvo.getAttribute('data-q');
        qIn.value = qIn.value.trim() + ' ' + (/\s/.test(extra) ? '"' + extra + '"' : extra);
        if (alvo.hasAttribute('data-v')) opcao(vIn, alvo.getAttribute('data-v'));
      } else if (alvo.hasAttribute('data-v')) {
        var v = alvo.getAttribute('data-v');
        opcao(vIn, vIn.value === v ? '' : v);
      } else if (alvo.hasAttribute('data-dia')) {
        deIn.value = ateIn.value = alvo.getAttribute('data-dia');
      } else {
        return;
      }
      buscar();
      form.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  }
