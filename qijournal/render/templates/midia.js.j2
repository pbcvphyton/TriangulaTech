  }

  // Lados e divergência nos assuntos da cobertura comparada que citam o termo.
  function lados(comps) {
    var itens = [], maj = {}, contra = {}, emp = {}, neu = {}, pares = {}, consenso = 0;
    comps.forEach(function (r) {
      var a = [], b = [], n = [];
      r.vs.forEach(function (o) { (o.lado === 'a' ? a : o.lado === 'b' ? b : n).push(o.n); });
      if (!(r.c.a && r.c.b) || !(a.length + b.length)) { consenso++; return; }
      itens.push({ r: r, a: a.length, b: b.length, n: n.length, dv: 2 * Math.min(a.length, b.length) / (a.length + b.length) });
      n.forEach(function (o) { somar(neu, o); });
      if (a.length === b.length) a.concat(b).forEach(function (o) { somar(emp, o); });
      else {
        (a.length > b.length ? a : b).forEach(function (o) { somar(maj, o); });
        (a.length > b.length ? b : a).forEach(function (o) { somar(contra, o); });
      }
      var comLado = a.map(function (o) { return [o, 'a']; }).concat(b.map(function (o) { return [o, 'b']; }));
      for (var i = 0; i < comLado.length; i++) {
        for (var j = i + 1; j < comLado.length; j++) {
          if (comLado[i][0] === comLado[j][0]) continue;
          var par = [comLado[i][0], comLado[j][0]].sort(), chave = par.join('\u0001');
          var p = pares[chave] || (pares[chave] = { a: par[0], b: par[1], n: 0, s: 0 });
          p.n++;
          if (comLado[i][1] === comLado[j][1]) p.s++;
        }
      }
    });
    var soma = 0;
    itens.forEach(function (x) { soma += x.dv; });
    var nomes = {};
    [maj, contra, emp, neu].forEach(function (m) { Object.keys(m).forEach(function (o) { nomes[o] = true; }); });
    var veiculos = Object.keys(nomes).map(function (o) {
      var com = maj[o] || 0, cont = contra[o] || 0;
      return { o: o, maj: com, contra: cont, emp: emp[o] || 0, neu: neu[o] || 0, n: com + cont, t: com + cont ? cont / (com + cont) : 0 };
    }).filter(function (v) { return v.n >= MD.lado; })
      .sort(function (a, b) { return b.t - a.t || b.n - a.n || (a.o < b.o ? -1 : 1); });
    var listaPares = Object.keys(pares).map(function (k) { var p = pares[k]; p.t = p.s / p.n; return p; })
      .filter(function (p) { return p.n >= MD.par; });
    var juntos = listaPares.slice().sort(function (a, b) { return b.t - a.t || b.n - a.n; });
    var opostos = listaPares.slice().sort(function (a, b) { return a.t - b.t || b.n - a.n; });
    if (listaPares.length > 6) { juntos = juntos.slice(0, 3); opostos = opostos.slice(0, 3); }
    else { opostos = []; }  // poucos pares: uma lista só, do mais ao menos alinhado
    itens.sort(function (x, y) { return y.dv - x.dv || (y.a + y.b) - (x.a + x.b) || (x.r.d < y.r.d ? 1 : -1); });
    return {
      total: comps.length, debates: itens.length, consenso: consenso, media: itens.length ? soma / itens.length : null,
      itens: itens, veiculos: veiculos, juntos: juntos, opostos: opostos
