        '<span class="md-dm">' + dataCurta(r.d) + (r.id ? ' · matéria da edição' : '') + ' · ' + plural(total, 'veículo', 'veículos') + ' · divergência ' + dec(x.dv * 100, 0) + '</span>' +
        '<span class="cov-bar" aria-hidden="true">' + (x.a ? '<span class="cov-a" style="width:' + (100 * x.a / total) + '%"></span>' : '') +
        (x.n ? '<span class="cov-n" style="width:' + (100 * x.n / total) + '%"></span>' : '') +
        (x.b ? '<span class="cov-b" style="width:' + (100 * x.b / total) + '%"></span>' : '') + '</span>' +
        // O lado de cada veículo por escrito (a cor só reforça).
        '<span class="md-dl"><span class="ca">' + esc(r.c.a) + '</span> · <b>' + x.a + '</b>: ' + esc(x.va.join(', ')) + '</span>' +
        '<span class="md-dl"><span class="cb">' + esc(r.c.b) + '</span> · <b>' + x.b + '</b>: ' + esc(x.vb.join(', ')) + '</span>' +
        (x.n ? '<span class="md-dv">' + plural(x.n, 'neutro', 'neutros') + ': ' + esc(x.vn.join(', ')) + '</span>' : '') + '</li>';
    });
    h += '</ol>';
    if (ld.itens.length > 5) h += '<p class="md-note">E mais ' + plural(ld.itens.length - 5, 'assunto', 'assuntos') + ' com dois lados nos resultados (tipo “Cobertura comparada”).</p>';
    var col1 = '', col2 = '';
    if (ld.veiculos.length) {
      col1 = '<section><h5>Quem destoa da maioria</h5><div class="an-tbl-wrap"><table class="md-tbl"><thead><tr><th scope="col">Veículo</th>' +
        '<th scope="col" title="No lado com mais veículos">Com a maioria</th><th scope="col" title="No lado com menos veículos">Contra</th>' +
        '<th scope="col" title="Assuntos empatados">Empate</th><th scope="col">Neutro</th><th scope="col" title="Contra ÷ (com a maioria + contra)">Destoa</th></tr></thead><tbody>';
      ld.veiculos.forEach(function (v) {
        col1 += '<tr' + (v.n < MD.pequena ? ' class="md-pq" title="Amostra pequena: menos de ' + MD.pequena + ' assuntos com lado definido"' : '') + '><th scope="row">' + esc(v.o) + '</th><td>' + v.maj + '</td><td>' + v.contra + '</td><td>' +
          v.emp + '</td><td>' + v.neu + '</td><td class="md-ix"><i style="--w:' + Math.round(v.t * 100) + '%" aria-hidden="true"></i>' + pct(v.contra, v.n) + '</td></tr>';
      });
      col1 += '</tbody></table></div></section>';
    }
    if (ld.juntos.length) {
      var linha = function (p) {
        return '<li><span>' + esc(p.a) + ' <i>e</i> ' + esc(p.b) + '</span><b>' + p.s + ' de ' + p.n + '</b><i class="md-pb" style="--w:' + Math.round(p.t * 100) + '%" aria-hidden="true"></i></li>';
      };
      col2 = '<section><h5>' + (ld.opostos.length ? 'Quem anda junto' : 'Mesmo lado, par a par') + '</h5><ol class="md-par">' + ld.juntos.map(linha).join('') + '</ol>';
      if (ld.opostos.length) col2 += '<h5>Quem se opõe</h5><ol class="md-par">' + ld.opostos.map(linha).join('') + '</ol>';
      col2 += '<p class="md-note">Assuntos em que os dois tomaram lado e ficaram do mesmo lado.</p></section>';
    }
    if (col1 || col2) h += '<div class="md-2c">' + col1 + col2 + '</div>';
    return h + '</div>';
  }

  function blocoComoLer() {
    return '<details class="md-como" id="md-como"><summary>Como ler</summary>' +
      '<p><b>O que entra:</b> as notícias cujo título casa com a busca e os assuntos da cobertura comparada que citam o termo (as matérias da edição com análise da cobertura e os demais assuntos comparados, como na seção da edição), com os mesmos filtros de período, editoria e veículo. A mesma notícia em mais de uma edição conta uma vez.</p>' +
      '<p><b>Atenção:</b> a parte das manchetes de cada veículo no período que cita o termo; “× o esperado” compara as manchetes do veículo sobre o termo com as que ele teria se desse ao termo, em cada editoria em que publica, o mesmo espaço que o conjunto dá (1× = o esperado; um site de esporte não “deveria” citar um político como um de política), só para veículos com ' + MD.base + '+ manchetes no período. Quem mais e quem menos dá espaço saem dos veículos que deveriam ter citado o termo 3+ vezes; quem mais dá precisa de 3+ manchetes sobre ele, e quem menos dá pode não citar nenhuma. Exterior: veículos de fora do Brasil. Tendência: as últimas ' + MD.semana + ' edições do período contra as ' + MD.semana + ' anteriores, pela participação, com ' + MD.minTend + '+ manchetes do termo nas duas.</p>' +
      '<p><b>Pauta:</b> nomes (palavras com inicial maiúscula) e palavras mais frequentes nas manchetes de veículos brasileiros, fora o próprio termo. Os assuntos são os agrupamentos de cada edição.</p>' +
      '<p><b>O que cada veículo enfatiza:</b> vocabulário distintivo — log-odds com prior de Dirichlet informativo (Monroe, Colaresi e Quinn, 2008): palavras que o veículo usa mais que os demais veículos brasileiros nas manchetes sobre o termo, com z &gt; ' + dec(MD.z, 1) + ' (limiar alto porque cada veículo testa muitas palavras de uma vez) e 3+ usos; veículos com ' + MD.voc + '+ manchetes.</p>' +
      '<p><b>Lados:</b> da análise da cobertura feita pela IA em cada edição (o mesmo medidor das matérias), nas matérias e nos demais assuntos comparados, cada assunto uma vez (a mesma regra da lente do enquadramento no Analítico Político): em cada assunto, os dois enfoques e o lado de cada veículo. Um assunto tem dois lados quando há veículos nos dois enfoques; se todos os que tomaram lado ficaram no mesmo, conta como sem divergência. Divergência = 2 × o lado menor ÷ (lado A + lado B), nos assuntos com dois lados: perto de 0 = quase todos de um lado; 100 = meio a meio. “Contra a maioria” = no lado com menos veículos (empates à parte); amostras com menos de ' + MD.pequena + ' assuntos com maioria definida ficam esmaecidas.</p>' +
      '<p><b>Tom:</b> lido por palavras, sem IA, em cada manchete brasileira com o termo: palavras de contexto desfavorável (escândalo, investigação, derrota, crise, crítica recebida…) ou favorável (vitória, apoio, aprovação, liderança…) contam para o nome mais próximo delas no título (até ' + (M.tom && M.tom.janela || 6) + ' palavras); ações contra alguém (“critica”, “acusa”, “condena”, “investiga”…) põem o nome que vem depois como alvo, e o que vem antes como quem age. A manchete é desfavorável ao termo com mais palavras negativas que positivas, favorável no contrário. Saldo = favoráveis − desfavoráveis, em pontos (−100 a +100; a barra vai de −' + TP.barra + ' a +' + TP.barra + '). “Mais crítico” e “mais favorável”: o veículo difere dos demais além do que o acaso explica (99%; ' + TP.minV + '+ manchetes). Padrão semanal: semanas de 7 dias até a última edição, com ' + TP.semV + '+ manchetes do veículo e ' + TP.semD + '+ dos demais; “padrão” quando ele fica do mesmo lado em 3 de cada 4. São os mesmos números da tabela “Quem fala de quem” do Analítico Político.</p>' +
      '<p><b>Limites:</b> o tom mede o contexto em que o termo aparece nas manchetes, não a opinião do veículo, e a leitura por palavras erra em parte delas (ironia, negação, o nome errado na frase) — por isso as manchetes de exemplo mostram as palavras que pesaram, e o que diz algo é a comparação entre veículos sobre o mesmo termo. Os lados são os enfoques de cada assunto, não “a favor” ou “contra” a pessoa; nomes iguais de pessoas diferentes se somam (“Bolsonaro”).</p></details>';
  }

  function leituraMidia(e, ts) {
    var qs = [];
    ts.forEach(function (t) { t.n.split(' ').forEach(function (p) { if (p && qs.indexOf(p) < 0) qs.push(p); }); });
    // A leitura não depende da ordem escolhida para a lista (os empates saem sempre iguais).
    var nots = [], comps = [];
    e.res.slice().sort(function (x, y) { return cmp(x.r.d, y.r.d) || cmp(x.r.u || '', y.r.u || '') || cmp(x.r.t || '', y.r.t || ''); })
      .forEach(function (x) { if (x.r.k === 'n') nots.push(x.r); else if (x.r.k === 'c') comps.push(x.r); });
    var at = nots.length ? atencao(nots, mdBase(e), e) : null;
    var pz = nots.length ? pauta(nots, qs) : null;
    var vz = nots.length ? vozes(nots, qs) : null;
    var ld = lados(comps);
    var tm = nots.length ? tomDoTermo(nots, e, ts, at) : null;
    var dias = e.dias.map(function (x) { return x.d; }).sort();
    var h = '<p class="md-sub">Leitura automática dos resultados: ' + (dias.length ? (dias.length === 1 ? 'edição de ' + dataCurta(dias[0]) : num(dias.length) + ' edições, de ' + dataCurta(dias[0]) + ' a ' + dataCurta(dias[dias.length - 1])) : '') +
      (e.f.ed || e.f.v ? ' · com os filtros de ' + [e.f.ed ? 'editoria' : '', e.f.v ? 'veículo (' + esc(e.f.v) + ')' : ''].filter(Boolean).join(' e ') : '') +
      '. <a href="#md-como">Como ler</a></p>';
    h += sintese(e, at, pz, ld, tm);
    if (!nots.length) {
      h += '<p class="md-note">Atenção, pauta e vocabulário usam as notícias coletadas: ' + (e.f.tipos.n ? 'nenhuma manchete casa com a busca.' : 'marque o tipo “Todas as notícias”.') + '</p>';
    } else {
      h += blocoAtencao(at) + blocoTom(tm) + blocoPicos(at) + blocoPauta(pz) + blocoVozes(vz);
    }
    h += blocoLados(ld) + blocoComoLer();
    return h;
  }

  // Fica depois da lista (os resultados continuam onde estavam); um atalho acima leva até ela.
  function midia(e) {
    if (!mdEl) return;
    var ts = e.ts.filter(function (t) { return !t.neg; });
    if (!ts.length || !e.res.length) {
      mdEl.hidden = true;
      mdEl.innerHTML = '';
      if (mdIr) mdIr.hidden = true;
      if (e.fim) irParaMidia = false;
      return;
    }
    mdEl.hidden = false;
    var termo = esc(aspas(rotulo(e.f.q)));
    var titulo = '<h3 class="md-h" id="mdH">Como a mídia cobre ' + termo + '</h3>';
    if (mdIr) {
      mdIr.hidden = false;
      mdIr.innerHTML = '<a href="#midia">Como a mídia cobre ' + termo + '</a> · atenção, tom, pauta, vocabulário e lados, depois da lista';
    }
    if (!e.fim) {
      mdEl.innerHTML = titulo + '<p class="md-sub">A leitura da cobertura sai quando a busca terminar…</p>';
      return;
    }
    // A leitura precisa de todas as edições do período (sem as que falharam, picos e tendência mentem).
    var faltam = e.dias.filter(function (x) { return falhas[x.d]; }).length;
    if (faltam) {
      mdEl.innerHTML = titulo + '<p class="md-sub">A leitura da cobertura precisa de todas as edições do período: ' +
        plural(faltam, 'edição não carregou', 'edições não carregaram') + '. Tente buscar de novo.</p>';
      irParaMidia = false;
      return;
    }
    if (!e.md) {
      // A lista aparece primeiro; a leitura (mais pesada) é calculada logo depois.
      mdEl.innerHTML = titulo + '<p class="md-sub">Calculando a leitura da cobertura…</p>';
      if (!e.mdAgendada) {
        e.mdAgendada = true;
        w.requestAnimationFrame(function () {
          w.setTimeout(function () {
            if (estado !== e) return;  // outra busca começou
            e.md = titulo + leituraMidia(e, ts);
            midia(e);
          }, 0);
        });
      }
      return;
    }
    mdEl.innerHTML = e.md;
    if (irParaMidia) {
      irParaMidia = false;
      // Não puxa de volta quem já rolou a página enquanto a busca corria.
      if (Math.abs((w.pageYOffset || 0) - mdY0) < 40) mdEl.scrollIntoView({ block: 'start' });
    }
  }

  if (mdEl) {
    mdEl.addEventListener('click', function (event) {
      var como = event.target.closest ? event.target.closest('a[href="#md-como"]') : null;
      if (como) {  // abre o "Como ler" (o link sozinho só rolaria até ele fechado)
        event.preventDefault();
        var det = $('md-como');
        if (det) {
          det.open = true;
          det.scrollIntoView({ block: 'start', behavior: 'smooth' });
        }
        return;
      }
      var alvo = event.target.closest ? event.target.closest('button') : null;
      if (!alvo) return;
      if (alvo.hasAttribute('data-q')) {
        // Refina a busca que gerou a leitura (não o que estiver na caixa), fechando aspas abertas.
        var extra = alvo.getAttribute('data-q'), atual = estado && estado.f ? estado.f.q : qIn.value.trim();
        if ((atual.match(/"/g) || []).length % 2) atual += '"';
        qIn.value = (atual + ' ' + (/\s/.test(extra) ? '"' + extra + '"' : extra)).trim();
        if (alvo.hasAttribute('data-v')) opcao(vIn, alvo.getAttribute('data-v'));
      } else if (alvo.hasAttribute('data-v')) {
        var v = alvo.getAttribute('data-v');
        opcao(vIn, vIn.value === v ? '' : v);
      } else if (alvo.hasAttribute('data-dia')) {
        deIn.value = ateIn.value = alvo.getAttribute('data-dia');
      } else {
        return;
      }
      buscar();
      form.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  }
