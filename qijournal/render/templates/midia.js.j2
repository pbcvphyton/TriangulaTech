{#- Como a mídia cobre o termo: o analítico da busca, incluído dentro de pesquisa.js.j2
    (usa o estado da busca e as edições já carregadas). Roda quando a busca termina,
    sobre os resultados (com os mesmos filtros) e, como base, todas as notícias das
    edições do período:
    - atenção: quanto espaço cada veículo dá ao termo, proporcionalmente ao que publicou;
      Brasil × exterior; picos e tendência;
    - pauta: com quem e com que temas o termo aparece; os assuntos que mais renderam;
    - o que cada veículo enfatiza: vocabulário distintivo (log-odds com prior de Dirichlet
      informativo, Monroe, Colaresi e Quinn, 2008);
    - lados e divergência na cobertura comparada (a análise da IA de cada edição, nas
      matérias e nos demais assuntos, como na seção da edição): quão dividida ficou, quem
      destoa da maioria e quais veículos andam juntos ou se opõem;
    - tom das manchetes (tom.js.j2, a regra de qijournal/render/tom.py): em que contexto o
      termo aparece — desfavorável ou favorável —, veículo por veículo contra os demais, e
      se isso se repete semana a semana (os mesmos números do Analítico Político).
    A regra dos nomes é a mesma de qijournal/render/midia.py. -#}
  /* ── Como a mídia cobre o termo (o analítico da busca) ─────────────── */
  var mdEl = $('midia'), mdIr = $('mdIr'), irParaMidia = w.location.hash === '#midia', mdY0 = w.pageYOffset || 0;
  var EXTERIOR = {}, FORA = {}, FORA_NOMES = {}, CALENDARIO = {}, VAZIAS = {};
  (M.exterior || []).forEach(function (n) { EXTERIOR[n] = true; });
  (M.fora || []).forEach(function (n) { FORA[n] = true; });
  (M.calendario || []).forEach(function (n) { CALENDARIO[n] = true; });
  (M.foraNomes || []).forEach(function (n) { FORA_NOMES[n] = true; });
  ('a o as os um uma uns umas de da do das dos em na no nas nos por para pra pro pelo pela pelos pelas com sem sob sobre ' +
   'entre ate apos ante contra desde e ou mas nem que se ja nao sim mais menos muito muita muitos muitas como quando onde ' +
   'quem qual quais seu sua seus suas ele ela eles elas isso isto esse essa este esta esses essas estes estas aquele aquela ' +
   'lhe lhes ao aos diz dizem afirma afirmam disse dizer foi ser sao era sera tem ter vai vao pode podem deve devem faz ' +
   'fazem fica ficam estao ha veja entenda saiba confira assista leia acompanhe vivo video videos foto fotos ano anos dia ' +
   'dias hoje ontem amanha agora cerca durante segundo tambem ainda apenas so sobre outro outra novo nova the of to in on ' +
   'for and or is are at by with from as after over new says said will be has have its it his her their this that an vs')
    .split(' ').forEach(function (p) { if (p) VAZIAS[p] = true; });
  var MD = {
    base: 30,        // manchetes do veículo no período para comparar a atenção com o esperado
    semana: 7,       // tendência: últimas 7 edições contra as 7 anteriores
    baseSemana: 50,  // manchetes por semana para dizer a tendência
    voc: 15,         // manchetes do veículo sobre o termo para o vocabulário distintivo
    termos: 6,       // palavras por veículo
    // vocabulário: limiar alto porque cada veículo testa dezenas a centenas de palavras de
    // uma vez (com 1,96, o acaso sozinho já enche a lista; com 3,3, raramente)
    z: 3.3,
    minTend: 10,     // manchetes do termo nas duas semanas para dizer a tendência
    lado: 3,         // assuntos com lado para entrar em "quem destoa"
    pequena: 5,      // abaixo disso, amostra pequena (esmaecida)
    par: 3,          // assuntos em comum para comparar dois veículos
    topo: 12
  };

  function pct(parte, todo) {
    if (!todo) return '—';
    var v = 100 * parte / todo, casas = v < 10 ? 1 : 0;
    if (v > 0 && v < 0.05) return '<0,1%';
    return v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }) + '%';
  }
  function dec(v, casas) { return v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }); }
  function aspas(s) { return '“' + s + '”'; }
  function rotulo(q) { return String(q || '').replace(/"/g, '').replace(/\s+/g, ' ').trim(); }  // o termo, sem as aspas da busca
  function maiuscula(s) { var c = s.charAt(0); return c !== c.toLowerCase(); }
  function somar(mapa, chave, n) { mapa[chave] = (mapa[chave] || 0) + (n == null ? 1 : n); }
  function cmp(a, b) { return a < b ? -1 : a > b ? 1 : 0; }
  function maisFrequente(mapa) {
    var melhor = null;
    Object.keys(mapa).forEach(function (k) { if (melhor === null || mapa[k] > mapa[melhor] || (mapa[k] === mapa[melhor] && k < melhor)) melhor = k; });
    return melhor;
  }
  function juntar(nomes) {
    if (nomes.length < 2) return nomes.join('');
    return nomes.slice(0, -1).join(', ') + ' e ' + nomes[nomes.length - 1];
  }

  /* palavras e nomes de um título (a mesma regra de qijournal/render/midia.py) */
  var PALAVRA = /[0-9A-Za-zÀ-ÖØ-öø-ÿ]+(?:['’\-][0-9A-Za-zÀ-ÖØ-öø-ÿ]+)*/g;
  var PONTUACAO = /[:.!?|–—"“”‘']/;
  var CONECTORES = { de: 1, da: 1, 'do': 1, das: 1, dos: 1, del: 1, di: 1, van: 1, von: 1 };
  function palavras(t) {
    var saida = [], m;
    PALAVRA.lastIndex = 0;
    while ((m = PALAVRA.exec(t))) saida.push({ a: m.index, b: m.index + m[0].length, p: m[0], n: norm(m[0]) });
    return saida;
  }
  function inicioFrase(t, ps, k) { return k === 0 || PONTUACAO.test(t.slice(ps[k - 1].b, ps[k].a)); }
  function nomesProprios(itens) {
    var cima = {}, baixo = {}, proprios = {};
    itens.forEach(function (it) {
      it.ps.forEach(function (p, k) {
        if (!inicioFrase(it.t, it.ps, k)) somar(maiuscula(p.p) ? cima : baixo, p.n);
      });
    });
    Object.keys(cima).forEach(function (n) { if (cima[n] >= 2 && cima[n] >= 2 * (baixo[n] || 0)) proprios[n] = true; });
    return proprios;
  }
  function nomesDoTitulo(t, ps, proprios) {
    var saida = [], i = 0;
    function nome(k) {
      var p = ps[k];
      if (p.p.length < 2 || !maiuscula(p.p)) return false;
      if (CALENDARIO[p.n]) return k + 1 < ps.length && junto(k) && nome(k + 1);  // "Marco Rubio", "Segunda Turma"
      if (FORA[p.n] || (p.n === 'vivo' && k > 0 && ps[k - 1].n === 'ao')) return false;  // "AO VIVO"
      return !inicioFrase(t, ps, k) || !!proprios[p.n] || p.p === p.p.toUpperCase();
    }
    function junto(k) { return t.slice(ps[k].b, ps[k + 1].a) === ' '; }
    while (i < ps.length) {
      if (!nome(i)) { i++; continue; }
      var j = i;
      for (;;) {
        if (j + 1 < ps.length && junto(j) && nome(j + 1)) j++;
        else if (j + 2 < ps.length && CONECTORES[ps[j + 1].n] && junto(j) && junto(j + 1) && nome(j + 2)) j += 2;
        else break;
      }
      var achado = t.slice(ps[i].a, ps[j].b);
      if (!FORA_NOMES[norm(achado)]) saida.push(achado);
      i = j + 1;
    }
    return saida;
  }
  // A palavra é o próprio termo buscado ("lula", "pró-lula", "trump's")?
  function doTermo(n, qs) {
    var partes = n.split(/[^a-z0-9]+/);
    for (var i = 0; i < partes.length; i++) {
      if (!partes[i]) continue;
      for (var j = 0; j < qs.length; j++) {
        if (qs[j].length <= 3 ? partes[i] === qs[j] : partes[i].indexOf(qs[j]) === 0) return true;
      }
    }
    return false;
  }

  /* ── cálculos ──────────────────────────────────────────────────────── */
  // Base: todas as notícias das edições do período com os mesmos filtros (sem o termo),
  // a mesma notícia uma vez: na edição em que entrou nos resultados (a mais antiga em que
  // casou com o termo) ou, se não casou, na mais antiga em que apareceu.
  function mdBase(e) {
    var porVeiculo = {}, porDia = {}, porSecao = {}, veiculoSecao = {}, total = 0, vistos = {}, dataDe = {};
    e.res.forEach(function (x) { if (x.r.k === 'n') dataDe[x.r.u] = x.r.d; });
    e.dias.slice().reverse().forEach(function (x) {
      (cache[x.d] || []).forEach(function (r) {
        if (r.k !== 'n' || vistos[r.u] || !passa(r, e.f)) return;
        vistos[r.u] = true;
        total++;
        var o = r.f[0] || '';
        somar(porVeiculo, o);
        somar(porDia, dataDe[r.u] || r.d);
        somar(porSecao, r.s || '');
        somar(veiculoSecao[o] || (veiculoSecao[o] = {}), r.s || '');
      });
    });
    return { total: total, veiculo: porVeiculo, dia: porDia, secao: porSecao, vs: veiculoSecao };
  }

  function atencao(nots, base, e) {
    var k = {}, kd = {}, ks = {}, br = { k: 0, b: 0 }, ex = { k: 0, b: 0 };
    nots.forEach(function (r) { somar(k, r.f[0] || ''); somar(kd, r.d); somar(ks, r.s || ''); });
    // Esperado: as manchetes que o veículo teria sobre o termo se desse a ele, em cada
    // editoria em que publica, o mesmo espaço que o conjunto dá (um site de esporte não
    // "deveria" citar um político como um de política). Com uma editoria só, é a média.
    function esperado(o) {
      var por = base.vs[o] || {}, soma = 0;
      Object.keys(por).forEach(function (s) { if (base.secao[s]) soma += por[s] * (ks[s] || 0) / base.secao[s]; });
      return soma;
    }
    Object.keys(base.veiculo).forEach(function (o) {
      var g = EXTERIOR[o] ? ex : br;
      g.k += k[o] || 0;
      g.b += base.veiculo[o];
    });
    var media = base.total ? nots.length / base.total : 0;
    function veiculo(o) {
      var b = base.veiculo[o] || 0, n = k[o] || 0, esp = esperado(o);
      return { o: o, k: n, b: b, s: b ? n / b : 0, esp: esp, i: b >= MD.base && esp > 0 ? n / esp : null, ex: !!EXTERIOR[o] };
    }
    var veiculos = Object.keys(k).map(veiculo).sort(function (a, b) { return b.k - a.k || cmp(a.o, b.o); });
    // Todos os veículos com base para comparar, citem ou não o termo (quem menos dá espaço).
    var todos = Object.keys(base.veiculo).filter(function (o) { return base.veiculo[o] >= MD.base; }).map(veiculo);
    var picos = Object.keys(kd).map(function (dia) { return { d: dia, k: kd[dia], b: base.dia[dia] || 0 }; })
      .filter(function (p) { return p.k >= 3; })
      .sort(function (a, b) { return b.k - a.k || cmp(b.d, a.d); }).slice(0, 3);
    picos.forEach(function (p) {
      var c = {};
      nots.forEach(function (r) { if (r.d === p.d && r.as) somar(c, r.as[0]); });
      p.as = maisFrequente(c);
      p.asn = p.as ? c[p.as] : 0;
    });
    var tend = null, dias = e.dias.map(function (x) { return x.d; });  // da mais recente para a mais antiga
    if (dias.length >= 2 * MD.semana) {
      var soma = function (ds, mapa) { var s = 0; ds.forEach(function (d) { s += mapa[d] || 0; }); return s; };
      var rec = dias.slice(0, MD.semana), ant = dias.slice(MD.semana, 2 * MD.semana);
      var bRec = soma(rec, base.dia), bAnt = soma(ant, base.dia), kr = soma(rec, kd), ka = soma(ant, kd);
      // Com poucas manchetes do termo (1 contra 0, 3 contra 4), não há tendência a dizer.
      if (bRec >= MD.baseSemana && bAnt >= MD.baseSemana && kr + ka >= MD.minTend) {
        var sr = kr / bRec, sa = ka / bAnt;
        tend = { sr: sr, sa: sa, kr: kr, ka: ka, br: bRec, ba: bAnt, v: sa ? (sr - sa) / sa : null };
      }
    }
    return { n: nots.length, base: base.total, media: media, veiculos: veiculos, todos: todos, br: br, ex: ex, picos: picos, tend: tend, nveic: veiculos.length };
  }

  // Com quem e com que temas o termo aparece (manchetes de veículos brasileiros).
  function pauta(nots, qs) {
    var itens = nots.filter(function (r) { return !EXTERIOR[r.f[0]]; })
      .map(function (r) { return { r: r, t: r.t, ps: r.ps || (r.ps = palavras(r.t)) }; });
    var proprios = nomesProprios(itens);
    var nomes = {}, formasN = {}, temas = {}, formasT = {}, assuntos = {};
    itens.forEach(function (it) {
      var vistosN = {}, vistosT = {}, emNome = {};
      nomesDoTitulo(it.t, it.ps, proprios).forEach(function (nome) {
        var chave = norm(nome);
        palavras(nome).forEach(function (p) { emNome[p.n] = true; });
        if (vistosN[chave] || doTermo(chave, qs)) return;
        vistosN[chave] = true;
        somar(nomes, chave);
        somar(formasN[chave] || (formasN[chave] = {}), nome);
      });
      it.ps.forEach(function (p, k) {
        var n = p.n;
        if (emNome[n] || n.length < 4 || VAZIAS[n] || FORA[n] || /^\d/.test(n) || doTermo(n, qs)) return;
        var inicio = inicioFrase(it.t, it.ps, k);
        if (maiuscula(p.p) && !inicio) return;  // nome próprio fora dos nomes (ex.: sigla solta)
        if (!vistosT[n]) { vistosT[n] = true; somar(temas, n); }
        somar(formasT[n] || (formasT[n] = {}), inicio && p.p !== p.p.toUpperCase() ? p.p.toLowerCase() : p.p);
      });
    });
    nots.forEach(function (r) {
      if (!r.as) return;
      var chave = r.d + '\u0001' + r.as[0], a = assuntos[chave] || (assuntos[chave] = { d: r.d, as: r.as, n: 0, v: {} });
      a.n++;
      a.v[r.f[0] || ''] = true;
    });
    function maiores(mapa, formas, n) {
      return Object.keys(mapa).filter(function (k) { return mapa[k] >= 2; })
        .sort(function (a, b) { return mapa[b] - mapa[a] || cmp(a, b); }).slice(0, n)
        .map(function (k) { return { f: maisFrequente(formas[k]), n: mapa[k] }; });
    }
    var rank = Object.keys(assuntos).map(function (k) {
      var a = assuntos[k];
      a.nv = Object.keys(a.v).length;
      return a;
    }).filter(function (a) { return a.n >= 2; })
      .sort(function (a, b) { return b.nv - a.nv || b.n - a.n || cmp(b.d, a.d) || cmp(a.as[0], b.as[0]); }).slice(0, 6);
    return { nomes: maiores(nomes, formasN, MD.topo), temas: maiores(temas, formasT, MD.topo), assuntos: rank, nacionais: itens.length };
  }

  // O que cada veículo enfatiza: palavras que ele usa bem mais que os outros veículos
  // brasileiros nas manchetes sobre o termo (log-odds com prior de Dirichlet informativo).
  function vozes(nots, qs) {
    var porVeiculo = {}, tudo = {}, total = 0, formas = {};
    nots.forEach(function (r) {
      var o = r.f[0];
      if (!o || EXTERIOR[o]) return;
      var ps = r.ps || (r.ps = palavras(r.t)), s = porVeiculo[o] || (porVeiculo[o] = { n: 0, c: {}, t: 0 });
      s.n++;
      ps.forEach(function (p, k) {
        var n = p.n;
        if (n.length < 3 || VAZIAS[n] || FORA[n] || /^\d+$/.test(n) || doTermo(n, qs)) return;
        somar(s.c, n);
        s.t++;
        somar(tudo, n);
        total++;
        var f = formas[n] || (formas[n] = { meio: {}, inicio: {} });
        if (inicioFrase(r.t, ps, k)) somar(f.inicio, p.p === p.p.toUpperCase() || maiuscula(p.p.slice(1)) ? p.p : p.p.toLowerCase());
        else somar(f.meio, p.p);
      });
    });
    var a0 = 0.1 * total;  // força do prior: 10% das palavras dos resultados, na proporção de cada uma
    var veiculos = Object.keys(porVeiculo).filter(function (o) { return porVeiculo[o].n >= MD.voc; })
      .sort(function (a, b) { return porVeiculo[b].n - porVeiculo[a].n || cmp(a, b); }).slice(0, 8);
    if (veiculos.length < 2) return { veiculos: [], faltam: veiculos.length };
    return {
      veiculos: veiculos.map(function (o) {
        var s = porVeiculo[o], ni = s.t, nj = total - ni, termos = [];
        if (nj > 0) {
          Object.keys(s.c).forEach(function (pal) {
            var yi = s.c[pal];
            if (yi < 3) return;
            var yw = tudo[pal], aw = a0 * yw / total, yj = yw - yi;
            var di = ni + a0 - yi - aw, dj = nj + a0 - yj - aw;
            if (di <= 0 || dj <= 0) return;
            var delta = Math.log((yi + aw) / di) - Math.log((yj + aw) / dj);
            var z = delta / Math.sqrt(1 / (yi + aw) + 1 / (yj + aw));
            if (z > MD.z) termos.push({ f: maisFrequente(Object.keys(formas[pal].meio).length ? formas[pal].meio : formas[pal].inicio), y: yi, z: z });
          });
        }
        termos.sort(function (a, b) { return b.z - a.z || cmp(a.f, b.f); });
        return { o: o, n: s.n, termos: termos.slice(0, MD.termos) };
      }),
      faltam: 0
    };
  }

  // Lados e divergência nos assuntos da cobertura comparada que citam o termo.
  function lados(comps) {
    var itens = [], maj = {}, contra = {}, emp = {}, neu = {}, pares = {}, consenso = 0;
    comps.forEach(function (r) {
      var a = [], b = [], n = [];
      r.vs.forEach(function (o) { (o.lado === 'a' ? a : o.lado === 'b' ? b : n).push(o.n); });
      if (!(r.c.a && r.c.b) || !(a.length + b.length)) { consenso++; return; }
      // Todos os veículos com lado do mesmo lado: não dividiu (mas conta para "com a maioria" e os pares).
      if (!a.length || !b.length) consenso++;
      else itens.push({ r: r, a: a.length, b: b.length, n: n.length, dv: 2 * Math.min(a.length, b.length) / (a.length + b.length), va: a, vb: b, vn: n });
      n.forEach(function (o) { somar(neu, o); });
      if (a.length === b.length) a.concat(b).forEach(function (o) { somar(emp, o); });
      else {
        (a.length > b.length ? a : b).forEach(function (o) { somar(maj, o); });
        (a.length > b.length ? b : a).forEach(function (o) { somar(contra, o); });
      }
      var comLado = a.map(function (o) { return [o, 'a']; }).concat(b.map(function (o) { return [o, 'b']; }));
      for (var i = 0; i < comLado.length; i++) {
        for (var j = i + 1; j < comLado.length; j++) {
          if (comLado[i][0] === comLado[j][0]) continue;
          var par = [comLado[i][0], comLado[j][0]].sort(), chave = par.join('\u0001');
          var p = pares[chave] || (pares[chave] = { a: par[0], b: par[1], n: 0, s: 0 });
