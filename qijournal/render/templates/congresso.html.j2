{#- Aba "Congresso": o que faz quem está sentado na Câmara e no Senado. No desenho da aba
    Analítico: a leitura (os achados, cada um com a prova), quatro lentes (com quem vota, a
    fila, o Plenário, quem é quem) e o método. O dossiê de cada parlamentar é carregado de
    data/congresso/fichas/ pelo script; sem script, todo o resto continua na página.
    Variáveis: c (CongressoView), brand, home_href, archive_href, base_url, repo_url, analitico.
    Estilos: analitico.css.j2 (az-…) e congresso.css.j2 (cg-…). -#}
{% extends "layout.html.j2" %}
{% import "macros.html.j2" as m %}

{% block title %}{{ brand.name }} — Congresso{% endblock %}
{% block description %}O que faz quem está sentado na Câmara e no Senado: com quem cada um vota, o que propõe, o que deixa parado e o que passa na frente, pelos registros oficiais.{% endblock %}
{% block meta %}
<link rel="canonical" href="{{ base_url }}edicoes/congresso.html">
{% endblock %}
{% block home_link %}{{ home_href }}{% endblock %}
{% block dateline %}Congresso{% if c.atualizado %}&nbsp;· <span class="nw">atualizado em {{ c.atualizado }}</span>{% endif %}{% endblock %}

{% block tools %}
    <a class="tool" href="{{ archive_href }}" title="Edições anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span>Edições</span></a>
    {% if analitico %}
    <a class="tool tool-an" href="{{ archive_href }}analitico.html" title="Analítico Político: como a imprensa cobre a política" aria-label="Analítico Político"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18"/><path d="M6 16v-5M11 16V7M16 16v-8M21 16V4"/></svg><span>Analítico</span></a>
    {% endif %}
    {{ m.search_tool(archive_href) }}
{% endblock %}

{% block styles %}
{% include "analitico.css.j2" %}
{% include "congresso.css.j2" %}
{% endblock %}

{#- Nome que abre o dossiê (com script) ou a busca do nome no jornal (sem script). -#}
{% macro pessoa(k, nome) -%}
<a class="cg-p" href="#p={{ k }}" data-k="{{ k }}">{{ nome }}</a>
{%- endmacro %}

{#- O número da matéria: com script, abre a ficha dela aqui na página (#m=cd-PL-2630-2020); sem
    script, vai para a página oficial (quando há o endereço). -#}
{% macro materia(casa, titulo, url="") -%}
{%- set chave = casa ~ "-" ~ titulo|replace(" ", "-")|replace("/", "-") -%}
<a class="cg-mt" href="{{ url or ("#m=" ~ chave) }}" data-m="{{ chave }}"{% if url %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ titulo }}</a>
{%- endmacro %}

{#- A régua do saldo: −100 (com a esquerda) a +100 (com a direita). -#}
{% macro regua() -%}
<div class="cg-regua" aria-hidden="true"><span>−100<i>sempre com a esquerda</i></span><span>0</span><span>+100<i>sempre com a direita</i></span></div>
{%- endmacro %}

{% macro legenda() -%}
<p class="cg-leg" aria-hidden="true"><span><i class="cg-e3"></i>com a esquerda</span><span><i class="cg-e2"></i>mais com a esquerda</span><span><i class="cg-m"></i>dividido</span><span><i class="cg-d2"></i>mais com a direita</span><span><i class="cg-d3"></i>com a direita</span></p>
{%- endmacro %}

{% block content %}
<section class="an az cg" id="congresso" aria-labelledby="cg-h">
  <div class="arch-top">
    <h2 class="kicker" id="cg-h">Congresso</h2>
    <a class="arch-home" href="{{ home_href }}">&larr; Edição mais recente</a>
  </div>
  {#- A barra fixa: a Casa e, logo abaixo, as vistas dela (uma de cada vez, com script; sem script, todas em sequência). -#}
  <div class="cg-barra" id="cgBarra">
    <div class="cg-casas" id="cgCasas" role="group" aria-label="Casa" hidden>
      {% for casa in c.casas %}
      <button class="cg-casa-b" type="button" data-casa="{{ casa.id }}"{% if loop.first %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ casa.curto }} <span>{{ casa.em_exercicio }}</span></button>
      {% endfor %}
      <span class="cg-casas-n">Escolha a Casa e, abaixo, o que quer ver dela.</span>
    </div>
    <nav class="cg-vistas" id="cgNav" aria-label="O que ver">
      <ul>
        {% if c.leitura %}<li><a href="#cg-leitura" data-vista="resumo">Resumo</a></li>{% endif %}
        <li><a href="#cg-polos" data-vista="posicoes">Onde cada um está</a></li>
        <li><a href="#cg-partidos" data-vista="partidos">Partidos</a></li>
        <li><a href="#cg-espera" data-vista="espera">O que espera × o que passa</a></li>
        <li><a href="#cg-fila" data-vista="fila">A fila</a></li>
        <li><a href="#cg-plenario" data-vista="votacoes">Votações e matérias</a></li>
        <li><a href="#cg-quem" data-vista="pessoas">Parlamentares</a></li>
        <li><a href="#cg-metodo" data-vista="metodo">Como ler</a></li>
      </ul>
    </nav>
  </div>

  {% if c.leitura %}{% set l = c.leitura %}
  <div class="cg-vista" data-vista="resumo">
  <div class="az-lead" id="cg-leitura">
    <div class="az-box">
      <p class="az-chapeu">{{ l.chapeu }}</p>
      <h3 class="az-manchete">{{ l.manchete }}</h3>
      <p class="az-prova"><span class="az-selo">{{ l.principal.selo }}</span><span>{{ l.principal.texto }} <a href="{{ l.principal.href }}">Ver a prova<span aria-hidden="true"> &darr;</span></a></span></p>
      <p class="az-fina">{{ l.linha_fina }}</p>
      {% if l.achados %}
      <div class="az-mais">
        <h4 class="az-lbl">Mais achados <span class="az-lbl-n">{{ l.achados|length }}</span></h4>
        <ol class="az-achados">
          {% for a in l.achados %}
          <li class="az-a">
            <div class="az-a-tx">
              <p class="az-a-k"><span class="az-selo">{{ a.selo }}</span><b class="az-a-num">{{ a.numero }}</b></p>
              <h5 class="az-a-t"><a class="hit" href="{{ a.href }}">{{ a.titulo }}</a></h5>
              <p class="az-a-x">{{ a.texto }}{% if a.ficha %} <a class="cg-p cg-abrir" href="#p={{ a.ficha }}" data-k="{{ a.ficha }}">Abrir o dossiê</a>{% endif %}</p>
            </div>
          </li>
          {% endfor %}
        </ol>
      </div>
      {% endif %}
    </div>
    <aside class="az-rail" aria-labelledby="cg-lentes-h">
      <h4 class="az-lbl" id="cg-lentes-h">Quatro lentes <span class="az-lbl-n">de onde saem os achados</span></h4>
      <ol class="az-lentes">
        <li class="az-l"><p class="az-l-k"><b>1</b>Com quem vota</p><p class="az-l-p"><a class="hit" href="#cg-polos">Por baixo dos rótulos, de que lado cada um fica?</a></p><p class="az-l-v"><b>{{ c.totais.divisivas|num }}</b> <span>votações de conteúdo dividiram os polos</span></p></li>
        <li class="az-l"><p class="az-l-k"><b>2</b>A fila</p><p class="az-l-p"><a class="hit" href="#cg-fila">O que espera, com quem, e o que passou na frente?</a></p><p class="az-l-v"><b>{{ c.totais.tramitando|num }}</b> <span>matérias tramitando nas duas Casas</span></p></li>
        <li class="az-l"><p class="az-l-k"><b>3</b>O Plenário</p><p class="az-l-p"><a class="hit" href="#cg-plenario">O que foi votado, e quem saiu da linha?</a></p><p class="az-l-v"><b>{{ c.totais.votacoes|num }}</b> <span>votações nominais desde 2023</span></p></li>
        <li class="az-l"><p class="az-l-k"><b>4</b>Quem é quem</p><p class="az-l-p"><a class="hit" href="#cg-quem">O que cada um vota, propõe e deixa parado?</a></p><p class="az-l-v"><b>{{ c.totais.pessoas|num }}</b> <span>parlamentares em exercício, cada um com dossiê</span></p></li>
      </ol>
      <form class="cg-achar" id="cgAchar" role="search" hidden>
        <label class="az-lbl az-lbl-2" for="cgAcharQ">Abrir o dossiê de alguém</label>
        <input class="az-fil-in" id="cgAcharQ" type="search" list="cgNomes" autocomplete="off" spellcheck="false" placeholder="Nome do deputado ou senador…">
      </form>
    </aside>
  </div>
  </div>
  {% endif %}

  {#- Onde cada um está -#}
  <section class="az-sec cg-vista" data-vista="posicoes" aria-labelledby="cg-polos-h">
    <header class="az-lh" id="cg-polos">
      <p class="az-ln"><b>1</b>Com quem vota</p>
      <h3 class="az-lt" id="cg-polos-h">Por baixo dos rótulos, de que lado cada um fica</h3>
      <p class="az-ld">Só contam as votações de conteúdo em que a esquerda ({{ c.polos.esquerda }}) e a direita ({{ c.polos.direita }}) ficaram em lados opostos, sem nenhum partido de um polo votando com o outro. O saldo de cada um vai de −100, sempre com a esquerda, a +100, sempre com a direita. Não é o que a pessoa diz ser: é com quem ela vota.</p>
    </header>
    {% for casa in c.casas %}
    <div class="cg-c" data-casa="{{ casa.id }}">
      <h4 class="cg-ct">{{ casa.nome }} <span>{{ casa.resumo }}</span></h4>

      {% if casa.faixas %}
      <div class="az-blk" id="cg-faixas-{{ casa.id }}">
        <h4 class="az-h">Onde cada um está <span>um ponto por parlamentar em exercício, partido a partido</span></h4>
        {% if casa.temas_faixa %}
        <div class="cg-fx-f" hidden>
          <label class="az-lbl az-lbl-2" for="cgFxTema-{{ casa.id }}">Ver por tema</label>
          <select class="cg-fx-s" id="cgFxTema-{{ casa.id }}" data-faixas="cg-faixas-{{ casa.id }}">
            <option value="">Todas as votações esquerda × direita</option>
            {% for t in casa.temas_faixa %}<option value="{{ t.id }}"{% if t.poucas %} disabled{% endif %}>{{ t.nome }} ({{ t.n }} {{ "votação" if t.n == 1 else "votações" }}{% if t.poucas %}: poucas para o saldo{% endif %})</option>{% endfor %}
          </select>
          <p class="cg-fx-st" aria-live="polite"></p>
          <p class="cg-fx-d">Escolha um tema para ver, abaixo das faixas, <b>quais matérias foram votadas</b>, o que cada uma muda e como cada polo votou.</p>
        </div>
        {% endif %}
        {{ legenda() }}
        <div class="cg-fx">
          {{ regua() }}
          {% for f in casa.faixas %}
          <div class="cg-fx-l">
            <p class="cg-fx-n"><b>{{ f.sigla }}</b><span>{{ f.membros }} · média {{ f.media }}</span></p>
            <div class="cg-fx-p" style="height:{{ f.altura }}px">{% for p in f.pontos %}<a class="cg-pt cg-{{ p.classe }}" href="#p={{ p.k }}" data-k="{{ p.k }}" data-nome="{{ p.nome }}" style="left:{{ p.left }}%;top:{{ p.top }}px" title="{{ p.titulo }}"><span class="sr-only">{{ p.titulo }}</span></a>{% endfor %}</div>
          </div>
          {% endfor %}
        </div>
        <p class="az-dek">Partidos com poucos parlamentares em exercício ficam fora do desenho, mas estão na tabela de todos, mais abaixo. Um ponto longe dos colegas é quem vota diferente da bancada: clique para abrir o dossiê.</p>
      </div>
      {% endif %}

      <div class="cg-td" id="cg-tema-det-{{ casa.id }}" data-casa="{{ casa.id }}" hidden></div>
    </div>
    {% endfor %}
  </section>

  {#- Partidos -#}
  <section class="az-sec cg-vista" data-vista="partidos" aria-labelledby="cg-partidos-h">
    <header class="az-lh" id="cg-partidos">
      <p class="az-ln">Partidos</p>
      <h3 class="az-lt" id="cg-partidos-h">Como cada bancada vota, e quanto vota junto com as outras</h3>
      <p class="az-ld">O saldo esquerda × direita só olha as votações em que os polos se opõem. Nele, {{ c.polos.esquerda }} e {{ c.polos.direita }} ficam nas pontas por construção: são eles que definem os lados. O que a régua informa é onde ficam os outros partidos e cada pessoa. Para ver quanto dois partidos votam juntos sem depender da régua, a tabela "Quanto os partidos votam juntos" conta todas as votações de conteúdo.</p>
    </header>
    {% for casa in c.casas %}
    <div class="cg-c" data-casa="{{ casa.id }}">
      <h4 class="cg-ct">{{ casa.nome }}</h4>
      {% if casa.matriz %}
      <div class="az-blk" id="cg-temas-{{ casa.id }}">
        <h4 class="az-h">Partido por tema <span>onde o rótulo e o voto se separam</span></h4>
        <p class="az-dek">O saldo de cada bancada nas {{ casa.matriz_base|num }} votações de conteúdo que dividiram os polos, separado pelo tema da matéria votada. Uma linha que troca de cor é um partido que muda de lado conforme o assunto.</p>
        <div class="az-mx-wrap">
          <table class="az-mx cg-mx">
            <thead><tr><th scope="col" class="az-mx-v">Partido</th><th scope="col">Todas<small>{{ casa.matriz_base }}</small></th>{% for t in casa.matriz_temas %}<th scope="col">{{ t.nome }}<small>{{ t.n }}</small></th>{% endfor %}</tr></thead>
            <tbody>
              {% for linha in casa.matriz %}
              <tr{% if linha.polo %} class="cg-mx-polo"{% endif %}><th scope="row">{{ linha.sigla }}{% if linha.polo %}<i title="Define o polo de {{ linha.polo }}: fica na ponta da régua por construção">régua</i>{% endif %}<small>{{ linha.membros }}</small></th><td class="cg-{{ linha.geral.classe }} cg-mx-g" title="{{ linha.geral.titulo }}">{{ linha.geral.valor }}</td>{% for cel in linha.celulas %}<td class="cg-{{ cel.classe }}" title="{{ cel.titulo }}">{{ cel.valor }}</td>{% endfor %}</tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {{ legenda() }}
        <p class="az-dek">O número pequeno ao lado do tema é quantas votações divisivas ele teve; ao lado do partido, quantos parlamentares em exercício. Célula com ponto: menos de 5 votações, sem saldo. Os partidos marcados com "régua" ({{ c.polos.esquerda }}; {{ c.polos.direita }}) definem os polos: a esquerda <i>é</i> o lado em que a maioria deles vota, por isso ficam em −100 e +100 quase por definição. O que a tabela informa é onde os outros partidos ficam em cada tema.</p>
      </div>
      {% endif %}

      {% if casa.juntos %}{% set j = casa.juntos %}
      <div class="az-blk" id="cg-juntos-{{ casa.id }}">
        <h4 class="az-h">Quanto os partidos votam juntos <span>em todas as votações de conteúdo, não só nas que opõem os polos</span></h4>
        <p class="az-dek">Das <b>{{ j.conteudo }}</b> votações de conteúdo do Plenário nesta legislatura, só as que opõem esquerda e direita entram no saldo. As outras também contam a história: em boa parte delas os dois polos votaram do mesmo lado.</p>
        <ul class="cg-jt">
          <li class="cg-jt-a"><b>{{ j.juntos.n }}</b><span>os dois polos do mesmo lado</span><small>{{ j.juntos.pct }} · consenso</small></li>
          <li class="cg-jt-b"><b>{{ j.divisivas.n }}</b><span>esquerda contra direita</span><small>{{ j.divisivas.pct }} · entram no saldo</small></li>
          <li class="cg-jt-c"><b>{{ j.rachas.n }}</b><span>um partido votou com o outro polo</span><small>{{ j.rachas.pct }} · rachas</small></li>
          <li class="cg-jt-d"><b>{{ j.sem_lado.n }}</b><span>um polo sem maioria clara</span><small>{{ j.sem_lado.pct }}</small></li>
        </ul>
        <div class="cg-jt-bar" role="img" aria-label="Das {{ j.conteudo }} votações de conteúdo: {{ j.juntos.pct }} de consenso entre os polos, {{ j.divisivas.pct }} de esquerda contra direita, {{ j.rachas.pct }} de rachas e {{ j.sem_lado.pct }} com um polo sem maioria clara"><i class="cg-jt-a" style="width:{{ j.juntos.w }}%"></i><i class="cg-jt-b" style="width:{{ j.divisivas.w }}%"></i><i class="cg-jt-c" style="width:{{ j.rachas.w }}%"></i><i class="cg-jt-d" style="width:{{ j.sem_lado.w }}%"></i></div>
        {% if j.linhas %}
        {% if j.exemplo %}<p class="az-ph">{{ j.exemplo.a }} e {{ j.exemplo.b }} ficaram do mesmo lado em <b>{{ j.exemplo.pct }}%</b> das {{ j.exemplo.n }} votações de conteúdo em que os dois tiveram posição.</p>{% endif %}
        <div class="az-mx-wrap">
          <table class="az-mx cg-mx cg-jx">
            <caption class="sr-only">Em quantas das votações de conteúdo a maioria de cada partido ficou do mesmo lado que a maioria de cada outro, em porcentagem</caption>
            <thead><tr><th scope="col" class="az-mx-v">Partido</th>{% for s in j.partidos %}<th scope="col">{{ s }}</th>{% endfor %}</tr></thead>
            <tbody>
              {% for linha in j.linhas %}
              <tr{% if linha.polo %} class="cg-mx-polo"{% endif %}><th scope="row">{{ linha.sigla }}</th>{% for cel in linha.celulas %}<td class="cg-{{ cel.classe }}"{% if cel.titulo %} title="{{ cel.titulo }}"{% endif %}>{{ cel.valor }}</td>{% endfor %}</tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="cg-leg cg-jx-leg" aria-hidden="true"><span><i class="cg-j0"></i>menos de 40%</span><span><i class="cg-j1"></i>40 a 54%</span><span><i class="cg-j2"></i>55 a 69%</span><span><i class="cg-j3"></i>70 a 84%</span><span><i class="cg-j4"></i>85% ou mais</span></p>
        <p class="az-dek">Cada número é a parte das votações de conteúdo em que a maioria dos dois partidos votou do mesmo lado (Sim ou Não). Os partidos vão da esquerda para a direita, pela ordem do saldo. Esta tabela não usa a régua dos polos: conta todas as votações de conteúdo em que os dois tiveram posição.</p>
        {% endif %}
      </div>
      {% endif %}

      {% if casa.cruzada %}
      <div class="az-blk" id="cg-cruzada-{{ casa.id }}">
        <h4 class="az-h">Quando um lado vota a proposta do outro <span>matérias de autores de um polo e como o outro polo votou o texto principal</span></h4>
        <div class="az-2c">
          {% for x in casa.cruzada %}
          <div class="az-col">
            <p class="az-ph">Das <b>{{ x.n }}</b> matérias de autores da {{ x.autor }} ({{ x.siglas }}) com o texto principal votado nominalmente, a {{ x.outro }} votou <b>a favor de {{ x.favor }}</b> e contra {{ x.contra }}{% if x.dividido %}; em {{ x.dividido }}, não teve maioria clara{% endif %}.</p>
            {% if x.itens %}
            <ol class="cg-ls">
              {% for i in x.itens %}
              <li><p class="cg-ls-k"><b>{{ materia(casa.id, i.t) }}</b>{% if i.apel %}<span class="cg-apel">{{ i.apel }}</span>{% endif %}<span>autor{{ "es" if "," in i.pa else "" }}: {{ i.pa }} · {{ i.data }}{% if i.resultado %} · {{ i.resultado }}{% endif %}</span></p><p class="cg-ls-x">{{ i.e }}</p></li>
              {% endfor %}
            </ol>
            {% else %}
            <p class="az-dek">Nenhuma em que a {{ x.outro }} tenha votado a favor.</p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        <p class="az-dek">Entram as matérias de parlamentares de partidos de um polo, sem coautor do outro, que tiveram o texto principal votado nominalmente no Plenário; vale a última dessas votações. Clique no número para ver a ficha da matéria e a contagem de cada partido.</p>
      </div>
      {% endif %}

      {% if casa.rachas %}
      <div class="az-blk" id="cg-rachas-{{ casa.id }}">
        <h4 class="az-h">Onde cada polo racha <span>quando um partido de um lado vota com o outro</span></h4>
        <p class="az-dek">Das {{ casa.rachas.opostas }} votações de conteúdo em que esquerda e direita se opuseram, estas tiveram um partido de um polo votando fechado com o outro. Ficam fora do saldo: quando o PSOL vota com o PL contra o PT, em geral os dois votam contra o governo por razões opostas, e a votação não diz quem é mais de esquerda ou de direita. A lista mostra onde está a divergência.</p>
        {% for p in casa.rachas.partidos %}
        <div class="cg-rc">
          <p class="cg-rc-h"><b class="cg-rc-s cg-{{ p.classe }}">{{ p.sigla }}</b> votou com a <b>{{ p.com }}</b>, contra o resto da {{ p.polo }}, em <b>{{ p.n }}</b> {{ "votação" if p.n_int == 1 else "votações" }}{% if p.contra_governo != "0" %}; em {{ p.contra_governo }}, contra a orientação do governo{% endif %}.</p>
          {% if p.temas %}<p class="cg-rc-t">{% for t in p.temas %}<span class="cg-chip">{{ t.nome }} <b>{{ t.n }}</b></span>{% endfor %}</p>{% endif %}
          <ol class="cg-rc-l">
            {% for i in p.itens %}
            <li><p class="cg-rc-k"><time>{{ i.data }}</time><span class="az-selo">{{ i.tipo }}</span>{% if i.resultado %}<span>{{ i.resultado }}</span>{% endif %}</p>
              <p class="cg-rc-e">{% if i.prop %}<b>{{ materia(casa.id, i.prop) }}</b> {% endif %}{{ i.ementa }}</p>
              <p class="cg-rc-v">{{ p.sigla }}: <b>{{ i.lado }}</b>{% if i.parte and i.parte < 100 %} ({{ i.parte }}%){% endif %} · resto da {{ p.polo }}: <b>{{ i.polo }}</b> · governo: <b>{{ i.gov or "—" }}</b>{% if i.temas %} · {{ i.temas|join(", ") }}{% endif %}</p></li>
            {% endfor %}
          </ol>
          {% if p.mais %}<p class="az-dek">E mais {{ p.mais }}.</p>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <div class="az-blk" id="cg-bancadas-{{ casa.id }}">
        <h4 class="az-h">As bancadas <span>o saldo, o governo e a disciplina de cada partido</span></h4>
        <div class="an-tbl-wrap">
          <table class="an-tbl cg-tb">
            <thead><tr><th scope="col">Partido</th><th scope="col">Em exercício</th><th scope="col" class="an-l">Com quem vota</th><th scope="col">Saldo</th><th scope="col">Com o governo {{ c.governo }}</th><th scope="col">Coesão</th></tr></thead>
            <tbody>
              {% for b in casa.bancadas %}
              <tr><th scope="row">{{ b.sigla }}</th><td>{{ b.membros }}</td><td class="an-l"><span class="cg-bar" aria-hidden="true"><i class="cg-{{ b.classe }}" style="left:{{ b.left }}%;width:{{ b.width }}%"></i></span></td><td>{{ b.saldo }}</td><td>{{ b.gov }}</td><td>{{ b.coesao }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="az-dek">Coesão: em média, a parte do partido que vota com a maioria dele. Com o governo: nas votações em que a liderança do Governo orientou Sim ou Não, quantas vezes a maioria do partido votou igual.</p>
      </div>
    </div>
    {% endfor %}
  </section>

  {#- O que espera × o que passa -#}
  <section class="az-sec cg-vista" data-vista="espera" aria-labelledby="cg-espera-h">
    <header class="az-lh" id="cg-espera">
      <p class="az-ln">A pauta</p>
      <h3 class="az-lt" id="cg-espera-h">O que está pronto para votar e o que foi votado, pela mesma régua</h3>
      <p class="az-ld">Cada ponto do gráfico é uma matéria. Clique num ponto (ou num nome da lista) para abrir a ficha dela: o que é, quem propôs, os sinais de relevância um a um e por que andou ou não.</p>
    </header>
    {% for casa in c.casas %}
    <div class="cg-c" data-casa="{{ casa.id }}">
      <h4 class="cg-ct">{{ casa.nome }}</h4>
      {% if casa.relevancia %}{% set rv = casa.relevancia %}{% set g = rv.grafico %}
      <div class="az-blk cg-rv" id="cg-relev-{{ casa.id }}">
        <h4 class="az-h">O que espera × o que passa <span>a mesma régua para as matérias prontas e para as aprovadas</span></h4>
        <p class="az-dek">Cada ponto é uma matéria: as {{ rv.esperam_n }} prontas para o Plenário e fora da pauta (círculos vazios) e as {{ rv.passaram_n }} aprovadas pelo Plenário nos últimos 12 meses (pontos cheios). Na altura, a nota de relevância, de 0 a 100, feita de sinais que dá para medir nos registros: {% if rv.sem_demanda %}a origem, o alcance da norma e o apoio entre partidos (os dados do Senado não dizem quantos projetos parecidos tramitam juntos){% else %}os projetos parecidos anexados, a origem, o alcance da norma e o apoio entre partidos{% endif %}. Na largura, o tempo desde o protocolo. Em cima e à direita fica o que tem sinais fortes e espera há anos; embaixo e à esquerda, o que passou rápido com sinais fracos.</p>
        <figure class="cg-gr" data-grafico>
          <div class="cg-gr-w">
            <svg viewBox="0 0 {{ g.w }} {{ g.h }}" role="img" aria-labelledby="cg-gr-t-{{ casa.id }}">
              <title id="cg-gr-t-{{ casa.id }}">Nota de relevância por tempo desde o protocolo: {{ rv.esperam_n }} matérias esperando e {{ rv.passaram_n }} aprovadas. A tabela abaixo do gráfico tem todos os pontos.</title>
              <rect class="cg-gr-faixa" x="{{ g.l }}" y="{{ g.t }}" width="{{ g.largura }}" height="{{ g.alta - g.t }}"></rect>
              <rect class="cg-gr-faixa" x="{{ g.l }}" y="{{ g.baixa }}" width="{{ g.largura }}" height="{{ g.b - g.baixa }}"></rect>
              <text class="cg-gr-fx" x="{{ g.l + 6 }}" y="{{ g.t + 12 }}">sinais fortes ({{ rv.alta }} ou mais)</text>
              <text class="cg-gr-fx" x="{{ g.l + 6 }}" y="{{ g.b - 6 }}">sinais fracos (abaixo de {{ rv.baixa }})</text>
              {% for t in g.yticks %}<line class="cg-gr-grade" x1="{{ g.l }}" x2="{{ g.r }}" y1="{{ t.y }}" y2="{{ t.y }}"></line><text class="cg-gr-ty" x="{{ g.l - 8 }}" y="{{ t.y + 4 }}">{{ t.rotulo }}</text>{% endfor %}
              {% for t in g.xticks %}<text class="cg-gr-tx{% if t.fim %} cg-gr-tx-fim{% endif %}" x="{{ t.x }}" y="{{ g.b + 18 }}">{{ t.rotulo }}</text>{% endfor %}
              <line class="cg-gr-guia" x1="{{ g.x_rapida }}" x2="{{ g.x_rapida }}" y1="{{ g.t }}" y2="{{ g.b }}"></line>
              <text class="cg-gr-tg" x="{{ g.x_rapida - 4 }}" y="{{ g.t + 28 }}">120 dias</text>
              <text class="cg-gr-ex" x="{{ (g.l + g.r) / 2 }}" y="{{ g.h - 4 }}">tempo desde o protocolo (escala logarítmica)</text>
              <g class="cg-gr-pts">{% for p in g.pontos %}<circle class="cg-gr-{{ p.g }}" cx="{{ p.x }}" cy="{{ p.y }}" r="4" data-t="{{ p.t }}" data-n="{{ p.n }}" data-tempo="{{ p.tempo }}" data-s="{{ p.situacao }}"></circle>{% endfor %}</g>
            </svg>
          </div>
          <div class="cg-gr-dica" role="status" hidden></div>
          <figcaption class="cg-gr-leg"><span><i class="cg-gr-le" aria-hidden="true"></i>pronta para o Plenário, esperando</span><span><i class="cg-gr-la" aria-hidden="true"></i>aprovada pelo Plenário (12 meses)</span><span>linha: 120 dias do protocolo</span></figcaption>
        </figure>
        <div class="az-2c">
          <div class="az-col">
            <h5 class="cg-rv-h">Sinais fortes, esperando <span>{{ rv.fortes_paradas }} com nota {{ rv.alta }} ou mais estão sem andamento há mais de um ano</span></h5>
            <ol class="cg-ls cg-rv-l">
              {% for i in rv.esperam %}
              <li><p class="cg-ls-k"><b>{{ materia(casa.id, i.t, i.u) }}</b>{% if i.apel %}<span class="cg-apel">{{ i.apel }}</span>{% endif %}<span class="cg-rv-n">nota {{ i.n }}</span>{% if i.jor %}<span class="cg-rv-jor">citada {{ i.jor }} {{ "vez" if i.jor == 1 else "vezes" }} no jornal</span>{% endif %}</p>
                <p class="cg-ls-x">{{ i.e }}</p>
                <p class="cg-rv-s">{% for s in i.sinais %}<span class="cg-chip">{{ s }}</span>{% endfor %}</p>
                <p class="cg-rv-q">último andamento em {{ i.pronta }} · protocolada há {{ i.idade }}{% if i.urg %} · em regime de urgência, e não votada{% endif %}</p></li>
              {% endfor %}
            </ol>
          </div>
          <div class="az-col">
            <h5 class="cg-rv-h">Sinais fracos, aprovadas <span>{{ rv.fracas_rapidas }} com nota abaixo de {{ rv.baixa }} passaram em menos de 120 dias; da mais rápida</span></h5>
            <ol class="cg-ls cg-rv-l">
              {% for i in rv.passaram %}
              <li><p class="cg-ls-k"><b>{{ materia(casa.id, i.t, i.u) }}</b>{% if i.apel %}<span class="cg-apel">{{ i.apel }}</span>{% endif %}<span class="cg-rv-n">nota {{ i.n }}</span>{% if i.jor %}<span class="cg-rv-jor">citada {{ i.jor }} {{ "vez" if i.jor == 1 else "vezes" }} no jornal</span>{% endif %}</p>
                <p class="cg-ls-x">{{ i.e }}</p>
                {% if i.sinais %}<p class="cg-rv-s">{% for s in i.sinais %}<span class="cg-chip">{{ s }}</span>{% endfor %}</p>{% endif %}
                <p class="cg-rv-q">aprovada em {{ i.aprovada }}, {{ i.tempo }} depois do protocolo{% if i.autoria %} · {{ i.autoria }}{% endif %}</p>
                {% if i.passos %}<p class="cg-rv-c">Por que andou: {{ i.passos|join("; ") }}.</p>{% endif %}</li>
              {% endfor %}
            </ol>
          </div>
        </div>
        <details class="cg-rv-tb">
          <summary>Todos os pontos do gráfico, em tabela</summary>
          <div class="an-tbl-wrap">
            <table class="an-tbl cg-tb">
              <thead><tr><th scope="col">Matéria</th><th scope="col">Situação</th><th scope="col">Nota</th><th scope="col">Desde o protocolo</th></tr></thead>
              <tbody>{% for p in rv.tabela %}<tr><th scope="row">{{ p.t }}</th><td>{{ p.situacao }}</td><td>{{ p.n }}</td><td>{{ p.tempo }}</td></tr>{% endfor %}</tbody>
            </table>
          </div>
        </details>
        <p class="az-dek">A nota não diz se a matéria é boa ou ruim: diz quantos sinais de relevância pública ela tem nos registros oficiais. Os pesos estão no "Como ler" e são escolha editorial. Medidas provisórias ficam de fora, porque têm prazo na Constituição. Na Câmara, "por que andou" sai do histórico oficial de cada matéria.</p>
      </div>
      {% endif %}
      {% if not casa.relevancia %}<p class="term-note">Sem os dados desta comparação nesta atualização.</p>{% endif %}
    </div>
    {% endfor %}
  </section>

  {#- A fila -#}
  <section class="az-sec cg-vista" data-vista="fila" aria-labelledby="cg-fila-h">
    <header class="az-lh" id="cg-fila">
      <p class="az-ln"><b>2</b>A fila</p>
      <h3 class="az-lt" id="cg-fila-h">O que espera, com quem, e o que passou na frente</h3>
      <p class="az-ld">Toda proposição que tramita está esperando alguém: um presidente de comissão designar o relator, o relator dar o parecer, alguém pôr na pauta. A situação oficial de cada uma diz em que porta ela parou.</p>
    </header>
    {% for casa in c.casas %}
    <div class="cg-c" data-casa="{{ casa.id }}">
      <h4 class="cg-ct">{{ casa.nome }}</h4>
      {% if casa.fila %}{% set f = casa.fila %}
      <div class="az-blk" id="cg-fila-{{ casa.id }}">
        <h4 class="az-h">Em que porta está parado <span>{{ f.tramitando }} matérias tramitando; outras {{ f.apensadas }} andam junto com alguma delas</span></h4>
        <ol class="cg-fl">
          {% for b in f.blocos %}
          <li>
            <p class="cg-fl-n"><b>{{ b.n }}</b> {{ b.nome }}{% if b.quem %} <span>quem segura: {{ b.quem }}</span>{% endif %}</p>
            <span class="cg-fl-b" aria-hidden="true"><i style="width:{{ b.largura }}%"></i></span>
            <p class="cg-fl-x">{{ b.parte }} do que tramita · metade sem andamento há mais de {{ b.mediana }} · <b>{{ b.parados }}</b> ({{ b.parados_parte }}) paradas há mais de um ano</p>
          </li>
          {% endfor %}
        </ol>
      </div>
      <div class="az-2c">
        <div class="az-col">
          {% if f.orgaos %}
          <div class="az-blk">
            <h4 class="az-h">Onde está represado <span>por comissão</span></h4>
            <div class="an-tbl-wrap">
              <table class="an-tbl cg-tb">
                <thead><tr><th scope="col">Comissão</th><th scope="col">Sem relator</th><th scope="col">Prontas, sem pauta</th><th scope="col">A mais antiga</th>{% if casa.id == "cd" %}<th scope="col" class="an-l">Quem preside</th>{% endif %}</tr></thead>
                <tbody>
                  {% for o in f.orgaos %}
                  <tr><th scope="row">{{ o.orgao }}</th><td>{{ o.sem_relator }}</td><td>{{ o.pauta }}</td><td>{{ o.mais_antiga }}</td>{% if casa.id == "cd" %}<td class="an-l">{% if o.presidente_k %}{{ pessoa(o.presidente_k, o.presidente) }}{% else %}—{% endif %}</td>{% endif %}</tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p class="az-dek">Designar o relator e fazer a pauta são atos de quem preside a comissão.</p>
          </div>
          {% endif %}
          {% if f.sentados %}
          <div class="az-blk">
            <h4 class="az-h">Com quem está <span>relatores com mais matérias esperando parecer</span></h4>
            <div class="an-tbl-wrap">
              <table class="an-tbl cg-tb">
                <thead><tr><th scope="col">Relator</th><th scope="col">Esperando</th><th scope="col">Há mais de 6 meses</th><th scope="col">A mais antiga</th></tr></thead>
                <tbody>
                  {% for s in f.sentados %}
                  <tr><th scope="row">{{ pessoa(s.k, s.nome) }}</th><td>{{ s.n }}</td><td>{{ s.antigas }}</td><td>{{ s.mais_antiga }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
          {% endif %}
        </div>
        <div class="az-col">
          {% if f.prontas %}
          <div class="az-blk">
            <h4 class="az-h">Prontas para o Plenário, fora da pauta <span>{{ f.prontas_n }} matérias; as que esperam há mais tempo</span></h4>
            <ol class="cg-ls">
              {% for i in f.prontas %}
              <li><p class="cg-ls-k"><b>{% if i.u %}<a href="{{ i.u }}" target="_blank" rel="noopener noreferrer">{{ i.t }}</a>{% else %}{{ i.t }}{% endif %}</b>{% if i.apel %}<span class="cg-apel">{{ i.apel }}</span>{% endif %}<span>parada há {{ i.tempo }}</span></p><p class="cg-ls-x">{{ i.e }}</p></li>
              {% endfor %}
            </ol>
          </div>
          {% endif %}
          {% if casa.furaram %}{% set r = casa.furaram %}
          <div class="az-blk" id="cg-furaram-{{ casa.id }}">
            <h4 class="az-h">Passaram na frente <span>do protocolo ao voto em menos de 120 dias</span></h4>
            <p class="az-ph">{{ r.rapidas_n }} de {{ r.aprovadas }} matérias aprovadas no Plenário desde {{ r.desde }}; {{ r.com_urgencia }} tiveram a urgência votada.</p>
            <ol class="cg-ls">
              {% for i in r.rapidas %}
              <li><p class="cg-ls-k"><b>{{ materia(casa.id, i.p) }}</b><span>{{ i.tempo }}{% if i.urg %} · com urgência{% endif %} · votada em {{ i.data }}</span></p><p class="cg-ls-x">{{ i.e }}{% if i.autoria %} <i>Autoria: {{ i.autoria }}.</i>{% endif %}</p></li>
              {% endfor %}
            </ol>
            <p class="az-dek">Metade das aprovadas levou menos de {{ r.mediana }} desde a apresentação. Só entram matérias com votação nominal do texto principal.</p>
          </div>
          {% endif %}
        </div>
      </div>
      {% else %}
      <p class="term-note">Sem os dados da fila nesta atualização.</p>
      {% endif %}
    </div>
    {% endfor %}
  </section>

  {#- Votações e matérias -#}
  <section class="az-sec cg-vista" data-vista="votacoes" aria-labelledby="cg-plenario-h">
    <header class="az-lh" id="cg-plenario">
      <p class="az-ln"><b>3</b>O Plenário</p>
      <h3 class="az-lt" id="cg-plenario-h">O que foi votado, e quem saiu da linha</h3>
      <p class="az-ld">As últimas votações nominais de cada Casa: o que era, como ficou, de que lado estavam o governo e os polos e, em cada partido que votou fechado, quem votou diferente.</p>
    </header>
    {% for casa in c.casas %}
    <div class="cg-c" data-casa="{{ casa.id }}">
      <h4 class="cg-ct">{{ casa.nome }}</h4>
      <div class="az-blk cg-mb" id="cg-materias-{{ casa.id }}" data-materias="{{ casa.id }}" hidden>
        <h4 class="az-h">As matérias votadas <span>todas as que tiveram votação nominal no Plenário nesta legislatura: ache pelo nome, pelo apelido ou pelo assunto</span></h4>
        <div class="cg-mb-f">
          <label class="sr-only" for="cgMbQ-{{ casa.id }}">Procurar matéria</label>
          <input class="az-fil-in" id="cgMbQ-{{ casa.id }}" type="search" autocomplete="off" spellcheck="false" placeholder="Procurar: licenciamento, imposto, PL 2159, escala 6x1…">
          <label class="sr-only" for="cgMbT-{{ casa.id }}">Tema</label>
          <select class="cg-fx-s" id="cgMbT-{{ casa.id }}"><option value="">Todos os temas</option></select>
          <label class="az-fil-ck"><input type="checkbox" id="cgMbD-{{ casa.id }}"> só as que dividiram esquerda e direita</label>
          <span class="az-fil-n" role="status"></span>
        </div>
        <ol class="cg-mb-l"></ol>
        <p class="az-dek">Clique numa matéria para abrir a ficha: o que ela é e muda (a ementa e a explicação oficiais), quem propôs, e cada votação com o lado de cada polo e a contagem de cada partido.</p>
      </div>
      <h4 class="az-h cg-vs-h">As últimas votações <span>com quem votou diferente do próprio partido</span></h4>
      <ol class="cg-vs" id="cg-votacoes-{{ casa.id }}">
        {% for v in casa.ultimas %}
        <li class="cg-v">
          <div class="cg-v-h">
            <p class="cg-v-k"><time>{{ v.data }}{% if v.hora %} · {{ v.hora }}{% endif %}</time><span class="az-selo">{{ v.tipo }}</span>{% if v.resultado %}<span class="cg-res cg-res-{{ v.classe }}">{{ v.resultado }}</span>{% endif %}{% if v.racha %}<span class="cg-div cg-div-r">racha: {{ v.racha|join(", ") }}</span>{% endif %}{% if v.divisiva %}<span class="cg-div">dividiu os polos</span>{% endif %}</p>
            <h5 class="cg-v-t">{% if v.prop %}<b>{{ materia(casa.id, v.prop) }}</b> {% endif %}{% if v.apelido %}<span class="cg-apel">{{ v.apelido }}</span> {% endif %}{{ v.descricao }}</h5>
            {% if v.ementa %}<p class="cg-v-e">{{ v.ementa }}</p>{% endif %}
          </div>
          <div class="cg-v-p">
            {% if v.secreta %}
            <p class="cg-v-n">Votação secreta: {{ v.sim }} Sim, {{ v.nao }} Não.</p>
            {% else %}
            <p class="cg-v-n"><b class="cg-s">{{ v.sim }}</b> Sim <span aria-hidden="true">×</span> <b class="cg-n">{{ v.nao }}</b> Não{% if v.abstencao %} · {{ v.abstencao }} abst.{% endif %}</p>
            <p class="cg-v-o">Governo: <b>{{ v.governo or "—" }}</b> · Esquerda: <b>{{ v.esquerda or "—" }}</b> · Direita: <b>{{ v.direita or "—" }}</b></p>
            {% endif %}
          </div>
          {% if v.partidos %}
          <p class="cg-v-b">{% for p in v.partidos %}<span class="cg-pb cg-pb-{{ p.classe }}" title="{{ p.sigla }}: {{ p.coesao }}% votaram {{ p.lado }} ({{ p.votos }} votos)">{{ p.sigla }} <b>{{ p.lado }}</b>{% if p.coesao < 100 %} <i>{{ p.coesao }}%</i>{% endif %}</span>{% endfor %}</p>
          {% endif %}
          {% if v.dissidentes %}
          <details class="cg-v-d">
            <summary>Quem votou diferente do próprio partido</summary>
            <ul>{% for g in v.dissidentes %}<li><b>{{ g.sigla }}</b> (a maioria votou {{ g.lado }}): {% for n in g.nomes %}{{ pessoa(n.k, n.nome) }}{% if not loop.last %}, {% endif %}{% endfor %}</li>{% endfor %}</ul>
          </details>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
  </section>

  {#- Parlamentares -#}
  <section class="az-sec cg-vista" data-vista="pessoas" aria-labelledby="cg-quem-h">
    <header class="az-lh" id="cg-quem">
      <p class="az-ln"><b>4</b>Quem é quem</p>
      <h3 class="az-lt" id="cg-quem-h">O que cada um vota, propõe e deixa parado</h3>
      <p class="az-ld">As listas do que salta aos olhos e, abaixo, todos os parlamentares. Clicar num nome abre o dossiê: com quem vota em cada tema, quando saiu da linha, o que propôs e o que o jornal publicou dele.</p>
    </header>
    {% for casa in c.casas %}
    <div class="cg-c" data-casa="{{ casa.id }}" id="cg-listas-{{ casa.id }}">
      <h4 class="cg-ct">{{ casa.nome }}</h4>
      <div class="cg-lts">
        {% for lista in casa.listas %}
        <div class="cg-lt">
          <h4 class="az-h5">{{ lista.titulo }}</h4>
          <p class="cg-lt-d">{{ lista.dek }}</p>
          <ol>
            {% for x in lista.linhas %}
            <li><span class="cg-lt-n">{{ pessoa(x.k, x.nome) }} <small>{{ x.legenda }}</small></span><span class="cg-lt-v"><b>{{ x.valor }}</b>{% if x.extra %} <small>{{ x.extra }}</small>{% endif %}</span></li>
            {% endfor %}
          </ol>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}

    {% for casa in c.casas %}{% if casa.jornal_voto %}
    <div class="cg-c" data-casa="{{ casa.id }}">
      <div class="az-blk" id="cg-jornal-voto-{{ casa.id }}">
        <h4 class="az-h">No jornal × no voto <span>a manchete que cita alguém e um projeto, ao lado de como ele votou nesse projeto</span></h4>
        <p class="az-dek">O que saiu no jornal posto ao lado do registro de voto, para quem lê comparar o que se diz com o que se vota. A página não interpreta a fala: mostra as duas coisas. O projeto é achado pelo número ou pelo apelido (como "PEC da Blindagem").</p>
        <ol class="cg-jv">
          {% for i in casa.jornal_voto %}
          <li>
            <p class="cg-jv-k">{{ pessoa(i.k, i.nome) }} <span>{{ i.legenda }}</span> <time>{{ i.data }}</time>{% if i.veiculo %} · {{ i.veiculo }}{% endif %}</p>
            <p class="cg-jv-t">{% if i.u %}<a href="{{ i.u }}" target="_blank" rel="noopener noreferrer">{{ i.titulo }}</a>{% else %}{{ i.titulo }}{% endif %}</p>
            <p class="cg-jv-v">No voto: <b>{{ materia(casa.id, i.prop) }}</b>{% if i.apel %} ({{ i.apel }}){% endif %} — {% for v in i.votos %}{{ v.tipo }} em {{ v.data }}: <b>{{ v.voto }}</b>{% if v.resultado %} ({{ v.resultado }}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}{% if i.mais %}; e mais {{ i.mais }}{% endif %}.</p>
          </li>
          {% endfor %}
        </ol>
      </div>
    </div>
    {% endif %}{% endfor %}

    <div class="az-blk" id="cg-todos">
      <h4 class="az-h">Todos os parlamentares <span>{{ c.totais.pessoas|num }} em exercício nas duas Casas</span></h4>
      <form class="cg-cmpf" id="cgCmpF" hidden>
        <p class="cg-cmpf-k"><b>Comparar dois, lado a lado</b> <span>quaisquer dois, deputados ou senadores: escreva os nomes ou marque dois na coluna ⇄ da tabela</span></p>
        <div class="cg-cmpf-c">
          <label class="sr-only" for="cgCmpQa">Primeiro parlamentar</label>
          <input class="az-fil-in" id="cgCmpQa" type="search" list="cgNomes" autocomplete="off" spellcheck="false" placeholder="Um nome…">
          <span class="cg-cmpf-x" aria-hidden="true">×</span>
          <label class="sr-only" for="cgCmpQb">Segundo parlamentar</label>
          <input class="az-fil-in" id="cgCmpQb" type="search" list="cgNomes" autocomplete="off" spellcheck="false" placeholder="Outro nome…">
          <button class="cg-cp-ir" type="submit">Comparar</button>
        </div>
        <p class="cg-cmpf-st" role="status" aria-live="polite"></p>
      </form>
      <div class="az-fil cg-fil" id="cgFil" hidden>
        <label class="sr-only" for="cgQ">Filtrar por nome, partido ou estado</label>
        <input class="az-fil-in" id="cgQ" type="search" autocomplete="off" spellcheck="false" placeholder="Filtrar: nome, partido, UF…">
        <label class="az-fil-ck"><input type="checkbox" id="cgFora"> incluir quem saiu ou está licenciado ({{ c.fora }})</label>
        <span class="az-fil-n" id="cgN" role="status"></span>
      </div>
      <div class="an-tbl-wrap">
        <table class="an-tbl cg-tb cg-todos" id="cgTab">
          <thead><tr>
            <th scope="col" class="cg-cp-th"><span class="sr-only">Comparar</span><span aria-hidden="true">⇄</span></th>
            <th scope="col" data-ord="nome">Nome</th><th scope="col" data-ord="partido">Partido</th><th scope="col" data-ord="uf">UF</th>
            <th scope="col" class="an-l" data-ord="saldo">Com quem vota</th><th scope="col" data-ord="saldo">Saldo</th>
            <th scope="col" data-ord="gov" title="Votou com a orientação do governo {{ c.governo }}">Governo</th>
            <th scope="col" data-ord="pres" title="Votações nominais em que podia votar e votou">Presença</th>
            <th scope="col" data-ord="fid" title="Votou com a maioria do próprio partido">Partido</th>
            <th scope="col" data-ord="prop" title="Proposições de autoria principal">Propostas</th>
            <th scope="col" data-ord="par" title="Propostas sem andamento há mais de um ano">Paradas</th>
            <th scope="col" data-ord="rel" title="Relatorias sem parecer há mais de seis meses">Relatorias</th>
            <th scope="col" data-ord="jor" title="Manchetes do jornal nos últimos 30 dias">No jornal</th>
          </tr></thead>
          <tbody>
            {% for p in c.pessoas %}
            <tr{% if not p.ex %} class="cg-fora" hidden{% endif %} data-casa="{{ p.casa }}" data-b="{{ p.busca }}" data-nome="{{ p.nome }}" data-partido="{{ p.partido }}" data-uf="{{ p.uf }}" data-saldo="{{ p.saldo if p.saldo is not none else '' }}" data-gov="{{ p.gov if p.gov is not none else '' }}" data-pres="{{ p.pres if p.pres is not none else '' }}" data-fid="{{ p.fid if p.fid is not none else '' }}" data-prop="{{ p.prop }}" data-par="{{ p.par }}" data-rel="{{ p.rel }}" data-jor="{{ p.jor }}">
              <td class="cg-cp-td"><input type="checkbox" class="cg-cp-ck" data-cmp="{{ p.k }}" aria-label="Comparar {{ p.nome }}" title="Marque dois para comparar lado a lado"></td>
              <th scope="row">{{ pessoa(p.k, p.nome) }}<small>{{ p.casa_nome }}{% if not p.ex %} · fora do exercício{% endif %}</small></th>
              <td>{{ p.partido }}</td><td>{{ p.uf }}</td>
              <td class="an-l"><span class="cg-bar" aria-hidden="true"><i class="cg-{{ p.classe }}" style="left:{{ p.left }}%;width:{{ p.width }}%"></i></span></td>
              <td>{{ p.saldo_txt }}</td><td>{{ p.gov_txt }}</td><td>{{ p.pres_txt }}</td><td>{{ p.fid_txt }}</td>
              <td>{{ p.prop or "—" }}</td><td>{{ p.par or "—" }}</td><td>{{ p.rel or "—" }}</td><td>{{ p.jor or "—" }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="az-dek">Saldo sem número: menos votações divisivas do que o mínimo para dizer algo. Propostas: só as de autoria principal (quem assina primeiro). Marque dois nomes na primeira coluna (⇄) para ver os perfis lado a lado, com quanto os dois votam juntos.</p>
    </div>
  </section>

  <section class="az-sec az-met cg-vista" data-vista="metodo" aria-labelledby="cg-metodo-h">
    <header class="az-lh" id="cg-metodo">
      <p class="az-ln">Método</p>
      <h3 class="az-lt" id="cg-metodo-h">Como ler</h3>
    </header>
    <dl class="az-dl">
      {% for titulo, texto in c.metodo %}
      <div><dt>{{ titulo }}</dt><dd>{{ texto }}</dd></div>
      {% endfor %}
    </dl>
  </section>
</section>
{% endblock %}

{% block footer %}
<footer class="ft">
  <p><strong>{{ brand.name }}</strong> · Congresso · legislatura {{ c.periodo }} · fontes: Dados Abertos da Câmara dos Deputados e do Senado Federal</p>
  <p class="ft-links"><a href="{{ home_href }}">Edição mais recente</a> · <a href="{{ archive_href }}">Edições anteriores</a>{% if repo_url %} · <a href="{{ repo_url }}" rel="noopener">Código-fonte</a>{% endif %}</p>
</footer>
{% endblock %}

{% block after %}
<datalist id="cgNomes">{% for p in c.pessoas %}<option value="{{ p.nome }}" label="{{ p.partido }}-{{ p.uf }} · {{ p.casa_nome }}">{% endfor %}</datalist>
<div class="cg-cp-bar" id="cgCmp" role="region" aria-label="Comparativo" hidden>
  <p class="cg-cp-sel"><b>Comparar</b> <span id="cgCmpA">escolha dois</span> <span aria-hidden="true">×</span> <span id="cgCmpB">—</span></p>
  <button class="cg-cp-ir" id="cgCmpIr" type="button" disabled>Comparar lado a lado</button>
  <button class="cg-cp-x" id="cgCmpX" type="button">Limpar</button>
</div>
<div class="cg-mo" id="cgDossie" role="dialog" aria-modal="true" aria-labelledby="cgDossieT" hidden>
  <article class="cg-ml" tabindex="-1">
    <button class="mc cg-mc" type="button" aria-label="Fechar o dossiê">&times;</button>
    <div id="cgDossieIn"><h2 id="cgDossieT" class="sr-only">Dossiê</h2></div>
  </article>
</div>
<script type="application/json" id="cgManifesto">{{ c.manifesto|safe }}</script>
<script>
{% include "congresso.js.j2" %}
</script>
{% endblock %}
