  }
  /* Um bloco da página pelo id: abre a vista e a Casa em que ele está e rola até ele. */
  function irPara(id) {
    var alvo = id ? d.getElementById(id) : null;
    if (!alvo || !root.contains(alvo)) return false;
    var nome = vistaDe(alvo), el = alvo;
