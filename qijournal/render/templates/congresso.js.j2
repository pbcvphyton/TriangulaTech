      var sobe = th.getAttribute('aria-sort') === (texto ? 'ascending' : 'descending') ? !texto : texto;
      lista(tab.tHead.querySelectorAll('th')).forEach(function (x) { x.removeAttribute('aria-sort'); });
      th.setAttribute('aria-sort', sobe ? 'ascending' : 'descending');
      linhas.sort(function (a, b) {
        var x = a.getAttribute('data-' + chave), y = b.getAttribute('data-' + chave);
