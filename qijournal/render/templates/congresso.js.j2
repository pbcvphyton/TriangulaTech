    var faixas = lista(grade.querySelectorAll('.cg-fx-l')), ordem = faixas.slice();
    faixas.forEach(function (fx) {
      var rot = fx.querySelector('.cg-fx-n span'), pista = fx.querySelector('.cg-fx-p');
      fx._orig = { rot: rot ? rot.textContent : '', altura: pista ? pista.style.height : '' };
      lista(fx.querySelectorAll('.cg-pt')).forEach(function (a) {
        a._orig = { left: a.style.left, top: a.style.top, cls: a.className, title: a.getAttribute('title') };
      });
    });
    function empilhar(pista, pts) {
      var pilha = {}, maior = 0;
      pts.sort(function (x, y) { return x.l - y.l; }).forEach(function (q) {
        var b = Math.round(q.l / 1.25), nivel = Math.min(pilha[b] || 0, PILHA_MAX);
        pilha[b] = (pilha[b] || 0) + 1;
        maior = Math.max(maior, nivel);
        q.a.style.left = q.l.toFixed(2) + '%';
        q.a.style.top = (nivel * PILHA_PX) + 'px';
      });
      pista.style.height = ((maior + 1) * PILHA_PX + 8) + 'px';
    }
    function aplicar() {
      var tema = sel.value, nomeTema = (M.temas || {})[tema] || '';
      var vistos = 0, total = 0, viram = 0, medias = [];
      faixas.forEach(function (fx) {
        var rot = fx.querySelector('.cg-fx-n span'), pista = fx.querySelector('.cg-fx-p'), pts = [], soma = 0;
        lista(fx.querySelectorAll('.cg-pt')).forEach(function (a) {
          total += 1;
          if (!tema) {
            a.style.left = a._orig.left; a.style.top = a._orig.top; a.className = a._orig.cls; a.setAttribute('title', a._orig.title); a.hidden = false;
            return;
          }
          var dado = (M.tm[a.getAttribute('data-k')] || {})[tema];
          if (!dado) { a.hidden = true; return; }
          a.hidden = false;
