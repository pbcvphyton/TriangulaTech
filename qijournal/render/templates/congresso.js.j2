    for (var i = 0; i < campos.length && i < 5; i++) if (v <= campos[i].ate) return nomes[i];
    return 'd3';
  }
  function campo(v) {
    var campos = M.campos || [];
    for (var i = 0; i < campos.length; i++) if (v <= campos[i].ate) return campos[i].nome;
    return campos.length ? campos[campos.length - 1].nome : '';
  }
  function dataBr(iso) { return iso && iso.length >= 10 ? iso.slice(8, 10) + '/' + iso.slice(5, 7) + '/' + iso.slice(0, 4) : ''; }
  function dias(iso) {
