  /* Onde cada um está, por tema: cada ponto vai para o saldo da pessoa naquele tema (com 5 ou mais
     votações esquerda × direita nele), as faixas se reordenam pela média e quem vira de lado (passa
     do acaso, como no dossiê) ganha contorno. "Todas" volta ao desenho original. */
  var PILHA_PX = 7, PILHA_MAX = 9;
  lista(d.querySelectorAll('.cg-fx-s')).forEach(function (sel) {
    var caixa = d.getElementById(sel.getAttribute('data-faixas')), status = sel.parentNode.querySelector('.cg-fx-st');
    var grade = caixa ? caixa.querySelector('.cg-fx') : null;
