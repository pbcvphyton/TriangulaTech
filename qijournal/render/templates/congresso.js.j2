  function lista(nos) { return Array.prototype.slice.call(nos); }
  function num(n) { return (n == null || isNaN(n)) ? '—' : String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function pct(v) {
    if (v == null) return '—';
    if ((v >= 99.5 && v < 100) || (v > 0 && v < 0.5)) return String(Math.round(v * 10) / 10).replace('.', ',') + '%';
    return Math.round(v) + '%';
