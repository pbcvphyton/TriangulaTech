{#- Aba Congresso (só esta página inclui este arquivo). Reforços: a navegação marca a seção
    da vez, as lentes mostram uma Casa por vez, a tabela de todos ganha filtro e ordem, e o
    nome de cada parlamentar abre o dossiê, carregado de data/congresso/fichas/<casa>-<id>.json
    e montado aqui (sempre com textContent: nada do arquivo vira HTML). O endereço guarda o
    dossiê aberto (#p=cd-204536), então ele pode ser enviado; as fichas das matérias da
    edição chegam por esse endereço. Sem script, a página continua inteira, sem o dossiê. -#}
(function () {
  'use strict';
  var d = document, w = window;
  var root = d.getElementById('congresso');
  if (!root) return;
  var M = {};
  try { M = JSON.parse(d.getElementById('cgManifesto').textContent || '{}'); } catch (erro) { M = {}; }
  function lista(nos) { return Array.prototype.slice.call(nos); }
  function num(n) { return (n == null || isNaN(n)) ? '—' : String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function pct(v) {
    if (v == null) return '—';
    if ((v >= 99.5 && v < 100) || (v > 0 && v < 0.5)) return String(Math.round(v * 10) / 10).replace('.', ',') + '%';
    return Math.round(v) + '%';
  }
  function saldo(v) { return v == null ? '—' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(Math.round(v)); }
  function classe(v) {
    if (v == null) return 'na';
    var campos = M.campos || [], nomes = ['e3', 'e2', 'm', 'd2', 'd3'];
    for (var i = 0; i < campos.length && i < 5; i++) if (v <= campos[i].ate) return nomes[i];
    return 'd3';
  }
  function campo(v) {
    var campos = M.campos || [];
    for (var i = 0; i < campos.length; i++) if (v <= campos[i].ate) return campos[i].nome;
    return campos.length ? campos[campos.length - 1].nome : '';
  }
  function dataBr(iso) { return iso && iso.length >= 10 ? iso.slice(8, 10) + '/' + iso.slice(5, 7) + '/' + iso.slice(0, 4) : ''; }
  function dias(iso) {
    if (!iso || !M.hoje) return null;
    var a = Date.parse(iso.slice(0, 10) + 'T00:00:00Z'), b = Date.parse(M.hoje + 'T00:00:00Z');
    return isNaN(a) || isNaN(b) ? null : Math.round((b - a) / 864e5);
  }
  function tempo(n) {
    if (n == null) return '—';
    if (n < 60) return n + (n === 1 ? ' dia' : ' dias');
    var meses = Math.floor(n / 30);
    if (meses < 24) return meses + ' meses';
    var anos = Math.floor(meses / 12), resto = meses % 12;
    return anos + ' anos' + (resto ? ' e ' + resto + (resto === 1 ? ' mês' : ' meses') : '');
  }
  function h(tag, attrs, filhos) {
    var el = d.createElement(tag), k;
    for (k in attrs || {}) {
      if (attrs[k] == null || attrs[k] === false) continue;
      if (k === 'text') el.textContent = attrs[k];
      else if (k === 'cls') el.className = attrs[k];
      else el.setAttribute(k, attrs[k]);
    }
    (filhos || []).forEach(function (f) { if (f != null) el.appendChild(typeof f === 'string' ? d.createTextNode(f) : f); });
    return el;
  }
  function barra(v) {
    var i = h('i', { cls: 'cg-' + classe(v) });
    var x = v == null ? 0 : Math.max(-100, Math.min(100, v));
    i.style.left = (x < 0 ? 50 + x / 2 : 50) + '%';
    i.style.width = Math.abs(x) / 2 + '%';
    return h('span', { cls: 'cg-bar', 'aria-hidden': 'true' }, [i]);
  }

  /* Nesta página: a seção da vez. */
  var nav = d.getElementById('cgNav');
  var links = nav ? lista(nav.querySelectorAll('a[href^="#"]')) : [];
  var secoes = links.map(function (a) { return d.getElementById(a.getAttribute('href').slice(1)); });
  var atual = -2, pedido = 0;
  function marcar() {
    pedido = 0;
    var limite = (nav ? nav.offsetHeight : 0) + 70, vez = -1;
    secoes.forEach(function (el, i) { if (el && el.getBoundingClientRect().top <= limite) vez = i; });
    if (vez === atual) return;
    atual = vez;
    links.forEach(function (a, i) { if (i === vez) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
  }
  if (links.length) {
    w.addEventListener('scroll', function () { if (!pedido) pedido = w.requestAnimationFrame ? w.requestAnimationFrame(marcar) : w.setTimeout(marcar, 60); }, { passive: true });
    marcar();
  }

  /* Uma Casa por vez. */
  var casas = d.getElementById('cgCasas');
  function verCasa(casa) {
    root.setAttribute('data-ver', casa);
    lista(casas.querySelectorAll('button')).forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-casa') === casa ? 'true' : 'false'); });
    try { w.sessionStorage.setItem('qij-casa', casa); } catch (erro) { /* sem armazenamento: vale só nesta página */ }
    filtrar();
  }
  if (casas && casas.querySelectorAll('button').length > 1) {
    casas.hidden = false;
    casas.addEventListener('click', function (event) {
      var b = event.target && event.target.closest ? event.target.closest('button[data-casa]') : null;
      if (b) verCasa(b.getAttribute('data-casa'));
    });
  }

  /* A tabela de todos: filtro, quem saiu e ordem. */
  var tab = d.getElementById('cgTab'), fil = d.getElementById('cgFil');
  var q = d.getElementById('cgQ'), fora = d.getElementById('cgFora'), conta = d.getElementById('cgN');
  var linhas = tab ? lista(tab.tBodies[0].rows) : [];
  function semAcento(s) { return (s || '').toLowerCase().normalize ? s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '') : (s || '').toLowerCase(); }
  function filtrar() {
    if (!tab) return;
    var termos = semAcento(q ? q.value : '').split(/\s+/).filter(Boolean);
    var comFora = fora && fora.checked, casa = root.getAttribute('data-ver'), visiveis = 0;
    linhas.forEach(function (tr) {
      var alvo = tr.getAttribute('data-b') || '';
      var ok = (comFora || !tr.classList.contains('cg-fora')) && termos.every(function (t) { return alvo.indexOf(t) >= 0; });
      tr.hidden = !ok;
      if (ok && (!casa || tr.getAttribute('data-casa') === casa)) visiveis++;
    });
    if (conta) conta.textContent = visiveis + (visiveis === 1 ? ' parlamentar' : ' parlamentares');
  }
  if (tab && fil) {
    fil.hidden = false;
    q.addEventListener('input', filtrar);
    fora.addEventListener('change', filtrar);
    tab.tHead.addEventListener('click', function (event) {
      var th = event.target && event.target.closest ? event.target.closest('th[data-ord]') : null;
      if (!th) return;
      var chave = th.getAttribute('data-ord'), texto = chave === 'nome' || chave === 'partido' || chave === 'uf';
      var sobe = th.getAttribute('aria-sort') === (texto ? 'ascending' : 'descending') ? !texto : texto;
      lista(tab.tHead.querySelectorAll('th')).forEach(function (x) { x.removeAttribute('aria-sort'); });
      th.setAttribute('aria-sort', sobe ? 'ascending' : 'descending');
      linhas.sort(function (a, b) {
        var x = a.getAttribute('data-' + chave), y = b.getAttribute('data-' + chave);
        if (texto) return (sobe ? 1 : -1) * semAcento(x).localeCompare(semAcento(y));
        if (x === '' || y === '') return x === y ? 0 : (x === '' ? 1 : -1);
        return (sobe ? 1 : -1) * (parseFloat(x) - parseFloat(y));
      });
      var corpo = tab.tBodies[0];
      linhas.forEach(function (tr) { corpo.appendChild(tr); });
    });
  }
  var casaInicial = null;
  try { casaInicial = w.sessionStorage.getItem('qij-casa'); } catch (erro) { casaInicial = null; }
  if (casas && !casas.hidden) verCasa(casaInicial === 'sf' ? 'sf' : 'cd'); else filtrar();

  /* Onde cada um está, por tema: cada ponto vai para o saldo da pessoa naquele tema (com 5 ou mais
     votações esquerda × direita nele), as faixas se reordenam pela média e quem vira de lado (passa
     do acaso, como no dossiê) ganha contorno. "Todas" volta ao desenho original. */
  var PILHA_PX = 7, PILHA_MAX = 9;
  lista(d.querySelectorAll('.cg-fx-s')).forEach(function (sel) {
    var caixa = d.getElementById(sel.getAttribute('data-faixas')), status = sel.parentNode.querySelector('.cg-fx-st');
    var grade = caixa ? caixa.querySelector('.cg-fx') : null;
    if (!grade || !M.tm) return;
    sel.parentNode.hidden = false;
    var faixas = lista(grade.querySelectorAll('.cg-fx-l')), ordem = faixas.slice();
    faixas.forEach(function (fx) {
      var rot = fx.querySelector('.cg-fx-n span'), pista = fx.querySelector('.cg-fx-p');
      fx._orig = { rot: rot ? rot.textContent : '', altura: pista ? pista.style.height : '' };
      lista(fx.querySelectorAll('.cg-pt')).forEach(function (a) {
        a._orig = { left: a.style.left, top: a.style.top, cls: a.className, title: a.getAttribute('title') };
      });
    });
    function empilhar(pista, pts) {
      var pilha = {}, maior = 0;
      pts.sort(function (x, y) { return x.l - y.l; }).forEach(function (q) {
        var b = Math.round(q.l / 1.25), nivel = Math.min(pilha[b] || 0, PILHA_MAX);
        pilha[b] = (pilha[b] || 0) + 1;
        maior = Math.max(maior, nivel);
        q.a.style.left = q.l.toFixed(2) + '%';
        q.a.style.top = (nivel * PILHA_PX) + 'px';
      });
      pista.style.height = ((maior + 1) * PILHA_PX + 8) + 'px';
    }
    function aplicar() {
      var tema = sel.value, nomeTema = sel.options[sel.selectedIndex].text.replace(/ \(\d+\)$/, '');
      var vistos = 0, total = 0, viram = 0, medias = [];
      faixas.forEach(function (fx) {
        var rot = fx.querySelector('.cg-fx-n span'), pista = fx.querySelector('.cg-fx-p'), pts = [], soma = 0;
        lista(fx.querySelectorAll('.cg-pt')).forEach(function (a) {
          total += 1;
          if (!tema) {
            a.style.left = a._orig.left; a.style.top = a._orig.top; a.className = a._orig.cls; a.setAttribute('title', a._orig.title); a.hidden = false;
            return;
          }
          var dado = (M.tm[a.getAttribute('data-k')] || {})[tema];
          if (!dado) { a.hidden = true; return; }
          a.hidden = false;
          vistos += 1; soma += dado[0];
          var vira = dado[2] === 1;
          viram += vira ? 1 : 0;
          a.className = 'cg-pt cg-' + classe(dado[0]) + (vira ? ' cg-pt-vira' : '');
          a.setAttribute('title', a.getAttribute('data-nome') + ': saldo ' + saldo(dado[0]) + ' em ' + nomeTema + ' (' + num(dado[1]) + ' votações)' + (vira ? ' · vira de lado neste tema' : ''));
          pts.push({ a: a, l: 50 + dado[0] / 2 });
        });
        if (!tema) {
          if (rot) rot.textContent = fx._orig.rot;
          pista.style.height = fx._orig.altura;
          fx.hidden = false;
          return;
        }
        fx.hidden = !pts.length;
        if (pts.length) {
          empilhar(pista, pts);
          var media = soma / pts.length;
          if (rot) rot.textContent = pts.length + ' · média ' + saldo(media);
          medias.push({ fx: fx, m: media });
        }
      });
      var lista_ = tema ? medias.sort(function (x, y) { return x.m - y.m; }).map(function (x) { return x.fx; }) : ordem;
      lista_.forEach(function (fx) { grade.appendChild(fx); });
      if (status) {
        status.textContent = tema
          ? nomeTema + ': ' + num(vistos) + ' de ' + num(total) + ' com 5 ou mais votações esquerda × direita no tema; partidos na ordem da média. '
            + (viram ? num(viram) + (viram === 1 ? ' ponto com contorno: vira' : ' pontos com contorno: viram') + ' de lado neste tema em relação ao saldo geral (passa do acaso).' : 'Ninguém vira de lado neste tema além do acaso.')
          : '';
      }
    }
    sel.addEventListener('change', aplicar);
  });

  /* O gráfico "o que espera × o que passa": a dica do ponto mais próximo do ponteiro. */
  lista(d.querySelectorAll('[data-grafico]')).forEach(function (fig) {
    var svg = fig.querySelector('svg'), dica = fig.querySelector('.cg-gr-dica');
    if (!svg || !dica || !svg.getScreenCTM) return;
    var pontos = lista(svg.querySelectorAll('circle')), ativo = null;
    function apagar() { if (ativo) ativo.classList.remove('on'); ativo = null; dica.hidden = true; }
    svg.addEventListener('pointermove', function (ev) {
      var m = svg.getScreenCTM();
      if (!m) return;
      var pt = svg.createSVGPoint();
      pt.x = ev.clientX; pt.y = ev.clientY;
      var p = pt.matrixTransform(m.inverse()), melhor = null, dist = 14 * 14;
      pontos.forEach(function (c) {
        var dx = c.cx.baseVal.value - p.x, dy = c.cy.baseVal.value - p.y, d2 = dx * dx + dy * dy;
        if (d2 < dist) { dist = d2; melhor = c; }
      });
      if (!melhor) { apagar(); return; }
      if (melhor !== ativo) {
        if (ativo) ativo.classList.remove('on');
        ativo = melhor;
        ativo.classList.add('on');
        while (dica.firstChild) dica.removeChild(dica.firstChild);
        dica.appendChild(h('b', { text: 'nota ' + melhor.getAttribute('data-n') }));
        dica.appendChild(h('span', { text: melhor.getAttribute('data-t') + ' · ' + melhor.getAttribute('data-s') + ' · ' + melhor.getAttribute('data-tempo') + ' desde o protocolo' }));
      }
      var caixa = fig.getBoundingClientRect(), q = ativo.getBoundingClientRect();
      var x = q.left - caixa.left + 12, y = q.top - caixa.top - 8;
      dica.hidden = false;
      if (x + dica.offsetWidth > caixa.width) x = Math.max(0, q.left - caixa.left - dica.offsetWidth - 12);
      dica.style.left = x + 'px';
      dica.style.top = Math.max(0, y - dica.offsetHeight) + 'px';
    });
    svg.addEventListener('pointerleave', apagar);
  });

  /* O dossiê. */
  var mo = d.getElementById('cgDossie'), dentro = d.getElementById('cgDossieIn');
  var cache = {}, foco = null, aberto = null;
  function voto(m) { return (M.votos || {})[m.v] || m.v; }
  function marcaItem(m, extra) {
    var k = h('p', { cls: 'cg-ms-k' }, [h('time', { text: dataBr(m.d) }), h('span', { text: (M.tipos || {})[m.t] || m.t }), h('span', { cls: 'cg-ms-v', text: voto(m) })]);
    if (extra) k.appendChild(h('span', { text: extra }));
    var t = h('p', { cls: 'cg-ms-t' }, [m.p ? h('b', { text: m.p + ' ' }) : null, m.x || '']);
    var tm = (m.tm || []).length ? h('p', { cls: 'cg-ms-tm' }, m.tm.slice(0, 3).map(function (x) { return h('span', { cls: 'cg-chip', text: (M.temas || {})[x] || x }); })) : null;
    return h('li', {}, [k, t, m.e ? h('p', { cls: 'cg-ms-e', text: m.e }) : null, tm]);
  }
  function listaDeMarcas(itens, fn) {
    return h('ol', { cls: 'cg-ms' }, itens.map(function (m) { return marcaItem(m, fn ? fn(m) : ''); }));
  }
  function propItem(i, quando) {
    var k = h('p', { cls: 'cg-ls-k' }, [h('b', {}, [i.u ? h('a', { href: i.u, target: '_blank', rel: 'noopener noreferrer', text: i.t }) : i.t]), h('span', { text: quando })]);
    return h('li', {}, [k, h('p', { cls: 'cg-ls-x', text: (i.ap ? '“' + i.ap + '”. ' : '') + (i.e || '') })]);
  }
  // Quem trocou de partido na legislatura: o saldo só dos votos dados no partido atual.
  function noPartido(f) {
    var np = f.campo && f.campo.no_partido;
    if (!np) return '';
    if (!np.n) return ' Trocou de partido: ainda sem votações divisivas no ' + f.partido + '.';
    return ' Desde que está no ' + f.partido + ': ' + saldo(np.saldo) + ' em ' + num(np.n) + (np.n === 1 ? ' votação.' : ' votações.');
  }

  function secao(titulo, sub, filhos) {
    return h('section', { cls: 'cg-d-sec' }, [h('h3', {}, [titulo, sub ? h('span', { text: sub }) : null])].concat(filhos));
  }
  function tile(rotulo, valor, miudo, texto, extra, rank) {
    return h('div', { cls: 'cg-tile' }, [
      h('p', { cls: 'cg-tile-k', text: rotulo }),
      h('p', { cls: 'cg-tile-v' }, [valor, miudo ? h('small', { text: miudo }) : null]),
      rank ? h('p', { cls: 'cg-tile-r', text: rank }) : null,
      extra || null,
      texto ? h('p', { cls: 'cg-tile-x', text: texto }) : null
    ]);
  }

  /* Os rankings da Casa: [de cima, total, de baixo]; o 1º é quem tem o maior número. */
  var RANKS = [
    ['pres', 'Presença', 'que mais vota', 'que menos vota'],
    ['gov', 'Com o governo', 'que mais vota com o governo', 'que menos vota com o governo'],
    ['fid', 'Com o partido', 'que mais vota com o partido', 'que menos vota com o partido'],
    ['fora', 'Votos contra o próprio partido', 'que mais vota contra o partido', 'que menos vota contra o partido'],
    ['prop', 'Propostas apresentadas', 'que mais propõe', 'que menos propõe'],
    ['par', 'Propostas paradas há mais de um ano', 'com mais propostas paradas', 'com menos propostas paradas'],
    ['norma', 'Propostas que viraram norma', 'que mais virou norma', 'que menos virou norma'],
    ['rel', 'Relatorias esperando o seu parecer', 'com mais relatorias na mão', 'com menos relatorias na mão'],
    ['jor', 'Manchetes no jornal (30 dias)', 'mais citado no jornal', 'menos citado no jornal']
  ];
  function valorDoRank(f, chave) {
    var leg = (f.leg || {})[String(M.legislatura)] || {}, a = f.autoria || {};
    if (chave === 'pres') return leg.pres ? pct(leg.pres.pct) : '—';
    if (chave === 'gov') return (f.gov || {})[M.governo] ? pct(f.gov[M.governo].pct) : '—';
    if (chave === 'fid') return leg.fid ? pct(leg.fid.pct) : '—';
    if (chave === 'fora') return num((f.fora || {}).partido || 0);
    if (chave === 'prop') return num(a.total || 0);
    if (chave === 'par') return num(a.paradas_n || 0);
    if (chave === 'norma') return num((a.estados || {}).norma || 0);
    if (chave === 'rel') return num((f.relatorias || {}).total || 0);
    if (chave === 'jor') return num((f.jornal || {}).n30 || 0);
    return '—';
  }
  function posicao(f, chave, curto) {
    var r = (f.ranks || {})[chave], def = null;
    if (!r) return '';
    RANKS.forEach(function (x) { if (x[0] === chave) def = x; });
    var casa = f.casa === 'cd' ? 'na Câmara' : 'no Senado';
    var empate = r[1] - r[0] - r[2] + 2;  // quantos têm o mesmo número
    var t = r[0] + 'º de ' + num(r[1]) + (curto ? '' : ' ' + casa);
    if (empate > 1) t += ' · empatado com ' + num(empate - 1) + (empate === 2 ? ' outro' : ' outros');
    else if (def && r[0] <= 10) t += ' · o ' + r[0] + 'º ' + def[2];
    else if (def && r[2] <= 10 && r[2] < r[0]) t += ' · o ' + r[2] + 'º ' + def[3];
    return t;
  }
  function secaoRanks(f) {
    var linhas = RANKS.filter(function (x) { return (f.ranks || {})[x[0]]; }).map(function (x) {
      return h('tr', {}, [h('th', { scope: 'row', text: x[1] }), h('td', { text: valorDoRank(f, x[0]) }), h('td', { cls: 'an-l', text: posicao(f, x[0], true) })]);
    });
    if (!linhas.length) return null;
    var total = (f.ranks.prop || f.ranks.pres || [0, 0])[1];
    return secao('Na Casa', 'a posição entre os ' + num(total) + ' em exercício; o 1º é quem tem o maior número', [
      h('div', { cls: 'an-tbl-wrap' }, [h('table', { cls: 'an-tbl cg-tb cg-rk' }, [
        h('thead', {}, [h('tr', {}, ['', 'Número', 'Posição'].map(function (x, i) { return h('th', { scope: 'col', cls: i === 2 ? 'an-l' : null, text: x }); }))]),
        h('tbody', {}, linhas)
      ])])
    ]);
  }
  function montar(f) {
    var leg = (f.leg || {})[String(M.legislatura)] || {}, nos = [];
    var casa = f.casa === 'cd' ? 'Câmara dos Deputados' : 'Senado Federal';
    var foto = h('div', { cls: 'cg-d-f', 'data-img': '' }, f.foto ? [h('img', { src: f.foto, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' })] : []);
    var sub = h('p', { cls: 'cg-d-s' }, []);
    if (f.pagina) sub.appendChild(h('a', { href: f.pagina, target: '_blank', rel: 'noopener noreferrer', text: 'Página oficial ↗' }));
    sub.appendChild(d.createTextNode(f.pagina ? ' · ' : ''));
    sub.appendChild(h('a', { href: M.pesquisa + '?q=' + encodeURIComponent('"' + f.nome + '"'), text: 'Tudo o que o jornal publicou →' }));
    sub.appendChild(d.createTextNode(' · '));
    var outroSel = (escolhidos || []).filter(function (x) { return x !== f.k; }).pop();
    sub.appendChild(h('button', { cls: 'cg-cp-add', type: 'button', 'data-cmp-add': f.k, text: outroSel ? '⇄ Comparar com ' + nomeDe(outroSel) : '⇄ Comparar com outro' }));
    nos.push(h('div', { cls: 'cg-d-h' }, [foto, h('div', {}, [
      h('p', { cls: 'cg-d-k', text: casa + ' · ' + [f.partido, f.uf].filter(Boolean).join('-') + (f.condicao && f.condicao !== 'Titular' ? ' · ' + f.condicao : '') + (f.exercicio ? '' : ' · fora do exercício') }),
      h('h2', { cls: 'cg-d-t', id: 'cgDossieT', text: f.nome }), sub
    ])]));
    if (f.frases && f.frases.length) nos.push(h('ul', { cls: 'cg-d-fr' }, f.frases.map(function (x) { return h('li', { text: x }); })));

