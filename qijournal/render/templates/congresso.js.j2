  var q = d.getElementById('cgQ'), fora = d.getElementById('cgFora'), conta = d.getElementById('cgN');
  var linhas = tab ? lista(tab.tBodies[0].rows) : [];
  function semAcento(s) { return (s || '').toLowerCase().normalize ? s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '') : (s || '').toLowerCase(); }
  function filtrar() {
    if (!tab) return;
    var termos = semAcento(q ? q.value : '').split(/\s+/).filter(Boolean);
    var comFora = fora && fora.checked, casa = root.getAttribute('data-ver'), visiveis = 0;
    linhas.forEach(function (tr) {
      var alvo = tr.getAttribute('data-b') || '';
      var ok = (comFora || !tr.classList.contains('cg-fora')) && termos.every(function (t) { return alvo.indexOf(t) >= 0; });
      tr.hidden = !ok;
