{#- Como a mídia cobre: os nomes em destaque de uma editoria (qijournal/render/midia.py).
    sugestoes(nm): os nomes como atalhos de busca na Pesquisa analítica. (No Analítico
    Político, os mesmos nomes viram o placar e a matriz: analitico_lentes.html.j2.) -#}

{% macro sugestoes(nm) -%}
<p class="md-sug"><span class="md-sl">Em destaque na {{ nm.secao_titulo }} ({{ nm.periodo }}):</span>{% for n in nm.nomes %} <a href="{{ n.href }}" title="{{ "{:,}".format(n.manchetes).replace(",", ".") }} manchetes de {{ nm.secao_titulo }} no período (abre a busca com a editoria e o período)">{{ n.nome }}</a>{% endfor %}</p>
{%- endmacro %}
