{#- A leitura da busca, desenhada no padrão da aba Analítico (dentro do IIFE de
    pesquisa.js.j2, depois de midia.js.j2): a caixa da leitura (chapéu, manchete, prova,
    linha fina, mais achados) com o trilho das lentes e "O que mudou"; as histórias e o
    cabeçalho dos resultados; as três lentes (Manchetes, Enquadramento, Texto); a base
    completa recolhida e o "Como ler". As classes az-… vêm de analitico.css.j2 (incluído
    sem mudança); o que só a Pesquisa precisa está em pesquisa_leitura.css.j2. Todo texto
    que vem da busca ou dos dados passa por esc(). -#}
  /* ── A leitura da busca: o desenho ──────────────────────────────────── */
  var ACH = achadosCriar(LZ, ST);
  var navEl = $('pqNav'), lentesEl = $('pqLentes'), histEl = $('pqHist'), tiposEl = $('pqTipos'), refinarEl = $('pq-refinar');
  var BARRA = 50;

  function r2(x) { return Math.round(x * 100) / 100; }
  function w1(x) { return (Math.round(Math.max(0, Math.min(100, x)) * 10) / 10).toFixed(1) + '%'; }
  function xTom(s) { return s === null || s === undefined ? 50 : r2(50 + Math.max(-BARRA, Math.min(BARRA, s)) * 50 / BARRA); }
  function ba(antes, agora, srAntes, srAgora) {
    return '<span class="az-ba">' + (srAntes ? '<span class="sr-only">' + esc(srAntes) + ' </span>' : '') + esc(antes) +
      '<span aria-hidden="true"> → </span><span class="sr-only">' + (srAgora ? ', ' + esc(srAgora) + ' ' : ' para ') + '</span><b>' + esc(agora) + '</b></span>';
  }
  function chip(texto, forte, lado) {
    return '<span class="az-chip' + (forte ? ' on' + (lado ? ' ' + lado : '') : '') + '">' + esc(texto) + '</span>';
  }
  function tb(pctNeg, pctPos, escala) {
    return '<span class="az-tb" aria-hidden="true"><span class="az-tb-n"><i style="width:' + w1(100 * pctNeg / escala) + '"></i></span>' +
      '<span class="az-tb-p"><i style="width:' + w1(100 * pctPos / escala) + '"></i></span></span>';
  }
  function db(antes, agora, forte, lado) {
    var a = xTom(antes), b = xTom(agora);
    return '<span class="az-db" aria-hidden="true"><i class="az-db-l" style="left:' + Math.min(a, b) + '%;width:' + r2(Math.abs(a - b)) + '%"></i>' +
      '<i class="az-db-a" style="left:' + a + '%"></i><i class="az-db-b' + (forte && lado ? ' ' + lado : '') + '" style="left:' + b + '%"></i></span>';
  }
  function tomClasse(s) { return s === null || s === undefined ? 'est' : s <= -10 ? 'neg' : s >= 10 ? 'pos' : 'est'; }
  function dataIso(d) { return DATA_ISO.test(d || '') ? d : ''; }
  function hrefEdicao(d, ancora) { d = dataIso(d); return d ? edicao(d) + (ancora || '') : ''; }
  function dmTxt(d) { return d ? dataCurta(d) : ''; }
  function periodoTxt(a, b) { return a === b ? dataCurta(a) : dataCurta(a) + '–' + dataCurta(b); }

  /* ── a caixa da leitura e o trilho ─────────────────────────────────── */
  function achadoHTML(a) {
    return '<li class="az-a"><div class="az-a-tx"><p class="az-a-k"><span class="az-selo">' + esc(a.selo) + '</span><b class="az-a-num">' + esc(a.numero) + '</b></p>' +
      '<h5 class="az-a-t"><a class="hit" href="' + esc(a.href) + '">' + esc(a.titulo) + '</a></h5><p class="az-a-x">' + esc(a.texto) + '</p></div></li>';
  }
  function lenteHTML(x) {
    return '<li class="az-l"><p class="az-l-k"><b>' + x.ordem + '</b>' + esc(x.nome) + '</p><p class="az-l-p"><a class="hit" href="' + esc(x.href) + '">' + esc(x.pergunta) +
      '</a></p><p class="az-l-v"><b>' + esc(x.numero) + '</b> <span>' + esc(x.unidade) + '</span></p><p class="az-l-b">' + esc(x.base) + '</p></li>';
  }
  function mudancaHTML(m) {
    return '<li><a class="hit" href="' + esc(m.href) + '"><b>' + esc(m.nome) + '</b></a><span class="az-mud-t">' + esc(m.tipo) + '</span>' +
      (m.antes ? ba(m.antes, m.agora) : '<span class="az-nd">—</span>') + chip(m.selo, m.forte, m.classe) + '</li>';
  }
  var LENTES_N = ['Uma lente', 'Duas lentes', 'Três lentes'];
  function leituraHTML(L, F) {
    var p = L.principal;
    if (L.curta) {
      var eds = F.editorias.filter(function (x) { return x.s; });
      return '<div class="az-lead pq-so"><div class="az-box"><p class="az-chapeu">' + esc(L.chapeu) + '</p><h3 class="az-manchete" id="pqLzH">' + esc(p.titulo) + '</h3>' +
        '<p class="az-fina">' + esc(L.fina) + '</p>' +
        (L.espalha ? '<p class="az-note">Os resultados se espalham por editorias diferentes: confira se falam todos do mesmo ' + esc(F.q.rot) + '.</p>' +
          '<p class="pq-eds">' + eds.map(function (x) {
            return '<button type="button" data-ed="' + esc(x.s) + '">Só ' + esc(x.t) + ' <b>' + num(x.k) + '</b></button>';
          }).join('') + '</p>' : '') + '</div></div>';
    }
    var caixa = '<div class="az-box"><p class="az-chapeu">' + esc(L.chapeu) + '</p><h3 class="az-manchete" id="pqLzH">' + esc(p.titulo) + '</h3>' +
      '<p class="az-prova"><span class="az-selo">' + esc(p.selo) + '</span><span>' + esc(p.texto) + ' <a href="' + esc(p.href) + '">Ver a prova<span aria-hidden="true"> ↓</span></a></span></p>' +
      (L.semNoticias ? '<p class="pq-eds"><button type="button" data-tipo-n="1">Incluir as notícias na busca</button></p>' : '') +
      (L.fina ? '<p class="az-fina">' + esc(L.fina) + '</p>' : '') +
      (L.achados.length ? '<div class="az-mais" id="pqMaisAch"><h4 class="az-lbl">Mais achados <span class="az-lbl-n">' + L.achados.length + '</span></h4><ol class="az-achados">' +
        L.achados.map(achadoHTML).join('') + '</ol>' +
        (L.achados.length > 3 ? '<button type="button" class="pq-mais-cel" data-mostra="pqMaisAch">Mais ' + (L.achados.length - 3) + (L.achados.length - 3 === 1 ? ' achado' : ' achados') + '</button>' : '') +
        '</div>' : '') + '</div>';
    var trilho = '';
    if (L.lentes.length) {
      trilho = '<aside class="az-rail" aria-labelledby="pqLentesH"><h4 class="az-lbl" id="pqLentesH">' + LENTES_N[L.lentes.length - 1] +
        ' <span class="az-lbl-n">de onde saem os achados</span></h4><ol class="az-lentes">' + L.lentes.map(lenteHTML).join('') + '</ol>';
      if (L.mudancas) {
        trilho += '<h4 class="az-lbl az-lbl-2">O que mudou em sete edições <span class="az-lbl-n">' +
          (L.comparadas ? L.fortes + ' de ' + L.comparadas + ' além do acaso' : 'sem amostra para comparar') + '</span></h4><ol class="az-mud">' + L.mudancas.map(mudancaHTML).join('') + '</ol>';
      } else if (L.mud0) {
        trilho += '<h4 class="az-lbl az-lbl-2">O que mudou em sete edições</h4><p class="az-mud-0">' + esc(L.mud0) + '</p>';
      }
      if (F.az && M.analitico) {
        trilho += '<p class="pq-az-link"><a href="' + esc(M.analitico + '#qf-' + F.az.i) + '">' + esc(F.q.T) + ' no Analítico Político <span aria-hidden="true">→</span></a></p>';
      }
      trilho += '</aside>';
    }
    return '<div class="az-lead' + (trilho ? '' : ' pq-so') + '">' + caixa + trilho + '</div>';
  }
  function esqueletoHTML(texto) {
    return '<div class="az-lead pq-so"><div class="az-box pq-sk" aria-busy="true"><p class="az-chapeu" id="pqLzH">' + esc(texto) + '</p>' +
      '<p class="pq-sk-l"><i></i><i></i><i></i></p></div></div>';
  }

  /* ── as histórias (entre o cabeçalho dos resultados e a lista) ─────── */
  function historiasHTML(F) {
    var hs = (F.hist || []).slice(0, 3);
    if (!hs.length) return '';
    return '<div class="az-blk" id="pq-historias"><h4 class="az-h">' + (hs.length === 1 ? 'A história' : 'As histórias') + ' <span>' +
      (hs.length === 1 ? 'o assunto com mais veículos nos resultados' : 'os assuntos com mais veículos nos resultados') + '</span></h4><ol class="pq-hs">' +
      hs.map(function (h, i) {
        var meta = [periodoTxt(h.d0, h.d1), plural(h.nv, 'veículo', 'veículos'), plural(h.n, 'manchete', 'manchetes')];
        if (h.mat) meta.push('virou matéria');
        if (h.comp) meta.push('cobertura comparada');
        var vs = h.veiculos.slice(0, 6).join(', ') + (h.veiculos.length > 6 ? ' e mais ' + (h.veiculos.length - 6) : '');
        var itens = h.itens.slice().sort(function (a, b) { return cmp(b.d, a.d) || cmp(a.f[0] || '', b.f[0] || ''); }).slice(0, 25);
        return '<li class="az-rx pq-h" id="pq-h-' + (i + 1) + '"><p class="az-rx-m">' + esc(meta.join(' · ')) + '</p>' +
          '<h5 class="az-rx-t"><a href="' + esc(h.href) + '">' + esc(h.titulo) + '</a></h5><p class="pq-h-v">' + esc(vs) + '</p>' +
          '<details class="az-more"><summary>Ver ' + (h.n === 1 ? 'a manchete' : (h.n > itens.length ? 'as ' + itens.length + ' mais recentes' : 'as ' + num(h.n) + ' manchetes')) + '</summary><ul class="pq-h-l">' +
          itens.map(function (r) {
            return '<li><a href="' + esc(r.u) + '" target="_blank" rel="noopener noreferrer">' + esc(r.t) + '<span aria-hidden="true"> ↗</span><span class="sr-only"> (abre a notícia em nova aba)</span></a>' +
              '<small>' + esc((r.f[0] || '') + ' · ' + dataCurta(r.d)) + '</small></li>';
          }).join('') + '</ul></details></li>';
      }).join('') + '</ol>' +
      (hs.length > 1 ? '<button type="button" class="pq-mais-cel" data-mostra="pq-historias">Mais ' + (hs.length - 1) + (hs.length === 2 ? ' história' : ' histórias') + '</button>' : '') + '</div>';
  }

  /* ── seções e blocos ───────────────────────────────────────────────── */
  function secaoHTML(id, n, nome, titulo, dek, corpo) {
    return '<section class="az-sec" aria-labelledby="' + id + '-h"><header class="az-lh" id="' + id + '"><p class="az-ln">' + (n ? '<b>' + n + '</b>' : '') + esc(nome) + '</p>' +
      '<h3 class="az-lt" id="' + id + '-h">' + esc(titulo) + '</h3>' + (dek ? '<p class="az-ld">' + esc(dek) + '</p>' : '') + '</header>' + corpo + '</section>';
  }
  function blocoHTML(id, titulo, sub, dek, corpo, nota) {
    return '<div class="az-blk"' + (id ? ' id="' + id + '"' : '') + '><h4 class="az-h">' + esc(titulo) + (sub ? ' <span>' + esc(sub) + '</span>' : '') + '</h4>' +
      (dek ? '<p class="az-dek">' + dek + '</p>' : '') + corpo + (nota ? '<p class="az-note">' + nota + '</p>' : '') + '</div>';
  }

  /* ── lente 1: manchetes ────────────────────────────────────────────── */
  function curvaHTML(F, T) {
    var serie = F.serie || [];
    if (serie.length < 2) return '';
    var vals = serie.map(function (s) { return s.k / s.b; });
    var topo = Math.max.apply(null, vals) || 1, u = serie.length - 1;  // na escala do próprio termo
    var pts = vals.map(function (v, i) { return [r2(100 * i / u), r2(94 - 88 * v / topo)]; });
    function d(ps) { return ps.map(function (p, i) { return (i ? 'L' : 'M') + p[0] + ',' + p[1]; }).join(' '); }
    var picos = {};
    (F.picos ? F.picos.dias : []).forEach(function (x) { if (x.passa) picos[x.d] = x; });
    var marcas = '';
    serie.forEach(function (s, i) {
      if (picos[s.d]) marcas += '<i class="pq-pk" style="left:' + pts[i][0] + '%;top:' + pts[i][1] + '%"></i>';
    });
    var maior = serie[vals.indexOf(Math.max.apply(null, vals))];
    var aria = 'Parte das manchetes que citam ' + T + ' por edição, de ' + dataCurta(serie[0].d) + ' a ' + dataCurta(serie[u].d) +
      ': máximo de ' + pct(maior.k, maior.b) + ' em ' + dataCurta(maior.d) + '; última edição, ' + pct(serie[u].k, serie[u].b) + '.';
    return '<figure class="pq-cv"><div class="pq-cv-in" role="img" aria-label="' + esc(aria) + '"><span class="az-sp"><svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">' +
      '<path class="az-sp-l" d="' + d(pts) + '" vector-effect="non-scaling-stroke"/>' +
      (serie.length >= 14 ? '<path class="az-sp-r" d="' + d(pts.slice(-7)) + '" vector-effect="non-scaling-stroke"/>' : '') +
      '</svg><i style="top:' + pts[u][1] + '%"></i></span>' + marcas + '</div>' +
      '<figcaption class="pq-cv-ax"><span>' + dataCurta(serie[0].d) + '</span><span>' + (serie.length >= 14 ? 'em destaque, as últimas 7 edições' : '') + '</span><span>' + dataCurta(serie[u].d) + '</span></figcaption></figure>';
  }
  function espacoLado(F, T) {
    var h = '', e = F.tend;
    if (e) {
      var sel = ACH.variacao(e.ka / e.ba, e.kr / e.br);
      h += '<p class="pq-7"><span class="pq-7-k">7 anteriores → últimas 7</span>' + ba(pct(e.ka, e.ba), pct(e.kr, e.br), 'parte das manchetes nas 7 edições anteriores', 'nas últimas 7') +
        chip(sel, e.passa, '') + '</p><p class="az-note">' + num(e.ka) + ' de ' + num(e.ba) + ' manchetes, contra ' + num(e.kr) + ' de ' + num(e.br) + '. ' +
        (e.passa ? 'A diferença passa do acaso (99%).' : 'Diferença dentro do que o acaso explica.') + '</p>';
    } else if (F.jan === null) {
      h += '<p class="az-note">Com ' + plural(F.f.D, 'edição', 'edições') + ' no período, não há sete contra sete para comparar.</p>';
    }
    var pks = (F.picos ? F.picos.dias : []).filter(function (x) { return x.passa; }).sort(function (a, b) { return b.R - a.R; }).slice(0, 3);
    if (pks.length) {
      h += '<h5 class="az-h5">Picos <span>dias acima do acaso</span></h5><ol class="pq-pks">' + pks.map(function (x) {
        var hd = null;
        (F.hist || []).forEach(function (s) { if (s.nv >= 3 && x.d >= s.d0 && x.d <= s.d1 && (!hd || s.nv > hd.nv)) hd = s; });
        return '<li><button type="button" data-dia="' + esc(x.d) + '" title="Ver só a edição de ' + esc(dataLonga(x.d)) + '"><b>' + dataCurta(x.d) + '</b></button>' +
          '<span>' + plural(x.k, 'manchete', 'manchetes') + ' · ' + pct(x.k, x.b) + ' do dia · ' + ACH.dec(x.R, 1) + '× os outros dias</span>' +
          (hd ? '<small>' + esc('“' + hd.titulo + '”') + '</small>' : '') + '</li>';
      }).join('') + '</ol>';
    } else if (F.picos) {
      h += '<p class="az-note">Nenhum dia fica acima do acaso contando as ' + num(F.picos.m) + ' edições do período.</p>';
    }
    return h;
  }
  function tomBlocoHTML(F, T, x) {
    var t = F.tom;
    if (!t) return '';
    if (!t.aplica) {
      return blocoHTML('pq-tom', 'Tom das manchetes', '', 'O tom não se aplica a ' + esc(T) + ': ' + esc(t.motivo) + '.', '', '');
    }
    var tm = x.tm, escala = Math.max(20, 5 * Math.ceil(Math.max(100 * t.desf / t.n, 100 * t.fav / t.n) / 5));
    var h = '<p class="az-dn pq-dn">' + num(t.n) + ' manchetes brasileiras · ' + tb(100 * t.desf / t.n, 100 * t.fav / t.n, escala) +
      '<b class="tom-' + tomClasse(t.saldo) + '">saldo ' + esc(ACH.saldo(t.saldo)) + '</b> · ' + pct(t.desf, t.n) + ' desfavoráveis · ' + pct(t.fav, t.n) + ' favoráveis · ' +
      pct(t.n - t.desf - t.fav, t.n) + ' sem tom</p>';
    if (t.tend) {
      var v = t.tend.passa ? (t.tend.sr < t.tend.sa ? 'piorou' : 'melhorou') : 'estável', lado = t.tend.sr < t.tend.sa ? 'neg' : 'pos';
      h += '<p class="pq-7"><span class="pq-7-k">7 anteriores → últimas 7</span>' + db(t.tend.sa, t.tend.sr, t.tend.passa, lado) +
        ba(ACH.saldo(t.tend.sa), ACH.saldo(t.tend.sr), 'saldo nas 7 edições anteriores', 'nas últimas 7') + chip(v, t.tend.passa, lado) + '</p>' +
        '<p class="az-note">' + num(t.tend.na) + ' manchetes nas 7 edições anteriores e ' + num(t.tend.nr) + ' nas últimas 7. ' +
        (t.tend.passa ? 'A diferença passa do acaso (95%).' : 'Diferença dentro do que o acaso explica.') + '</p>';
    }
    if (tm && (tm.exNeg.length || tm.exPos.length)) {
      var ex = function (i, tipo) {
        return '<li class="qf-' + tipo + '"><span class="qf-et">' + (tipo === 'neg' ? 'Desfavorável' : 'Favorável') + '</span><a href="' + esc(i.u) + '" target="_blank" rel="noopener noreferrer">' + esc(i.t) +
          '</a><small>' + esc(i.o) + ' · ' + dataCurta(i.d) + ' · por: ' + esc(i.tom.gatilhos.join(', ')) + '</small></li>';
      };
      h += '<details class="az-more"><summary>Ver as manchetes que pesaram</summary><div class="az-2c"><ul class="qf-ex">' + tm.exNeg.map(function (i) { return ex(i, 'neg'); }).join('') +
        '</ul><ul class="qf-ex">' + tm.exPos.map(function (i) { return ex(i, 'pos'); }).join('') + '</ul></div></details>';
    }
    return blocoHTML('pq-tom', 'Tom das manchetes', 'em que contexto ' + T + ' aparece', '', h,
      'Leitura por palavras do título, sem IA: serve melhor para nomes de pessoas; para instituições e temas, confira os exemplos. <a href="#pq-como">Como ler</a>');
  }
  function linhaVeiculoHTML(v, F, x, escala, maiorS) {
    var tv = v.tv, aplica = F.tom && F.tom.aplica && tv && !tv.pequena, T = F.q.T;
    var s = v.b ? v.k / v.b : 0;
    var tipEs = v.o + ': ' + num(v.k) + ' de ' + num(v.b) + ' manchetes do veículo citam ' + T + ' (' + pct(v.k, v.b) + ')';
    var ix = v.esp >= 3 && v.i !== null ? ACH.dec(v.i, 1) + '×' : '';
    var tipIx = ix ? 'Esperado: umas ' + num(Math.max(1, ST.arred(v.esp, 0))) + ' manchetes, pela parte de ' + T + ' em cada editoria em que o veículo publica; ' +
      (v.atForte ? 'a diferença passa do acaso, mesmo contando os ' + num(F.mAt) + ' veículos comparados' : 'diferença dentro do que o acaso explica, contando os veículos comparados') : '';
    var cls = aplica ? tomClasse(v.sv) : 'est';
    var tipTm = aplica ? v.o + ': ' + v.desf + ' desfavoráveis e ' + v.fav + ' favoráveis em ' + v.kTom + ' manchetes; saldo ' + ACH.saldo(v.sv) : '';
    var lado = v.sv !== null && v.so !== null && v.sv < v.so ? 'neg' : 'pos';
    var isolado = !!v.tomIsolado, forte = v.tomForte;
    var familia = F.az ? 'as ' + num(F.az.mVei) + ' comparações veículo × nome do Analítico' : 'os ' + num(F.mVei) + ' veículos comparados';
    var veredT7 = forte ? 'passa do acaso, mesmo contando ' + familia : isolado ? 'difere na comparação isolada (99%), mas não contando ' + familia : 'dentro do que o acaso explica';
    var tipT7 = aplica ? 'Saldo de ' + v.o + ' ' + ACH.saldo(v.sv) + ' contra ' + ACH.saldo(v.so) + ' nos demais veículos: ' + veredT7 : '';
    var recentes = (x.nots || []).filter(function (r) { return r.f[0] === v.o; }).sort(function (a, b) { return cmp(b.d, a.d) || cmp(a.t, b.t); }).slice(0, 3);
    var dossie = '<p class="az-dn">' + esc(v.o) + ': ' + plural(v.k, 'manchete', 'manchetes') + ' com ' + esc(T) + ' entre as ' + num(v.b) + ' do veículo no período (' + pct(v.k, v.b) + ')' +
      (ix ? '; o esperado seria umas ' + num(Math.max(1, ST.arred(v.esp, 0))) : '') + (tv && tv.assunto ? '; o assunto que mais rendeu: ' + esc('“' + tv.assunto + '”') + ' (' + tv.assuntoN + ')' : '') + '.</p>';
    if (recentes.length) {
      dossie += '<h5 class="az-h5">As mais recentes</h5><ul class="pq-h-l">' + recentes.map(function (r) {
        return '<li><a href="' + esc(r.u) + '" target="_blank" rel="noopener noreferrer">' + esc(r.t) + '<span aria-hidden="true"> ↗</span><span class="sr-only"> (abre a notícia em nova aba)</span></a><small>' + dataCurta(r.d) + '</small></li>';
      }).join('') + '</ul>';
    }
    if (aplica && (tv.exNeg.length || tv.exPos.length)) {
      dossie += '<ul class="qf-ex">' + tv.exNeg.concat(tv.exPos).map(function (i) {
        var tipo = i.tom.tom === 'neg' ? 'neg' : 'pos';
        return '<li class="qf-' + tipo + '"><span class="qf-et">' + (tipo === 'neg' ? 'Desfavorável' : 'Favorável') + '</span><a href="' + esc(i.u) + '" target="_blank" rel="noopener noreferrer">' + esc(i.t) +
          '</a><small>' + dataCurta(i.d) + ' · por: ' + esc(i.tom.gatilhos.join(', ')) + '</small></li>';
      }).join('') + '</ul>';
    }
