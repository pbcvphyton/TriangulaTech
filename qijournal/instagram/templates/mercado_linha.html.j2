{# Mercado em linha (§4.8): slide 7 do Em 1 minuto (marinho) e substituto da noite (papel, s.tema).
   Título-achado com o maior acumulado e, embaixo, a ponta final dele ("até o fechamento de 23/10", "até a leitura
   das 06h00": §3, ponta a ponta com as duas datas); 4 painéis em 2×2; faixa Selic · IPCA 12m · juro real; rodapé.
   Painel, para ler a 375 px (todo texto com dado tem 22 px ou mais; o gráfico é a foto, arte#10): três linhas de
   texto, "Ibovespa · fech. 23/10" (o selo da leitura à direita do nome), "205.083 ↑ +0,47%" (valor em Plex Mono
   40 px e a variação do dia) e "+12,1% desde 28/09"; embaixo, a linha da série compacta (um rótulo só e o eixo).
   O rodapé leva o método e, com pregão faltante em algum gráfico, a legenda do tracejado.
   Painel com menos leituras que o mínimo mostra só o valor. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block theme %}{{ s.tema }} v2{% endblock %}
{% block style %}
.hook{flex:0 1 auto;min-height:0;margin-top:30px}
.st{flex:none;margin-top:10px;font-family:var(--mono);font-weight:500;font-size:24px;line-height:1.25;color:var(--ink2);white-space:nowrap}
.grid4{flex:none;display:grid;grid-template-columns:440px 440px;column-gap:56px;row-gap:36px;margin-top:40px;margin-bottom:14px}
/* com a ponta final embaixo do título, a grade sobe para a faixa de juros não encostar nos gráficos */
.st + .grid4{margin-top:22px;row-gap:24px}
.pn{min-width:0;display:flex;flex-direction:column}
/* o selo da leitura fica à direita do nome; se não couber (leitura de outro dia), desce uma linha, sem corte */
.pn .hd{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;column-gap:16px}
.pn .nm{font-family:var(--label);font-stretch:100%;font-weight:600;font-size:30px;line-height:1.2;color:var(--ink);white-space:nowrap}
.pn .sl{margin-left:auto;font-family:var(--mono);font-weight:500;font-size:22px;line-height:1.3;color:var(--ink2);white-space:nowrap}
.pn .vr{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-top:4px}
.pn .chg{font-size:28px}
.pn .v{font-family:var(--mono);font-weight:600;font-size:40px;line-height:1.1;color:var(--ink);white-space:nowrap}
.pn .ac{font-family:var(--mono);font-weight:600;font-size:24px;line-height:1.3;color:var(--ink);margin-top:4px;white-space:nowrap}
.pn .grafico{margin-top:12px}
.pn .so{margin-top:16px;padding-top:12px;border-top:2px solid var(--rule);font-family:var(--mono);font-size:22px;line-height:1.3;color:var(--ink2);text-wrap:balance}
/* sem série para gráfico (começo da série): valores grandes, grade no meio do quadro */
.curta .grid4{margin:auto 0;row-gap:72px}
.curta .pn .vr{flex-direction:column;align-items:flex-start;gap:6px;margin-top:10px}
.curta .pn .v{font-size:64px}
.curta .pn .nm{font-size:36px}
.curta .pn .ac{font-size:26px}
.faixa{flex:none;margin-top:auto;padding-top:20px;border-top:2px solid var(--rule3);font-family:var(--mono);font-weight:600;font-size:25px;line-height:1.3;color:var(--ink)}
.pe{flex:none;margin-top:12px;font-family:var(--mono);font-size:22px;line-height:1.35;color:var(--ink2);white-space:nowrap}
.pe svg{display:inline-block;vertical-align:middle;margin:0 .3em 0 .1em}
{% endblock %}
{% block body %}
{{ m.serie_band(s.selo, s.contador or none, s.cor) }}
<div class="frame{{ '' if s.graficos else ' curta' }}">
  {{ m.hook(s.titulo, s.destaque or none, s.tam, 60) }}
  {% if s.selo_titulo %}<div class="st">{{ s.selo_titulo }}</div>{% endif %}
  <div class="grid4">
  {% for p in s.paineis %}
    <div class="pn">
      <div class="hd"><span class="nm">{{ p.nome }}</span>{% if p.selo %}<span class="sl">{{ p.selo }}</span>{% endif %}</div>
      <div class="vr"><span class="v">{{ p.valor }}</span>{{ m.change(p, 28) }}</div>
      {% if p.acumulado %}<div class="ac">{{ p.acumulado }}</div>{% endif %}
      {% if p.grafico %}{{ m.grafico(p.grafico) }}{% else %}<div class="so">{{ p.leituras }} {{ 'leitura' if p.leituras == 1 else 'leituras' }} na série: curta para o gráfico</div>{% endif %}
    </div>
  {% endfor %}
  </div>
  {% if s.faixa %}<div class="faixa" data-fit="faixa" data-min="22">{{ s.faixa }}</div>{% endif %}
  <div class="pe" data-fit="rodape" data-min="20">{{ s.pe }}{% if s.tracejado %} · <svg width="40" height="8" viewBox="0 0 40 8" aria-hidden="true"><path d="M4 4H36" stroke="var(--ink2)" stroke-width="4" stroke-dasharray="3 9" stroke-linecap="round"/></svg>pregão sem leitura{% endif %}</div>
</div>
{{ m.assinatura(s.nota) }}
{% endblock %}
