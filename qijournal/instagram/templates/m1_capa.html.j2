{# Em 1 minuto 2.0 · capa (§5.4): marinho. Selo da série, o letreiro pequeno (o único slide com logo), o número
   da manchete em laranja com o qualificador acima ("CERCA DE / R$ 1 BI"), a manchete em Noto Serif 800 (64 a
   80 px; até 96 sem número; manha.tamanhos_capa) e, no pé, o mais coberto do dia e a faixa de dados em Plex
   Mono. Sem número na manchete e com 5+ veículos, a cobertura da capa vira o número ("NOTICIADO POR / 13
   VEÍCULOS", qualificador em mono, como no fato). O laranja é só do dado da capa: a contagem do mais coberto
   vai em tinta e, quando ele é a própria capa, a linha sai sem a contagem (ela fica para o slide 2); quando ele é
   um dos fatos, a linha só aponta o slide, com a contagem (o texto fica no fato). Sem linha fina: ela vai para
   o slide 2. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block theme %}t-dark v2{% endblock %}
{% block style %}
.topo{flex:none;margin-top:26px;display:flex;align-items:center}
.topo .logo{width:206px;color:var(--ink)}
.miolo{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;justify-content:center;padding:40px 0 48px}
.miolo .numbox{flex:none;margin-bottom:34px}
.miolo .qual{margin-bottom:.1em;letter-spacing:.02em}
.miolo.cob .qual{font-family:var(--mono);font-stretch:100%;font-weight:600;font-size:26px!important;letter-spacing:.08em;color:var(--ink2);
  margin-bottom:.5em}
.manchete{flex:0 1 auto;min-height:0;overflow:hidden;font-family:var(--serif);font-weight:800;line-height:1.07;
  letter-spacing:-.016em;color:var(--ink);text-wrap:balance}
.pe{flex:none}
.mc{padding:22px 0 24px;border-top:3px solid var(--ink)}
.mc .k{font-family:var(--mono);font-weight:600;font-size:22px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.mc .k b{font-weight:600;color:var(--ink)}
.mc .nome{margin-top:10px;font-family:var(--label);font-stretch:100%;font-weight:600;font-size:34px;line-height:1.2;color:var(--ink);
  overflow:hidden;max-height:2.7em}
.faixa{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:20px;border-top:2px solid var(--rule2);
  font-family:var(--mono);font-weight:500;font-size:24px;line-height:1.3;color:var(--ink2)}
.faixa .dados{min-width:0;white-space:nowrap;overflow:hidden}
.faixa .go{flex:none;display:flex;align-items:center;gap:14px;font-weight:600;letter-spacing:.04em;color:var(--ink);white-space:nowrap}
.faixa .go svg{width:52px;height:24px}
{% endblock %}
{% block body %}
{{ m.serie_band(s.selo, none, 'em1min') }}
<div class="frame">
  <div class="topo">{{ m.logo(206) }}</div>
  <div class="miolo{{ ' cob' if s.heroi == 'cobertura' }}">
    {% if s.valor %}{{ m.num_hero(s.valor, s.qual or none, s.tam, 140, true) }}{% endif %}
    <h1 class="manchete" data-fit="capa-manchete" data-min="56" style="font-size:{{ s.tam_manchete }}px">{{ m.tx(s.manchete) }}</h1>
  </div>
  <div class="pe">
    {% if s.mais_coberto %}
    <div class="mc">
      {% if s.mais_coberto.proprio %}
      <div class="k">É o assunto mais coberto do dia</div>
      {% elif s.mais_coberto.get('slide') %}
      <div class="k">O mais coberto do dia está no slide {{ s.mais_coberto.slide }} · <b>{{ s.mais_coberto.k }} veículos</b></div>
      {% else %}
      <div class="k">O mais coberto · <b>{{ s.mais_coberto.k }} veículos</b></div>
      <div class="nome" data-fit="capa-mais-coberto" data-min="26">{{ m.tx(s.mais_coberto.nome) }}</div>
      {% endif %}
    </div>
    {% endif %}
    <div class="faixa"><span class="dados" data-fit="capa-faixa" data-min="18">{{ s.faixa }}</span><span class="go">{{ s.chamada }}{{ m.go_arrow(52, 24, 4) }}</span></div>
  </div>
</div>
{{ m.assinatura(s.nota) }}
{% endblock %}
